# 0 monitors the whole discovered universe; >0 explicitly limits local capacity.
MAX_SYMBOLS=0
# Trade subscriptions prioritized for active setups and configured pins.
PINNED_SYMBOLS=
MAX_FULL_REALTIME_SYMBOLS=20
UNIVERSE_REFRESH_SEC=3600
CONTEXT_REFRESH_SEC=15
MARKET_UPDATE_THROTTLE_MS=1000
# Optional partition workers; all shards must be deployed to scan all instruments.
ENGINE_SHARD_INDEX=0
ENGINE_SHARD_COUNT=1
# Preview leaves history unchanged. Archive preserves verified gzip files before removing
# old snapshots/events from PostgreSQL. 0 disables retention for that table.
RETENTION_MODE=preview
SNAPSHOT_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=90
RETENTION_BATCH_ROWS=250
RETENTION_MAX_BATCHES=8
RETENTION_INTERVAL_SEC=3600
ARCHIVE_DIR=data/archives
PARTITION_MONTHS_AHEAD=3
PARTITION_MAX_MOVE_ROWS=10000
