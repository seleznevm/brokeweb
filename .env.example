# BROKE_SETUPS: independent research and optional public-depth admission.
# Existing database settings override these defaults. Pine inputs are unchanged.
BROKE_EXECUTION_GATE_ENABLED=false
BROKE_EXECUTION_NOTIONAL_USDT=1000
BROKE_EXECUTION_MAX_SPREAD_BPS=10
BROKE_EXECUTION_MAX_SLIPPAGE_BPS=15
BROKE_EXECUTION_MAX_AGE_SEC=5
BROKE_EXECUTION_MAX_SYMBOLS=40
# Cost assumptions frozen in each new observation; no actual exchange fills.
BROKE_FEE_RATE=0.00055
BROKE_SLIPPAGE_BPS=2
BROKE_SPREAD_BPS=2
# Experimental separate LATE WE family, all original WATCH ENTRY filters required.
BROKE_LATE_WATCH_ENABLED=false
BROKE_LATE_WATCH_WINDOW_BARS=3

# Historical BROKE_PB: separate durable worker, bounded processes and REST requests
