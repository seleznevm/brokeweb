//@version=6
indicator("Weighted Trading — All Setups v1.9.0", shorttitle="WT Setups", overlay=true, behind_chart=false, max_labels_count=500, max_lines_count=100, max_boxes_count=50)

// ============================================================================
//  Weighted Trading — reconstructed strategy indicator
//  Setups:
//  T1: Trend + EMA21 pullback + reclaim
//  T2: Range / volatility compression breakout + volume
//  T3: SMC / liquidity reaction: FVG + Order Block + Breaker proxy
//  T4: Momentum continuation + liquidity fuel proxy
//
//  v1.6.2: dedicated READY TO ENTER alert when ACTION first becomes ENTER NOW.
//  v1.6: Auto/Manual TF Profiles (5m / 15m / 30m / 1H) + optional
//        Broke Confluence Layer via input.source() bridge outputs.
//        Broke can be OFF, informational, soft execution confluence, or a hard gate.
//
//  v1.6.3: fixed Pine-incompatible signed str.tostring() format in READY alert.
//  v1.6.4: dynamic alert() calls fire intrabar on the first realtime tick where a signal appears.
//  v1.6.5: SL/TP/LIQ visual levels stop on the candle where the corresponding level is reached.
//          If managed SL is hit, all remaining targets stop; after TP1 initial SL is retired in favor of BE.
//  v1.6.6: Research Mode simulates the full trade lifecycle: partial TP1-TP4 exits,
//          optional BE after TP1, net R, expectancy, Profit Factor and TP/SL/BE hit stats.
//  v1.6.7: input groups are declared in strict UI order 01→13.
//  v1.6.8: Research Entry Mode: SETUP SIGNAL vs ENTER NOW. ENTER NOW enters on
//          the first historical bar where ACTION becomes ENTER NOW and rebuilds
//          SL-relative TP1-TP4 from the executable entry price.
//  v1.7.0: Adaptive Core:
//          - ATR-normalized setup distances where fixed % is not cross-asset robust;
//          - rolling percentile ranks for Volume / ADX / ATR% / Bollinger width;
//          - Market Regime classifier: TREND / RANGE / COMPRESSION / EXPANSION / CHAOTIC;
//          - setup-aware regime compatibility with Off / Soft / Hard filtering;
//          - percentile-aware Score, T2 volume, T3 displacement and T4 momentum.
//  v1.8.0: Setup Quality:
//          - independent directional T1Q / T2Q / T3Q / T4Q scores (0..100);
//          - optional minimum-quality hard gate per setup;
//          - the global Score keeps its 0..100 structure, but the former fixed
//            +20 active-setup component is now quality-weighted;
//          - Entry Quality setup component is also driven by the captured Setup Q;
//          - Setup Q is shown in dashboard, combined labels and dynamic alerts.
//  v1.9.0: Setup Logic:
//          - T1 adaptive pullback: ATR depth, EMA slope/structure and volume contraction→expansion;
//          - T2 stateful Breakout / Retest engine with selectable BREAKOUT / RETEST / BOTH modes;
//          - T3 strict Sweep → CHoCH/Displacement → Zone reaction state machine;
//          - T4 hard exhaustion protection against chase entries;
//          - Setup Quality, stops, labels, alerts and Research consume the new setup events.
//
//  IMPORTANT:
//  Pine cannot natively reproduce a real liquidation heatmap or exchange order
//  book. Equal highs/lows + confirmed swing levels are used as liquidity proxy.
// ============================================================================

// ─────────────────────────────────────────────────────────────────────────────
// GROUPS
// ─────────────────────────────────────────────────────────────────────────────
grpGeneral = "01. General"
grpProfile = "02. TF Profiles"
grpTrend   = "03. MTF Trend"
grpAdaptive = "04. Adaptive Core"
grpEMA     = "05. T1 — EMA Pullback"
grpBO      = "06. T2 — Breakout / Retest"
grpSMC     = "07. T3 — SMC / Liquidity"
grpMOM     = "08. T4 — Momentum"
grpScore   = "09. Scoring / Filters"
grpSetupQ  = "10. Setup Quality"
grpRisk    = "11. Risk / Targets"
grpVisual  = "12. Visuals / Alerts"
grpEntry   = "13. Entry Quality / Action"
grpBroke   = "14. Broke Confluence"
grpResearch = "15. Research Mode"

// ============================================================================
// INPUTS — DECLARED IN THE SAME ORDER AS THEY APPEAR IN TRADINGVIEW SETTINGS
// Pine displays input groups by the first input declaration it encounters.
// Keeping all inputs here guarantees a stable 01 → 15 group order.
// ============================================================================

// ── 01. GENERAL ──
enableT1 = input.bool(true,  "Enable T1: EMA Pullback", group=grpGeneral)
enableT2 = input.bool(true,  "Enable T2: Breakout / Compression", group=grpGeneral)
enableT3 = input.bool(true,  "Enable T3: SMC / Liquidity Reaction", group=grpGeneral)
enableT4 = input.bool(true,  "Enable T4: Momentum Continuation", group=grpGeneral)
confirmOnClose = input.bool(false, "Signals only on confirmed bar close", group=grpGeneral, tooltip="OFF = signals and dynamic alert() calls can trigger intrabar on the first realtime tick that satisfies the setup. Such signals can disappear before candle close. ON = wait for confirmed bar close.")

// ── 02. TF PROFILES ──
profileMode = input.string("Auto", "TF Profile", options=["Auto", "5m", "15m", "30m", "1H", "Manual"], group=grpProfile)

// ── 03. MTF TREND ──
manualHtfTf = input.timeframe("240", "Manual: Higher timeframe", group=grpTrend)
manualMidTf = input.timeframe("60",  "Manual: Working trend timeframe", group=grpTrend)
manualStrictMtf = input.bool(true, "Manual: T1/T2/T4 require HTF + working TF alignment", group=grpTrend)
manualAllowSmcCountertrend = input.bool(true, "Manual: T3 may trade when only one MTF direction agrees", group=grpTrend)
useBtcFilter = input.bool(true, "Use BTC context in score", group=grpTrend)
btcHardFilter = input.bool(false, "BTC context is a hard filter", group=grpTrend)
btcSymbol = input.symbol("BINANCE:BTCUSDT", "BTC symbol", group=grpTrend)
manualBtcTf = input.timeframe("60", "Manual: BTC context TF", group=grpTrend)

// ── 04. ADAPTIVE CORE ──
adaptiveCore = input.bool(true, "Enable Adaptive Core", group=grpAdaptive, tooltip="ON = use ATR-normalized setup distances and rolling percentile ranks so thresholds adapt to each symbol's own volatility, activity and trend-strength distribution. OFF = legacy v1.6.x behavior.")
adaptiveLookback = input.int(200, "Percentile lookback, bars", minval=50, maxval=2000, group=grpAdaptive)
adaptiveRegimeMode = input.string("Soft", "Market Regime filter", options=["Off", "Soft", "Hard"], group=grpAdaptive, tooltip="Off = informational only. Soft = incompatible setups require extra Score. Hard = incompatible setup/regime pairs are blocked.")
adaptiveRegimePenalty = input.int(10, "Soft regime penalty, Score", minval=0, maxval=30, group=grpAdaptive)
adaptiveAdxFloor = input.float(15.0, "Minimum ADX floor", minval=5.0, maxval=40.0, step=1.0, group=grpAdaptive)
adaptiveTrendAdxPct = input.float(60.0, "TREND: ADX percentile >=", minval=0, maxval=100, step=5, group=grpAdaptive)
adaptiveRangeAdxPct = input.float(40.0, "RANGE: ADX percentile <=", minval=0, maxval=100, step=5, group=grpAdaptive)
adaptiveCompressionAtrPct = input.float(30.0, "COMPRESSION: ATR percentile <=", minval=0, maxval=100, step=5, group=grpAdaptive)
adaptiveCompressionBbPct = input.float(30.0, "COMPRESSION: BB width percentile <=", minval=0, maxval=100, step=5, group=grpAdaptive)
adaptiveExpansionAtrPct = input.float(70.0, "EXPANSION: ATR percentile >=", minval=0, maxval=100, step=5, group=grpAdaptive)
adaptiveExpansionVolPct = input.float(60.0, "EXPANSION: Volume percentile >=", minval=0, maxval=100, step=5, group=grpAdaptive)
adaptiveChaosAtrPct = input.float(85.0, "CHAOTIC: ATR percentile >=", minval=0, maxval=100, step=5, group=grpAdaptive)
adaptiveChaosAdxMaxPct = input.float(45.0, "CHAOTIC: ADX percentile <=", minval=0, maxval=100, step=5, group=grpAdaptive)
adaptiveSlopeBars = input.int(3, "Trend slope measurement, bars", minval=1, maxval=20, group=grpAdaptive)
adaptiveSlopeMinAtr = input.float(0.12, "TREND: EMA21 slope >= ATR ×", minval=0.01, maxval=2.0, step=0.01, group=grpAdaptive)
adaptiveScoreVolumePct = input.float(55.0, "Score: Volume percentile baseline", minval=0, maxval=100, step=5, group=grpAdaptive)
adaptiveStrongVolumePct = input.float(70.0, "T2/T4: Strong Volume percentile >=", minval=0, maxval=100, step=5, group=grpAdaptive)
adaptiveDisplacementVolumePct = input.float(60.0, "T3 displacement: Volume percentile >=", minval=0, maxval=100, step=5, group=grpAdaptive)
adaptiveMomentumAdxPct = input.float(60.0, "T4: ADX percentile >=", minval=0, maxval=100, step=5, group=grpAdaptive)
adaptiveT1ToleranceAtr = input.float(0.30, "T1: EMA21 touch tolerance, ATR ×", minval=0.05, maxval=2.0, step=0.05, group=grpAdaptive)
adaptiveEqualToleranceAtr = input.float(0.20, "T3: Equal high/low tolerance, ATR ×", minval=0.02, maxval=2.0, step=0.02, group=grpAdaptive)
adaptiveSweepAtr = input.float(0.10, "T3: Liquidity break, ATR ×", minval=0.0, maxval=2.0, step=0.05, group=grpAdaptive)
adaptiveBreakoutDistanceAtr = input.float(0.10, "T2: Minimum breakout distance, ATR ×", minval=0.0, maxval=2.0, step=0.05, group=grpAdaptive)
adaptiveMomentumMoveAtr = input.float(1.25, "T4: Minimum directional move, ATR ×", minval=0.1, maxval=10.0, step=0.05, group=grpAdaptive)

// ── 05. T1 — EMA PULLBACK ──
pbLookbackManual = input.int(8, "Manual: Pullback may occur within last N bars", minval=1, group=grpEMA)
pbTolerancePct = input.float(0.35, "EMA21 touch tolerance, %", minval=0.0, step=0.05, group=grpEMA)
pbRequireEMA9 = input.bool(true, "Require price back above/below EMA9", group=grpEMA)
pbRequireCandleConfirmation = input.bool(true, "Require rejection / local break confirmation", group=grpEMA)
pbAdaptiveLogic = input.bool(true, "Adaptive pullback logic", group=grpEMA, tooltip="When Adaptive Core is ON, require a healthy ATR-normalized pullback, directional EMA21 slope, preserved EMA50 structure, quieter pullback volume and stronger confirmation volume.")
pbDepthMinAtr = input.float(0.60, "Adaptive: minimum pullback depth, ATR ×", minval=0.0, maxval=10.0, step=0.05, group=grpEMA)
pbDepthMaxAtr = input.float(3.00, "Adaptive: maximum pullback depth, ATR ×", minval=0.1, maxval=20.0, step=0.10, group=grpEMA)
pbMinSlopeAtr = input.float(0.08, "Adaptive: minimum EMA21 slope, ATR ×", minval=0.0, maxval=2.0, step=0.01, group=grpEMA)
pbPullbackVolMaxPct = input.float(70.0, "Adaptive: pullback Volume percentile <=", minval=0, maxval=100, step=5, group=grpEMA)
pbConfirmVolMinPct = input.float(45.0, "Adaptive: confirmation Volume percentile >=", minval=0, maxval=100, step=5, group=grpEMA)
pbEma50GuardAtr = input.float(0.35, "Adaptive: max EMA50 structure violation, ATR ×", minval=0.0, maxval=5.0, step=0.05, group=grpEMA)

// ── 06. T2 — BREAKOUT / COMPRESSION ──
rangeLenManual = input.int(20, "Manual: Range lookback", minval=5, group=grpBO)
breakoutVolMinManual = input.float(1.40, "Manual: Minimum volume / average", minval=0.5, step=0.05, group=grpBO)
requireSqueezeManual = input.bool(false, "Manual: Require recent Bollinger compression", group=grpBO)
bbLen = input.int(20, "Bollinger length", minval=5, group=grpBO)
bbMult = input.float(2.0, "Bollinger deviation", minval=0.5, step=0.1, group=grpBO)
squeezeLookbackManual = input.int(50, "Manual: BB width baseline", minval=10, group=grpBO)
squeezeBarsManual = input.int(4, "Manual: Compression must persist N bars", minval=2, group=grpBO)
squeezeFactor = input.float(0.70, "Compression factor vs baseline", minval=0.2, maxval=1.2, step=0.05, group=grpBO)
squeezeRecentBarsManual = input.int(10, "Manual: Breakout allowed N bars after squeeze", minval=1, group=grpBO)
t2SignalMode = input.string("RETEST", "T2 signal mode", options=["BREAKOUT", "RETEST", "BOTH"], group=grpBO, tooltip="BREAKOUT = signal on the initial range break. RETEST = breakout arms a setup but the signal waits for a successful retest of the broken level. BOTH = emit both event types; Research can still hold only one T2 virtual trade at a time.")
t2RetestBarsManual = input.int(6, "Manual: Retest window, bars", minval=1, maxval=50, group=grpBO)
t2RetestToleranceAtr = input.float(0.20, "Retest touch tolerance, ATR ×", minval=0.0, maxval=2.0, step=0.05, group=grpBO)
t2RetestMaxPenetrationAtr = input.float(0.30, "Retest max penetration through level, ATR ×", minval=0.0, maxval=3.0, step=0.05, group=grpBO)
t2RetestCloseBufferAtr = input.float(0.05, "Retest close back beyond level, ATR ×", minval=0.0, maxval=2.0, step=0.05, group=grpBO)
t2RetestRequireDirectionCandle = input.bool(true, "Retest requires directional candle", group=grpBO)
t2BreakInvalidationAtr = input.float(0.45, "Invalidate breakout after close through level, ATR ×", minval=0.05, maxval=3.0, step=0.05, group=grpBO)

// ── 07. T3 — SMC / LIQUIDITY ──
pivotLenManual = input.int(4, "Manual: Swing pivot length", minval=2, group=grpSMC)
eqTolerancePct = input.float(0.25, "Equal high/low tolerance, %", minval=0.05, step=0.05, group=grpSMC)
eqBreakPct = input.float(0.10, "Liquidity level considered swept after overshoot, %", minval=0.0, step=0.05, group=grpSMC)
liqMaxAtrManual = input.float(8.0, "Manual: Max distance to liquidity proxy, ATR", minval=1.0, step=0.5, group=grpSMC)
obSearchManual = input.int(8, "Manual: Search last opposite candle for OB", minval=2, maxval=60, group=grpSMC)
dispLookbackManual = input.int(10, "Manual: Displacement structure lookback", minval=3, group=grpSMC)
dispBodyATR = input.float(0.80, "Displacement body >= ATR ×", minval=0.2, step=0.1, group=grpSMC)
dispVolMinManual = input.float(1.20, "Manual: Displacement volume / average", minval=0.5, step=0.05, group=grpSMC)
t3RequireSequence = input.bool(true, "Require Sweep → CHoCH → Zone sequence", group=grpSMC, tooltip="ON = a T3 signal is emitted only after a liquidity sweep/reclaim, then a structural CHoCH/displacement, then a reaction from the post-CHoCH zone. OFF = legacy direct FVG/OB/Breaker reactions.")
t3ChochLookback = input.int(5, "CHoCH structure lookback, bars", minval=2, maxval=30, group=grpSMC)
t3SweepToChochBars = input.int(6, "Max bars: Sweep → CHoCH", minval=1, maxval=50, group=grpSMC)
t3ChochToZoneBars = input.int(10, "Max bars: CHoCH → Zone reaction", minval=1, maxval=100, group=grpSMC)
t3ChochBodyAtr = input.float(0.45, "CHoCH minimum body, ATR ×", minval=0.0, maxval=3.0, step=0.05, group=grpSMC)
t3SweepReclaimBufferAtr = input.float(0.00, "Sweep reclaim beyond level, ATR ×", minval=0.0, maxval=1.0, step=0.05, group=grpSMC)
t3SequenceInvalidationAtr = input.float(0.35, "Sequence invalidation beyond swept level, ATR ×", minval=0.05, maxval=3.0, step=0.05, group=grpSMC)

// ── 08. T4 — MOMENTUM ──
momLenManual = input.int(10, "Manual: Momentum ROC bars", minval=2, group=grpMOM)
momRocMin = input.float(2.0, "Minimum absolute ROC, %", minval=0.1, step=0.1, group=grpMOM)
momVolMinManual = input.float(1.50, "Manual: Momentum volume / average", minval=0.5, step=0.05, group=grpMOM)
momAdxMinManual = input.float(22.0, "Manual: Minimum ADX", minval=5.0, step=1.0, group=grpMOM)
momBreakLenManual = input.int(8, "Manual: Must break closing extreme of N bars", minval=2, group=grpMOM)
t4ExhaustionProtection = input.bool(true, "Enable exhaustion protection", group=grpMOM, tooltip="Blocks late momentum entries when price is too stretched from EMA21, the signal candle is abnormally large, volatility+volume are climactic, or too many directional candles have already printed.")
t4MaxDistanceEmaAtr = input.float(2.50, "Max distance from EMA21, ATR ×", minval=0.5, maxval=10.0, step=0.10, group=grpMOM)
t4MaxSignalBarAtr = input.float(1.80, "Max signal candle range, ATR ×", minval=0.5, maxval=10.0, step=0.10, group=grpMOM)
t4ClimaxAtrPct = input.float(92.0, "Climax: ATR percentile >=", minval=0, maxval=100, step=1, group=grpMOM)
t4ClimaxVolumePct = input.float(92.0, "Climax: Volume percentile >=", minval=0, maxval=100, step=1, group=grpMOM)
t4MaxDirectionalBars = input.int(5, "Max consecutive directional candles", minval=2, maxval=12, group=grpMOM)
t4MaxOppositeWickPct = input.float(45.0, "Max rejection wick, % of candle range", minval=0, maxval=100, step=5, group=grpMOM)

// ── 09. SCORING / FILTERS ──
volLenManual = input.int(20, "Manual: Volume SMA length", minval=5, group=grpScore)
minScoreManual = input.int(70, "Manual: Minimum score for signal", minval=0, maxval=100, group=grpScore)
scoreVolMinManual = input.float(1.0, "Manual: Volume ratio for score", minval=0.1, step=0.1, group=grpScore)
scoreAdxMinManual = input.float(18.0, "Manual: ADX for score", minval=5.0, step=1.0, group=grpScore)
requireLiquidityHardManual = input.bool(false, "Manual: Liquidity proxy is a hard filter", group=grpScore)

// ── 10. SETUP QUALITY ──
setupQualityGate = input.bool(true, "Require minimum Setup Quality", group=grpSetupQ, tooltip="ON = each T1/T2/T3/T4 signal must also pass its own TnQ threshold. OFF = TnQ remains informational and still contributes to the aggregate Score.")
t1QualityMin = input.int(65, "T1Q minimum", minval=0, maxval=100, group=grpSetupQ)
t2QualityMin = input.int(70, "T2Q minimum", minval=0, maxval=100, group=grpSetupQ)
t3QualityMin = input.int(65, "T3Q minimum", minval=0, maxval=100, group=grpSetupQ)
t4QualityMin = input.int(70, "T4Q minimum", minval=0, maxval=100, group=grpSetupQ)
setupQualityConfluenceBonus = input.int(5, "Aggregate Q bonus per extra simultaneous setup", minval=0, maxval=15, group=grpSetupQ, tooltip="When several raw setups agree on the same bar, the aggregate setup-quality component receives this bonus per additional setup, capped at 100 Q.")

// ── 11. RISK / TARGETS ──
pbStopLenManual = input.int(8, "Manual: T1 stop structure lookback", minval=2, group=grpRisk)
slAtrBuffer = input.float(0.20, "Structure SL ATR buffer", minval=0.0, step=0.05, group=grpRisk)
breakStopAtr = input.float(0.50, "T2 stop below/above breakout level, ATR", minval=0.1, step=0.1, group=grpRisk)
momStopAtr = input.float(1.50, "T4 stop distance, ATR", minval=0.5, step=0.1, group=grpRisk)
riskUsdt = input.float(25.0, "SL (USDT) — risk per trade", minval=0.1, step=1.0, group=grpRisk, tooltip="Maximum planned loss at the initial SL. Position size in USDT is calculated as Risk USDT / SL distance %. Example: $25 risk and 2% stop = about $1,250 position notional.")
r1 = input.float(0.75, "TP1, R", minval=0.1, step=0.05, group=grpRisk)
r2 = input.float(1.50, "TP2, R", minval=0.2, step=0.1, group=grpRisk)
r3 = input.float(2.50, "TP3, R", minval=0.5, step=0.1, group=grpRisk)
r4 = input.float(3.50, "TP4, R", minval=0.5, step=0.1, group=grpRisk)

// ── 12. VISUALS / ALERTS ──
showEMA = input.bool(true, "Show EMA 9/21/50", group=grpVisual)
showBands = input.bool(false, "Show Bollinger Bands", group=grpVisual)
showZones = input.bool(true, "Show active FVG / OB / breaker zones", group=grpVisual)
showLiquidity = input.bool(true, "Show equal-high/low liquidity proxy", group=grpVisual)
showTradeLevels = input.bool(true, "Show latest Entry / SL / TP levels", group=grpVisual)
showDashboard = input.bool(true, "Show dashboard", group=grpVisual)
dashboardPosition = input.string("Top Right", "Dashboard position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], group=grpVisual)
dashboardBgTransparency = input.int(12, "Dashboard background transparency", minval=0, maxval=100, group=grpVisual)
showSignalLabels = input.bool(true, "Show combined signal label", group=grpVisual)
combinedLabelDetail = input.string("Compact", "Combined label detail", options=["Compact", "Full"], group=grpVisual, tooltip="Compact keeps only direction / setups / score on the chart. Full Entry/SL/TP/LIQ information remains available in the label tooltip.")
combinedLabelMinBars = input.int(8, "Minimum bars between combined labels", minval=0, maxval=100, group=grpVisual, tooltip="Anti-overlap filter. 0 restores a label on every qualified signal bar. On 15m, 6-10 bars usually works well.")
combinedLabelDirectionChange = input.bool(true, "Always show first label after direction change", group=grpVisual)
combinedLabelAtrOffset = input.float(0.75, "Combined label distance from candle, ATR", minval=0.0, maxval=10.0, step=0.05, group=grpVisual)
combinedLabelSizeInput = input.string("Small", "Combined label size", options=["Tiny", "Small", "Normal"], group=grpVisual)
combinedLabelBgTransparency = input.int(8, "Combined label background transparency", minval=0, maxval=100, group=grpVisual)
combinedLongTextColor = input.color(color.black, "Combined LONG text color", group=grpVisual)
combinedShortTextColor = input.color(color.white, "Combined SHORT text color", group=grpVisual)
enableDynamicAlerts = input.bool(true, "Enable dynamic alert() calls", group=grpVisual, tooltip="Keep ON when the TradingView alert condition is 'Any alert() function call'. Dynamic alerts include direction, setup IDs, score, Entry, SL and TP1.")
enableReadyAlert = input.bool(true, "Alert when ACTION becomes ENTER NOW", group=grpVisual, tooltip="Sends one dedicated alert when ACTION first becomes ENTER NOW. With confirmed-bar mode OFF, this can trigger intrabar. It will not repeat while ACTION remains ENTER NOW.")
suppressSetupAlertWhenReady = input.bool(true, "Avoid duplicate setup alert when READY fires", group=grpVisual, tooltip="When using 'Any alert() function call', suppresses the ordinary T1-T4 signal alert if the same bar also becomes ENTER NOW. The READY alert is still sent.")

// ── 13. ENTRY QUALITY / ACTION ──
entryQualityMinManual = input.int(70, "Manual: Minimum quality for ENTER NOW", minval=0, maxval=100, group=grpEntry)
entryWaitMinManual = input.int(55, "Manual: Minimum quality for WAIT RETEST", minval=0, maxval=100, group=grpEntry)
entryNowMaxRManual = input.float(0.15, "Manual: Max favorable distance from Entry for ENTER NOW, R", minval=0.0, maxval=2.0, step=0.05, group=grpEntry)
entryAdverseEnterRManual = input.float(0.20, "Manual: Max adverse distance from Entry for ENTER NOW, R", minval=0.0, maxval=2.0, step=0.05, group=grpEntry)
entryTooLateRManual = input.float(0.45, "Manual: TOO LATE after favorable move, R", minval=0.1, maxval=5.0, step=0.05, group=grpEntry)
entryMaxAgeBarsManual = input.int(6, "Manual: Maximum bars after signal for new entry", minval=1, maxval=100, group=grpEntry)
entryAdverseSkipRManual = input.float(0.50, "Manual: SKIP after adverse move, R", minval=0.1, maxval=5.0, step=0.05, group=grpEntry)
entryMinLiqRRManual = input.float(1.00, "Manual: Minimum current R:R to LIQ", minval=0.0, maxval=10.0, step=0.1, group=grpEntry)
entryRequireBothMtf = input.bool(true, "Require HTF + working TF alignment for ENTER NOW", group=grpEntry)

// ── 14. BROKE CONFLUENCE ──
useBrokeCorrelation = input.bool(false, "Enable Broke correlation", group=grpBroke)
brokeMode = input.string("Soft", "Broke mode", options=["Info only", "Soft", "Hard Gate"], group=grpBroke, tooltip="Info only: dashboard only. Soft: adjusts Entry Quality. Hard Gate: ENTER NOW requires Broke confirmation.")
brokeAffectsSignals = input.bool(false, "Broke hard-gates T1-T4 signal generation", group=grpBroke, tooltip="Default OFF. When ON, T1-T4 labels/alerts also require Broke direction + quality. Research then measures correlated signals instead of pure WT setups.")
brokeRequireEntryEvent = input.bool(false, "Require Broke WATCH/PINE entry event for ENTER NOW", group=grpBroke, tooltip="Strict execution confirmation. A recent Broke WATCH ENTRY or PINE READY event must agree with WT direction.")
brokeEntryEventWindow = input.int(3, "Broke entry-event confirmation window, bars", minval=0, maxval=20, group=grpBroke)
brokePackedSrc = input.source(close, "Broke Bridge: Packed", group=grpBroke, tooltip="Select the single 'WT Bridge — Packed' output from the Broke indicator patched with Broke_WT_Bridge_patch_v2.pine.")
brokeMinAvg = input.float(70.0, "Broke: AVG SETUP >=", minval=0, maxval=100, step=1, group=grpBroke)
brokeMinExecution = input.float(65.0, "Broke: Execution >=", minval=0, maxval=100, step=1, group=grpBroke)
brokeMinLevel = input.float(60.0, "Broke: Level Quality >=", minval=0, maxval=100, step=1, group=grpBroke)
brokeMaxMae = input.float(45.0, "Broke: MAE Risk <=", minval=0, maxval=100, step=1, group=grpBroke)
brokeMaxExhaustion = input.float(45.0, "Broke: Exhaustion Risk <=", minval=0, maxval=100, step=1, group=grpBroke)

// ── 15. RESEARCH MODE ──
researchMode = input.bool(false, "Enable Research Mode", group=grpResearch, tooltip="Simulates full T1-T4 trades with partial TP1-TP4 exits, optional BE after TP1, expectancy and Profit Factor.")
researchEntryMode = input.string("SETUP SIGNAL", "Research Entry Mode", options=["SETUP SIGNAL", "ENTER NOW"], group=grpResearch, tooltip="SETUP SIGNAL: enter at the close of each qualified T1-T4 setup event, using that setup's own structural SL. ENTER NOW: enter only when ACTION first becomes ENTER NOW for the latest trade plan. The entry is the ENTER NOW bar close; the active plan SL is used and TP1-TP4 are rebuilt from that executable entry using the same R multiples. Historical Research uses bar-close states, so it cannot reproduce transient intrabar ENTER NOW states that disappeared before candle close.")
researchPeriodMode = input.string("Days", "Calculation period mode", options=["Days", "Bars"], group=grpResearch)
researchDays = input.int(30, "Lookback, days", minval=1, maxval=3650, group=grpResearch)
researchBars = input.int(2000, "Lookback, bars", minval=50, maxval=50000, group=grpResearch)
researchMoveToBE = input.bool(true, "Move remaining position to BE after TP1", group=grpResearch, tooltip="BE becomes actionable starting from the bar AFTER TP1 is first reached. This avoids assuming intrabar order that OHLC cannot prove.")
researchAmbiguous = input.string("Stop first (conservative)", "If active stop and a new TP are touched on same bar", options=["Stop first (conservative)", "Exclude trade"], group=grpResearch, tooltip="Historical OHLC cannot reveal whether stop or target was touched first. Conservative mode resolves the stop first. Exclude removes the entire trade from performance statistics.")
researchDashboardDetail = input.string("Compact", "Research dashboard detail", options=["Compact", "Full"], group=grpResearch)
researchTp1Weight = input.float(25.0, "TP1 exit weight", minval=0.1, step=1.0, group=grpResearch)
researchTp2Weight = input.float(25.0, "TP2 exit weight", minval=0.1, step=1.0, group=grpResearch)
researchTp3Weight = input.float(25.0, "TP3 exit weight", minval=0.1, step=1.0, group=grpResearch)
researchTp4Weight = input.float(25.0, "TP4 exit weight", minval=0.1, step=1.0, group=grpResearch)

// ─────────────────────────────────────────────────────────────────────────────
// GENERAL
// ─────────────────────────────────────────────────────────────────────────────

confirmed = not confirmOnClose or barstate.isconfirmed

// ─────────────────────────────────────────────────────────────────────────────
// TF PROFILE SELECTOR
// Auto applies dedicated defaults only on exact 5m/15m/30m/1H charts.
// Other chart TFs fall back to Manual. Select Manual to use every raw input below.
// ─────────────────────────────────────────────────────────────────────────────

string autoProfile = timeframe.isminutes and timeframe.multiplier == 5 ? "5m" :
     timeframe.isminutes and timeframe.multiplier == 15 ? "15m" :
     timeframe.isminutes and timeframe.multiplier == 30 ? "30m" :
     timeframe.isminutes and timeframe.multiplier == 60 ? "1H" : "Manual"
string activeProfile = profileMode == "Auto" ? autoProfile : profileMode
bool profile5m  = activeProfile == "5m"
bool profile15m = activeProfile == "15m"
bool profile30m = activeProfile == "30m"
bool profile1h  = activeProfile == "1H"
bool profileManual = activeProfile == "Manual"

// ─────────────────────────────────────────────────────────────────────────────
// HELPERS
// ─────────────────────────────────────────────────────────────────────────────
f_trendState() =>
    _e9  = ta.ema(close, 9)
    _e21 = ta.ema(close, 21)
    _bull = close > _e21 and _e9 > _e21 and _e21 > _e21[1]
    _bear = close < _e21 and _e9 < _e21 and _e21 < _e21[1]
    _bull ? 1 : _bear ? -1 : 0

f_trendStateConfirmed() =>
    _e9  = ta.ema(close, 9)
    _e21 = ta.ema(close, 21)
    _bull = close[1] > _e21[1] and _e9[1] > _e21[1] and _e21[1] > _e21[2]
    _bear = close[1] < _e21[1] and _e9[1] < _e21[1] and _e21[1] < _e21[2]
    _bull ? 1 : _bear ? -1 : 0

f_stateText(_s) =>
    _s == 1 ? "BULL" : _s == -1 ? "BEAR" : "NEUTRAL"

f_stateColor(_s) =>
    _s == 1 ? color.new(color.lime, 78) : _s == -1 ? color.new(color.red, 78) : color.new(color.gray, 82)

f_touchZone(_lo, _hi) =>
    not na(_lo) and not na(_hi) and low <= _hi and high >= _lo

f_lastBearZone(_lookback) =>
    float _hi = na
    float _lo = na
    for i = 1 to _lookback
        if na(_hi) and close[i] < open[i]
            _hi := high[i]
            _lo := low[i]
    [_hi, _lo]

f_lastBullZone(_lookback) =>
    float _hi = na
    float _lo = na
    for i = 1 to _lookback
        if na(_hi) and close[i] > open[i]
            _hi := high[i]
            _lo := low[i]
    [_hi, _lo]

f_nearestAbove(_a, _b, _price) =>
    _aOk = not na(_a) and _a > _price
    _bOk = not na(_b) and _b > _price
    _aOk and _bOk ? math.min(_a, _b) : _aOk ? _a : _bOk ? _b : na

f_nearestBelow(_a, _b, _price) =>
    _aOk = not na(_a) and _a < _price
    _bOk = not na(_b) and _b < _price
    _aOk and _bOk ? math.max(_a, _b) : _aOk ? _a : _bOk ? _b : na

// Research statistics helpers.
f_researchWr(_wins, _closed) =>
    _closed > 0 ? 100.0 * _wins / _closed : na

f_researchPf(_grossProfitR, _grossLossR) =>
    _grossLossR > 0 ? _grossProfitR / _grossLossR : _grossProfitR > 0 ? 999.0 : na

f_researchAvg(_sum, _count) =>
    _count > 0 ? _sum / _count : na

f_researchColor(_expectancyR) =>
    na(_expectancyR) ? color.new(color.gray, 82) : _expectancyR >= 0.20 ? color.new(color.green, 65) : _expectancyR > 0 ? color.new(color.yellow, 68) : _expectancyR == 0 ? color.new(color.gray, 76) : color.new(color.red, 70)

f_fmtR(_v) =>
    na(_v) ? "—" : (_v > 0 ? "+" : "") + str.tostring(_v, "#.##") + "R"

// Entry execution helpers.
f_qualityColor(_q) =>
    na(_q) ? color.new(color.gray, 82) : _q >= 80 ? color.new(color.lime, 68) : _q >= 70 ? color.new(color.green, 72) : _q >= 55 ? color.new(color.yellow, 68) : color.new(color.red, 72)

f_actionColor(_a) =>
    _a == "ENTER NOW" ? color.new(color.lime, 58) :
     _a == "WAIT RETEST" ? color.new(color.yellow, 58) :
     _a == "TOO LATE" ? color.new(color.orange, 55) :
     _a == "SKIP" ? color.new(color.red, 58) : color.new(color.gray, 82)

f_regimeColor(_r) =>
    str.contains(_r, "TREND") ? color.new(color.green, 68) :
     str.contains(_r, "EXPANSION") ? color.new(color.blue, 68) :
     _r == "COMPRESSION" ? color.new(color.yellow, 68) :
     _r == "RANGE" ? color.new(color.gray, 72) :
     _r == "CHAOTIC" ? color.new(color.red, 62) : color.new(color.orange, 72)

f_clamp100(_v) =>
    math.max(0.0, math.min(100.0, _v))

// ─────────────────────────────────────────────────────────────────────────────
// BASE CALCULATIONS
// ─────────────────────────────────────────────────────────────────────────────
ema9  = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
ema50 = ta.ema(close, 50)
atr   = ta.atr(14)

int volLen = profile5m ? 60 : profile15m ? 20 : profile30m ? 12 : profile1h ? 8 : volLenManual
volAvg = ta.sma(volume, volLen)
volRatio = na(volAvg) or volAvg == 0 ? 0.0 : volume / volAvg

[diplus, diminus, adx] = ta.dmi(14, 14)

chartBull = close > ema21 and ema9 > ema21 and ema21 > ema21[1]
chartBear = close < ema21 and ema9 < ema21 and ema21 < ema21[1]

// Adaptive Core base metrics.
atrPctOfPrice = close != 0 ? atr / close * 100.0 : na
volumePctRank = nz(ta.percentrank(volume, adaptiveLookback), 50.0)
adxPctRank = nz(ta.percentrank(adx, adaptiveLookback), 50.0)
atrPctRank = nz(ta.percentrank(atrPctOfPrice, adaptiveLookback), 50.0)

bbBasis = ta.sma(close, bbLen)
bbDev = bbMult * ta.stdev(close, bbLen)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
bbWidth = bbBasis == 0 ? 0.0 : (bbUpper - bbLower) / bbBasis
bbWidthPctRank = nz(ta.percentrank(bbWidth, adaptiveLookback), 50.0)

ema21SlopeAtr = atr > syminfo.mintick and not na(ema21[adaptiveSlopeBars]) ? (ema21 - ema21[adaptiveSlopeBars]) / atr : 0.0
absEma21SlopeAtr = math.abs(ema21SlopeAtr)
barRangeAtr = atr > syminfo.mintick ? (high - low) / atr : 0.0

regimeCompression = adaptiveCore and atrPctRank <= adaptiveCompressionAtrPct and bbWidthPctRank <= adaptiveCompressionBbPct
regimeChaotic = adaptiveCore and atrPctRank >= adaptiveChaosAtrPct and adxPctRank <= adaptiveChaosAdxMaxPct
regimeTrendUp = adaptiveCore and chartBull and adx >= adaptiveAdxFloor and adxPctRank >= adaptiveTrendAdxPct and ema21SlopeAtr >= adaptiveSlopeMinAtr
regimeTrendDown = adaptiveCore and chartBear and adx >= adaptiveAdxFloor and adxPctRank >= adaptiveTrendAdxPct and ema21SlopeAtr <= -adaptiveSlopeMinAtr
regimeExpansion = adaptiveCore and atrPctRank >= adaptiveExpansionAtrPct and (volumePctRank >= adaptiveExpansionVolPct or barRangeAtr >= 1.20)
regimeRange = adaptiveCore and adxPctRank <= adaptiveRangeAdxPct and absEma21SlopeAtr < adaptiveSlopeMinAtr * 1.50 and not regimeCompression

string marketRegime = not adaptiveCore ? "LEGACY" :
     regimeChaotic ? "CHAOTIC" :
     regimeCompression ? "COMPRESSION" :
     regimeExpansion ? (chartBull ? "EXPANSION ↑" : chartBear ? "EXPANSION ↓" : "EXPANSION") :
     regimeTrendUp ? "TREND ↑" :
     regimeTrendDown ? "TREND ↓" :
     regimeRange ? "RANGE" : "TRANSITION"

barsFromBaseRegime = ta.barssince(regimeCompression or regimeRange)
recentBaseRegime = not na(barsFromBaseRegime) and barsFromBaseRegime <= 8

t1RegimeLongCompatible = not adaptiveCore or regimeTrendUp or (regimeExpansion and chartBull)
t1RegimeShortCompatible = not adaptiveCore or regimeTrendDown or (regimeExpansion and chartBear)
t2RegimeCompatible = not adaptiveCore or regimeCompression or regimeRange or (regimeExpansion and recentBaseRegime)
t3RegimeCompatible = not adaptiveCore or (not regimeChaotic and not regimeCompression)
t4RegimeLongCompatible = not adaptiveCore or regimeTrendUp or (regimeExpansion and chartBull)
t4RegimeShortCompatible = not adaptiveCore or regimeTrendDown or (regimeExpansion and chartBear)

// ─────────────────────────────────────────────────────────────────────────────
// MTF TREND
// ─────────────────────────────────────────────────────────────────────────────

string htfTf = profile5m or profile15m or profile30m ? "240" : profile1h ? "D" : manualHtfTf
string midTf = profile5m ? "30" : profile15m ? "60" : profile30m ? "120" : profile1h ? "240" : manualMidTf
bool strictMtf = profileManual ? manualStrictMtf : true
bool allowSmcCountertrend = profileManual ? manualAllowSmcCountertrend : false

// Use the previous CLOSED bar from requested TF with lookahead_on.
// This avoids using developing HTF values that may repaint before their close.
htfState = request.security(syminfo.tickerid, htfTf, f_trendStateConfirmed(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
midState = request.security(syminfo.tickerid, midTf, f_trendStateConfirmed(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

trendGateLong  = strictMtf ? (htfState == 1 and midState == 1) : (htfState == 1 or midState == 1)
trendGateShort = strictMtf ? (htfState == -1 and midState == -1) : (htfState == -1 or midState == -1)
smcTrendLong   = allowSmcCountertrend ? (htfState == 1 or midState == 1) : trendGateLong
smcTrendShort  = allowSmcCountertrend ? (htfState == -1 or midState == -1) : trendGateShort

// BTC context
string btcTf = profile5m ? "15" : profile15m ? "60" : profile30m ? "60" : profile1h ? "240" : manualBtcTf
btcState = request.security(btcSymbol, btcTf, f_trendStateConfirmed(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
btcLongOk  = not useBtcFilter or btcState != -1
btcShortOk = not useBtcFilter or btcState != 1

// ─────────────────────────────────────────────────────────────────────────────
// BROKE CONFLUENCE LAYER
// Requires Broke bridge plot outputs selected through input.source().
// OFF = Weighted Trading remains fully standalone.
// ─────────────────────────────────────────────────────────────────────────────



// One packed Broke plot transports all confluence values without consuming many
// Pine plot slots. Integer packing is exact at this magnitude in Pine's numeric range.
const float BROKE_PACK_MAGIC = 1000000000000.0
float brokePackedDelta = brokePackedSrc - BROKE_PACK_MAGIC
bool brokePackedRangeOk = brokePackedDelta >= 0.0 and brokePackedDelta <= 200000000000.0
int _brokePack = brokePackedRangeOk ? int(math.round(brokePackedDelta)) : 0
int _brokeEventCode = _brokePack % 3
_brokePack := int(_brokePack / 3)
int _brokeBtcCode = _brokePack % 2
_brokePack := int(_brokePack / 2)
int _brokeExhaustCode = _brokePack % 101
_brokePack := int(_brokePack / 101)
int _brokeMaeCode = _brokePack % 101
_brokePack := int(_brokePack / 101)
int _brokeLevelCode = _brokePack % 101
_brokePack := int(_brokePack / 101)
int _brokeExecutionCode = _brokePack % 101
_brokePack := int(_brokePack / 101)
int _brokeAvgCode = _brokePack % 101
_brokePack := int(_brokePack / 101)
int _brokeDirCode = _brokePack % 3

int brokeDir = _brokeDirCode - 1
int brokeEntryDir = _brokeEventCode - 1
float brokeAvgSrc = float(_brokeAvgCode)
float brokeExecutionSrc = float(_brokeExecutionCode)
float brokeLevelSrc = float(_brokeLevelCode)
float brokeMaeSrc = float(_brokeMaeCode)
float brokeExhaustionSrc = float(_brokeExhaustCode)
float brokeBtcOkSrc = float(_brokeBtcCode)
bool brokeDataValid = not useBrokeCorrelation or brokePackedRangeOk

// Setup-aware Broke confirmation. The goal is not to double-count WT factors:
// T1 emphasizes clean pullback execution, T2 execution/level, T3 level/MAE,
// and T4 is deliberately strict on execution + exhaustion because chasing is costly.
bool brokeBaseQualityPass = brokeDataValid and brokeAvgSrc >= brokeMinAvg and brokeExecutionSrc >= brokeMinExecution and brokeLevelSrc >= brokeMinLevel and brokeMaeSrc <= brokeMaxMae and brokeExhaustionSrc <= brokeMaxExhaustion and brokeBtcOkSrc >= 0.5
bool brokeT1QualityPass = brokeDataValid and brokeAvgSrc >= math.max(0.0, brokeMinAvg - 5.0) and brokeExecutionSrc >= math.max(0.0, brokeMinExecution - 5.0) and brokeMaeSrc <= brokeMaxMae and brokeExhaustionSrc <= math.min(100.0, brokeMaxExhaustion + 5.0) and brokeBtcOkSrc >= 0.5
bool brokeT2QualityPass = brokeDataValid and brokeAvgSrc >= brokeMinAvg and brokeExecutionSrc >= math.min(100.0, brokeMinExecution + 5.0) and brokeLevelSrc >= brokeMinLevel and brokeMaeSrc <= brokeMaxMae and brokeExhaustionSrc <= brokeMaxExhaustion and brokeBtcOkSrc >= 0.5
bool brokeT3QualityPass = brokeDataValid and brokeAvgSrc >= math.max(0.0, brokeMinAvg - 5.0) and brokeExecutionSrc >= math.max(0.0, brokeMinExecution - 5.0) and brokeLevelSrc >= math.min(100.0, brokeMinLevel + 5.0) and brokeMaeSrc <= math.max(0.0, brokeMaxMae - 5.0) and brokeExhaustionSrc <= brokeMaxExhaustion and brokeBtcOkSrc >= 0.5
bool brokeT4QualityPass = brokeDataValid and brokeAvgSrc >= math.min(100.0, brokeMinAvg + 2.0) and brokeExecutionSrc >= math.min(100.0, brokeMinExecution + 7.0) and brokeMaeSrc <= math.max(0.0, brokeMaxMae - 10.0) and brokeExhaustionSrc <= math.max(0.0, brokeMaxExhaustion - 10.0) and brokeBtcOkSrc >= 0.5
bool brokeQualityPass = brokeBaseQualityPass

_brokeLongEventBars = ta.barssince(brokeEntryDir == 1)
_brokeShortEventBars = ta.barssince(brokeEntryDir == -1)
bool brokeLongEntryRecent = not na(_brokeLongEventBars) and _brokeLongEventBars <= brokeEntryEventWindow
bool brokeShortEntryRecent = not na(_brokeShortEventBars) and _brokeShortEventBars <= brokeEntryEventWindow

// ─────────────────────────────────────────────────────────────────────────────
// T1 — EMA21 PULLBACK + RECLAIM
// ─────────────────────────────────────────────────────────────────────────────
int pbLookback = profile5m ? 24 : profile15m ? 8 : profile30m ? 6 : profile1h ? 4 : pbLookbackManual

emaTouchLegacy = low <= ema21 * (1 + pbTolerancePct / 100.0) and high >= ema21 * (1 - pbTolerancePct / 100.0)
emaTouchAdaptive = low <= ema21 + atr * adaptiveT1ToleranceAtr and high >= ema21 - atr * adaptiveT1ToleranceAtr
emaTouch = adaptiveCore ? emaTouchAdaptive : emaTouchLegacy
barsFromTouch = ta.barssince(emaTouch)
recentEmaTouch = not na(barsFromTouch) and barsFromTouch <= pbLookback

reclaimLong  = ta.crossover(close, ema9) or ta.crossover(close, ema21)
reclaimShort = ta.crossunder(close, ema9) or ta.crossunder(close, ema21)

bullReject = close > open and close > ema21 and close > high[1]
bearReject = close < open and close < ema21 and close < low[1]

emaLongConfirm  = pbRequireCandleConfirmation ? (reclaimLong or bullReject) : true
emaShortConfirm = pbRequireCandleConfirmation ? (reclaimShort or bearReject) : true
ema9LongOk  = not pbRequireEMA9 or close > ema9
ema9ShortOk = not pbRequireEMA9 or close < ema9

// v1.9 adaptive pullback structure.
// Depth measures the recent correction range in ATR rather than a fixed % move.
_pbRecentHigh = ta.highest(high, pbLookback + 1)
_pbRecentLow = ta.lowest(low, pbLookback + 1)
t1LongPullbackDepthAtr = atr > syminfo.mintick ? (_pbRecentHigh - _pbRecentLow) / atr : 0.0
t1ShortPullbackDepthAtr = t1LongPullbackDepthAtr

_pbTouchVolPct = ta.valuewhen(emaTouch, volumePctRank, 0)
_pbTouchVolRatio = ta.valuewhen(emaTouch, volRatio, 0)
t1PullbackVolumeQuiet = adaptiveCore ? (na(_pbTouchVolPct) or _pbTouchVolPct <= pbPullbackVolMaxPct) : (na(_pbTouchVolRatio) or _pbTouchVolRatio <= 1.20)
t1ConfirmVolumeLong = adaptiveCore ? volumePctRank >= pbConfirmVolMinPct and (na(_pbTouchVolPct) or volumePctRank >= _pbTouchVolPct) : volRatio >= nz(_pbTouchVolRatio, 0.0)
t1ConfirmVolumeShort = t1ConfirmVolumeLong

t1LongDepthOk = t1LongPullbackDepthAtr >= pbDepthMinAtr and t1LongPullbackDepthAtr <= pbDepthMaxAtr
t1ShortDepthOk = t1ShortPullbackDepthAtr >= pbDepthMinAtr and t1ShortPullbackDepthAtr <= pbDepthMaxAtr
t1LongSlopeOk = ema21SlopeAtr >= pbMinSlopeAtr
t1ShortSlopeOk = ema21SlopeAtr <= -pbMinSlopeAtr
t1LongStructureOk = ta.lowest(low, pbLookback + 1) >= ema50 - atr * pbEma50GuardAtr
t1ShortStructureOk = ta.highest(high, pbLookback + 1) <= ema50 + atr * pbEma50GuardAtr

t1LegacyRawLong = recentEmaTouch and close > ema21 and ema9LongOk and emaLongConfirm
t1LegacyRawShort = recentEmaTouch and close < ema21 and ema9ShortOk and emaShortConfirm
t1AdaptiveRawLong = t1LegacyRawLong and t1LongDepthOk and t1LongSlopeOk and t1LongStructureOk and t1PullbackVolumeQuiet and t1ConfirmVolumeLong
t1AdaptiveRawShort = t1LegacyRawShort and t1ShortDepthOk and t1ShortSlopeOk and t1ShortStructureOk and t1PullbackVolumeQuiet and t1ConfirmVolumeShort

rawT1Long  = adaptiveCore and pbAdaptiveLogic ? t1AdaptiveRawLong : t1LegacyRawLong
rawT1Short = adaptiveCore and pbAdaptiveLogic ? t1AdaptiveRawShort : t1LegacyRawShort

// ─────────────────────────────────────────────────────────────────────────────
// T2 — RANGE / COMPRESSION BREAKOUT
// ─────────────────────────────────────────────────────────────────────────────
int rangeLen = profile5m ? 60 : profile15m ? 20 : profile30m ? 12 : profile1h ? 10 : rangeLenManual
float breakoutVolMin = profile5m ? 1.60 : profile15m ? 1.40 : profile30m ? 1.30 : profile1h ? 1.20 : breakoutVolMinManual
bool requireSqueeze = profile5m ? true : profileManual ? requireSqueezeManual : false
int squeezeLookback = profile5m ? 150 : profile15m ? 50 : profile30m ? 30 : profile1h ? 25 : squeezeLookbackManual
int squeezeBars = profile5m ? 12 : profile15m ? 4 : profile30m ? 3 : profile1h ? 2 : squeezeBarsManual
int squeezeRecentBars = profile5m ? 30 : profile15m ? 10 : profile30m ? 6 : profile1h ? 4 : squeezeRecentBarsManual

bbWidthBase = ta.sma(bbWidth, squeezeLookback)
squeezeNowLegacy = ta.highest(bbWidth, squeezeBars) < bbWidthBase * squeezeFactor
squeezeNowAdaptive = ta.highest(bbWidthPctRank, squeezeBars) <= adaptiveCompressionBbPct
squeezeNow = adaptiveCore ? squeezeNowAdaptive : squeezeNowLegacy
barsFromSqueeze = ta.barssince(squeezeNow)
squeezeRecent = not na(barsFromSqueeze) and barsFromSqueeze <= squeezeRecentBars

rangeHigh = ta.highest(high[1], rangeLen)
rangeLow  = ta.lowest(low[1], rangeLen)
int t2RetestBars = profile5m ? 18 : profile15m ? 6 : profile30m ? 4 : profile1h ? 3 : t2RetestBarsManual

t2VolumeOk = adaptiveCore ? volumePctRank >= adaptiveStrongVolumePct : volRatio >= breakoutVolMin
t2BreakLong = ta.crossover(close, rangeHigh) and (not adaptiveCore or close - rangeHigh >= atr * adaptiveBreakoutDistanceAtr)
t2BreakShort = ta.crossunder(close, rangeLow) and (not adaptiveCore or rangeLow - close >= atr * adaptiveBreakoutDistanceAtr)

t2BreakoutEventLong = t2BreakLong and t2VolumeOk and (not requireSqueeze or squeezeRecent)
t2BreakoutEventShort = t2BreakShort and t2VolumeOk and (not requireSqueeze or squeezeRecent)

// A breakout arms a retest setup and freezes the broken level + breakout context.
var bool  t2LongAwaitRetest = false
var bool  t2ShortAwaitRetest = false
var float t2LongBreakLevel = na
var float t2ShortBreakLevel = na
var int   t2LongBreakBar = na
var int   t2ShortBreakBar = na
var float t2LongBreakDistAtrStored = na
var float t2ShortBreakDistAtrStored = na
var float t2LongBreakVolPctStored = na
var float t2ShortBreakVolPctStored = na
var float t2LongBreakVolRatioStored = na
var float t2ShortBreakVolRatioStored = na
var bool  t2LongBreakHadSqueeze = false
var bool  t2ShortBreakHadSqueeze = false

if t2BreakoutEventLong and not t2LongAwaitRetest
    t2LongAwaitRetest := true
    t2LongBreakLevel := rangeHigh
    t2LongBreakBar := bar_index
    t2LongBreakDistAtrStored := atr > syminfo.mintick ? math.max(0.0, close - rangeHigh) / atr : 0.0
    t2LongBreakVolPctStored := volumePctRank
    t2LongBreakVolRatioStored := volRatio
    t2LongBreakHadSqueeze := squeezeRecent

if t2BreakoutEventShort and not t2ShortAwaitRetest
    t2ShortAwaitRetest := true
    t2ShortBreakLevel := rangeLow
    t2ShortBreakBar := bar_index
    t2ShortBreakDistAtrStored := atr > syminfo.mintick ? math.max(0.0, rangeLow - close) / atr : 0.0
    t2ShortBreakVolPctStored := volumePctRank
    t2ShortBreakVolRatioStored := volRatio
    t2ShortBreakHadSqueeze := squeezeRecent

_t2LongRetestWindow = t2LongAwaitRetest and not na(t2LongBreakBar) and bar_index > t2LongBreakBar and bar_index - t2LongBreakBar <= t2RetestBars
_t2ShortRetestWindow = t2ShortAwaitRetest and not na(t2ShortBreakBar) and bar_index > t2ShortBreakBar and bar_index - t2ShortBreakBar <= t2RetestBars

_t2LongRetestTouch = _t2LongRetestWindow and low <= t2LongBreakLevel + atr * t2RetestToleranceAtr and low >= t2LongBreakLevel - atr * t2RetestMaxPenetrationAtr
_t2ShortRetestTouch = _t2ShortRetestWindow and high >= t2ShortBreakLevel - atr * t2RetestToleranceAtr and high <= t2ShortBreakLevel + atr * t2RetestMaxPenetrationAtr

_t2LongRetestCandleOk = not t2RetestRequireDirectionCandle or close > open
_t2ShortRetestCandleOk = not t2RetestRequireDirectionCandle or close < open
t2RetestLong = _t2LongRetestTouch and close >= t2LongBreakLevel + atr * t2RetestCloseBufferAtr and _t2LongRetestCandleOk
t2RetestShort = _t2ShortRetestTouch and close <= t2ShortBreakLevel - atr * t2RetestCloseBufferAtr and _t2ShortRetestCandleOk

// Invalidate stale/failed breakouts only after testing the current bar for a valid retest.
if t2LongAwaitRetest and not t2RetestLong and (bar_index - t2LongBreakBar > t2RetestBars or close < t2LongBreakLevel - atr * t2BreakInvalidationAtr or low < t2LongBreakLevel - atr * t2RetestMaxPenetrationAtr)
    t2LongAwaitRetest := false
if t2ShortAwaitRetest and not t2RetestShort and (bar_index - t2ShortBreakBar > t2RetestBars or close > t2ShortBreakLevel + atr * t2BreakInvalidationAtr or high > t2ShortBreakLevel + atr * t2RetestMaxPenetrationAtr)
    t2ShortAwaitRetest := false

if t2RetestLong
    t2LongAwaitRetest := false
if t2RetestShort
    t2ShortAwaitRetest := false

t2BreakoutSignalLong = (t2SignalMode == "BREAKOUT" or t2SignalMode == "BOTH") and t2BreakoutEventLong and t2LongBreakBar == bar_index
t2BreakoutSignalShort = (t2SignalMode == "BREAKOUT" or t2SignalMode == "BOTH") and t2BreakoutEventShort and t2ShortBreakBar == bar_index
t2RetestSignalLong = (t2SignalMode == "RETEST" or t2SignalMode == "BOTH") and t2RetestLong
t2RetestSignalShort = (t2SignalMode == "RETEST" or t2SignalMode == "BOTH") and t2RetestShort

rawT2Long = t2BreakoutSignalLong or t2RetestSignalLong
rawT2Short = t2BreakoutSignalShort or t2RetestSignalShort

string t2SignalKindLong = t2RetestSignalLong ? "RETEST" : t2BreakoutSignalLong ? "BREAKOUT" : ""
string t2SignalKindShort = t2RetestSignalShort ? "RETEST" : t2BreakoutSignalShort ? "BREAKOUT" : ""
t2LongSignalLevel = t2RetestSignalLong ? t2LongBreakLevel : rangeHigh
t2ShortSignalLevel = t2RetestSignalShort ? t2ShortBreakLevel : rangeLow
t2LongSignalBreakDistAtr = t2RetestSignalLong ? nz(t2LongBreakDistAtrStored, 0.0) : (atr > syminfo.mintick ? math.max(0.0, close - rangeHigh) / atr : 0.0)
t2ShortSignalBreakDistAtr = t2RetestSignalShort ? nz(t2ShortBreakDistAtrStored, 0.0) : (atr > syminfo.mintick ? math.max(0.0, rangeLow - close) / atr : 0.0)
t2LongSignalHadSqueeze = t2RetestSignalLong ? t2LongBreakHadSqueeze : squeezeRecent
t2ShortSignalHadSqueeze = t2RetestSignalShort ? t2ShortBreakHadSqueeze : squeezeRecent
t2LongSignalVolPct = t2RetestSignalLong ? nz(t2LongBreakVolPctStored, volumePctRank) : volumePctRank
t2ShortSignalVolPct = t2RetestSignalShort ? nz(t2ShortBreakVolPctStored, volumePctRank) : volumePctRank
t2LongSignalVolRatio = t2RetestSignalLong ? nz(t2LongBreakVolRatioStored, volRatio) : volRatio
t2ShortSignalVolRatio = t2RetestSignalShort ? nz(t2ShortBreakVolRatioStored, volRatio) : volRatio

// ─────────────────────────────────────────────────────────────────────────────
// T3 — SMC / LIQUIDITY
// FVG + Order Block + Breaker proxy
// ─────────────────────────────────────────────────────────────────────────────
int pivotLen = profile5m ? 5 : profile15m ? 4 : profile30m ? 4 : profile1h ? 3 : pivotLenManual
float liqMaxAtr = profile5m ? 6.0 : profile15m ? 8.0 : profile30m ? 8.0 : profile1h ? 10.0 : liqMaxAtrManual

// Confirmed swing / equal highs-lows
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float prevPh = na
var float prevPl = na
var float eqHighLevel = na
var float eqLowLevel  = na
var bool eqHighActive = false
var bool eqLowActive  = false

if not na(ph)
    _pivotAtrH = nz(atr[pivotLen], atr)
    _eqHighMatch = not na(prevPh) and (adaptiveCore ? math.abs(ph - prevPh) <= _pivotAtrH * adaptiveEqualToleranceAtr : math.abs(ph - prevPh) / prevPh * 100.0 <= eqTolerancePct)
    if _eqHighMatch
        eqHighLevel := math.max(ph, prevPh)
        eqHighActive := true
    prevPh := ph

if not na(pl)
    _pivotAtrL = nz(atr[pivotLen], atr)
    _eqLowMatch = not na(prevPl) and (adaptiveCore ? math.abs(pl - prevPl) <= _pivotAtrL * adaptiveEqualToleranceAtr : math.abs(pl - prevPl) / prevPl * 100.0 <= eqTolerancePct)
    if _eqLowMatch
        eqLowLevel := math.min(pl, prevPl)
        eqLowActive := true
    prevPl := pl

_eqHighBroken = eqHighActive and (adaptiveCore ? high > eqHighLevel + atr * adaptiveSweepAtr : high > eqHighLevel * (1 + eqBreakPct / 100.0))
_eqLowBroken = eqLowActive and (adaptiveCore ? low < eqLowLevel - atr * adaptiveSweepAtr : low < eqLowLevel * (1 - eqBreakPct / 100.0))
if _eqHighBroken
    eqHighActive := false
if _eqLowBroken
    eqLowActive := false

swingHighAbove = not na(prevPh) and prevPh > close and (prevPh - close) <= atr * liqMaxAtr
swingLowBelow  = not na(prevPl) and prevPl < close and (close - prevPl) <= atr * liqMaxAtr

eqHighAbove = eqHighActive and not na(eqHighLevel) and eqHighLevel > close and (eqHighLevel - close) <= atr * liqMaxAtr
eqLowBelow  = eqLowActive and not na(eqLowLevel) and eqLowLevel < close and (close - eqLowLevel) <= atr * liqMaxAtr

liquidityAbove = eqHighAbove or swingHighAbove
liquidityBelow = eqLowBelow or swingLowBelow
liqTargetLong  = f_nearestAbove(eqHighAbove ? eqHighLevel : na, swingHighAbove ? prevPh : na, close)
liqTargetShort = f_nearestBelow(eqLowBelow ? eqLowLevel : na, swingLowBelow ? prevPl : na, close)

// FVG / imbalance
var float bullFvgLo = na
var float bullFvgHi = na
var float bearFvgLo = na
var float bearFvgHi = na

newBullFvg = low > high[2]
newBearFvg = high < low[2]

if newBullFvg
    bullFvgLo := high[2]
    bullFvgHi := low
if newBearFvg
    bearFvgLo := high
    bearFvgHi := low[2]

if not na(bullFvgLo) and close < bullFvgLo
    bullFvgLo := na
    bullFvgHi := na
if not na(bearFvgHi) and close > bearFvgHi
    bearFvgLo := na
    bearFvgHi := na

// Order blocks from displacement
int obSearch = profile5m ? 24 : profile15m ? 8 : profile30m ? 6 : profile1h ? 4 : obSearchManual
int dispLookback = profile5m ? 30 : profile15m ? 10 : profile30m ? 6 : profile1h ? 5 : dispLookbackManual
float dispVolMin = profile5m ? 1.35 : profile15m ? 1.20 : profile30m ? 1.15 : profile1h ? 1.10 : dispVolMinManual

dispVolumeOk = adaptiveCore ? volumePctRank >= adaptiveDisplacementVolumePct : volRatio >= dispVolMin
bullDisplacement = close > ta.highest(high[1], dispLookback) and (close - open) >= atr * dispBodyATR and dispVolumeOk
bearDisplacement = close < ta.lowest(low[1], dispLookback) and (open - close) >= atr * dispBodyATR and dispVolumeOk

[lastBearHi, lastBearLo] = f_lastBearZone(obSearch)
[lastBullHi, lastBullLo] = f_lastBullZone(obSearch)

var float bullObLo = na
var float bullObHi = na
var float bearObLo = na
var float bearObHi = na
var float bullBreakerLo = na
var float bullBreakerHi = na
var float bearBreakerLo = na
var float bearBreakerHi = na

if bullDisplacement and not na(lastBearLo)
    bullObLo := lastBearLo
    bullObHi := lastBearHi

if bearDisplacement and not na(lastBullLo)
    bearObLo := lastBullLo
    bearObHi := lastBullHi

// Broken bearish OB -> bullish breaker proxy
if not na(bearObHi) and close > bearObHi
    bullBreakerLo := bearObLo
    bullBreakerHi := bearObHi
    bearObLo := na
    bearObHi := na

// Broken bullish OB -> bearish breaker proxy
if not na(bullObLo) and close < bullObLo
    bearBreakerLo := bullObLo
    bearBreakerHi := bullObHi
    bullObLo := na
    bullObHi := na

// Breaker invalidation
if not na(bullBreakerLo) and close < bullBreakerLo
    bullBreakerLo := na
    bullBreakerHi := na
if not na(bearBreakerHi) and close > bearBreakerHi
    bearBreakerLo := na
    bearBreakerHi := na

bullFvgReaction = f_touchZone(bullFvgLo, bullFvgHi) and close > (bullFvgLo + bullFvgHi) / 2 and close > open
bearFvgReaction = f_touchZone(bearFvgLo, bearFvgHi) and close < (bearFvgLo + bearFvgHi) / 2 and close < open
bullObReaction  = f_touchZone(bullObLo, bullObHi) and close > (bullObLo + bullObHi) / 2 and close > open
bearObReaction  = f_touchZone(bearObLo, bearObHi) and close < (bearObLo + bearObHi) / 2 and close < open
bullBrReaction  = f_touchZone(bullBreakerLo, bullBreakerHi) and close > (bullBreakerLo + bullBreakerHi) / 2 and close > open
bearBrReaction  = f_touchZone(bearBreakerLo, bearBreakerHi) and close < (bearBreakerLo + bearBreakerHi) / 2 and close < open

bullZoneReaction = bullFvgReaction or bullObReaction or bullBrReaction
bearZoneReaction = bearFvgReaction or bearObReaction or bearBrReaction

// v1.9 strict sequence:
//   LONG  = sweep SSL → bullish CHoCH/displacement → reaction from captured bull zone.
//   SHORT = sweep BSL → bearish CHoCH/displacement → reaction from captured bear zone.
_t3BullEqSweep = _eqLowBroken and not na(eqLowLevel) and close >= eqLowLevel + atr * t3SweepReclaimBufferAtr
_t3BearEqSweep = _eqHighBroken and not na(eqHighLevel) and close <= eqHighLevel - atr * t3SweepReclaimBufferAtr
_t3BullSwingSweep = not na(prevPl) and low < prevPl - atr * adaptiveSweepAtr and close >= prevPl + atr * t3SweepReclaimBufferAtr and not (low[1] < prevPl - atr * adaptiveSweepAtr)
_t3BearSwingSweep = not na(prevPh) and high > prevPh + atr * adaptiveSweepAtr and close <= prevPh - atr * t3SweepReclaimBufferAtr and not (high[1] > prevPh + atr * adaptiveSweepAtr)

t3LongSweepEvent = _t3BullEqSweep or _t3BullSwingSweep
t3ShortSweepEvent = _t3BearEqSweep or _t3BearSwingSweep
_t3LongSweepLevelNow = _t3BullEqSweep ? eqLowLevel : _t3BullSwingSweep ? prevPl : na
_t3ShortSweepLevelNow = _t3BearEqSweep ? eqHighLevel : _t3BearSwingSweep ? prevPh : na

var int   t3LongState = 0   // 0 wait sweep, 1 wait CHoCH, 2 wait zone reaction
var int   t3ShortState = 0
var int   t3LongSweepBar = na
var int   t3ShortSweepBar = na
var int   t3LongChochBar = na
var int   t3ShortChochBar = na
var float t3LongSweepLevel = na
var float t3ShortSweepLevel = na
var float t3LongChochLevel = na
var float t3ShortChochLevel = na
var float t3LongZoneLo = na
var float t3LongZoneHi = na
var float t3ShortZoneLo = na
var float t3ShortZoneHi = na
var int   t3LongZoneType = 0  // 3 breaker, 2 OB, 1 FVG
var int   t3ShortZoneType = 0

_t3StructuralHigh = ta.highest(high[1], t3ChochLookback)
_t3StructuralLow = ta.lowest(low[1], t3ChochLookback)

if t3LongSweepEvent
    t3LongState := 1
    t3LongSweepBar := bar_index
    t3LongSweepLevel := _t3LongSweepLevelNow
    t3LongChochLevel := _t3StructuralHigh
    t3LongChochBar := na
    t3LongZoneLo := na
    t3LongZoneHi := na
    t3LongZoneType := 0

if t3ShortSweepEvent
    t3ShortState := 1
    t3ShortSweepBar := bar_index
    t3ShortSweepLevel := _t3ShortSweepLevelNow
    t3ShortChochLevel := _t3StructuralLow
    t3ShortChochBar := na
    t3ShortZoneLo := na
    t3ShortZoneHi := na
    t3ShortZoneType := 0

_t3BullChochBodyOk = (close - open) >= atr * t3ChochBodyAtr
_t3BearChochBodyOk = (open - close) >= atr * t3ChochBodyAtr
t3LongChochEvent = t3LongState == 1 and close >= t3LongSweepLevel - atr * t3SequenceInvalidationAtr and bar_index > t3LongSweepBar and bar_index - t3LongSweepBar <= t3SweepToChochBars and ((not na(t3LongChochLevel) and close > t3LongChochLevel and _t3BullChochBodyOk) or bullDisplacement)
t3ShortChochEvent = t3ShortState == 1 and close <= t3ShortSweepLevel + atr * t3SequenceInvalidationAtr and bar_index > t3ShortSweepBar and bar_index - t3ShortSweepBar <= t3SweepToChochBars and ((not na(t3ShortChochLevel) and close < t3ShortChochLevel and _t3BearChochBodyOk) or bearDisplacement)

if t3LongState == 1 and not t3LongChochEvent and (bar_index - t3LongSweepBar > t3SweepToChochBars or close < t3LongSweepLevel - atr * t3SequenceInvalidationAtr)
    t3LongState := 0
if t3ShortState == 1 and not t3ShortChochEvent and (bar_index - t3ShortSweepBar > t3SweepToChochBars or close > t3ShortSweepLevel + atr * t3SequenceInvalidationAtr)
    t3ShortState := 0

if t3LongChochEvent
    t3LongState := 2
    t3LongChochBar := bar_index
    if not na(bullBreakerLo) and not na(bullBreakerHi)
        t3LongZoneLo := bullBreakerLo
        t3LongZoneHi := bullBreakerHi
        t3LongZoneType := 3
    else if not na(bullObLo) and not na(bullObHi)
        t3LongZoneLo := bullObLo
        t3LongZoneHi := bullObHi
        t3LongZoneType := 2
    else if not na(bullFvgLo) and not na(bullFvgHi)
        t3LongZoneLo := bullFvgLo
        t3LongZoneHi := bullFvgHi
        t3LongZoneType := 1

if t3ShortChochEvent
    t3ShortState := 2
    t3ShortChochBar := bar_index
    if not na(bearBreakerLo) and not na(bearBreakerHi)
        t3ShortZoneLo := bearBreakerLo
        t3ShortZoneHi := bearBreakerHi
        t3ShortZoneType := 3
    else if not na(bearObLo) and not na(bearObHi)
        t3ShortZoneLo := bearObLo
        t3ShortZoneHi := bearObHi
        t3ShortZoneType := 2
    else if not na(bearFvgLo) and not na(bearFvgHi)
        t3ShortZoneLo := bearFvgLo
        t3ShortZoneHi := bearFvgHi
        t3ShortZoneType := 1

// If CHoCH happened before a clean zone was available, capture the first new
// post-CHoCH zone produced while the sequence is alive.
if t3LongState == 2 and na(t3LongZoneLo)
    if not na(bullBreakerLo) and not na(bullBreakerHi)
        t3LongZoneLo := bullBreakerLo
        t3LongZoneHi := bullBreakerHi
        t3LongZoneType := 3
    else if bullDisplacement and not na(bullObLo) and not na(bullObHi)
        t3LongZoneLo := bullObLo
        t3LongZoneHi := bullObHi
        t3LongZoneType := 2
    else if newBullFvg and not na(bullFvgLo) and not na(bullFvgHi)
        t3LongZoneLo := bullFvgLo
        t3LongZoneHi := bullFvgHi
        t3LongZoneType := 1

if t3ShortState == 2 and na(t3ShortZoneLo)
    if not na(bearBreakerLo) and not na(bearBreakerHi)
        t3ShortZoneLo := bearBreakerLo
        t3ShortZoneHi := bearBreakerHi
        t3ShortZoneType := 3
    else if bearDisplacement and not na(bearObLo) and not na(bearObHi)
        t3ShortZoneLo := bearObLo
        t3ShortZoneHi := bearObHi
        t3ShortZoneType := 2
    else if newBearFvg and not na(bearFvgLo) and not na(bearFvgHi)
        t3ShortZoneLo := bearFvgLo
        t3ShortZoneHi := bearFvgHi
        t3ShortZoneType := 1

_t3LongSeqWindow = t3LongState == 2 and not na(t3LongChochBar) and bar_index > t3LongChochBar and bar_index - t3LongChochBar <= t3ChochToZoneBars
_t3ShortSeqWindow = t3ShortState == 2 and not na(t3ShortChochBar) and bar_index > t3ShortChochBar and bar_index - t3ShortChochBar <= t3ChochToZoneBars
t3LongSeqZoneReaction = _t3LongSeqWindow and close >= t3LongSweepLevel - atr * t3SequenceInvalidationAtr and f_touchZone(t3LongZoneLo, t3LongZoneHi) and close > (t3LongZoneLo + t3LongZoneHi) / 2 and close > open
t3ShortSeqZoneReaction = _t3ShortSeqWindow and close <= t3ShortSweepLevel + atr * t3SequenceInvalidationAtr and f_touchZone(t3ShortZoneLo, t3ShortZoneHi) and close < (t3ShortZoneLo + t3ShortZoneHi) / 2 and close < open

if t3LongState == 2 and not t3LongSeqZoneReaction and (bar_index - t3LongChochBar > t3ChochToZoneBars or close < t3LongSweepLevel - atr * t3SequenceInvalidationAtr)
    t3LongState := 0
if t3ShortState == 2 and not t3ShortSeqZoneReaction and (bar_index - t3ShortChochBar > t3ChochToZoneBars or close > t3ShortSweepLevel + atr * t3SequenceInvalidationAtr)
    t3ShortState := 0

t3LegacyLong = bullZoneReaction and not bullZoneReaction[1]
t3LegacyShort = bearZoneReaction and not bearZoneReaction[1]
rawT3Long = t3RequireSequence ? t3LongSeqZoneReaction : t3LegacyLong
rawT3Short = t3RequireSequence ? t3ShortSeqZoneReaction : t3LegacyShort

// Reset only the state flag after emitting. Keep captured levels/types available
// for Setup Quality, SL calculation, labels and alerts on this signal bar.
if t3LongSeqZoneReaction
    t3LongState := 0
if t3ShortSeqZoneReaction
    t3ShortState := 0

bullReactionLo = t3RequireSequence and t3LongSeqZoneReaction ? t3LongZoneLo : bullBrReaction ? bullBreakerLo : bullObReaction ? bullObLo : bullFvgReaction ? bullFvgLo : na
bearReactionHi = t3RequireSequence and t3ShortSeqZoneReaction ? t3ShortZoneHi : bearBrReaction ? bearBreakerHi : bearObReaction ? bearObHi : bearFvgReaction ? bearFvgHi : na

// ─────────────────────────────────────────────────────────────────────────────
// T4 — MOMENTUM CONTINUATION
// ─────────────────────────────────────────────────────────────────────────────
int momLen = profile5m ? 30 : profile15m ? 10 : profile30m ? 6 : profile1h ? 5 : momLenManual
float momVolMin = profile5m ? 1.80 : profile15m ? 1.50 : profile30m ? 1.35 : profile1h ? 1.25 : momVolMinManual
float momAdxMin = profile5m ? 25.0 : profile15m ? 22.0 : profile30m ? 20.0 : profile1h ? 18.0 : momAdxMinManual
int momBreakLen = profile5m ? 24 : profile15m ? 8 : profile30m ? 6 : profile1h ? 5 : momBreakLenManual

roc = na(close[momLen]) or close[momLen] == 0 ? 0.0 : (close - close[momLen]) / close[momLen] * 100.0
momMoveAtr = atr > syminfo.mintick and not na(close[momLen]) ? (close - close[momLen]) / atr : 0.0
newCloseHigh = close > ta.highest(close[1], momBreakLen)
newCloseLow  = close < ta.lowest(close[1], momBreakLen)

momVolumeOk = adaptiveCore ? volumePctRank >= adaptiveStrongVolumePct : volRatio >= momVolMin
momAdxOk = adaptiveCore ? (adx >= adaptiveAdxFloor and adxPctRank >= adaptiveMomentumAdxPct) : adx >= momAdxMin
momLongMoveOk = adaptiveCore ? momMoveAtr >= adaptiveMomentumMoveAtr : roc >= momRocMin
momShortMoveOk = adaptiveCore ? momMoveAtr <= -adaptiveMomentumMoveAtr : roc <= -momRocMin

// Count the current uninterrupted directional candle run.
int t4BullRunBars = 0
int t4BearRunBars = 0
for _i = 0 to 11
    if _i < t4MaxDirectionalBars + 2
        if close[_i] > open[_i] and t4BullRunBars == _i
            t4BullRunBars += 1
        if close[_i] < open[_i] and t4BearRunBars == _i
            t4BearRunBars += 1

_t4Range = math.max(high - low, syminfo.mintick)
_t4UpperWickPct = 100.0 * (high - math.max(open, close)) / _t4Range
_t4LowerWickPct = 100.0 * (math.min(open, close) - low) / _t4Range
t4DistanceEmaAtr = atr > syminfo.mintick ? math.abs(close - ema21) / atr : 99.0
t4Climax = adaptiveCore ? (atrPctRank >= t4ClimaxAtrPct and volumePctRank >= t4ClimaxVolumePct) : (barRangeAtr >= t4MaxSignalBarAtr and volRatio >= 2.0)

t4LongExhausted = t4ExhaustionProtection and (t4DistanceEmaAtr > t4MaxDistanceEmaAtr or barRangeAtr > t4MaxSignalBarAtr or t4Climax or t4BullRunBars >= t4MaxDirectionalBars or _t4UpperWickPct > t4MaxOppositeWickPct)
t4ShortExhausted = t4ExhaustionProtection and (t4DistanceEmaAtr > t4MaxDistanceEmaAtr or barRangeAtr > t4MaxSignalBarAtr or t4Climax or t4BearRunBars >= t4MaxDirectionalBars or _t4LowerWickPct > t4MaxOppositeWickPct)

strongMomLongBase  = momLongMoveOk and momVolumeOk and momAdxOk and chartBull and newCloseHigh
strongMomShortBase = momShortMoveOk and momVolumeOk and momAdxOk and chartBear and newCloseLow
strongMomLong = strongMomLongBase and not t4LongExhausted
strongMomShort = strongMomShortBase and not t4ShortExhausted

rawT4Long  = strongMomLong and not strongMomLong[1]
rawT4Short = strongMomShort and not strongMomShort[1]

// ─────────────────────────────────────────────────────────────────────────────
// SETUP QUALITY — T1Q / T2Q / T3Q / T4Q
// Directional, setup-specific quality scores. These are intentionally different
// from the global Score: Score describes broad context, while TnQ describes how
// well the CURRENT pattern itself is formed.
// ─────────────────────────────────────────────────────────────────────────────

// Reusable relative activity buckets.
_qVol15 = adaptiveCore ?
     (volumePctRank >= 85 ? 15.0 : volumePctRank >= 70 ? 12.0 : volumePctRank >= 55 ? 9.0 : volumePctRank >= 40 ? 5.0 : 2.0) :
     (volRatio >= 1.50 ? 15.0 : volRatio >= 1.20 ? 12.0 : volRatio >= 1.00 ? 9.0 : volRatio >= 0.80 ? 5.0 : 2.0)

_qVol20 = adaptiveCore ?
     (volumePctRank >= 90 ? 20.0 : volumePctRank >= 80 ? 17.0 : volumePctRank >= 70 ? 14.0 : volumePctRank >= 55 ? 10.0 : volumePctRank >= 40 ? 6.0 : 2.0) :
     (volRatio >= 1.80 ? 20.0 : volRatio >= 1.50 ? 17.0 : volRatio >= 1.25 ? 14.0 : volRatio >= 1.00 ? 10.0 : volRatio >= 0.80 ? 6.0 : 2.0)

_qVol25 = adaptiveCore ?
     (volumePctRank >= 90 ? 25.0 : volumePctRank >= 80 ? 22.0 : volumePctRank >= 70 ? 18.0 : volumePctRank >= 60 ? 14.0 : volumePctRank >= 45 ? 8.0 : 3.0) :
     (volRatio >= 1.80 ? 25.0 : volRatio >= 1.50 ? 22.0 : volRatio >= 1.25 ? 18.0 : volRatio >= 1.00 ? 14.0 : volRatio >= 0.80 ? 8.0 : 3.0)

// ----- T1Q: trend 25 + pullback geometry 25 + confirmation 20 + volume 15 + regime 15.
_t1TrendLong = (htfState == 1 ? 10.0 : 0.0) + (midState == 1 ? 8.0 : 0.0) + (chartBull ? 7.0 : 0.0)
_t1TrendShort = (htfState == -1 ? 10.0 : 0.0) + (midState == -1 ? 8.0 : 0.0) + (chartBear ? 7.0 : 0.0)

_t1TouchFresh = not recentEmaTouch ? 0.0 :
     barsFromTouch <= 1 ? 7.0 :
     barsFromTouch <= math.max(1, int(math.ceil(pbLookback * 0.50))) ? 5.0 : 2.0
_t1DistAtr = atr > syminfo.mintick ? math.abs(close - ema21) / atr : 99.0
_t1DistScore = _t1DistAtr <= 0.35 ? 6.0 : _t1DistAtr <= 0.75 ? 4.0 : _t1DistAtr <= 1.25 ? 2.0 : 0.0
_t1DepthScoreLong = t1LongPullbackDepthAtr >= pbDepthMinAtr and t1LongPullbackDepthAtr <= pbDepthMaxAtr ? 6.0 : t1LongPullbackDepthAtr <= pbDepthMaxAtr * 1.25 ? 2.0 : 0.0
_t1DepthScoreShort = t1ShortPullbackDepthAtr >= pbDepthMinAtr and t1ShortPullbackDepthAtr <= pbDepthMaxAtr ? 6.0 : t1ShortPullbackDepthAtr <= pbDepthMaxAtr * 1.25 ? 2.0 : 0.0
_t1GeometryLong = (recentEmaTouch ? 6.0 : 0.0) + _t1TouchFresh + _t1DistScore + _t1DepthScoreLong
_t1GeometryShort = (recentEmaTouch ? 6.0 : 0.0) + _t1TouchFresh + _t1DistScore + _t1DepthScoreShort

_t1ConfirmLong = (reclaimLong ? 11.0 : 0.0) + (bullReject ? 6.0 : 0.0) + (t1ConfirmVolumeLong ? 3.0 : 0.0)
_t1ConfirmShort = (reclaimShort ? 11.0 : 0.0) + (bearReject ? 6.0 : 0.0) + (t1ConfirmVolumeShort ? 3.0 : 0.0)

_t1RegimeLong = t1RegimeLongCompatible ? 15.0 : marketRegime == "TRANSITION" ? 7.0 : 2.0
_t1RegimeShort = t1RegimeShortCompatible ? 15.0 : marketRegime == "TRANSITION" ? 7.0 : 2.0
_t1VolLogic = t1PullbackVolumeQuiet ? _qVol15 : math.min(_qVol15, 5.0)

int t1QLong = int(math.round(f_clamp100(_t1TrendLong + _t1GeometryLong + _t1ConfirmLong + _t1VolLogic + _t1RegimeLong)))
int t1QShort = int(math.round(f_clamp100(_t1TrendShort + _t1GeometryShort + _t1ConfirmShort + _t1VolLogic + _t1RegimeShort)))

// ----- T2Q: base 20 + breakout impulse 20 + breakout volume 20 +
//             directional context 15 + liquidity 10 + execution/retest 15.
_t2BaseQLong = t2LongSignalHadSqueeze ? 20.0 : recentBaseRegime ? 14.0 : 5.0
_t2BaseQShort = t2ShortSignalHadSqueeze ? 20.0 : recentBaseRegime ? 14.0 : 5.0
_t2BreakDistLong = t2LongSignalBreakDistAtr
_t2BreakDistShort = t2ShortSignalBreakDistAtr
_t2BreakQLong = _t2BreakDistLong >= 0.50 ? 20.0 : _t2BreakDistLong >= 0.30 ? 18.0 : _t2BreakDistLong >= 0.20 ? 15.0 : _t2BreakDistLong >= 0.10 ? 11.0 : _t2BreakDistLong > 0 ? 6.0 : 0.0
_t2BreakQShort = _t2BreakDistShort >= 0.50 ? 20.0 : _t2BreakDistShort >= 0.30 ? 18.0 : _t2BreakDistShort >= 0.20 ? 15.0 : _t2BreakDistShort >= 0.10 ? 11.0 : _t2BreakDistShort > 0 ? 6.0 : 0.0
_t2VolQLong = adaptiveCore ? (t2LongSignalVolPct >= 90 ? 20.0 : t2LongSignalVolPct >= 80 ? 18.0 : t2LongSignalVolPct >= 70 ? 15.0 : t2LongSignalVolPct >= 55 ? 10.0 : 4.0) : (t2LongSignalVolRatio >= 1.8 ? 20.0 : t2LongSignalVolRatio >= 1.5 ? 18.0 : t2LongSignalVolRatio >= 1.25 ? 15.0 : t2LongSignalVolRatio >= 1.0 ? 10.0 : 4.0)
_t2VolQShort = adaptiveCore ? (t2ShortSignalVolPct >= 90 ? 20.0 : t2ShortSignalVolPct >= 80 ? 18.0 : t2ShortSignalVolPct >= 70 ? 15.0 : t2ShortSignalVolPct >= 55 ? 10.0 : 4.0) : (t2ShortSignalVolRatio >= 1.8 ? 20.0 : t2ShortSignalVolRatio >= 1.5 ? 18.0 : t2ShortSignalVolRatio >= 1.25 ? 15.0 : t2ShortSignalVolRatio >= 1.0 ? 10.0 : 4.0)
_t2DirLong = htfState == 1 and midState == 1 ? 15.0 : htfState == 1 or midState == 1 ? 8.0 : chartBull ? 4.0 : 0.0
_t2DirShort = htfState == -1 and midState == -1 ? 15.0 : htfState == -1 or midState == -1 ? 8.0 : chartBear ? 4.0 : 0.0
_t2LiqLong = liquidityAbove ? 10.0 : 3.0
_t2LiqShort = liquidityBelow ? 10.0 : 3.0
_t2ExecutionLong = t2RetestSignalLong ? 15.0 : t2BreakoutSignalLong ? (_t2BreakDistLong >= 0.20 ? 11.0 : 7.0) : 0.0
_t2ExecutionShort = t2RetestSignalShort ? 15.0 : t2BreakoutSignalShort ? (_t2BreakDistShort >= 0.20 ? 11.0 : 7.0) : 0.0

int t2QLong = int(math.round(f_clamp100(_t2BaseQLong + _t2BreakQLong + _t2VolQLong + _t2DirLong + _t2LiqLong + _t2ExecutionLong)))
int t2QShort = int(math.round(f_clamp100(_t2BaseQShort + _t2BreakQShort + _t2VolQShort + _t2DirShort + _t2LiqShort + _t2ExecutionShort)))

// ----- T3Q: zone 25 + liquidity context 25 + reaction candle 20 +
//             MTF context 15 + displacement freshness 15.
_barsFromLowSweep = ta.barssince(t3LongSweepEvent)
_barsFromHighSweep = ta.barssince(t3ShortSweepEvent)
_recentLowSweep2 = not na(_barsFromLowSweep) and _barsFromLowSweep <= 2
_recentLowSweep6 = not na(_barsFromLowSweep) and _barsFromLowSweep <= 6
_recentHighSweep2 = not na(_barsFromHighSweep) and _barsFromHighSweep <= 2
_recentHighSweep6 = not na(_barsFromHighSweep) and _barsFromHighSweep <= 6

_t3ZoneLong = t3RequireSequence ? (t3LongZoneType == 3 ? 25.0 : t3LongZoneType == 2 ? 20.0 : t3LongZoneType == 1 ? 14.0 : 0.0) : bullBrReaction ? 25.0 : bullObReaction ? 20.0 : bullFvgReaction ? 14.0 : 0.0
_t3ZoneShort = t3RequireSequence ? (t3ShortZoneType == 3 ? 25.0 : t3ShortZoneType == 2 ? 20.0 : t3ShortZoneType == 1 ? 14.0 : 0.0) : bearBrReaction ? 25.0 : bearObReaction ? 20.0 : bearFvgReaction ? 14.0 : 0.0

_t3LiqLong = _recentLowSweep2 ? 25.0 : _recentLowSweep6 ? 20.0 : liquidityAbove ? 12.0 : 5.0
_t3LiqShort = _recentHighSweep2 ? 25.0 : _recentHighSweep6 ? 20.0 : liquidityBelow ? 12.0 : 5.0

_candleRange = math.max(high - low, syminfo.mintick)
_bodyRatio = math.abs(close - open) / _candleRange
_t3ReactionCandle = _bodyRatio >= 0.65 ? 20.0 : _bodyRatio >= 0.45 ? 16.0 : _bodyRatio >= 0.30 ? 11.0 : 6.0

_t3TrendLong = htfState == 1 and midState == 1 ? 15.0 : htfState == 1 or midState == 1 ? 10.0 : chartBull ? 5.0 : 0.0
_t3TrendShort = htfState == -1 and midState == -1 ? 15.0 : htfState == -1 or midState == -1 ? 10.0 : chartBear ? 5.0 : 0.0

_barsFromBullDisp = ta.barssince(bullDisplacement)
_barsFromBearDisp = ta.barssince(bearDisplacement)
_t3ImpulseLong = t3RequireSequence and not na(t3LongChochBar) ? (bar_index - t3LongChochBar <= 3 ? 15.0 : 11.0) : not na(_barsFromBullDisp) and _barsFromBullDisp <= dispLookback ? 15.0 : not na(_barsFromBullDisp) and _barsFromBullDisp <= dispLookback * 2 ? 10.0 : _qVol15 * 0.40
_t3ImpulseShort = t3RequireSequence and not na(t3ShortChochBar) ? (bar_index - t3ShortChochBar <= 3 ? 15.0 : 11.0) : not na(_barsFromBearDisp) and _barsFromBearDisp <= dispLookback ? 15.0 : not na(_barsFromBearDisp) and _barsFromBearDisp <= dispLookback * 2 ? 10.0 : _qVol15 * 0.40

int t3QLong = int(math.round(f_clamp100(_t3ZoneLong + _t3LiqLong + _t3ReactionCandle + _t3TrendLong + _t3ImpulseLong)))
int t3QShort = int(math.round(f_clamp100(_t3ZoneShort + _t3LiqShort + _t3ReactionCandle + _t3TrendShort + _t3ImpulseShort)))

// ----- T4Q: momentum 25 + volume 20 + ADX 20 + trend 20 + anti-exhaustion 15.
_t4MoveRatioLong = adaptiveCore ? (adaptiveMomentumMoveAtr > 0 ? math.max(0.0, momMoveAtr) / adaptiveMomentumMoveAtr : 0.0) : (momRocMin > 0 ? math.max(0.0, roc) / momRocMin : 0.0)
_t4MoveRatioShort = adaptiveCore ? (adaptiveMomentumMoveAtr > 0 ? math.max(0.0, -momMoveAtr) / adaptiveMomentumMoveAtr : 0.0) : (momRocMin > 0 ? math.max(0.0, -roc) / momRocMin : 0.0)
_t4MomLong = _t4MoveRatioLong >= 2.50 ? 25.0 : _t4MoveRatioLong >= 1.75 ? 22.0 : _t4MoveRatioLong >= 1.25 ? 18.0 : _t4MoveRatioLong >= 1.00 ? 15.0 : _t4MoveRatioLong >= 0.75 ? 8.0 : 0.0
_t4MomShort = _t4MoveRatioShort >= 2.50 ? 25.0 : _t4MoveRatioShort >= 1.75 ? 22.0 : _t4MoveRatioShort >= 1.25 ? 18.0 : _t4MoveRatioShort >= 1.00 ? 15.0 : _t4MoveRatioShort >= 0.75 ? 8.0 : 0.0

_t4AdxQ = adaptiveCore ?
     (adx < adaptiveAdxFloor ? 0.0 : adxPctRank >= 85 ? 20.0 : adxPctRank >= 70 ? 17.0 : adxPctRank >= adaptiveMomentumAdxPct ? 14.0 : adxPctRank >= 45 ? 8.0 : 3.0) :
     (adx >= momAdxMin + 10 ? 20.0 : adx >= momAdxMin + 5 ? 17.0 : adx >= momAdxMin ? 14.0 : adx >= momAdxMin - 5 ? 8.0 : 3.0)

_t4TrendLong = htfState == 1 and midState == 1 ? 20.0 : htfState == 1 or midState == 1 ? 12.0 : chartBull ? 6.0 : 0.0
_t4TrendShort = htfState == -1 and midState == -1 ? 20.0 : htfState == -1 or midState == -1 ? 12.0 : chartBear ? 6.0 : 0.0

_t4DistEmaAtr = t4DistanceEmaAtr
_t4ExhaustBase = _t4DistEmaAtr <= 1.00 ? 15.0 : _t4DistEmaAtr <= 1.50 ? 12.0 : _t4DistEmaAtr <= 2.00 ? 8.0 : _t4DistEmaAtr <= 2.50 ? 4.0 : 0.0
_t4ExhaustQLong = t4LongExhausted ? 0.0 : t4Climax ? _t4ExhaustBase * 0.50 : _t4ExhaustBase
_t4ExhaustQShort = t4ShortExhausted ? 0.0 : t4Climax ? _t4ExhaustBase * 0.50 : _t4ExhaustBase

int t4QLong = int(math.round(f_clamp100(_t4MomLong + _qVol20 + _t4AdxQ + _t4TrendLong + _t4ExhaustQLong)))
int t4QShort = int(math.round(f_clamp100(_t4MomShort + _qVol20 + _t4AdxQ + _t4TrendShort + _t4ExhaustQShort)))

// Optional per-setup hard gate.
t1QualityLongOk = not setupQualityGate or t1QLong >= t1QualityMin
t1QualityShortOk = not setupQualityGate or t1QShort >= t1QualityMin
t2QualityLongOk = not setupQualityGate or t2QLong >= t2QualityMin
t2QualityShortOk = not setupQualityGate or t2QShort >= t2QualityMin
t3QualityLongOk = not setupQualityGate or t3QLong >= t3QualityMin
t3QualityShortOk = not setupQualityGate or t3QShort >= t3QualityMin
t4QualityLongOk = not setupQualityGate or t4QLong >= t4QualityMin
t4QualityShortOk = not setupQualityGate or t4QShort >= t4QualityMin

// ─────────────────────────────────────────────────────────────────────────────
// SCORE
// 20 HTF + 15 1H + 10 chart structure + 10 volume + 15 liquidity +
// 5 BTC + 5 ADX + up to 20 quality-weighted active setup = 100
// ─────────────────────────────────────────────────────────────────────────────
int minScore = profile5m ? 85 : profile15m ? 80 : profile30m ? 75 : profile1h ? 70 : minScoreManual
float scoreVolMin = profile5m ? 1.10 : profile15m ? 1.00 : profile30m ? 0.95 : profile1h ? 0.90 : scoreVolMinManual
float scoreAdxMin = profile5m ? 22.0 : profile15m ? 18.0 : profile30m ? 18.0 : profile1h ? 16.0 : scoreAdxMinManual
bool requireLiquidityHard = profile5m ? true : profileManual ? requireLiquidityHardManual : false

anyRawLong  = (enableT1 and rawT1Long) or (enableT2 and rawT2Long) or (enableT3 and rawT3Long) or (enableT4 and rawT4Long)
anyRawShort = (enableT1 and rawT1Short) or (enableT2 and rawT2Short) or (enableT3 and rawT3Short) or (enableT4 and rawT4Short)

// Aggregate Setup Q: use the strongest active raw setup plus a small confluence
// bonus when several DIFFERENT setups agree on the same bar.
_activeSetupCountLong = (enableT1 and rawT1Long ? 1 : 0) + (enableT2 and rawT2Long ? 1 : 0) + (enableT3 and rawT3Long ? 1 : 0) + (enableT4 and rawT4Long ? 1 : 0)
_activeSetupCountShort = (enableT1 and rawT1Short ? 1 : 0) + (enableT2 and rawT2Short ? 1 : 0) + (enableT3 and rawT3Short ? 1 : 0) + (enableT4 and rawT4Short ? 1 : 0)

_activeQMaxLong = math.max(math.max(enableT1 and rawT1Long ? t1QLong : 0, enableT2 and rawT2Long ? t2QLong : 0), math.max(enableT3 and rawT3Long ? t3QLong : 0, enableT4 and rawT4Long ? t4QLong : 0))
_activeQMaxShort = math.max(math.max(enableT1 and rawT1Short ? t1QShort : 0, enableT2 and rawT2Short ? t2QShort : 0), math.max(enableT3 and rawT3Short ? t3QShort : 0, enableT4 and rawT4Short ? t4QShort : 0))

int setupAggregateQLong = _activeSetupCountLong > 0 ? int(math.round(math.min(100.0, _activeQMaxLong + math.max(0, _activeSetupCountLong - 1) * setupQualityConfluenceBonus))) : 0
int setupAggregateQShort = _activeSetupCountShort > 0 ? int(math.round(math.min(100.0, _activeQMaxShort + math.max(0, _activeSetupCountShort - 1) * setupQualityConfluenceBonus))) : 0
int setupQualityScoreLong = int(math.round(setupAggregateQLong * 0.20))
int setupQualityScoreShort = int(math.round(setupAggregateQShort * 0.20))

int adaptiveVolumeScore = not adaptiveCore ? (volRatio >= scoreVolMin ? 10 : 0) :
     volumePctRank >= 85 ? 10 :
     volumePctRank >= 70 ? 8 :
     volumePctRank >= adaptiveScoreVolumePct ? 6 :
     volumePctRank >= 40 ? 3 : 0

int adaptiveAdxScore = not adaptiveCore ? (adx >= scoreAdxMin ? 5 : 0) :
     adx < adaptiveAdxFloor ? 0 :
     adxPctRank >= 80 ? 5 :
     adxPctRank >= adaptiveTrendAdxPct ? 4 :
     adxPctRank >= 45 ? 2 : 1

longScore =
     (htfState == 1 ? 20 : 0) +
     (midState == 1 ? 15 : 0) +
     (chartBull ? 10 : 0) +
     adaptiveVolumeScore +
     (liquidityAbove ? 15 : 0) +
     ((not useBtcFilter or btcState != -1) ? 5 : 0) +
     adaptiveAdxScore +
     setupQualityScoreLong

shortScore =
     (htfState == -1 ? 20 : 0) +
     (midState == -1 ? 15 : 0) +
     (chartBear ? 10 : 0) +
     adaptiveVolumeScore +
     (liquidityBelow ? 15 : 0) +
     ((not useBtcFilter or btcState != 1) ? 5 : 0) +
     adaptiveAdxScore +
     setupQualityScoreShort

liqGateLong  = not requireLiquidityHard or liquidityAbove
liqGateShort = not requireLiquidityHard or liquidityBelow
btcGateLong  = not btcHardFilter or btcLongOk
btcGateShort = not btcHardFilter or btcShortOk
brokeT1LongOk = not useBrokeCorrelation or brokeMode == "Info only" or not brokeAffectsSignals or (brokeDataValid and brokeDir == 1 and brokeT1QualityPass)
brokeT1ShortOk = not useBrokeCorrelation or brokeMode == "Info only" or not brokeAffectsSignals or (brokeDataValid and brokeDir == -1 and brokeT1QualityPass)
brokeT2LongOk = not useBrokeCorrelation or brokeMode == "Info only" or not brokeAffectsSignals or (brokeDataValid and brokeDir == 1 and brokeT2QualityPass)
brokeT2ShortOk = not useBrokeCorrelation or brokeMode == "Info only" or not brokeAffectsSignals or (brokeDataValid and brokeDir == -1 and brokeT2QualityPass)
brokeT3LongOk = not useBrokeCorrelation or brokeMode == "Info only" or not brokeAffectsSignals or (brokeDataValid and brokeDir == 1 and brokeT3QualityPass)
brokeT3ShortOk = not useBrokeCorrelation or brokeMode == "Info only" or not brokeAffectsSignals or (brokeDataValid and brokeDir == -1 and brokeT3QualityPass)
brokeT4LongOk = not useBrokeCorrelation or brokeMode == "Info only" or not brokeAffectsSignals or (brokeDataValid and brokeDir == 1 and brokeT4QualityPass)
brokeT4ShortOk = not useBrokeCorrelation or brokeMode == "Info only" or not brokeAffectsSignals or (brokeDataValid and brokeDir == -1 and brokeT4QualityPass)

_regimeHard = adaptiveCore and adaptiveRegimeMode == "Hard"
_regimeSoft = adaptiveCore and adaptiveRegimeMode == "Soft"

t1LongRegimeOk = not _regimeHard or t1RegimeLongCompatible
t1ShortRegimeOk = not _regimeHard or t1RegimeShortCompatible
t2RegimeOk = not _regimeHard or t2RegimeCompatible
t3RegimeOk = not _regimeHard or t3RegimeCompatible
t4LongRegimeOk = not _regimeHard or t4RegimeLongCompatible
t4ShortRegimeOk = not _regimeHard or t4RegimeShortCompatible

t1LongMinScore = minScore + (_regimeSoft and not t1RegimeLongCompatible ? adaptiveRegimePenalty : 0)
t1ShortMinScore = minScore + (_regimeSoft and not t1RegimeShortCompatible ? adaptiveRegimePenalty : 0)
t2MinScore = minScore + (_regimeSoft and not t2RegimeCompatible ? adaptiveRegimePenalty : 0)
t3MinScore = minScore + (_regimeSoft and not t3RegimeCompatible ? adaptiveRegimePenalty : 0)
t4LongMinScore = minScore + (_regimeSoft and not t4RegimeLongCompatible ? adaptiveRegimePenalty : 0)
t4ShortMinScore = minScore + (_regimeSoft and not t4RegimeShortCompatible ? adaptiveRegimePenalty : 0)

// Qualified setup signals
sigT1Long  = confirmed and enableT1 and rawT1Long  and trendGateLong  and btcGateLong  and liqGateLong  and brokeT1LongOk and t1LongRegimeOk and t1QualityLongOk and longScore  >= t1LongMinScore
sigT1Short = confirmed and enableT1 and rawT1Short and trendGateShort and btcGateShort and liqGateShort and brokeT1ShortOk and t1ShortRegimeOk and t1QualityShortOk and shortScore >= t1ShortMinScore

sigT2Long  = confirmed and enableT2 and rawT2Long  and trendGateLong  and btcGateLong  and liqGateLong  and brokeT2LongOk and t2RegimeOk and t2QualityLongOk and longScore  >= t2MinScore
sigT2Short = confirmed and enableT2 and rawT2Short and trendGateShort and btcGateShort and liqGateShort and brokeT2ShortOk and t2RegimeOk and t2QualityShortOk and shortScore >= t2MinScore

sigT3Long  = confirmed and enableT3 and rawT3Long  and smcTrendLong   and btcGateLong  and liqGateLong  and brokeT3LongOk and t3RegimeOk and t3QualityLongOk and longScore  >= t3MinScore
sigT3Short = confirmed and enableT3 and rawT3Short and smcTrendShort  and btcGateShort and liqGateShort and brokeT3ShortOk and t3RegimeOk and t3QualityShortOk and shortScore >= t3MinScore

sigT4Long  = confirmed and enableT4 and rawT4Long  and trendGateLong  and btcGateLong  and liqGateLong  and brokeT4LongOk and t4LongRegimeOk and t4QualityLongOk and longScore  >= t4LongMinScore
sigT4Short = confirmed and enableT4 and rawT4Short and trendGateShort and btcGateShort and liqGateShort and brokeT4ShortOk and t4ShortRegimeOk and t4QualityShortOk and shortScore >= t4ShortMinScore

anyLongSignal  = sigT1Long or sigT2Long or sigT3Long or sigT4Long
anyShortSignal = sigT1Short or sigT2Short or sigT3Short or sigT4Short

// One-shot setup events. T1 can remain qualified for several bars, so trade plans,
// research entries, combined labels and alerts use the rising edge instead.
eventT1Long  = sigT1Long  and not sigT1Long[1]
eventT1Short = sigT1Short and not sigT1Short[1]
eventT2Long  = sigT2Long
eventT2Short = sigT2Short
eventT3Long  = sigT3Long  and not sigT3Long[1]
eventT3Short = sigT3Short and not sigT3Short[1]
eventT4Long  = sigT4Long  and not sigT4Long[1]
eventT4Short = sigT4Short and not sigT4Short[1]
eventAnyLong  = eventT1Long or eventT2Long or eventT3Long or eventT4Long
eventAnyShort = eventT1Short or eventT2Short or eventT3Short or eventT4Short

// ─────────────────────────────────────────────────────────────────────────────
// RISK / TARGETS
// ─────────────────────────────────────────────────────────────────────────────
int pbStopLen = profile5m ? 24 : profile15m ? 8 : profile30m ? 6 : profile1h ? 4 : pbStopLenManual


// ─────────────────────────────────────────────────────────────────────────────
// ENTRY QUALITY / ACTION
// Execution layer only: it does not change T1-T4 signal generation.
// ─────────────────────────────────────────────────────────────────────────────
int entryQualityMin = profile5m ? 75 : profile15m ? 70 : profile30m ? 68 : profile1h ? 65 : entryQualityMinManual
int entryWaitMin = profile5m ? 60 : profile15m ? 55 : profile30m ? 55 : profile1h ? 50 : entryWaitMinManual
float entryNowMaxR = profile5m ? 0.10 : profile15m ? 0.15 : profile30m ? 0.18 : profile1h ? 0.20 : entryNowMaxRManual
float entryAdverseEnterR = profile5m ? 0.15 : profile15m ? 0.20 : profile30m ? 0.25 : profile1h ? 0.30 : entryAdverseEnterRManual
float entryTooLateR = profile5m ? 0.35 : profile15m ? 0.45 : profile30m ? 0.55 : profile1h ? 0.65 : entryTooLateRManual
int entryMaxAgeBars = profile5m ? 4 : profile15m ? 6 : profile30m ? 4 : profile1h ? 3 : entryMaxAgeBarsManual
float entryAdverseSkipR = profile5m ? 0.45 : profile15m ? 0.50 : profile30m ? 0.60 : profile1h ? 0.75 : entryAdverseSkipRManual
float entryMinLiqRR = profile5m ? 1.20 : profile15m ? 1.00 : profile30m ? 1.00 : profile1h ? 0.90 : entryMinLiqRRManual

// ─────────────────────────────────────────────────────────────────────────────
// RESEARCH MODE
// Full trade simulation. Each T1/T2/T3/T4 setup owns one independent virtual
// trade. Entry is the signal-bar close. On historical OHLC, management starts
// from the NEXT bar, because the close price is only known after that bar closes.
// ─────────────────────────────────────────────────────────────────────────────
researchAmbiguousExclude = researchAmbiguous == "Exclude trade"

// These are allocation WEIGHTS, not required to total 100. They are normalized
// automatically, so 40/30/20/10 and 4/3/2/1 produce the same partial exits.
_researchWeightSum = researchTp1Weight + researchTp2Weight + researchTp3Weight + researchTp4Weight
researchF1 = researchTp1Weight / _researchWeightSum
researchF2 = researchTp2Weight / _researchWeightSum
researchF3 = researchTp3Weight / _researchWeightSum
researchF4 = researchTp4Weight / _researchWeightSum
researchWindow = researchPeriodMode == "Days" ? time >= last_bar_time - researchDays * 86400000 : bar_index >= math.max(0, last_bar_index - researchBars + 1)

var int   lastDir   = 0
var float lastEntry = na
var float lastSL    = na
var float lastTP1   = na
var float lastTP2   = na
var float lastTP3   = na
var float lastTP4   = na
var float lastLiqTP = na
var bool  beActive  = false
var int   beActivatedBar = na
var int   lastSignalBar = na
var bool  lastSetupT1 = false
var bool  lastSetupT2 = false
var bool  lastSetupT3 = false
var bool  lastSetupT4 = false
var int   lastT1Q = na
var int   lastT2Q = na
var int   lastT3Q = na
var int   lastT4Q = na
var int   lastSetupAggregateQ = na
var string lastT2Kind = ""
var float lastSignalVolRatio = na
var float lastSignalVolPctRank = na
var int   lastSignalScore = na
var float lastPositionUsdt = na

// Visual lifecycle for the latest trade plan.
// A level remains visible through the candle that touches it, then becomes na
// from the following bar. This keeps historical SL/TP segments from extending
// indefinitely across the chart.
var bool visInitialSLActive = false
var bool visManagedSLActive = false
var bool visTP1Active = false
var bool visTP2Active = false
var bool visTP3Active = false
var bool visTP4Active = false
var bool visLiqActive = false

longStopT1 = ta.lowest(low, pbStopLen) - atr * slAtrBuffer
shortStopT1 = ta.highest(high, pbStopLen) + atr * slAtrBuffer
longStopT2 = nz(t2LongSignalLevel, rangeHigh) - atr * breakStopAtr
shortStopT2 = nz(t2ShortSignalLevel, rangeLow) + atr * breakStopAtr
longStopT3 = not na(bullReactionLo) ? bullReactionLo - atr * slAtrBuffer : close - atr * 1.5
shortStopT3 = not na(bearReactionHi) ? bearReactionHi + atr * slAtrBuffer : close + atr * 1.5
longStopT4 = close - atr * momStopAtr
shortStopT4 = close + atr * momStopAtr

// ─────────────────────────────────────────────────────────────────────────────
// RESEARCH ENGINE — FULL TRADE LIFECYCLE
// Index 0/1/2/3 = T1/T2/T3/T4.
// stage: 0 = no TP, 1 = TP1, 2 = TP2, 3 = TP3. TP4 closes the trade.
// realizedR stores R already banked by partial exits.
// ─────────────────────────────────────────────────────────────────────────────
var array<bool> rActive = array.new_bool(4, false)
var array<int> rDir = array.new_int(4, 0)
var array<float> rEntry = array.new_float(4, na)
var array<float> rSL = array.new_float(4, na)
var array<float> rRisk = array.new_float(4, na)
var array<int> rStage = array.new_int(4, 0)
var array<float> rRealizedR = array.new_float(4, 0.0)
var array<int> rEntryBar = array.new_int(4, na)
var array<int> rBeBar = array.new_int(4, na)

// Closed-trade statistics.
var array<int> rClosed = array.new_int(4, 0)
var array<int> rWins = array.new_int(4, 0)
var array<int> rLosses = array.new_int(4, 0)
var array<int> rBreakevens = array.new_int(4, 0)
var array<int> rExcluded = array.new_int(4, 0)
var array<float> rTotalR = array.new_float(4, 0.0)
var array<float> rGrossProfitR = array.new_float(4, 0.0)
var array<float> rGrossLossR = array.new_float(4, 0.0)
var array<float> rWinRSum = array.new_float(4, 0.0)
var array<float> rLossRSum = array.new_float(4, 0.0)

// Lifecycle diagnostics: number of trades that reached each level / exit.
var array<int> rTp1Hits = array.new_int(4, 0)
var array<int> rTp2Hits = array.new_int(4, 0)
var array<int> rTp3Hits = array.new_int(4, 0)
var array<int> rTp4Hits = array.new_int(4, 0)
var array<int> rSlHits = array.new_int(4, 0)
var array<int> rBeHits = array.new_int(4, 0)

// Resolve all already-open research trades before opening new ones.
for _ri = 0 to 3
    if array.get(rActive, _ri)
        _entryBar = array.get(rEntryBar, _ri)
        if not na(_entryBar) and bar_index > _entryBar
            _dir = array.get(rDir, _ri)
            _entry = array.get(rEntry, _ri)
            _sl = array.get(rSL, _ri)
            _risk = array.get(rRisk, _ri)
            _stage = array.get(rStage, _ri)
            _realized = array.get(rRealizedR, _ri)
            _beBar = array.get(rBeBar, _ri)

            _tp1 = _dir == 1 ? _entry + _risk * r1 : _entry - _risk * r1
            _tp2 = _dir == 1 ? _entry + _risk * r2 : _entry - _risk * r2
            _tp3 = _dir == 1 ? _entry + _risk * r3 : _entry - _risk * r3
            _tp4 = _dir == 1 ? _entry + _risk * r4 : _entry - _risk * r4

            _tp1Hit = _stage < 1 and (_dir == 1 ? high >= _tp1 : low <= _tp1)
            _tp2Hit = _stage < 2 and (_dir == 1 ? high >= _tp2 : low <= _tp2)
            _tp3Hit = _stage < 3 and (_dir == 1 ? high >= _tp3 : low <= _tp3)
            _tp4Hit = _dir == 1 ? high >= _tp4 : low <= _tp4
            _anyNewTpHit = _tp1Hit or _tp2Hit or _tp3Hit or _tp4Hit

            // Once TP1 has been achieved, BE is enabled only from the next bar.
            _beStopActive = researchMoveToBE and _stage >= 1 and not na(_beBar) and bar_index > _beBar
            _stopLevel = _beStopActive ? _entry : _sl
            _stopHit = _dir == 1 ? low <= _stopLevel : high >= _stopLevel

            _exitedBefore = (_stage >= 1 ? researchF1 : 0.0) + (_stage >= 2 ? researchF2 : 0.0) + (_stage >= 3 ? researchF3 : 0.0)
            _remainingBefore = math.max(0.0, 1.0 - _exitedBefore)

            bool _closeResearchTrade = false
            bool _excludeResearchTrade = false
            float _resultR = na

            // Same OHLC candle contains both an actionable stop and at least one
            // new target. Intrabar order is unknowable without lower-TF data.
            if _stopHit and _anyNewTpHit
                if researchAmbiguousExclude
                    _closeResearchTrade := true
                    _excludeResearchTrade := true
                else
                    _resultR := _realized + (_beStopActive ? 0.0 : -_remainingBefore)
                    if _beStopActive
                        array.set(rBeHits, _ri, array.get(rBeHits, _ri) + 1)
                    else
                        array.set(rSlHits, _ri, array.get(rSlHits, _ri) + 1)
                    _closeResearchTrade := true
            else if _stopHit
                _resultR := _realized + (_beStopActive ? 0.0 : -_remainingBefore)
                if _beStopActive
                    array.set(rBeHits, _ri, array.get(rBeHits, _ri) + 1)
                else
                    array.set(rSlHits, _ri, array.get(rSlHits, _ri) + 1)
                _closeResearchTrade := true
            else
                // A candle that reaches a farther target necessarily crosses all
                // nearer targets in the trade direction. Process them in order.
                if _tp1Hit
                    _realized += researchF1 * r1
                    _stage := 1
                    _beBar := bar_index
                    array.set(rTp1Hits, _ri, array.get(rTp1Hits, _ri) + 1)
                if _tp2Hit
                    _realized += researchF2 * r2
                    _stage := 2
                    array.set(rTp2Hits, _ri, array.get(rTp2Hits, _ri) + 1)
                if _tp3Hit
                    _realized += researchF3 * r3
                    _stage := 3
                    array.set(rTp3Hits, _ri, array.get(rTp3Hits, _ri) + 1)
                if _tp4Hit
                    _realized += researchF4 * r4
                    array.set(rTp4Hits, _ri, array.get(rTp4Hits, _ri) + 1)
                    _resultR := _realized
                    _closeResearchTrade := true

                array.set(rStage, _ri, _stage)
                array.set(rRealizedR, _ri, _realized)
                array.set(rBeBar, _ri, _beBar)

            if _closeResearchTrade
                array.set(rActive, _ri, false)
                if _excludeResearchTrade
                    array.set(rExcluded, _ri, array.get(rExcluded, _ri) + 1)
                else
                    _closed = array.get(rClosed, _ri) + 1
                    array.set(rClosed, _ri, _closed)
                    array.set(rTotalR, _ri, array.get(rTotalR, _ri) + _resultR)
                    if _resultR > 0.000001
                        array.set(rWins, _ri, array.get(rWins, _ri) + 1)
                        array.set(rGrossProfitR, _ri, array.get(rGrossProfitR, _ri) + _resultR)
                        array.set(rWinRSum, _ri, array.get(rWinRSum, _ri) + _resultR)
                    else if _resultR < -0.000001
                        array.set(rLosses, _ri, array.get(rLosses, _ri) + 1)
                        array.set(rGrossLossR, _ri, array.get(rGrossLossR, _ri) + math.abs(_resultR))
                        array.set(rLossRSum, _ri, array.get(rLossRSum, _ri) + _resultR)
                    else
                        array.set(rBreakevens, _ri, array.get(rBreakevens, _ri) + 1)

// SETUP SIGNAL mode: open a new independent trade for each setup that is
// currently flat. If both directions qualify for the SAME setup on one candle,
// higher score wins. Each setup uses its own structural SL.
if researchMode and researchWindow and researchEntryMode == "SETUP SIGNAL"
    for _ri = 0 to 3
        if not array.get(rActive, _ri)
            _longEvent = _ri == 0 ? eventT1Long : _ri == 1 ? eventT2Long : _ri == 2 ? eventT3Long : eventT4Long
            _shortEvent = _ri == 0 ? eventT1Short : _ri == 1 ? eventT2Short : _ri == 2 ? eventT3Short : eventT4Short
            _dir = _longEvent and _shortEvent ? (longScore >= shortScore ? 1 : -1) : _longEvent ? 1 : _shortEvent ? -1 : 0
            if _dir != 0
                _longSl = _ri == 0 ? longStopT1 : _ri == 1 ? longStopT2 : _ri == 2 ? longStopT3 : longStopT4
                _shortSl = _ri == 0 ? shortStopT1 : _ri == 1 ? shortStopT2 : _ri == 2 ? shortStopT3 : shortStopT4
                _sl = _dir == 1 ? _longSl : _shortSl
                _sl := _dir == 1 and _sl >= close ? close - atr * 1.5 : _dir == -1 and _sl <= close ? close + atr * 1.5 : _sl
                _risk = math.abs(close - _sl)
                if _risk > syminfo.mintick
                    array.set(rActive, _ri, true)
                    array.set(rDir, _ri, _dir)
                    array.set(rEntry, _ri, close)
                    array.set(rSL, _ri, _sl)
                    array.set(rRisk, _ri, _risk)
                    array.set(rStage, _ri, 0)
                    array.set(rRealizedR, _ri, 0.0)
                    array.set(rEntryBar, _ri, bar_index)
                    array.set(rBeBar, _ri, na)

// Select one side for the displayed/latest trade plan if both directions qualify.
bool selectedLongSignal = eventAnyLong
bool selectedShortSignal = eventAnyShort
if selectedLongSignal and selectedShortSignal
    if longScore >= shortScore
        selectedShortSignal := false
    else
        selectedLongSignal := false

if selectedLongSignal
    _sl = eventT1Long ? longStopT1 : eventT2Long ? longStopT2 : eventT3Long ? longStopT3 : longStopT4
    _sl := _sl >= close ? close - atr * 1.5 : _sl
    _risk = close - _sl
    lastDir := 1
    lastEntry := close
    lastSL := _sl
    lastTP1 := close + _risk * r1
    lastTP2 := close + _risk * r2
    lastTP3 := close + _risk * r3
    lastTP4 := close + _risk * r4
    lastLiqTP := liqTargetLong
    beActive := false
    beActivatedBar := na
    lastSignalBar := bar_index
    lastSetupT1 := eventT1Long
    lastSetupT2 := eventT2Long
    lastSetupT3 := eventT3Long
    lastSetupT4 := eventT4Long
    lastT1Q := eventT1Long ? t1QLong : na
    lastT2Q := eventT2Long ? t2QLong : na
    lastT3Q := eventT3Long ? t3QLong : na
    lastT4Q := eventT4Long ? t4QLong : na
    lastSetupAggregateQ := setupAggregateQLong
    lastT2Kind := eventT2Long ? t2SignalKindLong : ""
    lastSignalVolRatio := volRatio
    lastSignalVolPctRank := volumePctRank
    lastSignalScore := longScore
    _stopPct = close != 0 ? _risk / close : na
    lastPositionUsdt := not na(_stopPct) and _stopPct > 0 ? riskUsdt / _stopPct : na
    visInitialSLActive := true
    visManagedSLActive := true
    visTP1Active := true
    visTP2Active := true
    visTP3Active := true
    visTP4Active := true
    visLiqActive := not na(lastLiqTP)

else if selectedShortSignal
    _sl = eventT1Short ? shortStopT1 : eventT2Short ? shortStopT2 : eventT3Short ? shortStopT3 : shortStopT4
    _sl := _sl <= close ? close + atr * 1.5 : _sl
    _risk = _sl - close
    lastDir := -1
    lastEntry := close
    lastSL := _sl
    lastTP1 := close - _risk * r1
    lastTP2 := close - _risk * r2
    lastTP3 := close - _risk * r3
    lastTP4 := close - _risk * r4
    lastLiqTP := liqTargetShort
    beActive := false
    beActivatedBar := na
    lastSignalBar := bar_index
    lastSetupT1 := eventT1Short
    lastSetupT2 := eventT2Short
    lastSetupT3 := eventT3Short
    lastSetupT4 := eventT4Short
    lastT1Q := eventT1Short ? t1QShort : na
    lastT2Q := eventT2Short ? t2QShort : na
    lastT3Q := eventT3Short ? t3QShort : na
    lastT4Q := eventT4Short ? t4QShort : na
    lastSetupAggregateQ := setupAggregateQShort
    lastT2Kind := eventT2Short ? t2SignalKindShort : ""
    lastSignalVolRatio := volRatio
    lastSignalVolPctRank := volumePctRank
    lastSignalScore := shortScore
    _stopPct = close != 0 ? _risk / close : na
    lastPositionUsdt := not na(_stopPct) and _stopPct > 0 ? riskUsdt / _stopPct : na
    visInitialSLActive := true
    visManagedSLActive := true
    visTP1Active := true
    visTP2Active := true
    visTP3Active := true
    visTP4Active := true
    visLiqActive := not na(lastLiqTP)

// TP1 -> BE management hint (published channel rule).
// This is visualization only; it is not an exchange order simulator.
if lastDir == 1 and not beActive and not na(lastTP1) and not na(lastSignalBar) and bar_index > lastSignalBar and high >= lastTP1
    beActive := true
    beActivatedBar := bar_index
if lastDir == -1 and not beActive and not na(lastTP1) and not na(lastSignalBar) and bar_index > lastSignalBar and low <= lastTP1
    beActive := true
    beActivatedBar := bar_index

managedSL = beActive ? lastEntry : lastSL

// ─────────────────────────────────────────────────────────────────────────────
// ENTRY QUALITY / ACTION ENGINE
// Quality = MTF (25) + distance from Entry (25) + current RR to LIQ (20)
//         + signal volume (15) + setup type / confluence (15) = 100.
// Positive moveR means price moved in the intended trade direction.
// ─────────────────────────────────────────────────────────────────────────────
_hasTradePlan = lastDir != 0 and not na(lastEntry) and not na(lastSL) and not na(lastSignalBar)
_initialRisk = _hasTradePlan ? math.abs(lastEntry - lastSL) : na
_moveR = _hasTradePlan and _initialRisk > syminfo.mintick ? (lastDir == 1 ? (close - lastEntry) / _initialRisk : (lastEntry - close) / _initialRisk) : na

_mtfBoth = _hasTradePlan and (lastDir == 1 ? (htfState == 1 and midState == 1) : (htfState == -1 and midState == -1))
_mtfOne = _hasTradePlan and not _mtfBoth and (lastDir == 1 ? (htfState == 1 or midState == 1) : (htfState == -1 or midState == -1))
_mtfScore = _mtfBoth ? 25.0 : _mtfOne ? 12.0 : 0.0

_distanceScore = na(_moveR) ? 0.0 :
     _moveR >= -(entryAdverseEnterR * 0.50) and _moveR <= entryNowMaxR ? 25.0 :
     _moveR > entryNowMaxR and _moveR <= (entryNowMaxR + entryTooLateR) * 0.50 ? 20.0 :
     _moveR > (entryNowMaxR + entryTooLateR) * 0.50 and _moveR <= entryTooLateR ? 10.0 :
     _moveR < -(entryAdverseEnterR * 0.50) and _moveR >= -entryAdverseEnterR ? 20.0 :
     _moveR < -entryAdverseEnterR and _moveR >= -entryAdverseSkipR ? 10.0 : 0.0

_currentRiskToSL = _hasTradePlan ? (lastDir == 1 ? close - lastSL : lastSL - close) : na
_liqRewardNow = _hasTradePlan and not na(lastLiqTP) ? (lastDir == 1 ? lastLiqTP - close : close - lastLiqTP) : na
_rrToLiq = not na(_currentRiskToSL) and not na(_liqRewardNow) and _currentRiskToSL > syminfo.mintick and _liqRewardNow > 0 ? _liqRewardNow / _currentRiskToSL : na
_rrScore = na(_rrToLiq) ? 5.0 : _rrToLiq >= 2.0 ? 20.0 : _rrToLiq >= 1.5 ? 17.0 : _rrToLiq >= 1.0 ? 13.0 : _rrToLiq >= 0.75 ? 8.0 : _rrToLiq > 0 ? 4.0 : 0.0

_volScore = adaptiveCore and not na(lastSignalVolPctRank) ?
     (lastSignalVolPctRank >= 85 ? 15.0 : lastSignalVolPctRank >= 70 ? 12.0 : lastSignalVolPctRank >= adaptiveScoreVolumePct ? 9.0 : lastSignalVolPctRank >= 40 ? 5.0 : 2.0) :
     (na(lastSignalVolRatio) ? 0.0 : lastSignalVolRatio >= 1.50 ? 15.0 : lastSignalVolRatio >= 1.20 ? 12.0 : lastSignalVolRatio >= 1.00 ? 9.0 : lastSignalVolRatio >= 0.80 ? 5.0 : 2.0)

_setupCount = (lastSetupT1 ? 1 : 0) + (lastSetupT2 ? 1 : 0) + (lastSetupT3 ? 1 : 0) + (lastSetupT4 ? 1 : 0)
_setupScore = na(lastSetupAggregateQ) ? 0.0 : math.min(15.0, lastSetupAggregateQ * 0.15)

entryQualityBase = _hasTradePlan ? math.min(100.0, _mtfScore + _distanceScore + _rrScore + _volScore + _setupScore) : na

_brokeDirAgree = _hasTradePlan and brokeDataValid and brokeDir == lastDir
_brokeDirConflict = _hasTradePlan and brokeDataValid and brokeDir != 0 and brokeDir != lastDir
_brokeEntryAgree = _hasTradePlan and (lastDir == 1 ? brokeLongEntryRecent : brokeShortEntryRecent)
_brokeSetupQualityPass = _hasTradePlan and ((lastSetupT1 and brokeT1QualityPass) or (lastSetupT2 and brokeT2QualityPass) or (lastSetupT3 and brokeT3QualityPass) or (lastSetupT4 and brokeT4QualityPass))
_brokeHardReady = not useBrokeCorrelation or (brokeDataValid and _brokeDirAgree and _brokeSetupQualityPass and (not brokeRequireEntryEvent or _brokeEntryAgree))
_brokeSoftAdj = not useBrokeCorrelation or brokeMode != "Soft" ? 0.0 :
     not brokeDataValid ? -15.0 :
     _brokeDirConflict ? -25.0 :
     _brokeDirAgree and _brokeSetupQualityPass ? 10.0 :
     _brokeDirAgree ? -5.0 : -10.0
entryQuality = na(entryQualityBase) ? na : math.max(0.0, math.min(100.0, entryQualityBase + _brokeSoftAdj))

_stopInvalid = _hasTradePlan and (lastDir == 1 ? close <= lastSL : close >= lastSL)
_signalAge = _hasTradePlan ? bar_index - lastSignalBar : na
_liqRrTooLow = not na(_rrToLiq) and _rrToLiq < entryMinLiqRR
_mtfEnterOk = not entryRequireBothMtf or _mtfBoth

string entryAction = "WAIT SIGNAL"
if _hasTradePlan
    if _stopInvalid or not (_mtfBoth or _mtfOne) or (not na(_moveR) and _moveR <= -entryAdverseSkipR)
        entryAction := "SKIP"
    else if useBrokeCorrelation and brokeMode == "Hard Gate" and (not brokeDataValid or _brokeDirConflict)
        entryAction := "SKIP"
    else if useBrokeCorrelation and brokeMode == "Hard Gate" and not _brokeHardReady
        entryAction := "WAIT RETEST"
    else if beActive or (not na(_moveR) and _moveR >= entryTooLateR) or (not na(_signalAge) and _signalAge > entryMaxAgeBars)
        entryAction := "TOO LATE"
    else if _liqRrTooLow
        entryAction := "SKIP"
    else if not na(_moveR) and (_moveR > entryNowMaxR or _moveR < -entryAdverseEnterR)
        entryAction := "WAIT RETEST"
    else if _mtfEnterOk and entryQuality >= entryQualityMin
        entryAction := "ENTER NOW"
    else if entryQuality >= entryWaitMin
        entryAction := "WAIT RETEST"
    else
        entryAction := "SKIP"

// ─────────────────────────────────────────────────────────────────────────────
// READY TO ENTER EVENT
// Trigger when ACTION first enters ENTER NOW. A newly-created trade plan also
// gets its own READY event even if the previous bar belonged to another plan
// that was already ENTER NOW.
// ─────────────────────────────────────────────────────────────────────────────
readyToEnterNow = entryAction == "ENTER NOW"
_newTradePlan = not na(lastSignalBar) and (na(lastSignalBar[1]) or lastSignalBar != lastSignalBar[1])
readyToEnterEvent = confirmed and readyToEnterNow and (not readyToEnterNow[1] or _newTradePlan)
readyToEnterLong = readyToEnterEvent and lastDir == 1
readyToEnterShort = readyToEnterEvent and lastDir == -1

// ENTER NOW Research mode.
// Attribution rule: if several setups formed the latest combined plan, the same
// executable READY trade is attributed to every contributing setup bucket.
// This intentionally measures "trades where Tn participated in an ENTER NOW plan".
// The execution layer itself has one active plan/SL, so all contributing setup
// buckets use that same plan SL and the actual ENTER NOW bar close as Entry.
if researchMode and researchWindow and researchEntryMode == "ENTER NOW" and readyToEnterEvent and lastDir != 0
    for _ri = 0 to 3
        _setupParticipates = _ri == 0 ? lastSetupT1 : _ri == 1 ? lastSetupT2 : _ri == 2 ? lastSetupT3 : lastSetupT4
        if _setupParticipates and not array.get(rActive, _ri)
            _sl = lastSL
            _risk = math.abs(close - _sl)
            _validStop = lastDir == 1 ? _sl < close : _sl > close
            if _validStop and _risk > syminfo.mintick
                array.set(rActive, _ri, true)
                array.set(rDir, _ri, lastDir)
                array.set(rEntry, _ri, close)
                array.set(rSL, _ri, _sl)
                array.set(rRisk, _ri, _risk)
                array.set(rStage, _ri, 0)
                array.set(rRealizedR, _ri, 0.0)
                array.set(rEntryBar, _ri, bar_index)
                array.set(rBeBar, _ri, na)

// ─────────────────────────────────────────────────────────────────────────────
// VISUALS
// ─────────────────────────────────────────────────────────────────────────────

f_labelSize(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Normal" ? size.normal : size.small

combinedLabelSize = f_labelSize(combinedLabelSizeInput)

plot(showEMA ? ema9 : na,  "EMA 9",  color=color.new(color.teal, 0), linewidth=1)
plot(showEMA ? ema21 : na, "EMA 21", color=color.new(color.orange, 0), linewidth=2)
plot(showEMA ? ema50 : na, "EMA 50", color=color.new(color.gray, 25), linewidth=1)

pBbU = plot(showBands ? bbUpper : na, "BB Upper", color=color.new(color.blue, 60))
pBbL = plot(showBands ? bbLower : na, "BB Lower", color=color.new(color.blue, 60))
fill(pBbU, pBbL, color=color.new(color.blue, 94), title="BB Fill")

// Zones
pBullFvgHi = plot(showZones ? bullFvgHi : na, "Bull FVG High", color=color.new(color.lime, 68), style=plot.style_linebr)
pBullFvgLo = plot(showZones ? bullFvgLo : na, "Bull FVG Low",  color=color.new(color.lime, 68), style=plot.style_linebr)
fill(pBullFvgHi, pBullFvgLo, color=color.new(color.lime, 92), title="Bull FVG")

pBearFvgHi = plot(showZones ? bearFvgHi : na, "Bear FVG High", color=color.new(color.red, 68), style=plot.style_linebr)
pBearFvgLo = plot(showZones ? bearFvgLo : na, "Bear FVG Low",  color=color.new(color.red, 68), style=plot.style_linebr)
fill(pBearFvgHi, pBearFvgLo, color=color.new(color.red, 92), title="Bear FVG")

pBullObHi = plot(showZones ? bullObHi : na, "Bull OB High", color=color.new(color.green, 72), style=plot.style_linebr)
pBullObLo = plot(showZones ? bullObLo : na, "Bull OB Low",  color=color.new(color.green, 72), style=plot.style_linebr)
fill(pBullObHi, pBullObLo, color=color.new(color.green, 94), title="Bull OB")

pBearObHi = plot(showZones ? bearObHi : na, "Bear OB High", color=color.new(color.maroon, 72), style=plot.style_linebr)
pBearObLo = plot(showZones ? bearObLo : na, "Bear OB Low",  color=color.new(color.maroon, 72), style=plot.style_linebr)
fill(pBearObHi, pBearObLo, color=color.new(color.maroon, 94), title="Bear OB")

pBullBrHi = plot(showZones ? bullBreakerHi : na, "Bull Breaker High", color=color.new(color.aqua, 65), style=plot.style_linebr)
pBullBrLo = plot(showZones ? bullBreakerLo : na, "Bull Breaker Low",  color=color.new(color.aqua, 65), style=plot.style_linebr)
fill(pBullBrHi, pBullBrLo, color=color.new(color.aqua, 94), title="Bull Breaker")

pBearBrHi = plot(showZones ? bearBreakerHi : na, "Bear Breaker High", color=color.new(color.fuchsia, 65), style=plot.style_linebr)
pBearBrLo = plot(showZones ? bearBreakerLo : na, "Bear Breaker Low",  color=color.new(color.fuchsia, 65), style=plot.style_linebr)
fill(pBearBrHi, pBearBrLo, color=color.new(color.fuchsia, 94), title="Bear Breaker")

plot(showLiquidity and eqHighActive ? eqHighLevel : na, "Equal High Liquidity", color=color.new(color.red, 30), style=plot.style_linebr, linewidth=2)
plot(showLiquidity and eqLowActive  ? eqLowLevel  : na, "Equal Low Liquidity",  color=color.new(color.lime, 30), style=plot.style_linebr, linewidth=2)

// Individual setup marks
plotshape(sigT1Long,  title="T1 LONG",  style=shape.labelup,   location=location.belowbar, text="T1", color=color.new(color.lime, 0), textcolor=color.black, size=size.tiny)
plotshape(sigT1Short, title="T1 SHORT", style=shape.labeldown, location=location.abovebar, text="T1", color=color.new(color.red, 0),  textcolor=color.white, size=size.tiny)
plotshape(sigT2Long,  title="T2 LONG",  style=shape.labelup,   location=location.belowbar, text="T2", color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)
plotshape(sigT2Short, title="T2 SHORT", style=shape.labeldown, location=location.abovebar, text="T2", color=color.new(color.maroon, 0), textcolor=color.white, size=size.tiny)
plotshape(sigT3Long,  title="T3 LONG",  style=shape.labelup,   location=location.belowbar, text="T3", color=color.new(color.aqua, 0), textcolor=color.black, size=size.tiny)
plotshape(sigT3Short, title="T3 SHORT", style=shape.labeldown, location=location.abovebar, text="T3", color=color.new(color.fuchsia, 0), textcolor=color.white, size=size.tiny)
plotshape(sigT4Long,  title="T4 LONG",  style=shape.labelup,   location=location.belowbar, text="T4", color=color.new(color.yellow, 0), textcolor=color.black, size=size.tiny)
plotshape(sigT4Short, title="T4 SHORT", style=shape.labeldown, location=location.abovebar, text="T4", color=color.new(color.orange, 0), textcolor=color.black, size=size.tiny)

// Combined labels with anti-overlap logic.
// Full trade details are preserved in tooltip even when Compact mode is used.
var int lastCombinedLabelBar = na
var int lastCombinedLabelDir = 0

_combinedSpacingOk = na(lastCombinedLabelBar) or bar_index - lastCombinedLabelBar >= combinedLabelMinBars
_longDirChange = lastCombinedLabelDir != 1
_shortDirChange = lastCombinedLabelDir != -1

bool drawLongCombined = showSignalLabels and eventAnyLong and (_combinedSpacingOk or (combinedLabelDirectionChange and _longDirChange))
bool drawShortCombined = showSignalLabels and eventAnyShort and (_combinedSpacingOk or (combinedLabelDirectionChange and _shortDirChange))

// If opposite signals somehow qualify on the same candle, draw only the higher-score side.
if drawLongCombined and drawShortCombined
    if longScore >= shortScore
        drawShortCombined := false
    else
        drawLongCombined := false

if drawLongCombined
    _setupShort = (eventT1Long ? "T1 " : "") + (eventT2Long ? (t2SignalKindLong == "RETEST" ? "T2R " : "T2B ") : "") + (eventT3Long ? "T3 " : "") + (eventT4Long ? "T4 " : "")
    _setupFull = (eventT1Long ? "T1 Adaptive PB " : "") + (eventT2Long ? "T2 " + t2SignalKindLong + " " : "") + (eventT3Long ? (t3RequireSequence ? "T3 SWEEP>CHOCH>ZONE " : "T3 SMC ") : "") + (eventT4Long ? "T4 MOM " : "")
    _setupQTxt = (eventT1Long ? "T1=" + str.tostring(t1QLong) + " " : "") + (eventT2Long ? "T2=" + str.tostring(t2QLong) + " " : "") + (eventT3Long ? "T3=" + str.tostring(t3QLong) + " " : "") + (eventT4Long ? "T4=" + str.tostring(t4QLong) + " " : "")
    _liqTxt = not na(lastLiqTP) ? "\nLIQ: " + str.tostring(lastLiqTP, format.mintick) : ""
    _posTxt = not na(lastPositionUsdt) ? str.tostring(lastPositionUsdt, "#") + " USDT" : "—"
    _eqTxt = not na(entryQuality) ? str.tostring(entryQuality, "#.0") : "—"
    _fullText = "LONG  " + _setupFull + "\nSetupQ: " + _setupQTxt + "\nScore: " + str.tostring(longScore) + " | EQ: " + _eqTxt + "\nAction: " + entryAction + "\nRegime: " + marketRegime + "\nEntry: " + str.tostring(lastEntry, format.mintick) + "\nSL: " + str.tostring(lastSL, format.mintick) + "\nTP1: " + str.tostring(lastTP1, format.mintick) + "\nPos: " + _posTxt + " | Risk: " + str.tostring(riskUsdt, "#.##") + " USDT" + _liqTxt
    _chartText = combinedLabelDetail == "Compact" ? "LONG " + _setupShort + "| " + str.tostring(longScore) + "\nQ " + _setupQTxt + "| Pos: " + _posTxt : _fullText
    _y = low - atr * combinedLabelAtrOffset
    label.new(bar_index, _y, _chartText, style=label.style_label_up, color=color.new(color.lime, combinedLabelBgTransparency), textcolor=combinedLongTextColor, size=combinedLabelSize, tooltip=_fullText)
    lastCombinedLabelBar := bar_index
    lastCombinedLabelDir := 1

if drawShortCombined
    _setupShort = (eventT1Short ? "T1 " : "") + (eventT2Short ? (t2SignalKindShort == "RETEST" ? "T2R " : "T2B ") : "") + (eventT3Short ? "T3 " : "") + (eventT4Short ? "T4 " : "")
    _setupFull = (eventT1Short ? "T1 Adaptive PB " : "") + (eventT2Short ? "T2 " + t2SignalKindShort + " " : "") + (eventT3Short ? (t3RequireSequence ? "T3 SWEEP>CHOCH>ZONE " : "T3 SMC ") : "") + (eventT4Short ? "T4 MOM " : "")
    _setupQTxt = (eventT1Short ? "T1=" + str.tostring(t1QShort) + " " : "") + (eventT2Short ? "T2=" + str.tostring(t2QShort) + " " : "") + (eventT3Short ? "T3=" + str.tostring(t3QShort) + " " : "") + (eventT4Short ? "T4=" + str.tostring(t4QShort) + " " : "")
    _liqTxt = not na(lastLiqTP) ? "\nLIQ: " + str.tostring(lastLiqTP, format.mintick) : ""
    _posTxt = not na(lastPositionUsdt) ? str.tostring(lastPositionUsdt, "#") + " USDT" : "—"
    _eqTxt = not na(entryQuality) ? str.tostring(entryQuality, "#.0") : "—"
    _fullText = "SHORT  " + _setupFull + "\nSetupQ: " + _setupQTxt + "\nScore: " + str.tostring(shortScore) + " | EQ: " + _eqTxt + "\nAction: " + entryAction + "\nRegime: " + marketRegime + "\nEntry: " + str.tostring(lastEntry, format.mintick) + "\nSL: " + str.tostring(lastSL, format.mintick) + "\nTP1: " + str.tostring(lastTP1, format.mintick) + "\nPos: " + _posTxt + " | Risk: " + str.tostring(riskUsdt, "#.##") + " USDT" + _liqTxt
    _chartText = combinedLabelDetail == "Compact" ? "SHORT " + _setupShort + "| " + str.tostring(shortScore) + "\nQ " + _setupQTxt + "| Pos: " + _posTxt : _fullText
    _y = high + atr * combinedLabelAtrOffset
    label.new(bar_index, _y, _chartText, style=label.style_label_down, color=color.new(color.red, combinedLabelBgTransparency), textcolor=combinedShortTextColor, size=combinedLabelSize, tooltip=_fullText)
    lastCombinedLabelBar := bar_index
    lastCombinedLabelDir := -1

// Latest trade levels.
// linebr + lifecycle flags prevent old SL/TP segments from being connected to
// later bars after the price has already reached the level.
plot(showTradeLevels ? lastEntry : na, "Last Entry", color=color.new(color.white, 10), linewidth=2, style=plot.style_stepline)
plot(showTradeLevels and visInitialSLActive ? lastSL : na, "Initial SL", color=color.new(color.red, 35), linewidth=1, style=plot.style_linebr)
plot(showTradeLevels and visManagedSLActive and beActive ? lastEntry : na, "Managed SL / BE", color=color.new(color.aqua, 0), linewidth=2, style=plot.style_linebr)
plot(showTradeLevels and visTP1Active ? lastTP1 : na, "Last TP1", color=color.new(color.green, 30), style=plot.style_linebr)
plot(showTradeLevels and visTP2Active ? lastTP2 : na, "Last TP2", color=color.new(color.green, 20), style=plot.style_linebr)
plot(showTradeLevels and visTP3Active ? lastTP3 : na, "Last TP3", color=color.new(color.green, 10), style=plot.style_linebr)
plot(showTradeLevels and visTP4Active ? lastTP4 : na, "Last TP4", color=color.new(color.lime, 0), linewidth=2, style=plot.style_linebr)
plot(showTradeLevels and visLiqActive ? lastLiqTP : na, "Liquidity Target Proxy", color=color.new(color.yellow, 0), linewidth=2, style=plot.style_linebr)

// Process hits AFTER plotting, so the touched level is still drawn on the hit
// candle and disappears starting from the next candle.
// The signal bar itself is excluded because the plan is created at its close.
if lastDir != 0 and not na(lastSignalBar) and bar_index > lastSignalBar
    _initialSlHit = visInitialSLActive and not na(lastSL) and (lastDir == 1 ? low <= lastSL : high >= lastSL)
    // BE becomes actionable only after the TP1 activation candle. OHLC data cannot
    // tell whether a revisit to Entry happened before or after TP1 within that same bar.
    _beSlHit = visManagedSLActive and beActive and not na(beActivatedBar) and bar_index > beActivatedBar and (lastDir == 1 ? low <= lastEntry : high >= lastEntry)
    _managedSlHit = _initialSlHit or _beSlHit
    _tp1Hit = visTP1Active and not na(lastTP1) and (lastDir == 1 ? high >= lastTP1 : low <= lastTP1)
    _tp2Hit = visTP2Active and not na(lastTP2) and (lastDir == 1 ? high >= lastTP2 : low <= lastTP2)
    _tp3Hit = visTP3Active and not na(lastTP3) and (lastDir == 1 ? high >= lastTP3 : low <= lastTP3)
    _tp4Hit = visTP4Active and not na(lastTP4) and (lastDir == 1 ? high >= lastTP4 : low <= lastTP4)
    _liqHit = visLiqActive and not na(lastLiqTP) and (lastDir == 1 ? high >= lastLiqTP : low <= lastLiqTP)

    // Conservative handling for a candle that contains both SL and TP:
    // the SL closes the displayed trade plan and all remaining targets stop.
    if _managedSlHit
        beActive := false
        beActivatedBar := na
        visInitialSLActive := false
        visManagedSLActive := false
        visTP1Active := false
        visTP2Active := false
        visTP3Active := false
        visTP4Active := false
        visLiqActive := false
    else
        // TP1 activates BE in the management logic above. The original SL is
        // no longer the active stop, so retire only the initial-SL line.
        if _tp1Hit
            visTP1Active := false
            visInitialSLActive := false
        if _tp2Hit
            visTP2Active := false
        if _tp3Hit
            visTP3Active := false
        if _tp4Hit
            beActive := false
            beActivatedBar := na
            visTP4Active := false
            visInitialSLActive := false
            visManagedSLActive := false
            visTP1Active := false
            visTP2Active := false
            visTP3Active := false
            visLiqActive := false
        else if _liqHit
            visLiqActive := false

// ─────────────────────────────────────────────────────────────────────────────
// DASHBOARD
// ─────────────────────────────────────────────────────────────────────────────
f_dashboardPosition(_p) =>
    _p == "Top Left" ? position.top_left :
     _p == "Bottom Right" ? position.bottom_right :
     _p == "Bottom Left" ? position.bottom_left :
     _p == "Middle Right" ? position.middle_right :
     _p == "Middle Left" ? position.middle_left : position.top_right

var table dash = table.new(f_dashboardPosition(dashboardPosition), 2, 60,
     bgcolor=color.new(color.black, dashboardBgTransparency),
     frame_color=color.new(color.gray, 35), frame_width=1,
     border_color=color.new(color.gray, 55), border_width=1)

if barstate.islast
    table.clear(dash, 0, 0, 1, 59)

    if showDashboard
        _cellBg = color.new(color.black, dashboardBgTransparency)
        _labelBg = color.new(color.gray, math.min(100, dashboardBgTransparency + 18))
        _txt = color.white
        _muted = color.new(color.white, 12)
        _chartState = chartBull ? 1 : chartBear ? -1 : 0
        int _row = 0

        table.cell(dash, 0, _row, "WT ALL SETUPS", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.small)
        table.cell(dash, 1, _row, "v1.9.0", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.small)
        _row += 1

        _profileTxt = activeProfile + " | " + midTf + "/" + htfTf
        table.cell(dash, 0, _row, "TF PROFILE", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, _profileTxt, text_color=_txt, bgcolor=profileManual ? color.new(color.gray, 74) : color.new(color.blue, 68))
        _row += 1

        table.cell(dash, 0, _row, "HTF " + htfTf, text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, f_stateText(htfState), text_color=_txt, bgcolor=f_stateColor(htfState))
        _row += 1

        table.cell(dash, 0, _row, "Trend " + midTf, text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, f_stateText(midState), text_color=_txt, bgcolor=f_stateColor(midState))
        _row += 1

        table.cell(dash, 0, _row, "Chart trend", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, f_stateText(_chartState), text_color=_txt, bgcolor=f_stateColor(_chartState))
        _row += 1

        table.cell(dash, 0, _row, "Market Regime", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, marketRegime, text_color=_txt, bgcolor=f_regimeColor(marketRegime))
        _row += 1

        _adaptivePctTxt = adaptiveCore ? "V" + str.tostring(volumePctRank, "#") + " / A" + str.tostring(adxPctRank, "#") + " / ATR" + str.tostring(atrPctRank, "#") : "OFF"
        table.cell(dash, 0, _row, "Percentiles", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, _adaptivePctTxt, text_color=_txt, bgcolor=adaptiveCore ? color.new(color.blue, 78) : _cellBg)
        _row += 1

        table.cell(dash, 0, _row, "Volume", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, str.tostring(volRatio, "#.##") + "x | P" + str.tostring(volumePctRank, "#"), text_color=_txt, bgcolor=adaptiveCore ? (volumePctRank >= adaptiveScoreVolumePct ? color.new(color.green, 72) : _cellBg) : (volRatio >= scoreVolMin ? color.new(color.green, 72) : _cellBg))
        _row += 1

        table.cell(dash, 0, _row, "ADX", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, str.tostring(adx, "#.0") + " | P" + str.tostring(adxPctRank, "#"), text_color=_txt, bgcolor=adaptiveCore ? (adx >= adaptiveAdxFloor and adxPctRank >= adaptiveTrendAdxPct ? color.new(color.green, 72) : _cellBg) : (adx >= scoreAdxMin ? color.new(color.green, 72) : _cellBg))
        _row += 1

        table.cell(dash, 0, _row, "ATR", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, str.tostring(atrPctOfPrice, "#.##") + "% | P" + str.tostring(atrPctRank, "#"), text_color=_txt, bgcolor=atrPctRank >= adaptiveExpansionAtrPct ? color.new(color.blue, 76) : atrPctRank <= adaptiveCompressionAtrPct ? color.new(color.yellow, 76) : _cellBg)
        _row += 1

        table.cell(dash, 0, _row, "Compression", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, squeezeNow ? "YES" : "NO", text_color=_txt, bgcolor=squeezeNow ? color.new(color.yellow, 65) : _cellBg)
        _row += 1

        table.cell(dash, 0, _row, "Liquidity", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, (liquidityAbove ? "↑ " : "") + (liquidityBelow ? "↓" : "—"), text_color=_txt, bgcolor=(liquidityAbove or liquidityBelow) ? color.new(color.yellow, 70) : _cellBg)
        _row += 1

        _t2LogicTxt = t2SignalMode + " | wait " + (t2LongAwaitRetest ? "L" : "") + (t2ShortAwaitRetest ? "S" : "") + (not t2LongAwaitRetest and not t2ShortAwaitRetest ? "—" : "")
        table.cell(dash, 0, _row, "T2 Logic", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, _t2LogicTxt, text_color=_txt, bgcolor=(t2LongAwaitRetest or t2ShortAwaitRetest) ? color.new(color.yellow, 72) : _cellBg)
        _row += 1

        _t3StateL = t3LongState == 1 ? "SWEEP" : t3LongState == 2 ? "ZONE" : "WAIT"
        _t3StateS = t3ShortState == 1 ? "SWEEP" : t3ShortState == 2 ? "ZONE" : "WAIT"
        table.cell(dash, 0, _row, "T3 Sequence L/S", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, _t3StateL + " / " + _t3StateS, text_color=_txt, bgcolor=(t3LongState != 0 or t3ShortState != 0) ? color.new(color.aqua, 76) : _cellBg)
        _row += 1

        table.cell(dash, 0, _row, "T4 Exhaust L/S", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, (t4LongExhausted ? "YES" : "NO") + " / " + (t4ShortExhausted ? "YES" : "NO"), text_color=_txt, bgcolor=(t4LongExhausted or t4ShortExhausted) ? color.new(color.red, 68) : color.new(color.green, 78))
        _row += 1

        table.cell(dash, 0, _row, "T1 PB depth", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, str.tostring(t1LongPullbackDepthAtr, "#.##") + " ATR", text_color=_txt, bgcolor=(t1LongDepthOk or t1ShortDepthOk) ? color.new(color.green, 78) : _cellBg)
        _row += 1

        table.cell(dash, 0, _row, "T1Q L / S", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, str.tostring(t1QLong) + " / " + str.tostring(t1QShort) + "  ≥" + str.tostring(t1QualityMin), text_color=_txt, bgcolor=f_qualityColor(math.max(t1QLong, t1QShort)))
        _row += 1

        table.cell(dash, 0, _row, "T2Q L / S", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, str.tostring(t2QLong) + " / " + str.tostring(t2QShort) + "  ≥" + str.tostring(t2QualityMin), text_color=_txt, bgcolor=f_qualityColor(math.max(t2QLong, t2QShort)))
        _row += 1

        table.cell(dash, 0, _row, "T3Q L / S", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, str.tostring(t3QLong) + " / " + str.tostring(t3QShort) + "  ≥" + str.tostring(t3QualityMin), text_color=_txt, bgcolor=f_qualityColor(math.max(t3QLong, t3QShort)))
        _row += 1

        table.cell(dash, 0, _row, "T4Q L / S", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, str.tostring(t4QLong) + " / " + str.tostring(t4QShort) + "  ≥" + str.tostring(t4QualityMin), text_color=_txt, bgcolor=f_qualityColor(math.max(t4QLong, t4QShort)))
        _row += 1

        table.cell(dash, 0, _row, "Score L / S", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, str.tostring(longScore) + " / " + str.tostring(shortScore), text_color=_txt, bgcolor=math.max(longScore, shortScore) >= minScore ? color.new(color.green, 74) : _cellBg)
        _row += 1

        table.cell(dash, 0, _row, "BTC / Mgmt", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, (useBtcFilter ? f_stateText(btcState) : "OFF") + (beActive ? " | BE" : ""), text_color=_txt, bgcolor=beActive ? color.new(color.aqua, 68) : (useBtcFilter ? f_stateColor(btcState) : _cellBg))
        _row += 1

        table.cell(dash, 0, _row, "Alerts", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, enableDynamicAlerts ? "DYNAMIC ON" : "NAMED ONLY", text_color=_txt, bgcolor=enableDynamicAlerts ? color.new(color.green, 68) : color.new(color.orange, 72))
        _row += 1

        _eqDash = na(entryQuality) ? "—" : str.tostring(entryQuality, "#.0") + " / 100"
        _moveDash = na(_moveR) ? "—" : (_moveR >= 0 ? "+" : "") + str.tostring(_moveR, "#.##") + "R"
        _rrDash = na(_rrToLiq) ? "—" : str.tostring(_rrToLiq, "#.##")
        _posDash = na(lastPositionUsdt) ? "—" : str.tostring(lastPositionUsdt, "#") + " USDT"

        table.cell(dash, 0, _row, "ENTRY QUALITY", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, _eqDash, text_color=_txt, bgcolor=f_qualityColor(entryQuality))
        _row += 1

        table.cell(dash, 0, _row, "ACTION", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, entryAction, text_color=_txt, bgcolor=f_actionColor(entryAction))
        _row += 1

        table.cell(dash, 0, _row, "ΔEntry / RR→LIQ", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, _moveDash + " / " + _rrDash, text_color=_txt, bgcolor=_cellBg)
        _row += 1

        table.cell(dash, 0, _row, "Position / Risk", text_color=_muted, bgcolor=_labelBg)
        table.cell(dash, 1, _row, _posDash + " / " + str.tostring(riskUsdt, "#.##"), text_color=_txt, bgcolor=_cellBg)
        _row += 1

        if useBrokeCorrelation
            _brokeState = not brokeDataValid ? "SOURCE ERROR" : brokeDir == 1 ? "LONG" : brokeDir == -1 ? "SHORT" : "NO SETUP"
            _brokeQ = not brokeDataValid ? "Select WT Bridge" : "AVG " + str.tostring(brokeAvgSrc, "#") + " | EX " + str.tostring(brokeExecutionSrc, "#") + " | MAE " + str.tostring(brokeMaeSrc, "#")
            _brokeBg = not brokeDataValid ? color.new(color.red, 58) : _brokeDirAgree and _brokeSetupQualityPass ? color.new(color.green, 62) : _brokeDirConflict ? color.new(color.red, 62) : color.new(color.orange, 68)
            table.cell(dash, 0, _row, "BROKE " + brokeMode, text_color=_muted, bgcolor=_labelBg)
            table.cell(dash, 1, _row, _brokeState, text_color=_txt, bgcolor=_brokeBg)
            _row += 1
            table.cell(dash, 0, _row, "Broke Quality", text_color=_muted, bgcolor=_labelBg)
            table.cell(dash, 1, _row, _brokeQ, text_color=_txt, bgcolor=_brokeBg)
            _row += 1

        if researchMode
            _periodTxt = researchPeriodMode == "Days" ? str.tostring(researchDays) + "d" : str.tostring(researchBars) + " bars"
            _allocTxt = str.tostring(researchF1 * 100.0, "#") + "/" + str.tostring(researchF2 * 100.0, "#") + "/" + str.tostring(researchF3 * 100.0, "#") + "/" + str.tostring(researchF4 * 100.0, "#") + "%"
            _beTxt = researchMoveToBE ? "BE@TP1" : "INIT SL"
            _entryModeTxt = researchEntryMode == "ENTER NOW" ? "ENTER" : "SETUP"

            table.cell(dash, 0, _row, "RESEARCH", text_color=color.white, bgcolor=color.new(color.blue, 55), text_size=size.small)
            table.cell(dash, 1, _row, _periodTxt + " | " + _entryModeTxt + " | " + _beTxt + " | " + _allocTxt, text_color=color.white, bgcolor=color.new(color.blue, 55), text_size=size.small)
            _row += 1

            for _ri = 0 to 3
                _name = _ri == 0 ? "T1" : _ri == 1 ? "T2" : _ri == 2 ? "T3" : "T4"
                _closed = array.get(rClosed, _ri)
                _wins = array.get(rWins, _ri)
                _losses = array.get(rLosses, _ri)
                _bes = array.get(rBreakevens, _ri)
                _excluded = array.get(rExcluded, _ri)
                _totalR = array.get(rTotalR, _ri)
                _gp = array.get(rGrossProfitR, _ri)
                _gl = array.get(rGrossLossR, _ri)
                _wr = f_researchWr(_wins, _closed)
                _exp = f_researchAvg(_totalR, _closed)
                _pf = f_researchPf(_gp, _gl)
                _avgWin = f_researchAvg(array.get(rWinRSum, _ri), _wins)
                _avgLoss = f_researchAvg(array.get(rLossRSum, _ri), _losses)
                _activeTxt = array.get(rActive, _ri) ? " +1" : ""
                _wrTxt = na(_wr) ? "—" : str.tostring(_wr, "#.0") + "%"
                _pfTxt = na(_pf) ? "—" : _pf >= 999.0 ? "∞" : str.tostring(_pf, "#.##")

                _line1 = "WR " + _wrTxt + " | n=" + str.tostring(_closed) + _activeTxt + " | BEtr=" + str.tostring(_bes)
                _line2 = "E " + f_fmtR(_exp) + " | PF " + _pfTxt + " | W/L " + f_fmtR(_avgWin) + "/" + f_fmtR(_avgLoss)

                table.cell(dash, 0, _row, _name + " PERF", text_color=_muted, bgcolor=_labelBg)
                table.cell(dash, 1, _row, _line1, text_color=_txt, bgcolor=f_researchColor(_exp))
                _row += 1
                table.cell(dash, 0, _row, _name + " R", text_color=_muted, bgcolor=_labelBg)
                table.cell(dash, 1, _row, _line2, text_color=_txt, bgcolor=f_researchColor(_exp))
                _row += 1

                if researchDashboardDetail == "Full"
                    _hitTxt = "TP " + str.tostring(array.get(rTp1Hits, _ri)) + "/" + str.tostring(array.get(rTp2Hits, _ri)) + "/" + str.tostring(array.get(rTp3Hits, _ri)) + "/" + str.tostring(array.get(rTp4Hits, _ri)) + " | SL " + str.tostring(array.get(rSlHits, _ri)) + " | BE " + str.tostring(array.get(rBeHits, _ri)) + " | X " + str.tostring(_excluded)
                    table.cell(dash, 0, _row, _name + " HITS", text_color=_muted, bgcolor=_labelBg)
                    table.cell(dash, 1, _row, _hitTxt, text_color=_txt, bgcolor=_cellBg)
                    _row += 1

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────
// Use edge-triggered events so a persistent T1 qualification does not send the
// same alert again on every consecutive bar. T2/T3/T4 are already pulse-like,
// but edge detection is applied consistently to every setup.
alertT1Long  = eventT1Long
alertT1Short = eventT1Short
alertT2Long  = eventT2Long
alertT2Short = eventT2Short
alertT3Long  = eventT3Long
alertT3Short = eventT3Short
alertT4Long  = eventT4Long
alertT4Short = eventT4Short

alertAnyLong  = alertT1Long or alertT2Long or alertT3Long or alertT4Long
alertAnyShort = alertT1Short or alertT2Short or alertT3Short or alertT4Short

// Resolve the rare case when both directions qualify on the same bar.
// Only the side with the higher score is emitted by the combined/dynamic alert.
bool fireLongAlert = alertAnyLong
bool fireShortAlert = alertAnyShort
if fireLongAlert and fireShortAlert
    if longScore >= shortScore
        fireShortAlert := false
    else
        fireLongAlert := false

alertAnySignal = fireLongAlert or fireShortAlert

// Named alert conditions. Select one of these explicitly in TradingView's
// Create Alert dialog if you do NOT use "Any alert() function call".
alertcondition(alertT1Long,  "WT T1 LONG",  "WT: T1 EMA Pullback LONG | {{ticker}} | TF={{interval}} | Close={{close}}")
alertcondition(alertT1Short, "WT T1 SHORT", "WT: T1 EMA Pullback SHORT | {{ticker}} | TF={{interval}} | Close={{close}}")
alertcondition(alertT2Long,  "WT T2 LONG",  "WT: T2 Breakout/Compression LONG | {{ticker}} | TF={{interval}} | Close={{close}}")
alertcondition(alertT2Short, "WT T2 SHORT", "WT: T2 Breakout/Compression SHORT | {{ticker}} | TF={{interval}} | Close={{close}}")
alertcondition(alertT3Long,  "WT T3 LONG",  "WT: T3 SMC/Liquidity LONG | {{ticker}} | TF={{interval}} | Close={{close}}")
alertcondition(alertT3Short, "WT T3 SHORT", "WT: T3 SMC/Liquidity SHORT | {{ticker}} | TF={{interval}} | Close={{close}}")
alertcondition(alertT4Long,  "WT T4 LONG",  "WT: T4 Momentum LONG | {{ticker}} | TF={{interval}} | Close={{close}}")
alertcondition(alertT4Short, "WT T4 SHORT", "WT: T4 Momentum SHORT | {{ticker}} | TF={{interval}} | Close={{close}}")
alertcondition(fireLongAlert,  "WT ANY LONG",  "WT: Qualified LONG setup | {{ticker}} | TF={{interval}} | Close={{close}}")
alertcondition(fireShortAlert, "WT ANY SHORT", "WT: Qualified SHORT setup | {{ticker}} | TF={{interval}} | Close={{close}}")
alertcondition(alertAnySignal, "WT ANY SIGNAL", "WT: Qualified LONG/SHORT setup | {{ticker}} | TF={{interval}} | Close={{close}}")
alertcondition(readyToEnterLong, "WT READY TO ENTER LONG", "WT READY TO ENTER LONG | {{ticker}} | TF={{interval}} | Close={{close}}")
alertcondition(readyToEnterShort, "WT READY TO ENTER SHORT", "WT READY TO ENTER SHORT | {{ticker}} | TF={{interval}} | Close={{close}}")
alertcondition(readyToEnterEvent, "WT READY TO ENTER", "WT READY TO ENTER | {{ticker}} | TF={{interval}} | Close={{close}}")

// Dynamic alert() calls. In TradingView create ONE alert with condition:
//   WT Setups -> Any alert() function call
// Dynamic messages contain the actual setup IDs and calculated trade levels.
if enableDynamicAlerts and fireLongAlert and not (suppressSetupAlertWhenReady and enableReadyAlert and readyToEnterLong)
    _setup = (alertT1Long ? "T1 " : "") + (alertT2Long ? "T2-" + t2SignalKindLong + " " : "") + (alertT3Long ? (t3RequireSequence ? "T3-SEQ " : "T3 ") : "") + (alertT4Long ? "T4 " : "")
    _setupQ = (alertT1Long ? "T1:" + str.tostring(t1QLong) + " " : "") + (alertT2Long ? "T2:" + str.tostring(t2QLong) + " " : "") + (alertT3Long ? "T3:" + str.tostring(t3QLong) + " " : "") + (alertT4Long ? "T4:" + str.tostring(t4QLong) + " " : "")
    _sl = alertT1Long ? longStopT1 : alertT2Long ? longStopT2 : alertT3Long ? longStopT3 : longStopT4
    _risk = math.max(close - _sl, syminfo.mintick)
    _tp1 = close + _risk * r1
    _liq = not na(liqTargetLong) ? " | LIQ=" + str.tostring(liqTargetLong, format.mintick) : ""
    _pos = not na(lastPositionUsdt) ? str.tostring(lastPositionUsdt, "#") : "—"
    _eq = not na(entryQuality) ? str.tostring(entryQuality, "#.0") : "—"
    _br = useBrokeCorrelation ? " | Broke=" + (brokeDataValid ? (brokeDir == 1 ? "LONG" : brokeDir == -1 ? "SHORT" : "NONE") + "/" + (_brokeSetupQualityPass ? "PASS" : "WAIT") : "SOURCE_ERR") : ""
    alert("WT LONG | " + syminfo.ticker + " | TF=" + timeframe.period + " | " + _setup + "| SetupQ=" + _setupQ + "| Score=" + str.tostring(longScore) + " | EQ=" + _eq + " | Action=" + entryAction + " | Regime=" + marketRegime + " | Entry=" + str.tostring(close, format.mintick) + " | SL=" + str.tostring(_sl, format.mintick) + " | TP1=" + str.tostring(_tp1, format.mintick) + " | Pos=" + _pos + " USDT | Risk=" + str.tostring(riskUsdt, "#.##") + " USDT" + _liq + _br, alert.freq_once_per_bar)

if enableDynamicAlerts and fireShortAlert and not (suppressSetupAlertWhenReady and enableReadyAlert and readyToEnterShort)
    _setup = (alertT1Short ? "T1 " : "") + (alertT2Short ? "T2-" + t2SignalKindShort + " " : "") + (alertT3Short ? (t3RequireSequence ? "T3-SEQ " : "T3 ") : "") + (alertT4Short ? "T4 " : "")
    _setupQ = (alertT1Short ? "T1:" + str.tostring(t1QShort) + " " : "") + (alertT2Short ? "T2:" + str.tostring(t2QShort) + " " : "") + (alertT3Short ? "T3:" + str.tostring(t3QShort) + " " : "") + (alertT4Short ? "T4:" + str.tostring(t4QShort) + " " : "")
    _sl = alertT1Short ? shortStopT1 : alertT2Short ? shortStopT2 : alertT3Short ? shortStopT3 : shortStopT4
    _risk = math.max(_sl - close, syminfo.mintick)
    _tp1 = close - _risk * r1
    _liq = not na(liqTargetShort) ? " | LIQ=" + str.tostring(liqTargetShort, format.mintick) : ""
    _pos = not na(lastPositionUsdt) ? str.tostring(lastPositionUsdt, "#") : "—"
    _eq = not na(entryQuality) ? str.tostring(entryQuality, "#.0") : "—"
    _br = useBrokeCorrelation ? " | Broke=" + (brokeDataValid ? (brokeDir == 1 ? "LONG" : brokeDir == -1 ? "SHORT" : "NONE") + "/" + (_brokeSetupQualityPass ? "PASS" : "WAIT") : "SOURCE_ERR") : ""
    alert("WT SHORT | " + syminfo.ticker + " | TF=" + timeframe.period + " | " + _setup + "| SetupQ=" + _setupQ + "| Score=" + str.tostring(shortScore) + " | EQ=" + _eq + " | Action=" + entryAction + " | Regime=" + marketRegime + " | Entry=" + str.tostring(close, format.mintick) + " | SL=" + str.tostring(_sl, format.mintick) + " | TP1=" + str.tostring(_tp1, format.mintick) + " | Pos=" + _pos + " USDT | Risk=" + str.tostring(riskUsdt, "#.##") + " USDT" + _liq + _br, alert.freq_once_per_bar)

// Dedicated execution alert. This can fire later than the original T1/T2/T3/T4
// signal, for example after a retest brings ACTION from WAIT RETEST to ENTER NOW.
if enableDynamicAlerts and enableReadyAlert and readyToEnterEvent
    _dirTxt = lastDir == 1 ? "LONG" : "SHORT"
    _setupTxt = (lastSetupT1 ? "T1 " : "") + (lastSetupT2 ? "T2-" + lastT2Kind + " " : "") + (lastSetupT3 ? "T3-SEQ " : "") + (lastSetupT4 ? "T4 " : "")
    _setupQTxt = (lastSetupT1 and not na(lastT1Q) ? "T1:" + str.tostring(lastT1Q) + " " : "") + (lastSetupT2 and not na(lastT2Q) ? "T2:" + str.tostring(lastT2Q) + " " : "") + (lastSetupT3 and not na(lastT3Q) ? "T3:" + str.tostring(lastT3Q) + " " : "") + (lastSetupT4 and not na(lastT4Q) ? "T4:" + str.tostring(lastT4Q) + " " : "")
    _eqTxt = not na(entryQuality) ? str.tostring(entryQuality, "#.0") : "—"
    _rrTxt = not na(_rrToLiq) ? str.tostring(_rrToLiq, "#.##") : "—"
    _moveTxt = not na(_moveR) ? (_moveR > 0 ? "+" : "") + str.tostring(_moveR, "0.00") + "R" : "—"
    _riskNow = math.abs(close - lastSL)
    _stopPctNow = close != 0 ? _riskNow / close : na
    _posNow = not na(_stopPctNow) and _stopPctNow > 0 ? riskUsdt / _stopPctNow : na
    _posTxt = not na(_posNow) ? str.tostring(_posNow, "#") : "—"
    _liqTxt = not na(lastLiqTP) ? str.tostring(lastLiqTP, format.mintick) : "—"
    _brokeTxt = not useBrokeCorrelation ? "OFF" : not brokeDataValid ? "SOURCE_ERR" : (brokeDir == lastDir ? (_brokeSetupQualityPass ? "PASS" : "WAIT") : "CONFLICT")
    alert("WT READY TO ENTER " + _dirTxt + " | " + syminfo.ticker + " | TF=" + timeframe.period + " | " + _setupTxt + "| SetupQ=" + _setupQTxt + "| EQ=" + _eqTxt + " | Regime=" + marketRegime + " | Price=" + str.tostring(close, format.mintick) + " | PlanEntry=" + str.tostring(lastEntry, format.mintick) + " | dEntry=" + _moveTxt + " | SL=" + str.tostring(lastSL, format.mintick) + " | TP1=" + str.tostring(lastTP1, format.mintick) + " | LIQ=" + _liqTxt + " | RRliq=" + _rrTxt + " | Pos=" + _posTxt + " USDT | Risk=" + str.tostring(riskUsdt, "#.##") + " USDT | Broke=" + _brokeTxt, alert.freq_once_per_bar)

