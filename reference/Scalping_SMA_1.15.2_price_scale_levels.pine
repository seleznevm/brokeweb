alertcondition(newShortWatch, title = "Scalping_SMA: S WATCH", message = "S WATCH | {{exchange}}:{{ticker}} | TF={{interval}} | Close={{close}} | Direction=SHORT | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertWatchLabelsCombined and (newLongWatch or newShortWatch), title = "Scalping_SMA: L OR S WATCH", message = "L/S WATCH | {{exchange}}:{{ticker}} | TF={{interval}} | Close={{close}} | Direction={{plot(\"ALERT_DIR\")}} (1=LONG,-1=SHORT) | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertWatchEntry and watchEntryLongSignal, title = "Scalping_SMA: LONG WATCH ENTRY", message = "WATCH ENTRY | {{exchange}}:{{ticker}} | TF={{interval}} | Close={{close}} | Direction=LONG | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertWatchEntry and watchEntryShortSignal, title = "Scalping_SMA: SHORT WATCH ENTRY", message = "WATCH ENTRY | {{exchange}}:{{ticker}} | TF={{interval}} | Close={{close}} | Direction=SHORT | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertWatchEntryCombined and watchEntryAnySignal, title = "Scalping_SMA: LONG OR SHORT WATCH ENTRY", message = "WATCH ENTRY | {{exchange}}:{{ticker}} | TF={{interval}} | Close={{close}} | Direction={{plot(\"ALERT_DIR\")}} (1=LONG,-1=SHORT) | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertMaturedEntry and maturedEntryLongSignal, title = "Scalping_SMA: LONG MATURED PRE-BREAK ENTRY", message = "MATURED PRE-BREAK ENTRY | {{exchange}}:{{ticker}} | TF={{interval}} | Close={{close}} | Direction=LONG | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertArmed and newLongArmed, title = "Scalping_SMA: LONG ARMED", message = "ARMED | {{exchange}}:{{ticker}} | TF={{interval}} | Direction=LONG | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertArmed and newShortArmed, title = "Scalping_SMA: SHORT ARMED", message = "ARMED | {{exchange}}:{{ticker}} | TF={{interval}} | Direction=SHORT | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertEntry and newLongEntry, title = "Scalping_SMA: LONG PINE READY", message = "PINE READY | {{exchange}}:{{ticker}} | TF={{interval}} | Direction=LONG | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}} | CHECK DOM/Tape")
alertcondition(alertEntry and newShortEntry, title = "Scalping_SMA: SHORT PINE READY", message = "PINE READY | {{exchange}}:{{ticker}} | TF={{interval}} | Direction=SHORT | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}} | CHECK DOM/Tape")
alertcondition(alertBreak and newLongBreakout, title = "Scalping_SMA: LONG BREAKOUT", message = "BREAKOUT | {{exchange}}:{{ticker}} | TF={{interval}} | Direction=LONG | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertBreak and newShortBreakdown, title = "Scalping_SMA: SHORT BREAKDOWN", message = "BREAKDOWN | {{exchange}}:{{ticker}} | TF={{interval}} | Direction=SHORT | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertTarget and longT1Hit, title = "Scalping_SMA: LONG T1 HIT", message = "TP HIT | {{exchange}}:{{ticker}} | TF={{interval}} | Direction=LONG | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertTarget and shortT1Hit, title = "Scalping_SMA: SHORT T1 HIT", message = "TP HIT | {{exchange}}:{{ticker}} | TF={{interval}} | Direction=SHORT | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertArmedLost and longArmedLost, title = "Scalping_SMA: LONG ARMED LOST", message = "ARMED LOST | {{exchange}}:{{ticker}} | TF={{interval}} | Direction=LONG | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertArmedLost and shortArmedLost, title = "Scalping_SMA: SHORT ARMED LOST", message = "ARMED LOST | {{exchange}}:{{ticker}} | TF={{interval}} | Direction=SHORT | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertBounceWatch and newBounceLong, title = "Scalping_SMA: LONG BOUNCE WATCH", message = "BOUNCE WATCH | {{exchange}}:{{ticker}} | TF={{interval}} | Direction=LONG | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertBounceWatch and newBounceShort, title = "Scalping_SMA: SHORT BOUNCE WATCH", message = "BOUNCE WATCH | {{exchange}}:{{ticker}} | TF={{interval}} | Direction=SHORT | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertAvgSetup70 and avgSetup70Signal, title = "Scalping_SMA: AVG SETUP >= 70 REALTIME", message = "AVG SETUP REALTIME CROSS >= 70 | {{exchange}}:{{ticker}} | TF={{interval}} | Close={{close}} | Direction={{plot(\"ALERT_DIR\")}} (1=LONG,-1=SHORT) | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertExecutionQuality65 and execution65Signal, title = "Scalping_SMA: EXECUTION QUALITY >= 65 REALTIME", message = "EXECUTION QUALITY REALTIME CROSS >= 65 | {{exchange}}:{{ticker}} | TF={{interval}} | Close={{close}} | Direction={{plot(\"ALERT_DIR\")}} (1=LONG,-1=SHORT) | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertActivePlanHealth and activePlanExitSignal, title = "Scalping_SMA: ACTIVE PLAN EXIT / ABORT", message = "ACTIVE PLAN EXIT / ABORT | {{exchange}}:{{ticker}} | TF={{interval}} | Close={{close}} | Direction={{plot(\"ALERT_DIR\")}} | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertActivePlanHealth and activePlanDegradedSignal, title = "Scalping_SMA: ACTIVE PLAN DEGRADED / NO ADD", message = "ACTIVE PLAN DEGRADED / NO ADD | {{exchange}}:{{ticker}} | TF={{interval}} | Close={{close}} | Direction={{plot(\"ALERT_DIR\")}} | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")
alertcondition(alertActivePlanHealth and addOnAllowedSignal, title = "Scalping_SMA: ADD-ON CONFIRMED", message = "ADD-ON CONFIRMED | fresh breakout/retest + current gates | {{exchange}}:{{ticker}} | TF={{interval}} | Close={{close}} | Direction={{plot(\"ALERT_DIR\")}} | SL={{plot(\"ALERT_SL\")}} | TP={{plot(\"ALERT_TP\")}}")

f_dynamicCore(string side, string eventName, float eventT1) =>
    float eventSL = tradePlanActive ? tradePlanSL : estimatedSL
    float eventRR = tradePlanActive ? tradePlanRR : rrToT1
    string eventPath = tradePlanActive and tradePlanPath != "" ? tradePlanPath : entryPath != "WAIT" ? entryPath : candidateEntryPath
    eventName + " | " + side + " | " + syminfo.tickerid + " | TF=" + timeframe.period +
     " | Close=" + str.tostring(close, format.mintick) + " | AVG=" + (na(avgSetup) ? "n/a" : str.tostring(avgSetup, "#.1")) +
     " | F/E=" + str.tostring(formationQuality, "#") + "/" + str.tostring(executionQuality, "#") +
     " | Ex/MAE=" + str.tostring(exhaustionRisk, "#") + "/" + str.tostring(maeRisk, "#") + " | Path=" + eventPath +
     " | Fresh=" + (gateFreshReadyTrigger ? "Y" : "N") + " | Add=" + (addOnAllowed ? "Y" : "N") +
     " | SL=" + (na(eventSL) ? "n/a" : str.tostring(eventSL, format.mintick)) + " | TP=" + (na(eventT1) ? "n/a" : str.tostring(eventT1, format.mintick)) +
     " | RR=" + (na(eventRR) ? "n/a" : str.tostring(eventRR, "#.##"))

f_dispatchDynamicAlerts() =>
    if enableDynamicAlertMessages
        if alertAvgSetup70 and avgSetup70Signal
            alert(
                 f_dynamicCore(directionLong ? "LONG" : "SHORT", "REALTIME CROSS | AVG SETUP >= 70 | AVG=" + str.tostring(avgSetup, "#.1"), targetT1),
                 alert.freq_once_per_bar
            )
        if alertExecutionQuality65 and execution65Signal
            alert(
                 f_dynamicCore(directionLong ? "LONG" : "SHORT", "REALTIME CROSS | EXECUTION QUALITY >= 65 | EXEC=" + str.tostring(executionQuality, "#.1"), targetT1),
                 alert.freq_once_per_bar
            )
        if alertSetupQualityBronze and setupQualityBronzeSignal
            alert(
                 f_dynamicCore(directionLong ? "LONG" : "SHORT", "CONFIRMED CLOSE | SETUP QUALITY BRONZE >= " + str.tostring(SETUP_QUALITY_BRONZE, "#.#") + "%", targetT1),
                 alert.freq_once_per_bar_close
            )
        if alertSetupQualityStrong and setupQualityStrongSignal
            alert(
                 f_dynamicCore(directionLong ? "LONG" : "SHORT", "CONFIRMED CLOSE | SETUP QUALITY STRONG >= " + str.tostring(SETUP_QUALITY_STRONG, "#.#") + "%", targetT1),
                 alert.freq_once_per_bar_close
            )
        if alertReversalWarning and newLongReversalRisk
            alert(
                 f_dynamicCore("LONG", "REVERSAL RISK SIGNAL", targetT1),
                 alertsOnConfirmedClose ? alert.freq_once_per_bar_close : alert.freq_once_per_bar
            )
        if alertReversalWarning and newShortReversalRisk
            alert(
                 f_dynamicCore("SHORT", "REVERSAL RISK SIGNAL", targetT1),
                 alertsOnConfirmedClose ? alert.freq_once_per_bar_close : alert.freq_once_per_bar
            )
        if alertActivePlanHealth and activePlanExitSignal
            alert(f_dynamicCore(directionLong ? "LONG" : "SHORT", "ACTIVE PLAN EXIT / ABORT", displayedTradePlanT1), alert.freq_once_per_bar_close)
        else if alertActivePlanHealth and activePlanDegradedSignal
            alert(f_dynamicCore(directionLong ? "LONG" : "SHORT", "ACTIVE PLAN DEGRADED / NO ADD", displayedTradePlanT1), alert.freq_once_per_bar_close)
        if alertActivePlanHealth and addOnAllowedSignal
            alert(f_dynamicCore(directionLong ? "LONG" : "SHORT", "ADD-ON CONFIRMED", displayedTradePlanT1), alert.freq_once_per_bar_close)
        if alertWatchEntry and watchEntryLongSignal
            alert(f_dynamicCore("LONG", "WATCH ENTRY | EARLY", targetT1), alert.freq_once_per_bar_close)
        else if alertNewSetup and newLongWatch
            alert(f_dynamicCore("LONG", "L WATCH", targetT1), alert.freq_once_per_bar_close)
        if alertWatchEntry and watchEntryShortSignal
            alert(f_dynamicCore("SHORT", "WATCH ENTRY | EARLY", targetT1), alert.freq_once_per_bar_close)
        else if alertNewSetup and newShortWatch
            alert(f_dynamicCore("SHORT", "S WATCH", targetT1), alert.freq_once_per_bar_close)
        if alertMaturedEntry and maturedEntryLongSignal
            alert(f_dynamicCore("LONG", "MATURED PRE-BREAK ENTRY", targetT1), alert.freq_once_per_bar_close)
        if alertArmed and newLongArmed
            alert(f_dynamicCore("LONG", "ARMED", targetT1), alertsOnConfirmedClose ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)
        if alertArmed and newShortArmed
            alert(f_dynamicCore("SHORT", "ARMED", targetT1), alertsOnConfirmedClose ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)
        if alertEntry and newLongEntry
            alert(f_dynamicCore("LONG", "PINE READY", trackedLongT1), alertsOnConfirmedClose ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)
        if alertEntry and newShortEntry
            alert(f_dynamicCore("SHORT", "PINE READY", trackedShortT1), alertsOnConfirmedClose ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)
        if alertBreak and newLongBreakout
            alert(f_dynamicCore("LONG", "BREAKOUT", targetT1), alertsOnConfirmedClose ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)
        if alertBreak and newShortBreakdown
            alert(f_dynamicCore("SHORT", "BREAKDOWN", targetT1), alertsOnConfirmedClose ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)
        if alertTarget and longT1Hit
            alert(f_dynamicCore("LONG", "TP HIT", trackedLongT1), alertsOnConfirmedClose ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)
        if alertTarget and shortT1Hit
            alert(f_dynamicCore("SHORT", "TP HIT", trackedShortT1), alertsOnConfirmedClose ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)
        if alertArmedLost and longArmedLost
            alert(f_dynamicCore("LONG", "ARMED LOST", targetT1), alertsOnConfirmedClose ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)
        if alertArmedLost and shortArmedLost
            alert(f_dynamicCore("SHORT", "ARMED LOST", targetT1), alertsOnConfirmedClose ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)
        if alertBounceWatch and newBounceLong
            alert(f_dynamicCore("LONG", "BOUNCE WATCH | OBSERVATION", targetT1), alertsOnConfirmedClose ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)
        if alertBounceWatch and newBounceShort
            alert(f_dynamicCore("SHORT", "BOUNCE WATCH | OBSERVATION", targetT1), alertsOnConfirmedClose ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)

    0

f_dispatchDynamicAlerts()
