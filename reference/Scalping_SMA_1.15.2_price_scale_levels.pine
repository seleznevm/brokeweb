// ============================================================================
// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

f_fmtPct(float value) =>
    na(value) ? "n/a" : str.tostring(value, "#.##") + "%"

f_fmtMoney(float value) =>
    string result = "n/a"
    if not na(value)
        if math.abs(value) >= 1000000000.0
            result := "$" + str.tostring(value / 1000000000.0, "#.##") + "B"
        else if math.abs(value) >= 1000000.0
            result := "$" + str.tostring(value / 1000000.0, "#.##") + "M"
        else if math.abs(value) >= 1000.0
            result := "$" + str.tostring(value / 1000.0, "#.##") + "K"
        else
            result := "$" + str.tostring(value, "#.##")
    result

f_check(bool condition) =>
    condition ? "✓" : "✕"

f_filterState(bool enabled, bool condition) =>
    not enabled ? "OFF" : condition ? "✓" : "✕"

f_checkColor(bool condition) =>
    condition ? color.new(color.green, 62) : color.new(color.red, 68)

f_clamp(float value, float lo, float hi) =>
    math.max(lo, math.min(hi, value))

// 0..1 risk ramp: 0 ниже warn, 1 на extreme и выше.
f_riskScale(float value, float warnValue, float extremeValue) =>
    float span = math.max(extremeValue - warnValue, 0.0001)
    value <= warnValue ? 0.0 : value >= extremeValue ? 1.0 : (value - warnValue) / span

f_pct(float numerator, float denominator) =>
    denominator > 0.0 ? f_clamp(numerator / denominator * 100.0, 0.0, 100.0) : 0.0

f_gateMark(int state) =>
    state > 0 ? "✓" : state < 0 ? "✕" : "•"

f_gateColor(int state) =>
    state > 0 ? color.new(color.green, 62) : state < 0 ? color.new(color.red, 62) : color.new(color.orange, 72)

// Decision Panel VALUE traffic-light layer only.
// lowerIsBetter=false: low=RED, mid=YELLOW, high=GREEN (quality metrics).
// lowerIsBetter=true : low=GREEN, mid=YELLOW, high=RED (risk metrics).
// `na` stays neutral through f_dashRow().
f_valueTrafficColor(float value, float midFrom, float badFromOrGoodFrom, bool lowerIsBetter) =>
    na(value) ? color(na) :
     lowerIsBetter ? (value < midFrom ? color.new(color.green, 68) : value < badFromOrGoodFrom ? color.new(color.yellow, 68) : color.new(color.red, 68)) :
     (value < midFrom ? color.new(color.red, 68) : value < badFromOrGoodFrom ? color.new(color.yellow, 68) : color.new(color.green, 68))

// Stable execution-path codes used by path-aware MAE/Core logic.
const int PATH_WAIT = 0
const int PATH_PRE_BREAK = 1
const int PATH_DIRECT_MOMENTUM = 2
const int PATH_COMPRESSION = 3
const int PATH_PROTO_BREAK = 4
const int PATH_BREAKOUT = 5
const int PATH_BREAKOUT_RETEST = 6
const int PATH_BREAKDOWN = 7
const int PATH_BREAKDOWN_RETEST = 8
const int PATH_OPEN_SKY = 9

f_pathCode(string path) =>
    path == "PRE-BREAK" ? PATH_PRE_BREAK :
     path == "DIRECT MOMENTUM" ? PATH_DIRECT_MOMENTUM :
     path == "COMPRESSION" ? PATH_COMPRESSION :
     path == "PROTORGOVKA BREAK" ? PATH_PROTO_BREAK :
     path == "BREAKOUT" ? PATH_BREAKOUT :
     path == "BREAKOUT + RETEST" ? PATH_BREAKOUT_RETEST :
     path == "BREAKDOWN" ? PATH_BREAKDOWN :
     path == "BREAKDOWN + RETEST" ? PATH_BREAKDOWN_RETEST :
     path == "OPEN SKY" ? PATH_OPEN_SKY : PATH_WAIT

// v1.13.1 compile fix: remove duplicate ResearchStats fields and declare summary hit counters locally.
// v1.13.4 signal integrity: actionable path + short trigger + freshness window + RR sanity.
// Research tracker uses UDT references inside arrays to keep compiled code small.
const int RESEARCH_PATHS = 10
const int RESEARCH_WATCH_BASE = 0
const int RESEARCH_MATURED_BASE = RESEARCH_PATHS
const int RESEARCH_PINE_BASE = RESEARCH_PATHS * 2
const int RESEARCH_BRONZE_BASE = RESEARCH_PATHS * 3
const int RESEARCH_STRONG_BASE = RESEARCH_PATHS * 4
const int RESEARCH_BUCKETS = RESEARCH_PATHS * 5

type ResearchSignal
    int signalBar
    int direction
    int bucket
    float entry
    float atr0
    float t1
    float sl
    float mfe
    float mae
    int t1Bar
    int slBar

type ResearchStats
    int n = 0
    float sumMfeAtr = 0.0
    float sumMaeAtr = 0.0
    int t1Hit = 0
    int slHit = 0
    int t1First = 0
    int slFirst = 0
    int ambiguous = 0
    int clean = 0

var array<ResearchSignal> researchActiveSignals = array.new<ResearchSignal>()
var array<ResearchStats> researchStats = array.new<ResearchStats>()
var int researchDropped = 0

f_researchBucket(int familyBase, int pathCode) =>
    familyBase + math.max(PATH_WAIT, math.min(PATH_OPEN_SKY, pathCode))

f_researchAdd(array<ResearchSignal> active, int bucket, int dir, float entryPrice, float atrValue, float t1Value, float slValue, int maxActive) =>
    bool dropped = false
    if array.size(active) >= maxActive
        array.shift(active)
        dropped := true
    array.push(active, ResearchSignal.new(bar_index, dir, bucket, entryPrice, math.max(nz(atrValue, syminfo.mintick), syminfo.mintick), t1Value, slValue, 0.0, 0.0, na, na))
    dropped

f_researchUpdate(array<ResearchSignal> active, array<ResearchStats> stats, int horizonBars, float cleanMfeAtr, float cleanMaeAtr) =>
    int completedNow = 0
    int lastIdx = array.size(active) - 1
    if lastIdx >= 0
        for i = lastIdx to 0
            ResearchSignal rs = array.get(active, i)
            if bar_index > rs.signalBar
                float fav = rs.direction == 1 ? math.max(high - rs.entry, 0.0) : math.max(rs.entry - low, 0.0)
                float adv = rs.direction == 1 ? math.max(rs.entry - low, 0.0) : math.max(high - rs.entry, 0.0)
                rs.mfe := math.max(rs.mfe, fav)
                rs.mae := math.max(rs.mae, adv)
                bool t1Touched = not na(rs.t1) and (rs.direction == 1 ? high >= rs.t1 : low <= rs.t1)
                bool slTouched = not na(rs.sl) and (rs.direction == 1 ? low <= rs.sl : high >= rs.sl)
                if na(rs.t1Bar) and t1Touched
                    rs.t1Bar := bar_index
                if na(rs.slBar) and slTouched
                    rs.slBar := bar_index

            if bar_index - rs.signalBar >= horizonBars
                float mfeAtr = rs.mfe / rs.atr0
                float maeAtr = rs.mae / rs.atr0
                ResearchStats st = array.get(stats, rs.bucket)
                st.n += 1
                st.sumMfeAtr += mfeAtr
                st.sumMaeAtr += maeAtr
                st.t1Hit += not na(rs.t1Bar) ? 1 : 0
                st.slHit += not na(rs.slBar) ? 1 : 0
                bool sameBar = not na(rs.t1Bar) and not na(rs.slBar) and rs.t1Bar == rs.slBar
                st.ambiguous += sameBar ? 1 : 0
                st.t1First += not sameBar and not na(rs.t1Bar) and (na(rs.slBar) or rs.t1Bar < rs.slBar) ? 1 : 0
                st.slFirst += not sameBar and not na(rs.slBar) and (na(rs.t1Bar) or rs.slBar < rs.t1Bar) ? 1 : 0
                st.clean += mfeAtr >= cleanMfeAtr and maeAtr <= cleanMaeAtr ? 1 : 0
                array.set(stats, rs.bucket, st)
                array.remove(active, i)
                completedNow += 1
    completedNow

f_researchSummary(int milestoneBase, int pathCode) =>
    int n = 0
    float sumMfe = 0.0
    float sumMae = 0.0
    int t1Hit = 0
    int slHit = 0
    int t1First = 0
    int slFirst = 0
    int ambiguous = 0
    int clean = 0
    for p = 0 to RESEARCH_PATHS - 1
        ResearchStats st = array.get(researchStats, milestoneBase + p)
        n += st.n
        sumMfe += st.sumMfeAtr
        sumMae += st.sumMaeAtr
        t1Hit += st.t1Hit
        slHit += st.slHit
        t1First += st.t1First
        slFirst += st.slFirst
        ambiguous += st.ambiguous
        clean += st.clean
    float avgMfe = n > 0 ? sumMfe / n : na
    float avgMae = n > 0 ? sumMae / n : na
    int firstN = t1First + slFirst + ambiguous
    float t1HitPct = n > 0 ? t1Hit * 100.0 / n : na
    float slHitPct = n > 0 ? slHit * 100.0 / n : na
    float t1FirstPct = firstN > 0 ? t1First * 100.0 / firstN : na
    float slFirstPct = firstN > 0 ? slFirst * 100.0 / firstN : na
    float cleanPct = n > 0 ? clean * 100.0 / n : na
    ResearchStats pst = array.get(researchStats, milestoneBase + math.max(PATH_WAIT, math.min(PATH_OPEN_SKY, pathCode)))
    float pathMfe = pst.n > 0 ? pst.sumMfeAtr / pst.n : na
    float pathMae = pst.n > 0 ? pst.sumMaeAtr / pst.n : na
    string totalText = "N " + str.tostring(n) + " | MFE " + (na(avgMfe) ? "—" : str.tostring(avgMfe, "#.##") + "A") + " | MAE " + (na(avgMae) ? "—" : str.tostring(avgMae, "#.##") + "A") + " | Clean " + (na(cleanPct) ? "—" : str.tostring(cleanPct, "#") + "%")
    string pathText = "Hit T1/SL " + (na(t1HitPct) ? "—" : str.tostring(t1HitPct, "#")) + "/" + (na(slHitPct) ? "—" : str.tostring(slHitPct, "#")) + "% | First " + (na(t1FirstPct) ? "—" : str.tostring(t1FirstPct, "#")) + "/" + (na(slFirstPct) ? "—" : str.tostring(slFirstPct, "#")) + "% | Path N " + str.tostring(pst.n) + " " + (na(pathMfe) ? "—" : str.tostring(pathMfe, "#.##")) + "/" + (na(pathMae) ? "—" : str.tostring(pathMae, "#.##")) + "A"
    [totalText, pathText]

// Path-specific MAE transforms. Stage 3 keeps MAE orthogonal: only local adverse
// flow belongs here (Counter / Pullback-or-Retest / Deceleration / Failure-Rejection).
// Execution, Context and Exhaustion are separate dimensions and are NOT fed back into MAE.
f_pathMaeAdjusted(int pathCode, float counterScore, float pullbackScore, float decelScore, float failureScore, float retestScore) =>
    float c = counterScore
    float p = pullbackScore
    float d = decelScore
    float f = failureScore
    if pathCode == PATH_BREAKOUT_RETEST
        c := counterScore * 0.60
        p := retestScore
        d := decelScore * 0.35
    else if pathCode == PATH_BREAKDOWN_RETEST
        c := counterScore * 0.70
        p := retestScore
        d := decelScore * 0.50
    else if pathCode == PATH_COMPRESSION
        c := counterScore * 0.80
        p := pullbackScore * 0.45
        d := decelScore * 0.25
    else if pathCode == PATH_PROTO_BREAK
        c := counterScore * 0.80
        p := pullbackScore * 0.70
        d := decelScore * 0.60
    else if pathCode == PATH_BREAKOUT
        p := pullbackScore * 0.85
        d := decelScore * 0.75
    else if pathCode == PATH_BREAKDOWN
        p := pullbackScore * 0.90
    else if pathCode == PATH_OPEN_SKY
        c := counterScore * 0.85
        p := pullbackScore * 0.75
        d := decelScore * 0.65
    [f_clamp(c, 0.0, 100.0), f_clamp(p, 0.0, 100.0), f_clamp(d, 0.0, 100.0), f_clamp(f, 0.0, 100.0)]

f_pathMaeWeights(int pathCode) =>
    float wc = pathCode == PATH_PRE_BREAK ? 0.30 : pathCode == PATH_DIRECT_MOMENTUM ? 0.25 : pathCode == PATH_COMPRESSION ? 0.25 : pathCode == PATH_PROTO_BREAK ? 0.25 : pathCode == PATH_BREAKOUT ? 0.25 : pathCode == PATH_BREAKOUT_RETEST ? 0.20 : pathCode == PATH_BREAKDOWN ? 0.30 : pathCode == PATH_BREAKDOWN_RETEST ? 0.25 : pathCode == PATH_OPEN_SKY ? 0.25 : 0.30
    float wp = pathCode == PATH_PRE_BREAK ? 0.25 : pathCode == PATH_DIRECT_MOMENTUM ? 0.15 : pathCode == PATH_COMPRESSION ? 0.15 : pathCode == PATH_PROTO_BREAK ? 0.15 : pathCode == PATH_BREAKOUT ? 0.15 : pathCode == PATH_BREAKOUT_RETEST ? 0.35 : pathCode == PATH_BREAKDOWN ? 0.15 : pathCode == PATH_BREAKDOWN_RETEST ? 0.35 : pathCode == PATH_OPEN_SKY ? 0.15 : 0.25
    float wd = pathCode == PATH_PRE_BREAK ? 0.20 : pathCode == PATH_DIRECT_MOMENTUM ? 0.30 : pathCode == PATH_COMPRESSION ? 0.10 : pathCode == PATH_PROTO_BREAK ? 0.15 : pathCode == PATH_BREAKOUT ? 0.20 : pathCode == PATH_BREAKOUT_RETEST ? 0.10 : pathCode == PATH_BREAKDOWN ? 0.20 : pathCode == PATH_BREAKDOWN_RETEST ? 0.10 : pathCode == PATH_OPEN_SKY ? 0.25 : 0.20
    float wf = pathCode == PATH_PRE_BREAK ? 0.25 : pathCode == PATH_DIRECT_MOMENTUM ? 0.30 : pathCode == PATH_COMPRESSION ? 0.50 : pathCode == PATH_PROTO_BREAK ? 0.45 : pathCode == PATH_BREAKOUT ? 0.40 : pathCode == PATH_BREAKOUT_RETEST ? 0.35 : pathCode == PATH_BREAKDOWN ? 0.35 : pathCode == PATH_BREAKDOWN_RETEST ? 0.30 : pathCode == PATH_OPEN_SKY ? 0.35 : 0.25
    [wc, wp, wd, wf]

// Persistent Setup State Machine. Values only move forward inside one generation.
const int FSM_NONE = 0
const int FSM_FORMING = 1
const int FSM_WATCH = 2
const int FSM_APPROACH = 3
const int FSM_ARMED = 4
const int FSM_TRIGGERED = 5
const int FSM_RETEST = 6
const int FSM_READY = 7
const int FSM_ACTIVE = 8

f_fsmStateName(int state) =>
    state == FSM_ACTIVE ? "ACTIVE" :
     state == FSM_READY ? "PINE READY" :
     state == FSM_RETEST ? "POST-BREAK RETEST" :
     state == FSM_TRIGGERED ? "TRIGGERED" :
     state == FSM_ARMED ? "ARMED" :
     state == FSM_APPROACH ? "APPROACH" :
     state == FSM_WATCH ? "WATCH" :
     state == FSM_FORMING ? "FORMING" : "NO SETUP"

f_levelQuality(int touches, float prominenceAtr, int ageBars, float clusterWidthAtr) =>
    // Intrinsic structural quality only.
    // Distance to current price and cascade relevance are deliberately excluded:
    // a strong historical zone does not become "weaker" merely because price moved away.
    float touchScore = f_clamp(touches / 4.0, 0.0, 1.0) * 35.0
    float densityScore = (1.0 - f_clamp(clusterWidthAtr / math.max(levelTolAtr * 2.0, 0.05), 0.0, 1.0)) * 20.0
    float prominenceScore = f_clamp(prominenceAtr / 3.0, 0.0, 1.0) * 30.0
    float recencyScore = (1.0 - f_clamp(ageBars / 250.0, 0.0, 1.0)) * 15.0
    f_clamp(touchScore + densityScore + prominenceScore + recencyScore, 0.0, 100.0)


f_scaleMultiplier(string scale) =>
    scale == "$B" ? 1000000000.0 :
     scale == "$M" ? 1000000.0 :
     scale == "$K" ? 1000.0 : 1.0

// Native quote-currency notional for the requested symbol context.
// TradingView volume semantics:
// - quote: volume is already expressed in quote currency;
// - base:  volume is base units, so multiply by price;
// - tick/n/a: there is no defensible dollar-notional conversion from OHLCV alone.
f_quoteNotionalVolume() =>
    syminfo.volumetype == "quote" ? volume :
     syminfo.volumetype == "base" ? volume * hlc3 : na

f_usdLikeQuote(string currencyCode) =>
    currencyCode == "USD" or currencyCode == "USDT" or currencyCode == "USDC" or
     currencyCode == "FDUSD" or currencyCode == "TUSD" or currencyCode == "BUSD" or
     currencyCode == "USDE"


// Auto TF Profile v2 tier selector. Inputs remain the complete Manual profile;
// Auto replaces only time-sensitive windows, not semantic thresholds/scores.
f_profileInt(float tfSec, int p1m, int p5m, int p15m, int p1h, int p4h, int pHigh) =>
    tfSec <= 60.0 ? p1m :
     tfSec <= 300.0 ? p5m :
     tfSec <= 900.0 ? p15m :
     tfSec <= 3600.0 ? p1h :
     tfSec <= 14400.0 ? p4h : pHigh

// Executed in BTC Shock TF context. Move is signed in ATR units.
f_btcShockMetrics(int lookback) =>
    float shockAtr = ta.atr(14)
    float shockVolMa = ta.sma(volume, 20)
    float moveAtr = shockAtr > 0.0 and not na(close[lookback]) ? (close - close[lookback]) / shockAtr : 0.0
    float rangeAtr = shockAtr > 0.0 ? (high - low) / shockAtr : 0.0
    float shockRvol = not na(shockVolMa) and shockVolMa > 0.0 ? volume / shockVolMa : na
    [moveAtr, rangeAtr, shockRvol]


f_trendComponent(float c, float fast, float slow, bool longSide) =>
    longSide ? (c >= fast and fast >= slow ? 100.0 : c >= slow and fast >= slow ? 70.0 : c >= slow ? 50.0 : 15.0) :
     (c <= fast and fast <= slow ? 100.0 : c <= slow and fast <= slow ? 70.0 : c <= slow ? 50.0 : 15.0)

f_htfBaseMetrics(int longLookback, int shortLookback, int athLookback, int athDelay) =>
    float longHi = ta.highest(high, longLookback)
    float longLo = ta.lowest(low, longLookback)
    float longRange = longHi - longLo
    float recentHi = ta.highest(high, shortLookback)
    float recentLo = ta.lowest(low, shortLookback)
    float recentRange = recentHi - recentLo
    float priorRecentLo = ta.lowest(low[shortLookback], shortLookback)
    float pos = longRange > 0.0 ? f_clamp((close - longLo) / longRange, 0.0, 1.0) : 0.5
    float compression = longRange > 0.0 ? f_clamp(recentRange / longRange, 0.0, 2.0) : 1.0
    float higherLowFlag = not na(priorRecentLo) and recentLo > priorRecentLo ? 1.0 : 0.0
    float ema20 = ta.ema(close, 20)
    float priorAth = ta.highest(high[athDelay], athLookback)
    bool rollingEscape = close > ta.highest(high[1], longLookback) or close < ta.lowest(low[1], longLookback)
    float ageProxy = nz(ta.barssince(rollingEscape), longLookback)
    [priorAth, pos, compression, higherLowFlag, close, ema20, ageProxy]

f_rrQualityScore(float rr, float safetyFloor, float qualityReference) =>
    float q = 0.0
    if not na(rr)
        if rr < safetyFloor
            q := 0.0
        else if rr < 1.0
            q := 30.0 + f_clamp((rr - safetyFloor) / math.max(1.0 - safetyFloor, 0.01), 0.0, 1.0) * 25.0
        else if rr < qualityReference
            q := 55.0 + f_clamp((rr - 1.0) / math.max(qualityReference - 1.0, 0.01), 0.0, 1.0) * 20.0
        else if rr < 2.0
            q := 75.0 + f_clamp((rr - qualityReference) / math.max(2.0 - qualityReference, 0.01), 0.0, 1.0) * 15.0
        else
            q := 90.0 + f_clamp((rr - 2.0) / 2.0, 0.0, 1.0) * 10.0
    f_clamp(q, 0.0, 100.0)

// Aggregates ALL available lower-TF bars inside one chart bar.
// Per-intrabar proto states are calculated in the lower-TF context first, then the
// main context combines occupancy, directional price pressure and directional volume.
f_microIntrabarEngine(
     array<bool> longStates,
     array<bool> shortStates,
     array<float> opens,
     array<float> highs,
     array<float> lows,
     array<float> closes,
     array<float> volumes
 ) =>
    int n = array.size(closes)
    float longQuality = 0.0
    float shortQuality = 0.0
    float longHitPct = 0.0
    float shortHitPct = 0.0
    bool lastLongState = false
    bool lastShortState = false

    if n > 0
        int longHits = 0
        int shortHits = 0
        int bullBars = 0
        int bearBars = 0
        float totalVolume = 0.0
        float bullVolume = 0.0
        float bearVolume = 0.0
        float aggregateHigh = na
        float aggregateLow = na
        float firstOpen = na
        float lastClose = na

        for i = 0 to n - 1
            bool stateLong = array.get(longStates, i)
            bool stateShort = array.get(shortStates, i)
            float o = array.get(opens, i)
            float h = array.get(highs, i)
            float l = array.get(lows, i)
            float c = array.get(closes, i)
            float v = nz(array.get(volumes, i), 0.0)

            longHits += stateLong ? 1 : 0
            shortHits += stateShort ? 1 : 0
            bullBars += c > o ? 1 : 0
            bearBars += c < o ? 1 : 0
            totalVolume += math.max(v, 0.0)
            bullVolume += c > o ? math.max(v, 0.0) : 0.0
            bearVolume += c < o ? math.max(v, 0.0) : 0.0
            aggregateHigh := na(aggregateHigh) ? h : math.max(aggregateHigh, h)
            aggregateLow := na(aggregateLow) ? l : math.min(aggregateLow, l)
            firstOpen := i == 0 ? o : firstOpen
            lastClose := c
            lastLongState := stateLong
            lastShortState := stateShort

        longHitPct := longHits / math.max(float(n), 1.0) * 100.0
        shortHitPct := shortHits / math.max(float(n), 1.0) * 100.0

        float aggregateRange = not na(aggregateHigh) and not na(aggregateLow) ? aggregateHigh - aggregateLow : 0.0
        float closePos = aggregateRange > 0.0 and not na(lastClose) ? f_clamp((lastClose - aggregateLow) / aggregateRange, 0.0, 1.0) : 0.5
        float netMoveShare = aggregateRange > 0.0 and not na(lastClose) and not na(firstOpen) ? f_clamp((lastClose - firstOpen) / aggregateRange, -1.0, 1.0) : 0.0
        float bullBarShare = bullBars / math.max(float(n), 1.0) * 100.0
        float bearBarShare = bearBars / math.max(float(n), 1.0) * 100.0
        float bullVolumeShare = totalVolume > 0.0 ? bullVolume / totalVolume * 100.0 : bullBarShare
        float bearVolumeShare = totalVolume > 0.0 ? bearVolume / totalVolume * 100.0 : bearBarShare

        float longDirectionalQuality = f_clamp(
             math.max(netMoveShare, 0.0) * 100.0 * 0.40 +
             closePos * 100.0 * 0.35 +
             bullBarShare * 0.25, 0.0, 100.0)
        float shortDirectionalQuality = f_clamp(
             math.max(-netMoveShare, 0.0) * 100.0 * 0.40 +
             (1.0 - closePos) * 100.0 * 0.35 +
             bearBarShare * 0.25, 0.0, 100.0)

        longQuality := f_clamp(longHitPct * 0.55 + longDirectionalQuality * 0.30 + bullVolumeShare * 0.15, 0.0, 100.0)
        shortQuality := f_clamp(shortHitPct * 0.55 + shortDirectionalQuality * 0.30 + bearVolumeShare * 0.15, 0.0, 100.0)

    [longQuality, shortQuality, longHitPct, shortHitPct, n, lastLongState, lastShortState]

// Базовый decimal step для поиска major round level.
// Примеры при majorRoundMultiplier = 10:
// 3.78 -> base 0.1 -> major step 1.0 -> следующий round = 4.0
// 0.432 -> base 0.01 -> major step 0.1 -> следующий round = 0.5
f_roundStep(float price) =>
    float p = math.abs(price)
    float result = syminfo.mintick
    if not na(p) and p > 0.0
        float exponent = math.floor(math.log10(p)) - 1.0
        result := math.max(math.pow(10.0, exponent), syminfo.mintick)
    result

// Per-intrabar lower-TF proto state. Эти функции выполняются внутри
// request.security_lower_tf(), поэтому их lookback/ATR относятся к Micro TF.
// Затем ВСЕ состояния intrabars текущей chart-свечи агрегируются основным engine.
// Это всё ещё OHLCV proxy: Pine не видит полноценный DOM/Tape.
f_microProtoLong(int lookback, float maxWidthAtr, float acceptancePos) =>
    float microAtr = ta.atr(14)
    float microHigh = ta.highest(high, lookback)
    float microLow = ta.lowest(low, lookback)
    float microRange = microHigh - microLow
    float microWidthAtr = microAtr > 0.0 ? microRange / microAtr : na
    float microPos = microRange > 0.0 ? (close - microLow) / microRange : 0.5
    float microLowMa = ta.sma(low, 3)
    bool structureOk = microLowMa >= microLowMa[2]
    bool widthOk = not na(microWidthAtr) and microWidthAtr <= maxWidthAtr
    bool positionOk = microPos >= acceptancePos
    widthOk and positionOk and structureOk

f_microProtoShort(int lookback, float maxWidthAtr, float acceptancePos) =>
    float microAtr = ta.atr(14)
    float microHigh = ta.highest(high, lookback)
    float microLow = ta.lowest(low, lookback)
    float microRange = microHigh - microLow
    float microWidthAtr = microAtr > 0.0 ? microRange / microAtr : na
    float microPos = microRange > 0.0 ? (close - microLow) / microRange : 0.5
    float microHighMa = ta.sma(high, 3)
    bool structureOk = microHighMa <= microHighMa[2]
    bool widthOk = not na(microWidthAtr) and microWidthAtr <= maxWidthAtr
    bool positionOk = microPos <= acceptancePos
    widthOk and positionOk and structureOk

// Persistent structural zone storage.
// A zone is created/updated ONLY when a confirmed pivot appears. Current Close never
// changes the zone center, raw bounds or padding.
//
// Lifecycle arrays:
// consumedBars < 0  => liquidity is still fresh/ACTIVE.
// consumedBars >= 0 => the outer edge has already been swept; zone can no longer be R/S target.
// brokenBars >= 0   => sweep was accepted beyond the zone -> BROKEN/RETEST.
// failedBars >= 0   => sweep failed/reclaimed -> FAILED SWEEP.
//
// IMPORTANT: new pivots are merged ONLY into fresh ACTIVE zones. A later pivot near a
// consumed zone therefore creates a new structural generation instead of silently
// re-arming already-consumed liquidity.
f_upsertZone(
     array<float> centers,
     array<float> rawMins,
     array<float> rawMaxs,
     array<float> paddings,
     array<int> touchesArr,
     array<int> firstBars,
     array<int> newestBars,
     array<float> prominenceArr,
     array<int> consumedBars,
     array<int> brokenBars,
     array<int> failedBars,
     array<int> breakCounts,
     float pivotPrice,
     int pivotBar,
     float pivotProminenceAtr,
     float pivotAtr,
     float toleranceAtr,
     float paddingAtr,
     int maxZones
 ) =>
    float mergeTolerance = math.max(pivotAtr * toleranceAtr, syminfo.mintick * 2.0)
    float pivotPadding = math.max(pivotAtr * paddingAtr, syminfo.mintick)
    int matchIdx = -1
    float bestDistance = 1000000000000.0
    int n = array.size(centers)

    if n > 0
        for i = 0 to n - 1
            bool fresh = array.get(consumedBars, i) < 0 and array.get(brokenBars, i) < 0 and array.get(failedBars, i) < 0
            if fresh
                float d = math.abs(array.get(centers, i) - pivotPrice)
                if d <= mergeTolerance and d < bestDistance
                    bestDistance := d
                    matchIdx := i

    if matchIdx >= 0
        int oldTouches = array.get(touchesArr, matchIdx)
        int newTouches = oldTouches + 1
        float oldCenter = array.get(centers, matchIdx)
        float oldProm = array.get(prominenceArr, matchIdx)
        array.set(centers, matchIdx, (oldCenter * oldTouches + pivotPrice) / newTouches)
        array.set(rawMins, matchIdx, math.min(array.get(rawMins, matchIdx), pivotPrice))
        array.set(rawMaxs, matchIdx, math.max(array.get(rawMaxs, matchIdx), pivotPrice))
        array.set(paddings, matchIdx, math.max(array.get(paddings, matchIdx), pivotPadding))
        array.set(touchesArr, matchIdx, newTouches)
        array.set(newestBars, matchIdx, math.max(array.get(newestBars, matchIdx), pivotBar))
        array.set(prominenceArr, matchIdx, (oldProm * oldTouches + pivotProminenceAtr) / newTouches)
    else
        array.push(centers, pivotPrice)
        array.push(rawMins, pivotPrice)
        array.push(rawMaxs, pivotPrice)
        array.push(paddings, pivotPadding)
        array.push(touchesArr, 1)
        array.push(firstBars, pivotBar)
        array.push(newestBars, pivotBar)
        array.push(prominenceArr, pivotProminenceAtr)
        array.push(consumedBars, -1)
        array.push(brokenBars, -1)
        array.push(failedBars, -1)
        array.push(breakCounts, 0)
        matchIdx := array.size(centers) - 1

        if array.size(centers) > maxZones
            array.shift(centers)
            array.shift(rawMins)
            array.shift(rawMaxs)
            array.shift(paddings)
            array.shift(touchesArr)
            array.shift(firstBars)
            array.shift(newestBars)
            array.shift(prominenceArr)
            array.shift(consumedBars)
            array.shift(brokenBars)
            array.shift(failedBars)
            array.shift(breakCounts)
            matchIdx := array.size(centers) - 1

    matchIdx

// Confirmed lifecycle updater for one side of the structural map. Arrays are mutable
// reference types in Pine, so moving this logic into a function reduces main-body size
// without changing zone state. Stable event ID = immutable first pivot bar of zone.
f_updateZoneLifecycle(
     array<float> rawMins,
     array<float> rawMaxs,
     array<float> paddings,
     array<int> firstBars,
     array<int> consumedBars,
     array<int> brokenBars,
     array<int> failedBars,
     array<int> breakCounts,
     bool resistanceSide,
     float atrValue,
     int breakConfirmBars,
     int sweepResolveBars
 ) =>
    bool newSweep = false
    bool newBroken = false
    bool newFailed = false
    int newSweepZoneId = na
    int newBrokenZoneId = na
    int newFailedZoneId = na

    if barstate.isconfirmed and atrValue > 0.0
        int n = array.size(rawMins)
        if n > 0
            for i = 0 to n - 1
                float zoneTop = array.get(rawMaxs, i) + array.get(paddings, i)
                float zoneBottom = array.get(rawMins, i) - array.get(paddings, i)
                int consumedBar = array.get(consumedBars, i)
                int brokenBar = array.get(brokenBars, i)
                int failedBar = array.get(failedBars, i)
                int zoneId = array.get(firstBars, i)

                bool sweptNow = resistanceSide ? high > zoneTop : low < zoneBottom
                if consumedBar < 0 and brokenBar < 0 and failedBar < 0 and sweptNow
                    consumedBar := bar_index
                    array.set(consumedBars, i, consumedBar)
                    array.set(breakCounts, i, 0)
                    newSweep := true
                    newSweepZoneId := zoneId

                if consumedBar >= 0 and brokenBar < 0 and failedBar < 0
                    bool hardFailed = resistanceSide ? close < zoneBottom : close > zoneTop
                    if hardFailed
                        array.set(failedBars, i, bar_index)
                        array.set(breakCounts, i, 0)
                        newFailed := true
                        newFailedZoneId := zoneId
                    else
                        bool acceptedBeyond = resistanceSide ? close > zoneTop + atrValue * zoneBreakBufferAtr : close < zoneBottom - atrValue * zoneBreakBufferAtr
                        int c = acceptedBeyond ? array.get(breakCounts, i) + 1 : 0
                        array.set(breakCounts, i, c)
                        if c >= breakConfirmBars
                            array.set(brokenBars, i, bar_index)
                            array.set(breakCounts, i, 0)
                            newBroken := true
                            newBrokenZoneId := zoneId
                        else if bar_index - consumedBar >= sweepResolveBars
                            array.set(failedBars, i, bar_index)
                            array.set(breakCounts, i, 0)
                            newFailed := true
                            newFailedZoneId := zoneId

    [newSweep, newBroken, newFailed, newSweepZoneId, newBrokenZoneId, newFailedZoneId]

// Selects the nearest FRESH structural zone above/below price.
// Consumed, broken and failed-sweep zones are excluded immediately.
// Distance affects only relevance/selection, never intrinsic Level Quality.
f_selectStructuralZone(
     array<float> centers,
     array<float> rawMins,
     array<float> rawMaxs,
     array<float> paddings,
     array<int> touchesArr,
     array<int> firstBars,
     array<int> newestBars,
     array<float> prominenceArr,
     array<int> consumedBars,
     array<int> brokenBars,
     array<int> failedBars,
     bool above,
     float price,
     float atrValue,
     int excludeIndex,
     float minQuality
 ) =>
    float bestCenter = na
    float bestTop = na
    float bestBottom = na
    int bestTouches = 0
    int bestAge = 100000
    float bestProminence = 0.0
    float bestWidthAtr = 100.0
    int bestFirstBar = na
    int bestIndex = -1
    float bestQuality = -1.0
    float bestGap = 1000000000000.0
    int n = array.size(centers)

    if n > 0 and not na(atrValue) and atrValue > 0.0
        for i = 0 to n - 1
            bool fresh = array.get(consumedBars, i) < 0 and array.get(brokenBars, i) < 0 and array.get(failedBars, i) < 0
            if i != excludeIndex and fresh
                float center = array.get(centers, i)
                float rawMin = array.get(rawMins, i)
                float rawMax = array.get(rawMaxs, i)
                float padding = array.get(paddings, i)
                float zoneTop = rawMax + padding
                float zoneBottom = rawMin - padding
                bool sideOk = above ? zoneTop >= price : zoneBottom <= price

                if sideOk
                    int ageBars = bar_index - array.get(newestBars, i)
                    float zoneReferenceAtr = math.max(padding / math.max(zonePaddingAtr, 0.0001), syminfo.mintick)
                    float widthAtr = (rawMax - rawMin) / zoneReferenceAtr
                    float quality = f_levelQuality(array.get(touchesArr, i), array.get(prominenceArr, i), ageBars, widthAtr)

                    if quality >= minQuality
                        float gap = above ? math.max(zoneBottom - price, 0.0) : math.max(price - zoneTop, 0.0)
                        bool better = gap < bestGap - syminfo.mintick or (math.abs(gap - bestGap) <= syminfo.mintick and quality > bestQuality)
                        if better
                            bestGap := gap
                            bestCenter := center
                            bestTop := zoneTop
                            bestBottom := zoneBottom
                            bestTouches := array.get(touchesArr, i)
                            bestAge := ageBars
                            bestProminence := array.get(prominenceArr, i)
                            bestWidthAtr := widthAtr
                            bestFirstBar := array.get(firstBars, i)
                            bestIndex := i
                            bestQuality := quality

    [bestCenter, bestTop, bestBottom, bestTouches, bestAge, bestProminence, bestWidthAtr, bestFirstBar, bestIndex, bestQuality]


if barstate.isfirst
    for i = 0 to RESEARCH_BUCKETS - 1
        array.push(researchStats, ResearchStats.new())

// ============================================================================
// EFFECTIVE TF PROFILE v2 — Auto / Manual
// Auto profiles time-sensitive windows by chart tier while preserving semantic
// thresholds (ATR %, scores, R:R, Quality) and standard ATR/EMA lengths.
// Tiers: 1m / 5m / 15m / 1h / 4h / >4h.
// ============================================================================
float chartTfSeconds = timeframe.in_seconds()
string effectiveTfProfileName =
     tfProfileMode == "Manual" ? "MANUAL" :
     chartTfSeconds <= 60.0 ? "SCALP 1m" :
     chartTfSeconds <= 300.0 ? "SCALP 5m" :
     chartTfSeconds <= 900.0 ? "INTRADAY 15m" :
     chartTfSeconds <= 3600.0 ? "INTRADAY 1h" :
     chartTfSeconds <= 14400.0 ? "SWING 4h" : "SWING+"

string autoMicroTf =
     chartTfSeconds <= 60.0 ? "30S" :
     chartTfSeconds <= 300.0 ? "1" :
     chartTfSeconds <= 900.0 ? "5" :
     chartTfSeconds <= 3600.0 ? "5" :
     chartTfSeconds <= 14400.0 ? "30" : "60"

int autoSetupExpiryMinutes =
     chartTfSeconds <= 60.0 ? 240 :
     chartTfSeconds <= 300.0 ? 480 :
     chartTfSeconds <= 900.0 ? 1440 :
     chartTfSeconds <= 3600.0 ? 2880 :
     chartTfSeconds <= 14400.0 ? 10080 : 20160

string autoBtcShockTf =
     chartTfSeconds <= 60.0 ? "1" :
     chartTfSeconds <= 300.0 ? "1" :
     chartTfSeconds <= 900.0 ? "5" :
     chartTfSeconds <= 3600.0 ? "15" :
     chartTfSeconds <= 14400.0 ? "60" : "240"

string effectiveMicroTf = tfProfileMode == "Auto" ? autoMicroTf : manualMicroTf
int effectiveSetupExpiryMinutes = tfProfileMode == "Auto" ? autoSetupExpiryMinutes : manualSetupExpiryMinutes
string effectiveBtcShockTf = tfProfileMode == "Auto" ? autoBtcShockTf : manualBtcShockTf
int effectiveBtcShockLookback = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 3, 3, 3, 2, 2, 2) : manualBtcShockLookback

// Structural / approach lifecycle.
int effectiveMicroLookback = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 8, 8, 8, 8, 8, 8) : microLookback
int effectivePivotLen = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 3, 3, 3, 3, 2, 2) : pivotLen
int effectiveZoneBreakConfirmBars = zoneBreakConfirmBars
int effectiveZoneSweepResolveBars = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 3, 3, 3, 2, 2, 2) : zoneSweepResolveBars
int effectiveBrokenZoneRetestBars = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 20, 20, 16, 12, 8, 8) : brokenZoneRetestBars
int effectiveTrendSlopeBars = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 5, 5, 4, 3, 3, 3) : trendSlopeBars
int effectiveApproachBars = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 5, 5, 4, 3, 3, 3) : approachBars
int effectiveRejectionLookback = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 3, 3, 3, 2, 2, 2) : rejectionLookback
int effectiveAcceptanceLen = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 12, 12, 10, 8, 6, 6) : acceptanceLen
int effectiveProtoLookback = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 10, 10, 8, 6, 5, 5) : protoLookback
int effectiveAttackLookback = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 16, 16, 12, 10, 8, 8) : attackLookback
int effectiveMaxRetestGapBars = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 8, 8, 6, 4, 3, 3) : maxRetestGapBars
int effectiveCompressionSlopeBars = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 5, 5, 4, 3, 3, 3) : compressionSlopeBars
int effectiveResetLookback = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 30, 30, 24, 18, 12, 12) : resetLookback

// Volume / execution timing.
int effectiveVolMaLen = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 20, 20, 16, 12, 10, 10) : volMaLen
int effectiveVolumeFormationLen = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 8, 8, 6, 5, 4, 4) : volumeFormationLen
int effectiveVolumeBaselineLen = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 30, 30, 24, 20, 16, 16) : volumeBaselineLen
int effectiveContractionLookback = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 12, 12, 10, 8, 6, 6) : contractionLookback
int effectiveActivityVelocityBars = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 3, 3, 3, 2, 2, 2) : activityVelocityBars
int effectiveShortAcceptanceBars = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 4, 4, 3, 2, 2, 2) : shortAcceptanceBars
int effectiveFirstBreakEntryBars = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 2, 2, 2, 1, 1, 1) : firstBreakEntryBars
int effectivePostBreakRetestBars = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 8, 8, 6, 4, 3, 3) : postBreakRetestBars

// Context / risk / geometry windows.
int effectiveFalseBreakLevelLookback = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 12, 12, 10, 8, 6, 6) : falseBreakLevelLookback
int effectiveFalseBreakRiskLookback = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 60, 60, 48, 36, 24, 24) : falseBreakRiskLookback
int effectiveStopLookback = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 12, 12, 10, 8, 6, 6) : stopLookback
int effectiveExhaustionLegLookback = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 12, 12, 10, 8, 6, 6) : exhaustionLegLookback
int effectiveRiskAtrSmoothingLen = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 5, 5, 4, 3, 3, 3) : riskAtrSmoothingLen
int effectiveReversalEvidencePersistenceBars = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 3, 3, 3, 2, 2, 2) : reversalEvidencePersistenceBars
int effectiveRejectionRiskPersistenceBars = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 8, 8, 8, 8, 6, 4) : rejectionRiskPersistenceBars
int effectivePullbackRiskLookback = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 8, 8, 6, 5, 4, 4) : pullbackRiskLookback
int effectiveDecelerationFastBars = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 2, 2, 2, 1, 1, 1) : decelerationFastBars
int effectiveDecelerationSlowBars = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 5, 5, 4, 3, 3, 3) : decelerationSlowBars
int effectiveAccelerationLookback = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 5, 5, 4, 3, 3, 3) : accelerationLookback
int effectiveMinNoPullbackBars = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 4, 4, 3, 2, 2, 2) : minNoPullbackBars
int effectiveFailedBreakRecentBars = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 8, 8, 8, 8, 6, 4) : failedBreakRecentBars
int effectiveDivergenceLookback = tfProfileMode == "Auto" ? f_profileInt(chartTfSeconds, 12, 12, 10, 8, 6, 6) : divergenceLookback

// ============================================================================
// БАЗОВЫЕ МЕТРИКИ
// ============================================================================

float atr = ta.atr(atrLen)
float emaFast = ta.ema(close, emaFastLen)
float emaSlow = ta.ema(close, emaSlowLen)

float volumeSma = ta.sma(volume, effectiveVolMaLen)
float rvol = not na(volumeSma) and volumeSma > 0.0 ? volume / volumeSma : na

// Fixed-time activity + 24h native notional.
// IMPORTANT: f_quoteNotionalVolume() is evaluated inside the requested 1h symbol context.
// For quote-volume feeds it uses volume directly; for base-volume feeds it uses volume×HLC3.
// tick/n/a feeds return na instead of fabricating dollar volume.
[return1h, return6h, return24h, natr1h, volume24hQuoteNotional] = request.security(
     syminfo.tickerid, "60",
     [(close / close[1] - 1.0) * 100.0,
      (close / close[6] - 1.0) * 100.0,
      (close / close[24] - 1.0) * 100.0,
      ta.atr(14) / close * 100.0,
      math.sum(f_quoteNotionalVolume(), 24)],
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off
)

// Convert quote notional to USD. TradingView supplies a currency-rate request for
// non-USD quotes. USD-like stablecoin quotes use 1:1 only as a transparent fallback
// when TradingView does not expose a direct conversion series.
float quoteToUsdRequested = request.currency_rate(syminfo.currency, "USD", ignore_invalid_currency = true)
bool quoteCurrencyUsdLike = f_usdLikeQuote(syminfo.currency)
float quoteToUsdRate =
     syminfo.currency == "USD" ? 1.0 :
     not na(quoteToUsdRequested) ? quoteToUsdRequested :
     quoteCurrencyUsdLike ? 1.0 : na
bool quoteToUsdFallback = syminfo.currency != "USD" and na(quoteToUsdRequested) and quoteCurrencyUsdLike
bool tvVolumeTypeSupported = syminfo.volumetype == "base" or syminfo.volumetype == "quote"
bool tvDollarVolumeKnown = tvVolumeTypeSupported and not na(volume24hQuoteNotional) and not na(quoteToUsdRate)
float volume24hProxy = tvDollarVolumeKnown ? volume24hQuoteNotional * quoteToUsdRate : na

float externalScale = f_scaleMultiplier(lazyExternalScale)
float volume24hUsed =
     lazyMode == "LazyScalp plot" ? lazyExternalSource * externalScale :
     lazyMode == "Manual" ? lazyManualM * 1000000.0 :
     volume24hProxy

bool volume24hKnown =
     lazyMode == "LazyScalp plot" ? not na(lazyExternalSource) :
     lazyMode == "Manual" ? true :
     tvDollarVolumeKnown
bool volume24hOk = volume24hKnown and not na(volume24hUsed) and volume24hUsed >= min24hVolumeM * 1000000.0

// Liquidity Gate: known dollar-volume plus minimum price granularity proxies.
float liquidityTickAtrPct = atr > 0.0 ? syminfo.mintick / atr * 100.0 : na
float liquidityTickPriceBps = close > 0.0 ? syminfo.mintick / close * 10000.0 : na
bool liquidityDollarPass =
     min24hVolumeM <= 0.0 ? true :
     volume24hKnown ? volume24hOk :
     not liquidityRequireKnownDollarVolume
bool liquidityTickAtrPass = na(liquidityTickAtrPct) or liquidityTickAtrPct <= liquidityMaxTickAtrPct
bool liquidityTickPricePass = na(liquidityTickPriceBps) or liquidityTickPriceBps <= liquidityMaxTickPriceBps
bool liquidityGateRaw = liquidityDollarPass and liquidityTickAtrPass and liquidityTickPricePass
bool gateLiquidity = not enableLiquidityGate or liquidityGateRaw
int liquidityGateState = not enableLiquidityGate ? 0 : liquidityGateRaw ? 1 : -1
string liquidityGateReason =
     not enableLiquidityGate ? "OFF" :
     not liquidityDollarPass ? (volume24hKnown ? "$VOL LOW" : "$VOL UNKNOWN") :
     not liquidityTickAtrPass ? "TICK/ATR" :
     not liquidityTickPricePass ? "TICK/PRICE" : "OK"

string tvVolumeConversionText =
     not tvVolumeTypeSupported ? "TV " + syminfo.volumetype + ": $vol n/a" :
     syminfo.volumetype == "quote" ? "TV quote→USD" : "TV base×price→USD"
tvVolumeConversionText := tvVolumeConversionText + (quoteToUsdFallback ? " (" + syminfo.currency + "≈USD)" : "")
string volume24hSourceText = lazyMode == "LazyScalp plot" ? "LazyScalp" : lazyMode == "Manual" ? "Manual USD" : tvVolumeConversionText

bool move24Active = not na(return24h) and math.abs(return24h) >= minMove24
bool move6Active = not na(return6h) and math.abs(return6h) >= minMove6h
bool move1Active = not na(return1h) and math.abs(return1h) >= minMove1h
bool volatilityActive = not na(natr1h) and natr1h >= minNatr1h

int activityCheckCount =
     (move24Active ? 1 : 0) +
     (move6Active ? 1 : 0) +
     (move1Active ? 1 : 0) +
     (volatilityActive ? 1 : 0)

bool inPlay = activityCheckCount >= minActivityChecks

// ============================================================================
// STRUCTURAL PIVOT-ZONES OF LIQUIDITY
// Zones are persistent objects in data: they are created/updated only on confirmed
// pivots. Current price is used ONLY to choose which existing zone is R1/R2/S1/S2.
// ============================================================================

float pivotHigh = ta.pivothigh(high, effectivePivotLen, effectivePivotLen)
float pivotLow  = ta.pivotlow(low, effectivePivotLen, effectivePivotLen)
// History-dependent rolling calculations are evaluated on every bar.
float pivotWindowLow = ta.lowest(low, effectivePivotLen * 2 + 1)
float pivotWindowHigh = ta.highest(high, effectivePivotLen * 2 + 1)
float pivotAtr = nz(atr[effectivePivotLen], atr)

// Persistent resistance structural zones.
var array<float> resZoneCenters = array.new_float()
var array<float> resZoneRawMins = array.new_float()
var array<float> resZoneRawMaxs = array.new_float()
var array<float> resZonePaddings = array.new_float()
var array<int> resZoneTouches = array.new_int()
var array<int> resZoneFirstBars = array.new_int()
var array<int> resZoneNewestBars = array.new_int()
var array<float> resZoneProminence = array.new_float()
var array<int> resZoneConsumedBars = array.new_int()
var array<int> resZoneBrokenBars = array.new_int()
var array<int> resZoneFailedBars = array.new_int()
var array<int> resZoneBreakCounts = array.new_int()

// Persistent support structural zones.
var array<float> supZoneCenters = array.new_float()
var array<float> supZoneRawMins = array.new_float()
var array<float> supZoneRawMaxs = array.new_float()
var array<float> supZonePaddings = array.new_float()
var array<int> supZoneTouches = array.new_int()
var array<int> supZoneFirstBars = array.new_int()
var array<int> supZoneNewestBars = array.new_int()
var array<float> supZoneProminence = array.new_float()
var array<int> supZoneConsumedBars = array.new_int()
var array<int> supZoneBrokenBars = array.new_int()
var array<int> supZoneFailedBars = array.new_int()
var array<int> supZoneBreakCounts = array.new_int()

if not na(pivotHigh)
    int phBar = bar_index - effectivePivotLen
    float phPromAtr = pivotAtr > 0.0 ? math.max(pivotHigh - pivotWindowLow, 0.0) / pivotAtr : 0.0
    f_upsertZone(
         resZoneCenters, resZoneRawMins, resZoneRawMaxs, resZonePaddings,
         resZoneTouches, resZoneFirstBars, resZoneNewestBars, resZoneProminence,
         resZoneConsumedBars, resZoneBrokenBars, resZoneFailedBars, resZoneBreakCounts,
         pivotHigh, phBar, phPromAtr, pivotAtr, levelTolAtr, zonePaddingAtr, maxStructuralZones
    )

if not na(pivotLow)
    int plBar = bar_index - effectivePivotLen
    float plPromAtr = pivotAtr > 0.0 ? math.max(pivotWindowHigh - pivotLow, 0.0) / pivotAtr : 0.0
    f_upsertZone(
         supZoneCenters, supZoneRawMins, supZoneRawMaxs, supZonePaddings,
         supZoneTouches, supZoneFirstBars, supZoneNewestBars, supZoneProminence,
         supZoneConsumedBars, supZoneBrokenBars, supZoneFailedBars, supZoneBreakCounts,
         pivotLow, plBar, plPromAtr, pivotAtr, levelTolAtr, zonePaddingAtr, maxStructuralZones
    )

// -----------------------------------------------------------------------------
// LIQUIDITY LIFECYCLE
//
// ACTIVE:
//   outer edge has never been swept. Zone may be selected as R1/R2/S1/S2.
//
// SWEPT / PENDING:
//   a wick/range crossed the outer edge. Liquidity is CONSUMED IMMEDIATELY and
//   the zone is removed from active R/S selection even if the candle later closes back.
//
// BROKEN / RETEST:
//   after the sweep, confirmed close(s) accept price beyond the outer edge + buffer.
//
// FAILED SWEEP:
//   price reclaims the opposite side of the box, or no acceptance appears within
//   effectiveZoneSweepResolveBars. This is reversal evidence, not a fresh continuation target.
// -----------------------------------------------------------------------------
[newResistanceSweep, newResistanceBroken, newResistanceFailedSweep, newResistanceSweepZoneId, newResistanceBrokenZoneId, newResistanceFailedSweepZoneId] =
     f_updateZoneLifecycle(
         resZoneRawMins, resZoneRawMaxs, resZonePaddings, resZoneFirstBars,
         resZoneConsumedBars, resZoneBrokenBars, resZoneFailedBars, resZoneBreakCounts,
         true, atr, effectiveZoneBreakConfirmBars, effectiveZoneSweepResolveBars)

[newSupportSweep, newSupportBroken, newSupportFailedSweep, newSupportSweepZoneId, newSupportBrokenZoneId, newSupportFailedSweepZoneId] =
     f_updateZoneLifecycle(
         supZoneRawMins, supZoneRawMaxs, supZonePaddings, supZoneFirstBars,
         supZoneConsumedBars, supZoneBrokenBars, supZoneFailedBars, supZoneBreakCounts,
         false, atr, effectiveZoneBreakConfirmBars, effectiveZoneSweepResolveBars)

// Select nearest FRESH structural zones. A swept zone is already excluded here;
// confirmed break is only a classification of consumed liquidity, not the moment
// when the target finally becomes inactive.
[resistance1, resistanceTop1, resistanceBottom1, resistanceTouches1, resistanceAge1, resistanceProminence1, resistanceWidthAtr1, resistanceFirstBar1, resistanceIndex1, resistanceQuality1] =
     f_selectStructuralZone(
         resZoneCenters, resZoneRawMins, resZoneRawMaxs, resZonePaddings,
         resZoneTouches, resZoneFirstBars, resZoneNewestBars, resZoneProminence,
         resZoneConsumedBars, resZoneBrokenBars, resZoneFailedBars,
         true, close, atr, -1, minMapLevelQuality
     )

[resistance2, resistanceTop2, resistanceBottom2, resistanceTouches2, resistanceAge2, resistanceProminence2, resistanceWidthAtr2, resistanceFirstBar2, resistanceIndex2, resistanceQuality2] =
     f_selectStructuralZone(
         resZoneCenters, resZoneRawMins, resZoneRawMaxs, resZonePaddings,
         resZoneTouches, resZoneFirstBars, resZoneNewestBars, resZoneProminence,
         resZoneConsumedBars, resZoneBrokenBars, resZoneFailedBars,
         true, close, atr, resistanceIndex1, minMapLevelQuality
     )

[support1, supportTop1, supportBottom1, supportTouches1, supportAge1, supportProminence1, supportWidthAtr1, supportFirstBar1, supportIndex1, supportQuality1] =
     f_selectStructuralZone(
         supZoneCenters, supZoneRawMins, supZoneRawMaxs, supZonePaddings,
         supZoneTouches, supZoneFirstBars, supZoneNewestBars, supZoneProminence,
         supZoneConsumedBars, supZoneBrokenBars, supZoneFailedBars,
         false, close, atr, -1, minMapLevelQuality
     )

[support2, supportTop2, supportBottom2, supportTouches2, supportAge2, supportProminence2, supportWidthAtr2, supportFirstBar2, supportIndex2, supportQuality2] =
     f_selectStructuralZone(
         supZoneCenters, supZoneRawMins, supZoneRawMaxs, supZonePaddings,
         supZoneTouches, supZoneFirstBars, supZoneNewestBars, supZoneProminence,
         supZoneConsumedBars, supZoneBrokenBars, supZoneFailedBars,
         false, close, atr, supportIndex1, minMapLevelQuality
     )

bool hasResistance = not na(resistance1) and not na(resistanceTop1) and not na(resistanceBottom1)
bool hasSupport = not na(support1) and not na(supportTop1) and not na(supportBottom1)

// Distance is a separate relevance metric to the NEAR EDGE of the fresh zone.
float distanceLongAtr =
     hasResistance and atr > 0.0 ? math.max(resistanceBottom1 - close, 0.0) / atr : na

float distanceShortAtr =
     hasSupport and atr > 0.0 ? math.max(close - supportTop1, 0.0) / atr : na

bool cascadeLong =
     hasResistance and not na(resistance2) and atr > 0.0 and
     resistance2 > resistance1 and (resistance2 - resistance1) / atr <= cascadeMaxSpacingAtr

bool cascadeShort =
     hasSupport and not na(support2) and atr > 0.0 and
     support2 < support1 and (support1 - support2) / atr <= cascadeMaxSpacingAtr

float levelTolerance = atr * levelTolAtr

// Most recent consumed lifecycle zone for visualization.
float recentLifecycleZoneTop = na
float recentLifecycleZoneBottom = na
int recentLifecycleZoneFirstBar = na
int recentLifecycleZoneEventBar = -100000
int recentLifecycleZoneSide = 0   // +1 = former resistance, -1 = former support
int recentLifecycleZoneState = 0  // 1=SWEPT/PENDING, 2=BROKEN/RETEST, 3=FAILED SWEEP

int resLifeN = array.size(resZoneCenters)
if effectiveBrokenZoneRetestBars > 0 and resLifeN > 0
    for i = 0 to resLifeN - 1
        int consumedBar = array.get(resZoneConsumedBars, i)
        int brokenBar = array.get(resZoneBrokenBars, i)
        int failedBar = array.get(resZoneFailedBars, i)
        int eventBar = failedBar >= 0 ? failedBar : brokenBar >= 0 ? brokenBar : consumedBar
        int state = failedBar >= 0 ? 3 : brokenBar >= 0 ? 2 : consumedBar >= 0 ? 1 : 0

        if state > 0 and eventBar >= 0 and bar_index - eventBar <= effectiveBrokenZoneRetestBars and eventBar > recentLifecycleZoneEventBar
            recentLifecycleZoneEventBar := eventBar
            recentLifecycleZoneTop := array.get(resZoneRawMaxs, i) + array.get(resZonePaddings, i)
            recentLifecycleZoneBottom := array.get(resZoneRawMins, i) - array.get(resZonePaddings, i)
            recentLifecycleZoneFirstBar := array.get(resZoneFirstBars, i)
            recentLifecycleZoneSide := 1
            recentLifecycleZoneState := state

int supLifeN = array.size(supZoneCenters)
if effectiveBrokenZoneRetestBars > 0 and supLifeN > 0
    for i = 0 to supLifeN - 1
        int consumedBar = array.get(supZoneConsumedBars, i)
        int brokenBar = array.get(supZoneBrokenBars, i)
        int failedBar = array.get(supZoneFailedBars, i)
        int eventBar = failedBar >= 0 ? failedBar : brokenBar >= 0 ? brokenBar : consumedBar
        int state = failedBar >= 0 ? 3 : brokenBar >= 0 ? 2 : consumedBar >= 0 ? 1 : 0

        if state > 0 and eventBar >= 0 and bar_index - eventBar <= effectiveBrokenZoneRetestBars and eventBar > recentLifecycleZoneEventBar
            recentLifecycleZoneEventBar := eventBar
            recentLifecycleZoneTop := array.get(supZoneRawMaxs, i) + array.get(supZonePaddings, i)
            recentLifecycleZoneBottom := array.get(supZoneRawMins, i) - array.get(supZonePaddings, i)
            recentLifecycleZoneFirstBar := array.get(supZoneFirstBars, i)
            recentLifecycleZoneSide := -1
            recentLifecycleZoneState := state


// ============================================================================
// TREND / КОНТЕКСТ
// ============================================================================

bool bullTrend = emaFast > emaSlow and emaFast > emaFast[effectiveTrendSlopeBars] and close >= emaFast
bool bearTrend = emaFast < emaSlow and emaFast < emaFast[effectiveTrendSlopeBars] and close <= emaFast


[mtfC1, mtfF1, mtfS1] = request.security(syminfo.tickerid, mtfTrendTf1, [close, ta.ema(close, 20), ta.ema(close, 50)], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[mtfC2, mtfF2, mtfS2] = request.security(syminfo.tickerid, mtfTrendTf2, [close, ta.ema(close, 20), ta.ema(close, 50)], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[mtfC3, mtfF3, mtfS3] = request.security(syminfo.tickerid, mtfTrendTf3, [close, ta.ema(close, 20), ta.ema(close, 50)], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[mtfC4, mtfF4, mtfS4] = request.security(syminfo.tickerid, mtfTrendTf4, [close, ta.ema(close, 20), ta.ema(close, 50)], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
float mtfTrendQualityLong = enableMtfTrendQuality ? (f_trendComponent(mtfC1, mtfF1, mtfS1, true) + f_trendComponent(mtfC2, mtfF2, mtfS2, true) + f_trendComponent(mtfC3, mtfF3, mtfS3, true) + f_trendComponent(mtfC4, mtfF4, mtfS4, true)) / 4.0 : 50.0
float mtfTrendQualityShort = enableMtfTrendQuality ? (f_trendComponent(mtfC1, mtfF1, mtfS1, false) + f_trendComponent(mtfC2, mtfF2, mtfS2, false) + f_trendComponent(mtfC3, mtfF3, mtfS3, false) + f_trendComponent(mtfC4, mtfF4, mtfS4, false)) / 4.0 : 50.0

[openSkyPriorHigh, htfBasePosition, htfBaseCompressionRatio, htfBaseHigherLowFlag, htfBaseClose, htfBaseEma20, htfBaseAgeProxy] = request.security(
     syminfo.tickerid, htfBaseTf,
     f_htfBaseMetrics(htfBaseLongLookback, htfBaseShortLookback, openSkyLookback, openSkyReferenceDelayBars),
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
float htfBaseQualityLong = enableHtfBaseQuality ? f_clamp(
     htfBasePosition * 40.0 +
     (1.0 - f_clamp(htfBaseCompressionRatio / 0.65, 0.0, 1.0)) * 30.0 +
     htfBaseHigherLowFlag * 20.0 +
     (htfBaseClose >= htfBaseEma20 ? 10.0 : 0.0), 0.0, 100.0) : 50.0

// ----------------------------------------------------------------------------
// LEVEL QUALITY + LEVEL/DIRECTION LOCK
// Structural zones themselves are persistent. WATCH additionally freezes the active
// zone bounds so even a newly confirmed nearby pivot cannot move the trade's trigger.
// ----------------------------------------------------------------------------
float rawResistance1 = resistance1
float rawResistanceTop1 = resistanceTop1
float rawResistanceBottom1 = resistanceBottom1
float rawResistance2 = resistance2
float rawResistanceTop2 = resistanceTop2
float rawResistanceBottom2 = resistanceBottom2
int rawResistanceFirstBar1 = resistanceFirstBar1
int rawResistanceFirstBar2 = resistanceFirstBar2

float rawSupport1 = support1
float rawSupportTop1 = supportTop1
float rawSupportBottom1 = supportBottom1
float rawSupport2 = support2
float rawSupportTop2 = supportTop2
float rawSupportBottom2 = supportBottom2
int rawSupportFirstBar1 = supportFirstBar1
int rawSupportFirstBar2 = supportFirstBar2

int rawResistanceTouches1 = resistanceTouches1
int rawSupportTouches1 = supportTouches1
bool rawCascadeLong = cascadeLong
bool rawCascadeShort = cascadeShort
float rawDistanceLongAtr = distanceLongAtr
float rawDistanceShortAtr = distanceShortAtr
float rawResistanceQuality = resistanceQuality1
float rawSupportQuality = supportQuality1

float candidateLongInvalidation = ta.lowest(low, effectiveStopLookback) - atr * stopAtrBuffer
float candidateShortInvalidation = ta.highest(high, effectiveStopLookback) + atr * stopAtrBuffer

var int lockedDirection = 0
var float lockedLevel = na
var float lockedZoneTop = na
var float lockedZoneBottom = na
var int lockedZoneFirstBar = na
var int lockedZoneId = na  // stable ID = immutable first pivot bar of the locked R1/S1 zone
var float lockedLevel2 = na
var float lockedZone2Top = na
var float lockedZone2Bottom = na
var int lockedZone2FirstBar = na
var int lockedTouches = 0
var float lockedLevelQuality = na
var float lockedInvalidation = na
var int lockedStartBar = na
var int lockedStartTime = na
var bool lockedCascade = false
var bool lockedOpenSky = false
var bool lockedLiquidityConsumed = false
var int lockedConsumedBar = na
// Break state belongs to the current locked setup generation only.
var int lockedBreakBar = na
var float lockedBreakLevel = na
var int lockedBreakGeneration = na
var bool releaseSetupNextBar = false

if releaseSetupNextBar
    lockedDirection := 0
    lockedLevel := na
    lockedZoneTop := na
    lockedZoneBottom := na
    lockedZoneFirstBar := na
    lockedZoneId := na
    lockedLevel2 := na
    lockedZone2Top := na
    lockedZone2Bottom := na
    lockedZone2FirstBar := na
    lockedTouches := 0
    lockedLevelQuality := na
    lockedInvalidation := na
    lockedStartBar := na
    lockedStartTime := na
    lockedCascade := false
    lockedOpenSky := false
    lockedLiquidityConsumed := false
    lockedConsumedBar := na
    lockedBreakBar := na
    lockedBreakLevel := na
    lockedBreakGeneration := na
    releaseSetupNextBar := false

if lockedDirection != 0
    bool lockExpired = not na(lockedStartTime) and time - lockedStartTime > effectiveSetupExpiryMinutes * 60000
    bool lockBroken = lockedDirection == 1 ? close < lockedInvalidation : close > lockedInvalidation
    if lockExpired or lockBroken
        lockedDirection := 0
        lockedLevel := na
        lockedZoneTop := na
        lockedZoneBottom := na
        lockedZoneFirstBar := na
        lockedZoneId := na
        lockedLevel2 := na
        lockedZone2Top := na
        lockedZone2Bottom := na
        lockedZone2FirstBar := na
        lockedTouches := 0
        lockedLevelQuality := na
        lockedInvalidation := na
        lockedStartBar := na
        lockedStartTime := na
        lockedCascade := false
        lockedOpenSky := false
        lockedLiquidityConsumed := false
        lockedConsumedBar := na
        lockedBreakBar := na
        lockedBreakLevel := na
        lockedBreakGeneration := na

bool previewLong =
     inPlay and gateLiquidity and not na(rawResistance1) and rawResistanceQuality >= minLevelQuality and
     not na(rawDistanceLongAtr) and rawDistanceLongAtr >= 0.0 and rawDistanceLongAtr <= maxWatchDistanceAtr and
     (bullTrend or close >= emaFast)

bool openSkyHistoricalBreak =
     enableOpenSkyMode and na(rawResistance1) and not na(openSkyPriorHigh) and atr > 0.0 and
     close > openSkyPriorHigh and low >= openSkyPriorHigh - atr * openSkyReclaimToleranceAtr
bool previewOpenSkyLong =
     inPlay and gateLiquidity and openSkyHistoricalBreak and
     (bullTrend or mtfTrendQualityLong >= 60.0) and close >= emaFast

bool previewShort =
     inPlay and gateLiquidity and not na(rawSupport1) and rawSupportQuality >= minLevelQuality and
     not na(rawDistanceShortAtr) and rawDistanceShortAtr >= 0.0 and rawDistanceShortAtr <= maxWatchDistanceAtr and
     bearTrend

// Level Quality and Level Relevance are intentionally separate.
// Distance can choose which already-existing structural zone matters now,
// but it can no longer change that zone's intrinsic quality or coordinates.
float longLevelRelevance = not na(rawDistanceLongAtr) ? (1.0 - f_clamp(rawDistanceLongAtr / math.max(maxWatchDistanceAtr, 0.1), 0.0, 1.0)) * 100.0 : 0.0
float shortLevelRelevance = not na(rawDistanceShortAtr) ? (1.0 - f_clamp(rawDistanceShortAtr / math.max(maxWatchDistanceAtr, 0.1), 0.0, 1.0)) * 100.0 : 0.0

float longPreviewRank = rawResistanceQuality + longLevelRelevance * 0.10 + (bullTrend ? 15.0 : 0.0) + (not na(return6h) and return6h > 0 ? 7.0 : 0.0)
float shortPreviewRank = rawSupportQuality + shortLevelRelevance * 0.10 + (bearTrend ? 15.0 : 0.0) + (not na(return6h) and return6h < 0 ? 7.0 : 0.0)
float openSkyPreviewRank = 70.0 + mtfTrendQualityLong * 0.15 + htfBaseQualityLong * 0.10 + (not na(return6h) and return6h > 0 ? 5.0 : 0.0)

if lockedDirection == 0 and previewOpenSkyLong and (not previewShort or openSkyPreviewRank >= shortPreviewRank)
    float openSkyPad = math.max(atr * zonePaddingAtr, syminfo.mintick)
    lockedDirection := 1
    lockedLevel := openSkyPriorHigh
    lockedZoneTop := openSkyPriorHigh + openSkyPad
    lockedZoneBottom := openSkyPriorHigh - openSkyPad
    lockedZoneFirstBar := bar_index
    lockedZoneId := bar_index
    lockedLevel2 := na
    lockedZone2Top := na
    lockedZone2Bottom := na
    lockedZone2FirstBar := na
    lockedTouches := 1
    lockedLevelQuality := f_clamp(60.0 + mtfTrendQualityLong * 0.25 + htfBaseQualityLong * 0.15, 0.0, 100.0)
    lockedInvalidation := candidateLongInvalidation
    lockedStartBar := bar_index
    lockedStartTime := time
    lockedCascade := false
    lockedOpenSky := true
    lockedLiquidityConsumed := true
    lockedConsumedBar := bar_index
    lockedBreakBar := bar_index
    lockedBreakLevel := lockedZoneTop
    lockedBreakGeneration := lockedStartBar
else if lockedDirection == 0 and (previewLong or previewShort)
    bool chooseLong = previewLong and (not previewShort or longPreviewRank >= shortPreviewRank)
    lockedDirection := chooseLong ? 1 : -1
    lockedLevel := chooseLong ? rawResistance1 : rawSupport1
    lockedZoneTop := chooseLong ? rawResistanceTop1 : rawSupportTop1
    lockedZoneBottom := chooseLong ? rawResistanceBottom1 : rawSupportBottom1
    lockedZoneFirstBar := chooseLong ? rawResistanceFirstBar1 : rawSupportFirstBar1
    lockedZoneId := lockedZoneFirstBar
    lockedLevel2 := chooseLong ? rawResistance2 : rawSupport2
    lockedZone2Top := chooseLong ? rawResistanceTop2 : rawSupportTop2
    lockedZone2Bottom := chooseLong ? rawResistanceBottom2 : rawSupportBottom2
    lockedZone2FirstBar := chooseLong ? rawResistanceFirstBar2 : rawSupportFirstBar2
    lockedTouches := chooseLong ? rawResistanceTouches1 : rawSupportTouches1
    lockedLevelQuality := chooseLong ? rawResistanceQuality : rawSupportQuality
    lockedInvalidation := chooseLong ? candidateLongInvalidation : candidateShortInvalidation
    lockedStartBar := bar_index
    lockedStartTime := time
    lockedCascade := chooseLong ? rawCascadeLong : rawCascadeShort
    lockedOpenSky := false
    lockedLiquidityConsumed := false
    lockedConsumedBar := na
    lockedBreakBar := na
    lockedBreakLevel := na
    lockedBreakGeneration := na

// A locked target stops being fresh liquidity on the FIRST sweep of its outer edge.
// IMPORTANT v1.8.0: the frozen level is NOT released immediately. It is retained
// through the post-break/retest window so BREAKOUT + RETEST / BREAKDOWN + RETEST
// can be evaluated against the same structural zone that was actually swept.
// The structural map still excludes the consumed underlying zone from fresh R/S.
if barstate.isconfirmed and lockedDirection != 0 and not lockedLiquidityConsumed
    bool lockedSweepLong = lockedDirection == 1 and not na(lockedZoneTop) and high > lockedZoneTop
    bool lockedSweepShort = lockedDirection == -1 and not na(lockedZoneBottom) and low < lockedZoneBottom
    if lockedSweepLong or lockedSweepShort
        lockedLiquidityConsumed := true
        lockedConsumedBar := bar_index

// Working side continues to use the frozen center + bounds while the consumed
// level is being classified / retested. Release is decided later, after the
// post-break state and retest window are known.
resistance1 := lockedDirection == 1 ? lockedLevel : rawResistance1
resistanceTop1 := lockedDirection == 1 ? lockedZoneTop : rawResistanceTop1
resistanceBottom1 := lockedDirection == 1 ? lockedZoneBottom : rawResistanceBottom1
resistanceFirstBar1 := lockedDirection == 1 ? lockedZoneFirstBar : rawResistanceFirstBar1
resistance2 := lockedDirection == 1 ? lockedLevel2 : rawResistance2
resistanceTop2 := lockedDirection == 1 ? lockedZone2Top : rawResistanceTop2
resistanceBottom2 := lockedDirection == 1 ? lockedZone2Bottom : rawResistanceBottom2
resistanceFirstBar2 := lockedDirection == 1 ? lockedZone2FirstBar : rawResistanceFirstBar2

support1 := lockedDirection == -1 ? lockedLevel : rawSupport1
supportTop1 := lockedDirection == -1 ? lockedZoneTop : rawSupportTop1
supportBottom1 := lockedDirection == -1 ? lockedZoneBottom : rawSupportBottom1
supportFirstBar1 := lockedDirection == -1 ? lockedZoneFirstBar : rawSupportFirstBar1
support2 := lockedDirection == -1 ? lockedLevel2 : rawSupport2
supportTop2 := lockedDirection == -1 ? lockedZone2Top : rawSupportTop2
supportBottom2 := lockedDirection == -1 ? lockedZone2Bottom : rawSupportBottom2
supportFirstBar2 := lockedDirection == -1 ? lockedZone2FirstBar : rawSupportFirstBar2

resistanceTouches1 := lockedDirection == 1 ? lockedTouches : rawResistanceTouches1
supportTouches1 := lockedDirection == -1 ? lockedTouches : rawSupportTouches1

hasResistance := not na(resistance1) and not na(resistanceTop1) and not na(resistanceBottom1)
hasSupport := not na(support1) and not na(supportTop1) and not na(supportBottom1)

// Relevance distance is measured to the nearest edge of the box-zone.
distanceLongAtr := hasResistance and atr > 0.0 ? math.max(resistanceBottom1 - close, 0.0) / atr : na
distanceShortAtr := hasSupport and atr > 0.0 ? math.max(close - supportTop1, 0.0) / atr : na
cascadeLong := lockedDirection == 1 ? lockedCascade : rawCascadeLong
cascadeShort := lockedDirection == -1 ? lockedCascade : rawCascadeShort

float activeLevelQualityLocked = lockedDirection != 0 ? lockedLevelQuality : 0.0

// ============================================================================
// PRICE ACCEPTANCE
// ============================================================================

float acceptanceHigh = ta.highest(high, effectiveAcceptanceLen)
float acceptanceLow  = ta.lowest(low, effectiveAcceptanceLen)
float acceptanceRange = acceptanceHigh - acceptanceLow

float rangePosition =
     acceptanceRange > 0.0
     ? (close - acceptanceLow) / acceptanceRange
     : 0.5

bool acceptanceLong =
     rangePosition >= longAcceptancePos and
     close >= emaFast

bool acceptanceShort =
     rangePosition <= shortAcceptancePos and
     close <= emaFast


// ============================================================================
// ПОДХОД К УРОВНЮ / APPROACH QUALITY 0..9
// ============================================================================

float distanceLongAtrPast = hasResistance and atr > 0.0 and not na(close[effectiveApproachBars]) ? math.max(resistanceBottom1 - close[effectiveApproachBars], 0.0) / atr : na
float distanceShortAtrPast = hasSupport and atr > 0.0 and not na(close[effectiveApproachBars]) ? math.max(close[effectiveApproachBars] - supportTop1, 0.0) / atr : na

bool distanceImprovingLong = not na(distanceLongAtr) and not na(distanceLongAtrPast) and distanceLongAtr <= distanceLongAtrPast
bool distanceImprovingShort = not na(distanceShortAtr) and not na(distanceShortAtrPast) and distanceShortAtr <= distanceShortAtrPast

float upperWickAtr = atr > 0.0 ? (high - math.max(open, close)) / atr : na
float lowerWickAtr = atr > 0.0 ? (math.min(open, close) - low) / atr : na

float recentUpperRejection = ta.sma(upperWickAtr, effectiveRejectionLookback)
float priorUpperRejection = recentUpperRejection[effectiveRejectionLookback]
float recentLowerRejection = ta.sma(lowerWickAtr, effectiveRejectionLookback)
float priorLowerRejection = recentLowerRejection[effectiveRejectionLookback]

bool rejectionWeakeningLong = not na(recentUpperRejection) and not na(priorUpperRejection) and recentUpperRejection <= priorUpperRejection * rejectionDecayTolerance
bool rejectionWeakeningShort = not na(recentLowerRejection) and not na(priorLowerRejection) and recentLowerRejection <= priorLowerRejection * rejectionDecayTolerance

float approachLowMA = ta.sma(low, 3)
float approachHighMA = ta.sma(high, 3)
bool approachHigherLows = approachLowMA > approachLowMA[effectiveApproachBars]
bool approachLowerHighs = approachHighMA < approachHighMA[effectiveApproachBars]

float approachWindowHigh = ta.highest(high, effectiveApproachBars + 1)
float approachWindowLow = ta.lowest(low, effectiveApproachBars + 1)
float pullbackDepthLongAtr = atr > 0.0 ? (approachWindowHigh - close) / atr : na
float pullbackDepthShortAtr = atr > 0.0 ? (close - approachWindowLow) / atr : na
bool shallowPullbackLong = not na(pullbackDepthLongAtr) and (na(pullbackDepthLongAtr[effectiveApproachBars]) or pullbackDepthLongAtr <= pullbackDepthLongAtr[effectiveApproachBars] * 1.15)
bool shallowPullbackShort = not na(pullbackDepthShortAtr) and (na(pullbackDepthShortAtr[effectiveApproachBars]) or pullbackDepthShortAtr <= pullbackDepthShortAtr[effectiveApproachBars] * 1.15)

float approachRecoveryLong = atr > 0.0 ? (close - approachWindowLow) / atr / math.max(effectiveApproachBars, 1) : na
float approachRecoveryShort = atr > 0.0 ? (approachWindowHigh - close) / atr / math.max(effectiveApproachBars, 1) : na
bool recoveryFastLong = not na(approachRecoveryLong) and approachRecoveryLong >= minApproachRecoveryAtrPerBar
bool recoveryFastShort = not na(approachRecoveryShort) and approachRecoveryShort >= minApproachRecoveryAtrPerBar

int approachScoreLong = 0
approachScoreLong += hasResistance and close <= resistanceTop1 and not na(distanceLongAtr) and distanceLongAtr <= maxApproachAtr ? 1 : 0
approachScoreLong += distanceImprovingLong ? 1 : 0
approachScoreLong += close > close[effectiveApproachBars] and emaFast >= emaFast[effectiveApproachBars] ? 1 : 0
approachScoreLong += approachHigherLows ? 1 : 0
approachScoreLong += acceptanceLong ? 1 : 0
approachScoreLong += rejectionWeakeningLong ? 1 : 0
approachScoreLong += shallowPullbackLong ? 1 : 0
approachScoreLong += recoveryFastLong ? 1 : 0

int approachScoreShort = 0
approachScoreShort += hasSupport and close >= supportBottom1 and not na(distanceShortAtr) and distanceShortAtr <= maxApproachAtr ? 1 : 0
approachScoreShort += distanceImprovingShort ? 1 : 0
approachScoreShort += close < close[effectiveApproachBars] and emaFast <= emaFast[effectiveApproachBars] ? 1 : 0
approachScoreShort += approachLowerHighs ? 1 : 0
approachScoreShort += acceptanceShort ? 1 : 0
approachScoreShort += rejectionWeakeningShort ? 1 : 0
approachScoreShort += shallowPullbackShort ? 1 : 0
approachScoreShort += recoveryFastShort ? 1 : 0

// ============================================================================
// ПРОТОРГОВКА / ACCEPTANCE NEAR LEVEL
// ============================================================================

float protoHigh = ta.highest(high, effectiveProtoLookback)
float protoLow = ta.lowest(low, effectiveProtoLookback)
float protoRange = protoHigh - protoLow
float protoWidthAtr = atr > 0.0 ? protoRange / atr : na
float protoRangePosition = protoRange > 0.0 ? (close - protoLow) / protoRange : 0.5

bool longAttackEvent = hasResistance and high >= resistanceBottom1 - levelTolerance and low <= resistanceTop1 + levelTolerance
bool shortAttackEvent = hasSupport and low <= supportTop1 + levelTolerance and high >= supportBottom1 - levelTolerance
float longAttackCountRaw = math.sum(longAttackEvent ? 1.0 : 0.0, effectiveAttackLookback)
float shortAttackCountRaw = math.sum(shortAttackEvent ? 1.0 : 0.0, effectiveAttackLookback)
float longAttackCount = hasResistance ? longAttackCountRaw : 0.0
float shortAttackCount = hasSupport ? shortAttackCountRaw : 0.0
int lastLongAttackBar = int(nz(ta.valuewhen(longAttackEvent, bar_index, 0), -100000))
int prevLongAttackBar = int(nz(ta.valuewhen(longAttackEvent, bar_index, 1), -100000))
int lastShortAttackBar = int(nz(ta.valuewhen(shortAttackEvent, bar_index, 0), -100000))
int prevShortAttackBar = int(nz(ta.valuewhen(shortAttackEvent, bar_index, 1), -100000))
int longRetestGapBars = lastLongAttackBar > -100000 and prevLongAttackBar > -100000 ? lastLongAttackBar - prevLongAttackBar : 100000
int shortRetestGapBars = lastShortAttackBar > -100000 and prevShortAttackBar > -100000 ? lastShortAttackBar - prevShortAttackBar : 100000
bool retestCadenceLong = longRetestGapBars > 0 and longRetestGapBars <= effectiveMaxRetestGapBars
bool retestCadenceShort = shortRetestGapBars > 0 and shortRetestGapBars <= effectiveMaxRetestGapBars

// Девятый компонент Approach = повторные атаки.
approachScoreLong += longAttackCount >= minAttacks ? 1 : 0
approachScoreShort += shortAttackCount >= minAttacks ? 1 : 0

bool approachingLong = approachScoreLong >= minApproachScore

bool nearResistance = hasResistance and not na(distanceLongAtr) and distanceLongAtr <= protoDistanceAtr and close <= resistanceTop1
bool nearSupport = hasSupport and not na(distanceShortAtr) and distanceShortAtr <= protoDistanceAtr and close >= supportBottom1

bool nearResistanceEvent = hasResistance and close >= resistanceBottom1 - atr * protoDistanceAtr and close <= resistanceTop1
bool nearSupportEvent = hasSupport and close <= supportTop1 + atr * protoDistanceAtr and close >= supportBottom1
float timeNearResistanceRaw = math.sum(nearResistanceEvent ? 1.0 : 0.0, effectiveProtoLookback)
float timeNearSupportRaw = math.sum(nearSupportEvent ? 1.0 : 0.0, effectiveProtoLookback)
float timeNearResistance = hasResistance ? timeNearResistanceRaw : 0.0
float timeNearSupport = hasSupport ? timeNearSupportRaw : 0.0
float nearLevelOccupancyLong = effectiveProtoLookback > 0 ? timeNearResistance / effectiveProtoLookback : 0.0
float nearLevelOccupancyShort = effectiveProtoLookback > 0 ? timeNearSupport / effectiveProtoLookback : 0.0

bool protorgovkaLong =
     nearResistance and not na(protoWidthAtr) and protoWidthAtr <= protoMaxWidthAtr and
     protoRangePosition >= longAcceptancePos and longAttackCount >= minAttacks and
     nearLevelOccupancyLong >= minNearLevelOccupancy

bool protorgovkaShort =
     nearSupport and not na(protoWidthAtr) and protoWidthAtr <= protoMaxWidthAtr and
     protoRangePosition <= shortAcceptancePos and shortAttackCount >= minAttacks and
     nearLevelOccupancyShort >= minNearLevelOccupancy

// Acceptance требует не только геометрии диапазона, но и отсутствия усиливающегося rejection.
bool priceAcceptanceNearLong = protorgovkaLong and rejectionWeakeningLong
bool priceAcceptanceNearShort = protorgovkaShort and rejectionWeakeningShort

float protoQualityLong = f_clamp(
     (not na(protoWidthAtr) ? (1.0 - f_clamp(protoWidthAtr / protoMaxWidthAtr, 0.0, 1.0)) * 15.0 : 0.0) +
     f_clamp((protoRangePosition - 0.5) / 0.5, 0.0, 1.0) * 15.0 +
     f_clamp(nearLevelOccupancyLong / math.max(minNearLevelOccupancy, 0.01), 0.0, 1.0) * 20.0 +
     f_clamp(longAttackCount / math.max(minAttacks, 1), 0.0, 1.0) * 15.0 +
     (retestCadenceLong ? 10.0 : 0.0) +
     (approachHigherLows ? 10.0 : 0.0) + (rejectionWeakeningLong ? 10.0 : 0.0) + (recoveryFastLong ? 5.0 : 0.0), 0.0, 100.0)

float protoQualityShort = f_clamp(
     (not na(protoWidthAtr) ? (1.0 - f_clamp(protoWidthAtr / protoMaxWidthAtr, 0.0, 1.0)) * 15.0 : 0.0) +
     f_clamp((0.5 - protoRangePosition) / 0.5, 0.0, 1.0) * 15.0 +
     f_clamp(nearLevelOccupancyShort / math.max(minNearLevelOccupancy, 0.01), 0.0, 1.0) * 20.0 +
     f_clamp(shortAttackCount / math.max(minAttacks, 1), 0.0, 1.0) * 15.0 +
     (retestCadenceShort ? 10.0 : 0.0) +
     (approachLowerHighs ? 10.0 : 0.0) + (rejectionWeakeningShort ? 10.0 : 0.0) + (recoveryFastShort ? 5.0 : 0.0), 0.0, 100.0)

// ============================================================================
// СТРУКТУРНОЕ ПОДЖАТИЕ
// ============================================================================

float shortLowMA = ta.sma(low, 3)
float shortHighMA = ta.sma(high, 3)

bool risingLocalLows =
     shortLowMA > shortLowMA[effectiveCompressionSlopeBars]

bool fallingLocalHighs =
     shortHighMA < shortHighMA[effectiveCompressionSlopeBars]

bool compressionLong =
     nearResistance and
     risingLocalLows and
     longAttackCount >= minAttacks

bool compressionShort =
     nearSupport and
     fallingLocalHighs and
     shortAttackCount >= minAttacks


// Rising dynamic support/trendline proxy from the latest three confirmed swing lows.
float dynLow0 = ta.valuewhen(not na(pivotLow), pivotLow, 0)
float dynLow1 = ta.valuewhen(not na(pivotLow), pivotLow, 1)
float dynLow2 = ta.valuewhen(not na(pivotLow), pivotLow, 2)
int dynLowBar0 = int(nz(ta.valuewhen(not na(pivotLow), bar_index - effectivePivotLen, 0), -100000))
int dynLowBar1 = int(nz(ta.valuewhen(not na(pivotLow), bar_index - effectivePivotLen, 1), -100000))
int dynLowBar2 = int(nz(ta.valuewhen(not na(pivotLow), bar_index - effectivePivotLen, 2), -100000))
bool dynSupportHas3 = dynLowBar2 > -100000 and dynLowBar1 > dynLowBar2 and dynLowBar0 > dynLowBar1 and not na(dynLow0) and not na(dynLow1) and not na(dynLow2)
bool dynSupportHigherLows = dynSupportHas3 and dynLow0 > dynLow1 and dynLow1 >= dynLow2
float dynSupportSlope = dynSupportHas3 ? (dynLow0 - dynLow1) / math.max(float(dynLowBar0 - dynLowBar1), 1.0) : 0.0
float dynSupportProjected = dynSupportHas3 ? dynLow0 + dynSupportSlope * math.max(float(bar_index - dynLowBar0), 0.0) : na
float dynSupportDistanceAtr = dynSupportHas3 and atr > 0.0 and not na(dynSupportProjected) and close >= dynSupportProjected ? (close - dynSupportProjected) / atr : na
float dynamicSupportQualityLong = enableDynamicSupportQuality and dynSupportHas3 ? f_clamp(
     (dynSupportHigherLows ? 40.0 : 0.0) +
     (dynSupportSlope > 0.0 ? 20.0 : 0.0) +
     (not na(dynSupportProjected) and close >= dynSupportProjected ? 20.0 : 0.0) +
     (not na(dynSupportDistanceAtr) and dynSupportDistanceAtr <= dynamicSupportNearAtr ? 15.0 : 0.0) +
     (distanceImprovingLong ? 5.0 : 0.0), 0.0, 100.0) : 0.0
bool dynamicSupportLong = enableDynamicSupportQuality and dynamicSupportQualityLong >= dynamicSupportMinScore


// ============================================================================
// CORRECTION → RESET → RECOVERY — ordered state machine
// Исправляет ошибку rolling highest/lowest, где low мог исторически идти ДО high.
// ============================================================================

var float seqLongHigh = na
var int seqLongHighBar = na
var float seqLongLow = na
var int seqLongLowBar = na
var bool seqLongCorrection = false

var float seqShortLow = na
var int seqShortLowBar = na
var float seqShortHigh = na
var int seqShortHighBar = na
var bool seqShortCorrection = false

if not na(pivotHigh)
    int phBar = bar_index - effectivePivotLen
    if na(seqLongHigh) or (not seqLongCorrection and phBar > nz(seqLongHighBar, -1)) or (seqLongCorrection and pivotHigh > seqLongHigh)
        seqLongHigh := pivotHigh
        seqLongHighBar := phBar
        seqLongLow := na
        seqLongLowBar := na
        seqLongCorrection := false

if not na(pivotLow) and not na(seqLongHigh)
    int plBar = bar_index - effectivePivotLen
    float seqCorrectionPct = seqLongHigh > 0.0 ? (seqLongHigh - pivotLow) / seqLongHigh * 100.0 : 0.0
    if plBar > nz(seqLongHighBar, plBar) and seqCorrectionPct >= minCorrectionPct
        seqLongLow := pivotLow
        seqLongLowBar := plBar
        seqLongCorrection := true

if not na(pivotLow)
    int plBarShort = bar_index - effectivePivotLen
    if na(seqShortLow) or (not seqShortCorrection and plBarShort > nz(seqShortLowBar, -1)) or (seqShortCorrection and pivotLow < seqShortLow)
        seqShortLow := pivotLow
        seqShortLowBar := plBarShort
        seqShortHigh := na
        seqShortHighBar := na
        seqShortCorrection := false

if not na(pivotHigh) and not na(seqShortLow)
    int phBarShort = bar_index - effectivePivotLen
    float seqBouncePct = seqShortLow > 0.0 ? (pivotHigh - seqShortLow) / seqShortLow * 100.0 : 0.0
    if phBarShort > nz(seqShortLowBar, phBarShort) and seqBouncePct >= minCorrectionPct
        seqShortHigh := pivotHigh
        seqShortHighBar := phBarShort
        seqShortCorrection := true

float orderedRecoveryLong = seqLongCorrection and not na(seqLongLow) and seqLongHigh > seqLongLow ? (close - seqLongLow) / (seqLongHigh - seqLongLow) : 0.0
float orderedRecoveryShort = seqShortCorrection and not na(seqShortHigh) and seqShortHigh > seqShortLow ? (seqShortHigh - close) / (seqShortHigh - seqShortLow) : 0.0

bool correctionResetLong = seqLongCorrection and not na(seqLongLowBar) and bar_index - seqLongLowBar <= effectiveResetLookback and orderedRecoveryLong >= minRecoveryFraction and close >= emaFast
bool correctionResetShort = seqShortCorrection and not na(seqShortHighBar) and bar_index - seqShortHighBar <= effectiveResetLookback and orderedRecoveryShort >= minRecoveryFraction and close <= emaFast

if not na(seqLongHighBar) and bar_index - seqLongHighBar > effectiveResetLookback * 3
    seqLongHigh := na
    seqLongHighBar := na
    seqLongLow := na
    seqLongLowBar := na
    seqLongCorrection := false

if not na(seqShortLowBar) and bar_index - seqShortLowBar > effectiveResetLookback * 3
    seqShortLow := na
    seqShortLowBar := na
    seqShortHigh := na
    seqShortHighBar := na
    seqShortCorrection := false


// Broad consolidation is intentionally separate from narrow protorgovka.
bool broadConsolidationLong =
     enableBroadConsolidation and nearResistance and not protorgovkaLong and
     not na(protoWidthAtr) and protoWidthAtr > protoMaxWidthAtr and protoWidthAtr <= broadConsolidationMaxWidthAtr and
     protoRangePosition >= broadConsolidationMinRangePos and nearLevelOccupancyLong >= broadConsolidationMinOccupancy and
     (risingLocalLows or dynamicSupportLong or correctionResetLong)
float broadConsolidationQualityLong = broadConsolidationLong ? f_clamp(
     (1.0 - f_clamp((protoWidthAtr - protoMaxWidthAtr) / math.max(broadConsolidationMaxWidthAtr - protoMaxWidthAtr, 0.1), 0.0, 1.0)) * 25.0 +
     f_clamp((protoRangePosition - 0.5) / 0.5, 0.0, 1.0) * 25.0 +
     f_clamp(nearLevelOccupancyLong / math.max(broadConsolidationMinOccupancy, 0.01), 0.0, 1.0) * 20.0 +
     dynamicSupportQualityLong * 0.20 +
     (correctionResetLong ? 10.0 : 0.0), 0.0, 100.0) : 0.0

// ============================================================================
// MOMENTUM / VOLUME REGIME / ACTIVITY PROXY / TRIGGERS
// ============================================================================

float candleBodyAtr = atr > 0.0 ? math.abs(close - open) / atr : na
float candleRangeAtr = atr > 0.0 ? (high - low) / atr : na
float candleRange = high - low
float closeLocation = candleRange > 0.0 ? (close - low) / candleRange : 0.5

float formationVolume = ta.sma(volume, effectiveVolumeFormationLen)
float baselineVolume = ta.sma(volume, effectiveVolumeBaselineLen)
float volumeSma3 = ta.sma(volume, 3)
float volumeCompressionRatio = baselineVolume > 0.0 ? formationVolume / baselineVolume : na
float volumeReExpansionRatio = formationVolume > 0.0 ? volume / formationVolume : na
float volumeAcceleration = volumeSma3 > 0.0 ? volume / volumeSma3 : na
float lowestVolumeCompressionRatio = ta.lowest(volumeCompressionRatio, effectiveContractionLookback)

bool contractionSeenRecently =
     not na(volumeCompressionRatio) and
     lowestVolumeCompressionRatio <= maxVolumeCompressionRatio

bool volumeReExpansion =
     contractionSeenRecently and
     not na(volumeReExpansionRatio) and volumeReExpansionRatio >= minVolumeReExpansion

bool volumeReactivation =
     (not na(rvol) and rvol >= minRvol) or
     volumeReExpansion or
     (not na(rvol[3]) and not na(rvol) and rvol > rvol[3])

float velocityLongAtrPerBar =
     atr > 0.0 and not na(close[effectiveActivityVelocityBars])
     ? (close - close[effectiveActivityVelocityBars]) / atr / effectiveActivityVelocityBars
     : na

float velocityShortAtrPerBar =
     atr > 0.0 and not na(close[effectiveActivityVelocityBars])
     ? (close[effectiveActivityVelocityBars] - close) / atr / effectiveActivityVelocityBars
     : na

int activityProxyLong = 0
activityProxyLong += close > open and not na(candleBodyAtr) and candleBodyAtr >= minBodyAtr ? 1 : 0
activityProxyLong += not na(candleRangeAtr) and candleRangeAtr >= minRangeAtr ? 1 : 0
activityProxyLong += closeLocation >= minCloseLocation ? 1 : 0
activityProxyLong += not na(velocityLongAtrPerBar) and velocityLongAtrPerBar >= minVelocityAtrPerBar ? 1 : 0
activityProxyLong += (not na(volumeAcceleration) and volumeAcceleration >= minVolumeAcceleration) or (not na(rvol) and rvol >= triggerRvol) ? 1 : 0

int activityProxyShort = 0
activityProxyShort += close < open and not na(candleBodyAtr) and candleBodyAtr >= minBodyAtr ? 1 : 0
activityProxyShort += not na(candleRangeAtr) and candleRangeAtr >= minRangeAtr ? 1 : 0
activityProxyShort += closeLocation <= 1.0 - minCloseLocation ? 1 : 0
activityProxyShort += not na(velocityShortAtrPerBar) and velocityShortAtrPerBar >= minVelocityAtrPerBar ? 1 : 0
activityProxyShort += (not na(volumeAcceleration) and volumeAcceleration >= minVolumeAcceleration) or (not na(rvol) and rvol >= triggerRvol) ? 1 : 0

bool microTfValid = timeframe.in_seconds(effectiveMicroTf) < timeframe.in_seconds()

// Full intrabar request. Unlike request.security() on a lower TF, this returns an
// ordered array containing EVERY available lower-TF bar inside the current chart bar.
[microLongStateArr, microShortStateArr, microOpenArr, microHighArr, microLowArr, microCloseArr, microVolumeArr] = request.security_lower_tf(
     syminfo.tickerid, effectiveMicroTf,
     [f_microProtoLong(effectiveMicroLookback, microMaxWidthAtr, longAcceptancePos),
      f_microProtoShort(effectiveMicroLookback, microMaxWidthAtr, shortAcceptancePos),
      open, high, low, close, volume],
     ignore_invalid_timeframe = true)

[microQualityLong, microQualityShort, microProtoHitPctLong, microProtoHitPctShort, microIntrabarCount, microLastLongState, microLastShortState] =
     f_microIntrabarEngine(microLongStateArr, microShortStateArr, microOpenArr, microHighArr, microLowArr, microCloseArr, microVolumeArr)

bool microCoverageOk = microIntrabarCount >= microMinIntrabars
bool microProtoLong =
     useMicroTf and microTfValid and microCoverageOk and
     microProtoHitPctLong >= microMinProtoHitPct and microQualityLong >= microMinQuality
bool microProtoShort =
     useMicroTf and microTfValid and microCoverageOk and
     microProtoHitPctShort >= microMinProtoHitPct and microQualityShort >= microMinQuality

bool bullMomentum =
     close > open and
     not na(candleBodyAtr) and candleBodyAtr >= minBodyAtr and
     close > high[1] and
     (activityProxyLong >= minActivityProxyScore or candleBodyAtr >= strongBodyAtr)

bool bearMomentum =
     close < open and
     not na(candleBodyAtr) and candleBodyAtr >= minBodyAtr and
     close < low[1] and
     (activityProxyShort >= minActivityProxyScore or candleBodyAtr >= strongBodyAtr)

// Breakout/Breakdown is measured ONLY through the frozen locked-zone of the
// current setup generation. Structural crossing and trigger validation share the
// same source-of-truth level, so a new setup cannot inherit R/S from the prior one.
bool lockedCrossLongNow =
     lockedDirection == 1 and not na(lockedZoneTop) and
     close > lockedZoneTop and close[1] <= lockedZoneTop

bool lockedCrossShortNow =
     lockedDirection == -1 and not na(lockedZoneBottom) and
     close < lockedZoneBottom and close[1] >= lockedZoneBottom

bool breakoutLong = lockedCrossLongNow and not na(candleBodyAtr) and candleBodyAtr >= minBodyAtr
bool breakdownShort = lockedCrossShortNow and not na(candleBodyAtr) and candleBodyAtr >= minBodyAtr

// Persist the first structural break of this setup generation.
if (lockedCrossLongNow or lockedCrossShortNow) and (na(lockedBreakGeneration) or lockedBreakGeneration != lockedStartBar)
    lockedBreakBar := bar_index
    lockedBreakLevel := lockedCrossLongNow ? lockedZoneTop : lockedZoneBottom
    lockedBreakGeneration := lockedStartBar

int barsSinceGenerationBreak =
     lockedDirection != 0 and lockedBreakGeneration == lockedStartBar and not na(lockedBreakBar)
     ? bar_index - lockedBreakBar : 100000

float brokenSupport = lockedDirection == -1 and lockedBreakGeneration == lockedStartBar ? lockedBreakLevel : na
int barsSinceBreakdown = lockedDirection == -1 ? barsSinceGenerationBreak : 100000
bool breakdownRecent = barsSinceBreakdown > 0 and barsSinceBreakdown <= effectiveShortAcceptanceBars
bool acceptanceBelowSupport =
     breakdownRecent and not na(brokenSupport) and
     close < brokenSupport and high <= brokenSupport + levelTolerance

bool failedSupportReclaim =
     breakdownRecent and not na(brokenSupport) and
     high >= brokenSupport - levelTolerance and close < brokenSupport

bool directMomentumLong =
     hasResistance and close <= resistanceTop1 and not na(distanceLongAtr) and
     distanceLongAtr <= directMomentumMaxDistAtr and
     bullMomentum and approachScoreLong >= math.max(minApproachScore - 1, 1)

bool preBreakLong =
     nearResistance and
     approachingLong and acceptanceLong and
     (priceAcceptanceNearLong or compressionLong or bullTrend or microProtoLong) and
     (activityProxyLong >= minActivityProxyScore or volumeReExpansion)

bool longTrigger = breakoutLong or directMomentumLong or preBreakLong

bool exhaustionSafeShort = not na(return24h) and return24h >= -maxShortDrop24

bool sellSideReactivation =
     bearMomentum or
     volumeReExpansion and close < open or
     (not na(rvol) and rvol >= triggerRvol and close < open)

// SHORT не зеркалит LONG: предпочтение breakdown + продавец,
// либо acceptance ниже уже пробитой поддержки с неудачным reclaim.
bool shortTrigger =
     (breakdownShort and activityProxyShort >= minActivityProxyScore) or
     (acceptanceBelowSupport and failedSupportReclaim and sellSideReactivation)

// ============================================================================
// BTC CONTEXT / ROUND CONFLUENCE / WHIPSAW RISK
// ============================================================================

[btcClose, btcEmaFast, btcEmaSlow] = request.security(
     btcSymbol, timeframe.period,
     [close, ta.ema(close, btcFastLen), ta.ema(close, btcSlowLen)],
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off
)

// Short-horizon BTC Shock request. This is deliberately independent of BTC EMA regime.
[btcShockMoveAtr, btcShockRangeAtr, btcShockRvol] = request.security(
     btcSymbol, effectiveBtcShockTf,
     f_btcShockMetrics(effectiveBtcShockLookback),
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off
)
float btcShockMoveScore = f_clamp(math.abs(nz(btcShockMoveAtr, 0.0)) / math.max(btcShockExtremeMoveAtr, 0.05) * 100.0, 0.0, 100.0)
float btcShockRangeScore = f_clamp(nz(btcShockRangeAtr, 0.0) / math.max(btcShockExtremeMoveAtr * 1.25, 0.10) * 100.0, 0.0, 100.0)
float btcShockVolumeScore = not na(btcShockRvol) ? f_clamp(btcShockRvol / math.max(btcShockRvolConfirm, 0.1) * 100.0, 0.0, 100.0) : 50.0
float btcShockScore = enableBtcShock and useBtcContext ? f_clamp(
     btcShockMoveScore * 0.65 + btcShockRangeScore * 0.20 + btcShockVolumeScore * 0.15, 0.0, 100.0) : 0.0
bool btcShockDirectionDown = enableBtcShock and useBtcContext and nz(btcShockMoveAtr, 0.0) < 0.0
bool btcShockDirectionUp = enableBtcShock and useBtcContext and nz(btcShockMoveAtr, 0.0) > 0.0

bool btcBull = btcClose >= btcEmaFast and btcEmaFast >= btcEmaSlow
bool btcBear = btcClose <= btcEmaFast and btcEmaFast <= btcEmaSlow
bool btcAdverseLong = useBtcContext and btcClose < btcEmaFast and btcEmaFast < btcEmaSlow
bool btcAdverseShort = useBtcContext and btcClose > btcEmaFast and btcEmaFast > btcEmaSlow

float roundAnchorLong = hasResistance ? math.max(resistanceTop1, close) : close
float roundAnchorShort = hasSupport ? math.min(supportBottom1, close) : close
float roundStepLong = f_roundStep(roundAnchorLong) * majorRoundMultiplier
float roundStepShort = f_roundStep(roundAnchorShort) * majorRoundMultiplier
float roundAbove = math.ceil(roundAnchorLong / roundStepLong) * roundStepLong
float roundBelow = math.floor(roundAnchorShort / roundStepShort) * roundStepShort
roundAbove := roundAbove <= roundAnchorLong ? roundAbove + roundStepLong : roundAbove
roundBelow := roundBelow >= roundAnchorShort ? roundBelow - roundStepShort : roundBelow

bool roundConfluenceLong =
     not na(roundAbove) and atr > 0.0 and
     roundAbove > roundAnchorLong and (roundAbove - roundAnchorLong) / atr <= roundConfluenceAtr

bool roundConfluenceShort =
     hasSupport and not na(roundBelow) and atr > 0.0 and
     roundBelow < roundAnchorShort and (roundAnchorShort - roundBelow) / atr <= roundConfluenceAtr

float priorLocalHigh = ta.highest(high[1], effectiveFalseBreakLevelLookback)
float priorLocalLow = ta.lowest(low[1], effectiveFalseBreakLevelLookback)
bool falseBreakUp = not na(priorLocalHigh) and high > priorLocalHigh and close < priorLocalHigh
bool falseBreakDown = not na(priorLocalLow) and low < priorLocalLow and close > priorLocalLow

float falseBreakUpCount = nz(math.sum(falseBreakUp ? 1.0 : 0.0, effectiveFalseBreakRiskLookback), 0.0)
float falseBreakDownCount = nz(math.sum(falseBreakDown ? 1.0 : 0.0, effectiveFalseBreakRiskLookback), 0.0)

bool wickRiskLong = not na(upperWickAtr) and upperWickAtr >= longWickRiskAtr
bool wickRiskShort = not na(lowerWickAtr) and lowerWickAtr >= shortWickRiskAtr
// Context owns the historical false-break regime. Current wick rejection is kept
// out of Context and later belongs only to MAE.
bool whipsawRiskLong = falseBreakUpCount >= falseBreakRiskCount
bool whipsawRiskShort = falseBreakDownCount >= falseBreakRiskCount

// ============================================================================
// STAGE 3 SCORE ARCHITECTURE — SIX INDEPENDENT DIMENSIONS
//
// Formation  = structural setup only. No activity/volume/BTC/R:R/risk.
// Execution  = timing/trigger quality only. Calculated after path routing below.
// Exhaustion = overextension/climax only. High = bad.
// MAE        = local adverse-flow risk only. High = bad.
// Geometry   = SL / R:R / target-space only.
// Context    = market regime/liquidity/BTC/whipsaw environment only.
//
// Legacy aliases are retained so existing thresholds/alerts keep working:
// Setup Quality -> Formation, Entry Readiness -> Execution, Trade Quality -> Geometry,
// Reversal Risk -> Exhaustion, Pullback/MAE Risk -> MAE.
// ============================================================================

bool longStructuralPattern = priceAcceptanceNearLong or compressionLong or broadConsolidationLong or correctionResetLong or microProtoLong
bool shortStructuralPattern = priceAcceptanceNearShort or compressionShort or correctionResetShort or microProtoShort

int direction = lockedDirection
bool directionLong = direction == 1
bool directionShort = direction == -1

float activeDistanceAtr = directionLong ? distanceLongAtr : directionShort ? distanceShortAtr : na
int activeApproachScore = directionLong ? approachScoreLong : directionShort ? approachScoreShort : 0
float activeApproachQuality = f_clamp(activeApproachScore / 9.0 * 100.0, 0.0, 100.0)
bool activeApproach = activeApproachScore >= minApproachScore
bool activeAcceptance = directionLong ? acceptanceLong : directionShort ? acceptanceShort : false
bool activeProto = directionLong ? priceAcceptanceNearLong : directionShort ? priceAcceptanceNearShort : false
bool activeCompression = directionLong ? compressionLong : directionShort ? compressionShort : false
float activeProtoQuality = directionLong ? protoQualityLong : directionShort ? protoQualityShort : 0.0
int activeActivityProxy = directionLong ? activityProxyLong : directionShort ? activityProxyShort : 0
float activeActivityQuality = f_clamp(activeActivityProxy / 5.0 * 100.0, 0.0, 100.0)
bool activeMomentum = activeActivityProxy >= minActivityProxyScore
bool activeCascade = directionLong ? cascadeLong : directionShort ? cascadeShort : false
bool activeWhipsaw = directionLong ? whipsawRiskLong : directionShort ? whipsawRiskShort : false
bool activeCurrentWickRisk = directionLong ? wickRiskLong : directionShort ? wickRiskShort : false
bool activeBtcSupportive = not useBtcContext or (directionLong ? btcBull : directionShort ? btcBear : false)
bool activeBtcAdverse = directionLong ? btcAdverseLong : directionShort ? btcAdverseShort : false
bool activeBtcShockDirectional = directionLong ? btcShockDirectionDown : directionShort ? btcShockDirectionUp : false
bool activeBtcShockAdverse = activeBtcShockDirectional and btcShockScore >= btcShockWarningScore
bool activeBtcShockBlocking = activeBtcShockDirectional and btcShockScore >= btcShockBlockScore
bool gateBtcShock = not useBtcContext or not enableBtcShock or not btcShockBlocksPineReady or not activeBtcShockBlocking

// FORMATION QUALITY 0..100 — owns structural information exclusively.
float formationStructureQualityLong = f_clamp(
     (bullTrend ? 20.0 : 0.0) +
     (compressionLong ? 20.0 : 0.0) +
     (correctionResetLong ? 15.0 : 0.0) +
     (microProtoLong ? microQualityLong * 0.10 : 0.0) +
     mtfTrendQualityLong * 0.15 +
     dynamicSupportQualityLong * 0.10 +
     (broadConsolidationLong ? 5.0 : 0.0) +
     htfBaseQualityLong * 0.05, 0.0, 100.0)
float formationStructureQualityShort = f_clamp(
     (bearTrend ? 40.0 : 0.0) +
     (compressionShort ? 20.0 : 0.0) +
     (correctionResetShort ? 15.0 : 0.0) +
     (acceptanceBelowSupport ? 15.0 : 0.0) +
     (microProtoShort ? microQualityShort * 0.10 : 0.0), 0.0, 100.0)
float activeStructureQuality = directionLong ? formationStructureQualityLong : directionShort ? formationStructureQualityShort : 0.0
float formationAcceptanceQuality = activeAcceptance ? 100.0 : activeProto ? 75.0 : 35.0
float formationLiquidityShapeQuality = activeCascade ? 100.0 : lockedTouches >= 3 ? 85.0 : lockedTouches >= 2 ? 70.0 : 50.0
float formationQuality = direction != 0 ? f_clamp(
     activeLevelQualityLocked * 0.30 +
     activeStructureQuality * 0.25 +
     activeApproachQuality * 0.20 +
     formationAcceptanceQuality * 0.15 +
     formationLiquidityShapeQuality * 0.10, 0.0, 100.0) : 0.0
float activeLevelQuality = direction != 0 ? activeLevelQualityLocked : 0.0

// CONTEXT QUALITY 0..100 — regime/environment only.
float contextActivityQuality = f_clamp(activityCheckCount / 4.0 * 100.0, 0.0, 100.0)
float contextDollarVolumeQuality =
     min24hVolumeM <= 0.0 ? 100.0 :
     volume24hKnown and not na(volume24hUsed) ? f_clamp(volume24hUsed / math.max(min24hVolumeM * 2000000.0, 1.0) * 100.0, 0.0, 100.0) :
     50.0
float contextTickAtrQuality = na(liquidityTickAtrPct) ? 50.0 : f_clamp((1.0 - liquidityTickAtrPct / math.max(liquidityMaxTickAtrPct * 2.0, 0.01)) * 100.0, 0.0, 100.0)
float contextTickPriceQuality = na(liquidityTickPriceBps) ? 50.0 : f_clamp((1.0 - liquidityTickPriceBps / math.max(liquidityMaxTickPriceBps * 2.0, 0.01)) * 100.0, 0.0, 100.0)
float contextLiquidityQuality = f_clamp(
     contextDollarVolumeQuality * 0.60 + contextTickAtrQuality * 0.20 + contextTickPriceQuality * 0.20, 0.0, 100.0)
float contextBtcRegimeQuality = not useBtcContext ? 70.0 : activeBtcAdverse ? 25.0 : activeBtcSupportive ? 100.0 : 65.0
float contextBtcShockQuality = not useBtcContext or not enableBtcShock ? 100.0 : activeBtcShockDirectional ? f_clamp(100.0 - btcShockScore, 0.0, 100.0) : 100.0
float contextBtcQuality = not useBtcContext ? 70.0 : f_clamp(contextBtcRegimeQuality * 0.65 + contextBtcShockQuality * 0.35, 0.0, 100.0)
float contextWhipsawQuality = activeWhipsaw ? 25.0 : 100.0
float contextRoundQuality = direction == 0 ? 50.0 : (directionLong ? roundConfluenceLong : roundConfluenceShort) ? 100.0 : 65.0
float contextQuality = direction != 0 ? f_clamp(
     contextActivityQuality * 0.30 +
     contextLiquidityQuality * 0.25 +
     contextBtcQuality * 0.20 +
     contextWhipsawQuality * 0.20 +
     contextRoundQuality * 0.05, 0.0, 100.0) : 0.0

// Legacy Setup Quality is now a strict compatibility alias to Formation Quality.
float setupQuality = formationQuality

// -----------------------------------------------------------------------------
// LOCKED LEVEL BREAK PHASE / LATE-ENTRY FIX
// Исправляет прежний bug: отрицательный activeDistanceAtr после LONG breakout
// больше не считается идеальной близостью к уровню.
// -----------------------------------------------------------------------------
int barsSinceLockedBreak = direction != 0 ? barsSinceGenerationBreak : 100000

bool isPostBreak =
     directionLong ? (lockedBreakGeneration == lockedStartBar and not na(lockedZoneTop) and close > lockedZoneTop) :
     directionShort ? (lockedBreakGeneration == lockedStartBar and not na(lockedZoneBottom) and close < lockedZoneBottom) : false
float postBreakExtensionAtr = directionLong and not na(lockedZoneTop) and atr > 0.0 ? math.max((close - lockedZoneTop) / atr, 0.0) : directionShort and not na(lockedZoneBottom) and atr > 0.0 ? math.max((lockedZoneBottom - close) / atr, 0.0) : 0.0

float retestDistanceLongAtr = directionLong and not na(lockedZoneTop) and atr > 0.0 ? math.max(low - lockedZoneTop, 0.0) / atr : 100000.0
float retestDistanceShortAtr = directionShort and not na(lockedZoneBottom) and atr > 0.0 ? math.max(lockedZoneBottom - high, 0.0) / atr : 100000.0
bool retestApproachingLong = directionLong and barsSinceLockedBreak > 0 and (close <= close[1] or low <= low[1])
bool retestApproachingShort = directionShort and barsSinceLockedBreak > 0 and (close >= close[1] or high >= high[1])

bool postBreakRetestLong =
     directionLong and barsSinceLockedBreak > 0 and barsSinceLockedBreak <= effectivePostBreakRetestBars and
     low <= lockedZoneTop + levelTolerance and
     low >= lockedZoneBottom - atr * maxRetestPenetrationAtr and
     close >= lockedZoneTop and closeLocation >= 0.55

bool postBreakRetestShort =
     directionShort and barsSinceLockedBreak > 0 and barsSinceLockedBreak <= effectivePostBreakRetestBars and
     high >= lockedZoneBottom - levelTolerance and
     high <= lockedZoneTop + atr * maxRetestPenetrationAtr and
     close <= lockedZoneBottom and closeLocation <= 0.45

bool postBreakRetestAccepted = postBreakRetestLong or postBreakRetestShort


// ATH / OPEN SKY continuation: after a clean accepted break, keep the setup alive
// beyond the short retest window when there is no fresh overhead structural resistance.
bool openSkyNoFreshResistance = directionLong and na(rawResistance1)
bool openSkyModeActive = enableOpenSkyMode and directionLong and isPostBreak and (lockedOpenSky or openSkyNoFreshResistance)
float openSkyAcceptanceShare = openSkyModeActive and openSkyAcceptanceBars > 0 ? math.sum(close >= lockedZoneTop ? 1.0 : 0.0, openSkyAcceptanceBars) / openSkyAcceptanceBars : 0.0
float athAcceptanceQuality = openSkyModeActive ? f_clamp(
     openSkyAcceptanceShare * 60.0 +
     (close >= emaFast ? 15.0 : 0.0) +
     mtfTrendQualityLong * 0.20 +
     (not activeBtcShockBlocking ? 5.0 : 0.0), 0.0, 100.0) : 0.0
bool postBreakHoldLong = openSkyModeActive and close >= lockedZoneTop - atr * openSkyReclaimToleranceAtr and openSkyAcceptanceShare >= 0.67 and mtfTrendQualityLong >= 50.0

// Consumed locked-zone lifecycle resolution.
// 1) A sweep that never gains acceptance beyond the level is released only after
//    effectiveZoneSweepResolveBars, so the structural event has time to resolve.
// 2) A confirmed post-break keeps the original frozen zone alive through the full
//    retest window; only after that window expires do we move on to the next zone.
bool generationPostBreakPhase =
     lockedLiquidityConsumed and lockedBreakGeneration == lockedStartBar and
     barsSinceLockedBreak >= 0 and barsSinceLockedBreak <= effectivePostBreakRetestBars

bool consumedResolveExpired =
     lockedLiquidityConsumed and not na(lockedConsumedBar) and
     lockedBreakGeneration != lockedStartBar and
     bar_index - lockedConsumedBar > effectiveZoneSweepResolveBars

int effectivePostBreakHoldBars = openSkyModeActive ? math.max(effectivePostBreakRetestBars, openSkyHoldBars) : effectivePostBreakRetestBars
bool postBreakWindowExpired =
     lockedLiquidityConsumed and lockedBreakGeneration == lockedStartBar and
     barsSinceLockedBreak > effectivePostBreakHoldBars

if consumedResolveExpired or postBreakWindowExpired
    releaseSetupNextBar := true

bool firstBreakWindow = isPostBreak and barsSinceLockedBreak <= effectiveFirstBreakEntryBars
bool preBreakDistanceOk = direction != 0 and not isPostBreak and not na(activeDistanceAtr) and activeDistanceAtr <= maxApproachAtr
bool postBreakDistanceOk = direction != 0 and isPostBreak and (postBreakHoldLong or (postBreakExtensionAtr <= maxPostBreakEntryAtr and (firstBreakWindow or postBreakRetestAccepted)))

bool longRetestTrigger = postBreakRetestLong and (bullMomentum or volumeReactivation or activityProxyLong >= minActivityProxyScore)
bool shortRetestTrigger = postBreakRetestShort and (bearMomentum or sellSideReactivation or activityProxyShort >= minActivityProxyScore)
bool openSkyContinuationTrigger = postBreakHoldLong and (bullMomentum or volumeReactivation or activityProxyLong >= minActivityProxyScore)
bool activeTrigger = directionLong ? (longTrigger or longRetestTrigger or openSkyContinuationTrigger) : directionShort ? (shortTrigger or shortRetestTrigger) : false

// Entry Path Router v1.8.0.
// Two separate layers are intentional:
// - Candidate Path = the execution method currently FORMING / available if a trigger appears.
// - Trigger Path   = the execution method that ACTUALLY fired on the current bar.
// This prevents the dashboard from collapsing to WAIT/0 during setup maturation while
// preserving gateTrigger as the mandatory execution gate for PINE READY.
bool openSkyPathLong = directionLong and openSkyContinuationTrigger
bool protoBreakLong = directionLong and breakoutLong and priceAcceptanceNearLong
bool breakoutRetestLong = directionLong and longRetestTrigger
bool compressionPathLong = directionLong and preBreakLong and compressionLong
bool directPathLong = directionLong and directMomentumLong
bool breakoutPathLong = directionLong and breakoutLong
bool preBreakPathLong = directionLong and preBreakLong
bool breakdownRetestShort = directionShort and ((acceptanceBelowSupport and failedSupportReclaim and shortTrigger) or shortRetestTrigger)
bool breakdownPathShort = directionShort and breakdownShort and shortTrigger

// Current Trigger Path: only a route that has actually fired NOW.
// Ordering exactly matches score priority so label and numeric score cannot disagree.
string entryPath =
     openSkyPathLong ? "OPEN SKY" :
     protoBreakLong ? "PROTORGOVKA BREAK" :
     breakoutRetestLong ? "BREAKOUT + RETEST" :
     breakdownRetestShort ? "BREAKDOWN + RETEST" :
     breakoutPathLong ? "BREAKOUT" :
     breakdownPathShort ? "BREAKDOWN" :
     compressionPathLong ? "COMPRESSION" :
     directPathLong ? "DIRECT MOMENTUM" :
     preBreakPathLong ? "PRE-BREAK" :
     "WAIT"

float entryPathScore =
     openSkyPathLong ? 88.0 :
     protoBreakLong ? 95.0 :
     breakoutRetestLong ? 93.0 :
     breakdownRetestShort ? 92.0 :
     breakoutPathLong ? 86.0 :
     breakdownPathShort ? 84.0 :
     compressionPathLong ? 78.0 :
     directPathLong ? 76.0 :
     preBreakPathLong ? 68.0 :
     0.0

// Candidate Path: describes the best currently forming execution route BEFORE trigger.
// It is allowed to improve Entry Readiness, but it can never bypass gateTrigger.
bool candidateOpenSkyLong = directionLong and postBreakHoldLong and not openSkyContinuationTrigger

bool candidateBreakoutRetestLong =
     directionLong and lockedLiquidityConsumed and lockedBreakGeneration == lockedStartBar and
     barsSinceLockedBreak > 0 and barsSinceLockedBreak <= effectivePostBreakRetestBars and
     retestDistanceLongAtr <= retestCandidateMaxDistanceAtr and retestApproachingLong and
     low >= lockedZoneBottom - atr * maxRetestPenetrationAtr

bool candidateBreakdownRetestShort =
     directionShort and lockedLiquidityConsumed and lockedBreakGeneration == lockedStartBar and
     barsSinceLockedBreak > 0 and barsSinceLockedBreak <= effectivePostBreakRetestBars and
     retestDistanceShortAtr <= retestCandidateMaxDistanceAtr and retestApproachingShort and
     high <= lockedZoneTop + atr * maxRetestPenetrationAtr

bool candidateProtoBreakLong =
     directionLong and not isPostBreak and nearResistance and
     approachingLong and priceAcceptanceNearLong

bool candidateCompressionLong =
     directionLong and not isPostBreak and nearResistance and
     approachingLong and compressionLong

bool candidateDirectMomentumLong =
     directionLong and not isPostBreak and not candidateProtoBreakLong and
     not candidateCompressionLong and activeApproach and
     not na(activeDistanceAtr) and activeDistanceAtr <= directMomentumMaxDistAtr and
     (activeActivityProxy >= math.max(minActivityProxyScore - 1, 1) or bullTrend)

bool candidatePreBreakLong =
     directionLong and not isPostBreak and nearResistance and
     activeApproach and activeAcceptance

// SHORT remains deliberately stricter: before the actual trigger we only expose
// a BREAKDOWN candidate when bearish structure/approach and exhaustion guard agree.
bool candidateBreakdownShort =
     directionShort and not isPostBreak and nearSupport and
     activeApproach and bearTrend and exhaustionSafeShort

string candidateEntryPath =
     candidateOpenSkyLong ? "OPEN SKY" :
     candidateBreakoutRetestLong ? "BREAKOUT + RETEST" :
     candidateBreakdownRetestShort ? "BREAKDOWN + RETEST" :
     candidateProtoBreakLong ? "PROTORGOVKA BREAK" :
     candidateBreakdownShort ? "BREAKDOWN" :
     candidateCompressionLong ? "COMPRESSION" :
     candidateDirectMomentumLong ? "DIRECT MOMENTUM" :
     candidatePreBreakLong ? "PRE-BREAK" :
     "WAIT"

float candidateEntryPathScore =
     candidateOpenSkyLong ? 88.0 :
     candidateBreakoutRetestLong ? 93.0 :
     candidateBreakdownRetestShort ? 92.0 :
     candidateProtoBreakLong ? 95.0 :
     candidateBreakdownShort ? 84.0 :
     candidateCompressionLong ? 78.0 :
     candidateDirectMomentumLong ? 76.0 :
     candidatePreBreakLong ? 68.0 :
     0.0

// Generation-local execution-path memory. The live trigger/candidate path has priority,
// while this memory supplies a stable fallback when a route briefly disappears.
var int pathMemoryDirection = 0
var int pathMemoryGeneration = na
var string pathMemory = "WAIT"
var float pathMemoryScore = 0.0
bool pathMemoryGenerationChanged =
     direction != 0 and
     (pathMemoryDirection != direction or nz(pathMemoryGeneration, -1) != nz(lockedStartBar, -1))

if direction == 0
    pathMemoryDirection := 0
    pathMemoryGeneration := na
    pathMemory := "WAIT"
    pathMemoryScore := 0.0
else if pathMemoryGenerationChanged
    pathMemoryDirection := direction
    pathMemoryGeneration := lockedStartBar
    pathMemory := candidateEntryPathScore > 0.0 ? candidateEntryPath : entryPathScore > 0.0 ? entryPath : "WAIT"
    pathMemoryScore := math.max(candidateEntryPathScore, entryPathScore)

if barstate.isconfirmed and direction != 0
    if entryPathScore > 0.0
        pathMemory := entryPath
        pathMemoryScore := entryPathScore
    else if candidateEntryPathScore > pathMemoryScore and candidateEntryPathScore > 0.0
        pathMemory := candidateEntryPath
        pathMemoryScore := candidateEntryPathScore

string riskPath =
     entryPathScore > 0.0 ? entryPath :
     candidateEntryPathScore > 0.0 ? candidateEntryPath :
     pathMemory
int riskPathCode = f_pathCode(riskPath)

// EXECUTION QUALITY 0..100 — timing/trigger only. No Formation/Context/Geometry/Risk.
float readinessPathScore = entryPathScore > 0.0 ? entryPathScore : candidateEntryPathScore * 0.75
float preBreakProximityQuality = not na(activeDistanceAtr) and activeDistanceAtr >= 0.0 ? (1.0 - f_clamp(activeDistanceAtr / math.max(maxApproachAtr, 0.1), 0.0, 1.0)) * 100.0 : 0.0
float postBreakProximityQuality = isPostBreak ? (1.0 - f_clamp(postBreakExtensionAtr / math.max(maxPostBreakEntryAtr, 0.05), 0.0, 1.0)) * 100.0 : 0.0
float proximityQuality = isPostBreak ? postBreakProximityQuality : preBreakProximityQuality
float triggerVolumeQuality = volumeReExpansion ? 100.0 : not na(rvol) and rvol >= triggerRvol ? 85.0 : not na(rvol) and rvol >= minRvol ? 65.0 : 30.0
float executionTriggerConfirmationQuality = activeTrigger ? 100.0 : candidateEntryPathScore > 0.0 ? 55.0 : 20.0
float executionProximityQuality =
     riskPathCode == PATH_BREAKOUT_RETEST ? (postBreakRetestAccepted ? 100.0 : candidateBreakoutRetestLong ? 75.0 : postBreakProximityQuality) :
     riskPathCode == PATH_BREAKDOWN_RETEST ? (postBreakRetestAccepted ? 100.0 : candidateBreakdownRetestShort ? 75.0 : postBreakProximityQuality) : proximityQuality
float executionQuality = direction != 0 ? f_clamp(
     readinessPathScore * 0.30 +
     activeActivityQuality * 0.25 +
     executionProximityQuality * 0.20 +
     triggerVolumeQuality * 0.15 +
     executionTriggerConfirmationQuality * 0.10, 0.0, 100.0) : 0.0

// Legacy Entry Readiness is now a strict compatibility alias to Execution Quality.
float entryReadiness = executionQuality

// HARD GATES: второстепенные бонусы не могут компенсировать провал обязательного слоя.
bool gateInPlay = direction != 0 and inPlay
bool gateLevel = direction != 0 and activeLevelQuality >= minLevelQuality
bool gateStructure = directionLong ? (bullTrend or longStructuralPattern) : directionShort ? (bearTrend and (shortStructuralPattern or acceptanceBelowSupport)) : false
bool gateApproach = direction != 0 and activeApproach
bool gateDistance = direction != 0 and (preBreakDistanceOk or postBreakDistanceOk)
bool gateTrigger = direction != 0 and activeTrigger
bool gateContext = direction != 0 and contextQuality >= minContextQualityForPineReady
bool gateShortExhaustion = not directionShort or exhaustionSafeShort
bool validWatch = direction != 0 and setupQuality >= minSetupQuality

bool armed =
     validWatch and gateInPlay and gateLiquidity and gateLevel and gateStructure and gateApproach and gateDistance and
     setupQuality >= minArmedQuality and gateShortExhaustion

// ============================================================================
// TRIGGER LEVEL + T1 / T2 — ПРОГНОЗИРУЕМОЕ ДВИЖЕНИЕ
// На большинстве авторских скринов горизонтальный high/low — это уровень атаки,
// а измеренная цель расположена УЖЕ ЗА уровнем. Поэтому Trigger Level != T1.
// ============================================================================

float triggerLevel =
     directionLong ? resistanceTop1 :
     directionShort ? supportBottom1 :
     na

float structureExtension = not na(protoRange) ? protoRange * targetStructureMultiplier : 0.0
float atrExtension = atr * targetAtrExtension
float targetExtension = math.min(math.max(structureExtension, atrExtension), atr * maxTargetExtensionAtr)

float measuredTargetLong = hasResistance ? resistanceTop1 + targetExtension : na
float measuredTargetShort = hasSupport ? supportBottom1 - targetExtension : na

float r2GapAtr = hasResistance and not na(resistance2) and not na(resistanceBottom2) and atr > 0.0 ? math.max(resistanceBottom2 - resistanceTop1, 0.0) / atr : na
float s2GapAtr = hasSupport and not na(support2) and not na(supportTop2) and atr > 0.0 ? math.max(supportBottom1 - supportTop2, 0.0) / atr : na

bool r2IsTargetLiquidity = not na(r2GapAtr) and r2GapAtr >= minTargetLiquidityGapAtr
bool s2IsTargetLiquidity = not na(s2GapAtr) and s2GapAtr >= minTargetLiquidityGapAtr

float nextLiquidityTargetLong = r2IsTargetLiquidity ? resistanceBottom2 : na
float nextLiquidityTargetShort = s2IsTargetLiquidity ? supportTop2 : na

float autoTargetLong =
     r2IsTargetLiquidity and nextLiquidityTargetLong <= measuredTargetLong ? nextLiquidityTargetLong : measuredTargetLong

float autoTargetShort =
     s2IsTargetLiquidity and nextLiquidityTargetShort >= measuredTargetShort ? nextLiquidityTargetShort : measuredTargetShort

float openSkyMeasuredTargetLong = close + math.max(atr * targetAtrExtension, atr * minRemainingTargetAtr)
float openSkyRoundTargetLong = not na(roundAbove) and roundAbove > close ? roundAbove : na
float openSkyTargetLong = not na(openSkyRoundTargetLong) and atr > 0.0 and (openSkyRoundTargetLong - close) / atr <= maxTargetExtensionAtr ? openSkyRoundTargetLong : openSkyMeasuredTargetLong

float targetT1 =
     directionLong
     ? (openSkyModeActive ? openSkyTargetLong : targetMode == "Measured move" ? measuredTargetLong : targetMode == "Next liquidity" ? (r2IsTargetLiquidity ? nextLiquidityTargetLong : measuredTargetLong) : autoTargetLong)
     : directionShort
     ? (targetMode == "Measured move" ? measuredTargetShort : targetMode == "Next liquidity" ? (s2IsTargetLiquidity ? nextLiquidityTargetShort : measuredTargetShort) : autoTargetShort)
     : na

bool targetAhead =
     directionLong ? (not na(targetT1) and targetT1 > close + syminfo.mintick) :
     directionShort ? (not na(targetT1) and targetT1 < close - syminfo.mintick) : false

float expectedMovePct =
     directionLong and targetAhead and close != 0.0 ? (targetT1 / close - 1.0) * 100.0 :
     directionShort and targetAhead and close != 0.0 ? (1.0 - targetT1 / close) * 100.0 : na

bool expectedMoveOk = targetAhead and not na(expectedMovePct) and expectedMovePct >= minExpectedMovePct

// ============================================================================
// STRUCTURAL SL / R:R / TRADE QUALITY / CONTINUATION
// ============================================================================

float lastPivotLow = ta.valuewhen(not na(pivotLow), pivotLow, 0)
float lastPivotHigh = ta.valuewhen(not na(pivotHigh), pivotHigh, 0)
int lastPivotLowBar = int(nz(ta.valuewhen(not na(pivotLow), bar_index - effectivePivotLen, 0), -100000))
int lastPivotHighBar = int(nz(ta.valuewhen(not na(pivotHigh), bar_index - effectivePivotLen, 0), -100000))
bool recentPivotLowEligible = lastPivotLowBar > -100000 and bar_index - lastPivotLowBar <= effectiveStopLookback
bool recentPivotHighEligible = lastPivotHighBar > -100000 and bar_index - lastPivotHighBar <= effectiveStopLookback

float fallbackLongStop = ta.lowest(low, effectiveStopLookback) - atr * stopAtrBuffer
float fallbackShortStop = ta.highest(high, effectiveStopLookback) + atr * stopAtrBuffer
float estimatedSL =
     directionLong ? ((recentPivotLowEligible and not na(lastPivotLow) and lastPivotLow < close) ? lastPivotLow - atr * stopAtrBuffer : fallbackLongStop) :
     directionShort ? ((recentPivotHighEligible and not na(lastPivotHigh) and lastPivotHigh > close) ? lastPivotHigh + atr * stopAtrBuffer : fallbackShortStop) : na

bool slDirectionalOk =
     directionLong ? (not na(estimatedSL) and estimatedSL < close - syminfo.mintick) :
     directionShort ? (not na(estimatedSL) and estimatedSL > close + syminfo.mintick) : false

float stopDistance =
     directionLong and slDirectionalOk ? close - estimatedSL :
     directionShort and slDirectionalOk ? estimatedSL - close : na
float stopDistanceAtr = not na(stopDistance) and atr > 0.0 ? stopDistance / atr : na
float rewardDistance =
     directionLong and targetAhead ? targetT1 - close :
     directionShort and targetAhead ? close - targetT1 : na
float rewardDistanceAtr = not na(rewardDistance) and atr > 0.0 ? rewardDistance / atr : na
float rrToT1 = not na(rewardDistance) and not na(stopDistance) and stopDistance > syminfo.mintick ? rewardDistance / stopDistance : na

bool rrOk = targetAhead and slDirectionalOk and not na(rrToT1) and rrToT1 >= minRRSafetyFloor
bool stopAtrOk = slDirectionalOk and not na(stopDistanceAtr) and stopDistanceAtr <= maxStopAtr

float rrQuality = f_rrQualityScore(rrToT1, minRRSafetyFloor, minRR)
float stopQuality = not na(stopDistanceAtr) ? (1.0 - f_clamp(stopDistanceAtr / math.max(maxStopAtr, 0.1), 0.0, 1.0)) * 100.0 : 0.0
float expectedMoveQuality = targetAhead and not na(expectedMovePct) ? (minExpectedMovePct > 0.0 ? f_clamp(expectedMovePct / minExpectedMovePct * 60.0, 0.0, 100.0) : 100.0) : 0.0
float geometryTargetReferenceAtr = math.max(targetAtrExtension * 1.50, math.max(minRemainingTargetAtr * 2.50, 0.50))
float targetSpaceQuality = targetAhead and not na(rewardDistanceAtr) ? f_clamp(rewardDistanceAtr / geometryTargetReferenceAtr * 100.0, 0.0, 100.0) : 0.0
float geometryLiquidityQuality =
     directionLong ? (r2IsTargetLiquidity ? 100.0 : activeCascade ? 75.0 : 55.0) :
     directionShort ? (s2IsTargetLiquidity ? 100.0 : activeCascade ? 75.0 : 55.0) : 0.0

// GEOMETRY QUALITY 0..100 — owns only SL / reward / target-space information.
float geometryQuality = direction != 0 and targetAhead and slDirectionalOk ? f_clamp(
     rrQuality * 0.35 +
     stopQuality * 0.20 +
     expectedMoveQuality * 0.20 +
     targetSpaceQuality * 0.15 +
     geometryLiquidityQuality * 0.10, 0.0, 100.0) : 0.0

// Legacy Trade Quality is now a strict compatibility alias to Geometry Quality.
float tradeQuality = geometryQuality

// ============================================================================
// EXHAUSTION RISK 0..100 + PULLBACK / MAE RISK 0..100 — independent dimensions
//
// Exhaustion Risk = overextension / acceleration / climax / divergence only.
// MAE Risk = local adverse-flow / pullback / deceleration / failure only.
// Context and Geometry are scored separately, so no raw factor is shared across dimensions.
// ============================================================================

// Stable risk denominator. A sudden ATR spike no longer mechanically compresses all
// extension measurements on exactly the candle where volatility expands.
float riskAtrSmoothed = ta.sma(atr, effectiveRiskAtrSmoothingLen)
float riskAtr = math.max(nz(riskAtrSmoothed, atr), syminfo.mintick)
float emaExtensionAtr = direction != 0 ? math.abs(close - emaFast) / riskAtr : 0.0

// -----------------------------------------------------------------------------
// GENERATION-LOCAL RESET STATE
// OLD BUG FIXED: the first adverse candle is NOT itself a completed reset.
// It opens a pending pullback. Reset is confirmed only after directional recovery.
// All state is scoped to the current lockedStartBar + direction and cannot leak.
// -----------------------------------------------------------------------------
float fallbackLegLow = ta.lowest(low, effectiveExhaustionLegLookback)
float fallbackLegHigh = ta.highest(high, effectiveExhaustionLegLookback)
int fallbackLegLowOffset = int(nz(ta.lowestbars(low, effectiveExhaustionLegLookback), 0))
int fallbackLegHighOffset = int(nz(ta.highestbars(high, effectiveExhaustionLegLookback), 0))
int fallbackLegLowBar = bar_index - fallbackLegLowOffset
int fallbackLegHighBar = bar_index - fallbackLegHighOffset

bool meaningfulPullbackLong =
     directionLong and close < open and (high - low) / riskAtr >= meaningfulPullbackAtr and closeLocation <= 0.50
bool meaningfulPullbackShort =
     directionShort and close > open and (high - low) / riskAtr >= meaningfulPullbackAtr and closeLocation >= 0.50

var int riskStateDirection = 0
var int riskStateGeneration = na
var float confirmedResetAnchor = na
var int confirmedResetAnchorBar = na
var int confirmedResetConfirmationBar = na
var bool pendingResetActive = false
var float pendingResetExtreme = na
var int pendingResetExtremeBar = na
var int pendingResetStartBar = na

bool riskGenerationChanged =
     direction != 0 and
     (riskStateDirection != direction or nz(riskStateGeneration, -1) != nz(lockedStartBar, -1))

if direction == 0
    riskStateDirection := 0
    riskStateGeneration := na
    confirmedResetAnchor := na
    confirmedResetAnchorBar := na
    confirmedResetConfirmationBar := na
    pendingResetActive := false
    pendingResetExtreme := na
    pendingResetExtremeBar := na
    pendingResetStartBar := na
else if riskGenerationChanged
    riskStateDirection := direction
    riskStateGeneration := lockedStartBar
    confirmedResetAnchor := directionLong ? fallbackLegLow : fallbackLegHigh
    confirmedResetAnchorBar := directionLong ? fallbackLegLowBar : fallbackLegHighBar
    // Baseline is adopted when the setup generation starts; the anchor itself keeps
    // the true historical extreme bar so barsSinceReset is no longer fabricated.
    confirmedResetConfirmationBar := bar_index
    pendingResetActive := false
    pendingResetExtreme := na
    pendingResetExtremeBar := na
    pendingResetStartBar := na

// The ordered correction state machine is already recovery-confirmed, so it may
// directly establish a reset anchor — but only inside the active setup generation.
if directionLong and correctionResetLong and not correctionResetLong[1] and not na(seqLongLow)
    confirmedResetAnchor := seqLongLow
    confirmedResetAnchorBar := seqLongLowBar
    confirmedResetConfirmationBar := bar_index
    pendingResetActive := false
    pendingResetExtreme := na
    pendingResetExtremeBar := na
    pendingResetStartBar := na
if directionShort and correctionResetShort and not correctionResetShort[1] and not na(seqShortHigh)
    confirmedResetAnchor := seqShortHigh
    confirmedResetAnchorBar := seqShortHighBar
    confirmedResetConfirmationBar := bar_index
    pendingResetActive := false
    pendingResetExtreme := na
    pendingResetExtremeBar := na
    pendingResetStartBar := na

// First meaningful counter candle starts/extends a PENDING pullback; it does not
// erase extension risk. This fixes the prior paradox where risk fell as MAE began.
if meaningfulPullbackLong
    if not pendingResetActive
        pendingResetActive := true
        pendingResetStartBar := bar_index
        pendingResetExtreme := low
        pendingResetExtremeBar := bar_index
    else if low < nz(pendingResetExtreme, low + syminfo.mintick)
        pendingResetExtreme := low
        pendingResetExtremeBar := bar_index
if meaningfulPullbackShort
    if not pendingResetActive
        pendingResetActive := true
        pendingResetStartBar := bar_index
        pendingResetExtreme := high
        pendingResetExtremeBar := bar_index
    else if high > nz(pendingResetExtreme, high - syminfo.mintick)
        pendingResetExtreme := high
        pendingResetExtremeBar := bar_index

// While pending, keep tracking the adverse extreme even on smaller candles.
if pendingResetActive and directionLong and low < nz(pendingResetExtreme, low + syminfo.mintick)
    pendingResetExtreme := low
    pendingResetExtremeBar := bar_index
if pendingResetActive and directionShort and high > nz(pendingResetExtreme, high - syminfo.mintick)
    pendingResetExtreme := high
    pendingResetExtremeBar := bar_index

float pendingRecoveryAtr =
     pendingResetActive and directionLong ? math.max(close - nz(pendingResetExtreme, close), 0.0) / riskAtr :
     pendingResetActive and directionShort ? math.max(nz(pendingResetExtreme, close) - close, 0.0) / riskAtr : 0.0

bool pendingResetRecovered =
     pendingResetActive and
     (directionLong ? (close > open and close >= emaFast and pendingRecoveryAtr >= resetRecoveryAtr) :
      directionShort ? (close < open and close <= emaFast and pendingRecoveryAtr >= resetRecoveryAtr) : false)

if pendingResetRecovered
    confirmedResetAnchor := pendingResetExtreme
    confirmedResetAnchorBar := pendingResetExtremeBar
    confirmedResetConfirmationBar := bar_index
    pendingResetActive := false
    pendingResetExtreme := na
    pendingResetExtremeBar := na
    pendingResetStartBar := na

float activeResetAnchor = not na(confirmedResetAnchor) ? confirmedResetAnchor : directionLong ? fallbackLegLow : fallbackLegHigh
float moveSinceResetAtr =
     directionLong ? math.max(close - activeResetAnchor, 0.0) / riskAtr :
     directionShort ? math.max(activeResetAnchor - close, 0.0) / riskAtr : 0.0
int barsSinceReset = direction != 0 and not na(confirmedResetAnchorBar) ? math.max(bar_index - confirmedResetAnchorBar, 0) : 0

// -----------------------------------------------------------------------------
// EXTENSION / ACCELERATION
// -----------------------------------------------------------------------------
int riskBarsInSetup = direction != 0 and not na(lockedStartBar) ? math.max(bar_index - lockedStartBar, 0) : 0
bool strongBullImpulseBar = close > open and math.abs(close - open) / riskAtr >= minBodyAtr
bool strongBearImpulseBar = close < open and math.abs(close - open) / riskAtr >= minBodyAtr
float strongBullBars = math.sum(strongBullImpulseBar ? 1.0 : 0.0, effectiveAccelerationLookback)
float strongBearBars = math.sum(strongBearImpulseBar ? 1.0 : 0.0, effectiveAccelerationLookback)
float accelerationMoveAtrLong = not na(close[effectiveAccelerationLookback]) ? math.max(close - close[effectiveAccelerationLookback], 0.0) / riskAtr : 0.0
float accelerationMoveAtrShort = not na(close[effectiveAccelerationLookback]) ? math.max(close[effectiveAccelerationLookback] - close, 0.0) / riskAtr : 0.0
bool noPullbackAcceleration =
     directionLong ? (riskBarsInSetup >= effectiveAccelerationLookback and not pendingResetActive and barsSinceReset >= effectiveMinNoPullbackBars and strongBullBars >= accelerationStrongBars and accelerationMoveAtrLong >= accelerationMinMoveAtr) :
     directionShort ? (riskBarsInSetup >= effectiveAccelerationLookback and not pendingResetActive and barsSinceReset >= effectiveMinNoPullbackBars and strongBearBars >= accelerationStrongBars and accelerationMoveAtrShort >= accelerationMinMoveAtr) : false

float postBreakRiskComponent = f_clamp(postBreakExtensionAtr / math.max(maxPostBreakEntryAtr * 2.0, 0.1), 0.0, 1.0) * 20.0
float emaRiskComponent = f_riskScale(emaExtensionAtr, emaExtensionWarnAtr, emaExtensionExtremeAtr) * 15.0
float resetRiskComponent = f_riskScale(moveSinceResetAtr, moveSinceResetWarnAtr, moveSinceResetExtremeAtr) * 15.0
float accelerationRiskComponent = noPullbackAcceleration ? 10.0 : 0.0

// -----------------------------------------------------------------------------
// DIRECT COUNTER-PRESSURE + PULLBACK DEPTH
// These components close the old dead-zone where risk could stay at 0 while an
// adverse move was already visibly developing.
// -----------------------------------------------------------------------------
bool adverseBar = directionLong ? close < open : directionShort ? close > open : false
float adverseBodyAtr =
     directionLong ? math.max(open - close, 0.0) / riskAtr :
     directionShort ? math.max(close - open, 0.0) / riskAtr : 0.0
float adverseRangeAtr = direction != 0 ? (high - low) / riskAtr : 0.0
bool riskSameGeneration1 = direction != 0 and direction[1] == direction and nz(lockedStartBar[1], -1) == nz(lockedStartBar, -1)
bool riskSameGeneration2 = riskSameGeneration1 and direction[2] == direction and nz(lockedStartBar[2], -1) == nz(lockedStartBar, -1)
float priorAdverseRangeAtr = riskSameGeneration1 ? nz(adverseRangeAtr[1], adverseRangeAtr) : adverseRangeAtr
float adverseBars3 =
     (adverseBar ? 1.0 : 0.0) +
     (riskSameGeneration1 and adverseBar[1] ? 1.0 : 0.0) +
     (riskSameGeneration2 and adverseBar[2] ? 1.0 : 0.0)
float adverseCloseSeverity =
     directionLong ? f_clamp((0.50 - closeLocation) / 0.50, 0.0, 1.0) :
     directionShort ? f_clamp((closeLocation - 0.50) / 0.50, 0.0, 1.0) : 0.0
float counterPressureScore = direction != 0 ? f_clamp(
     f_clamp(adverseBodyAtr / math.max(counterPressureExtremeAtr, 0.05), 0.0, 1.0) * 45.0 +
     adverseCloseSeverity * 25.0 +
     f_clamp((adverseBars3 - 1.0) / 2.0, 0.0, 1.0) * 20.0 +
     (adverseBar and adverseRangeAtr > priorAdverseRangeAtr * 1.10 ? 10.0 : 0.0),
     0.0, 100.0) : 0.0

float recentRiskHigh = high
float recentRiskLow = low
if direction != 0
    for i = 1 to effectivePullbackRiskLookback - 1
        if i <= riskBarsInSetup
            recentRiskHigh := math.max(recentRiskHigh, high[i])
            recentRiskLow := math.min(recentRiskLow, low[i])
float pullbackFromExtremeAtr =
     directionLong ? math.max(recentRiskHigh - close, 0.0) / riskAtr :
     directionShort ? math.max(close - recentRiskLow, 0.0) / riskAtr : 0.0
float pullbackDepthScore = direction != 0 ? f_riskScale(
     pullbackFromExtremeAtr,
     pullbackRiskStartAtr,
     math.max(pullbackRiskExtremeAtr, pullbackRiskStartAtr + 0.05)) * 100.0 : 0.0

// -----------------------------------------------------------------------------
// MOMENTUM DECELERATION
// Compare most recent directional velocity with the immediately preceding segment.
// -----------------------------------------------------------------------------
bool decelWindowValid = effectiveDecelerationSlowBars > effectiveDecelerationFastBars and riskBarsInSetup >= effectiveDecelerationSlowBars
int decelPriorSpan = math.max(effectiveDecelerationSlowBars - effectiveDecelerationFastBars, 1)
float recentDirectionalVelocity =
     decelWindowValid and directionLong and not na(close[effectiveDecelerationFastBars]) ? (close - close[effectiveDecelerationFastBars]) / riskAtr / effectiveDecelerationFastBars :
     decelWindowValid and directionShort and not na(close[effectiveDecelerationFastBars]) ? (close[effectiveDecelerationFastBars] - close) / riskAtr / effectiveDecelerationFastBars : 0.0
float priorDirectionalVelocity =
     decelWindowValid and directionLong and not na(close[effectiveDecelerationSlowBars]) ? (close[effectiveDecelerationFastBars] - close[effectiveDecelerationSlowBars]) / riskAtr / decelPriorSpan :
     decelWindowValid and directionShort and not na(close[effectiveDecelerationSlowBars]) ? (close[effectiveDecelerationSlowBars] - close[effectiveDecelerationFastBars]) / riskAtr / decelPriorSpan : 0.0
float velocityDecayScore =
     priorDirectionalVelocity > 0.0
     ? (recentDirectionalVelocity <= 0.0 ? 100.0 : f_clamp(1.0 - recentDirectionalVelocity / priorDirectionalVelocity, 0.0, 1.0) * 100.0)
     : 0.0
float weakCloseScore =
     directionLong ? f_clamp((0.60 - closeLocation) / 0.60, 0.0, 1.0) * 100.0 :
     directionShort ? f_clamp((closeLocation - 0.40) / 0.60, 0.0, 1.0) * 100.0 : 0.0
float decelerationScore = direction != 0 ? f_clamp(velocityDecayScore * 0.75 + weakCloseScore * 0.25, 0.0, 100.0) : 0.0

// -----------------------------------------------------------------------------
// CLIMAX / REJECTION PERSISTENCE — setup-generation scoped with linear decay.
// -----------------------------------------------------------------------------
bool volumeClimax =
     direction != 0 and not na(rvol) and rvol >= volumeClimaxRvol and
     adverseRangeAtr >= volumeClimaxRangeAtr and
     (emaExtensionAtr >= emaExtensionWarnAtr or moveSinceResetAtr >= moveSinceResetWarnAtr or postBreakExtensionAtr >= maxPostBreakEntryAtr * 0.75)

bool rejectionLongNow = directionLong and not na(upperWickAtr) and upperWickAtr >= reversalWickAtr and closeLocation <= reversalCloseLocation
bool rejectionShortNow = directionShort and not na(lowerWickAtr) and lowerWickAtr >= reversalWickAtr and closeLocation >= 1.0 - reversalCloseLocation
bool reversalRejectionNow = rejectionLongNow or rejectionShortNow

var int lastVolumeClimaxBar = na
var int lastVolumeClimaxGeneration = na
var int lastRejectionBar = na
var int lastRejectionGeneration = na
var int previousRejectionBar = na
var int previousRejectionGeneration = na

if volumeClimax
    lastVolumeClimaxBar := bar_index
    lastVolumeClimaxGeneration := lockedStartBar
if reversalRejectionNow
    if nz(lastRejectionGeneration, -1) == nz(lockedStartBar, -1) and not na(lastRejectionBar)
        previousRejectionBar := lastRejectionBar
        previousRejectionGeneration := lastRejectionGeneration
    else
        previousRejectionBar := na
        previousRejectionGeneration := na
    lastRejectionBar := bar_index
    lastRejectionGeneration := lockedStartBar

int volumeClimaxAge =
     direction != 0 and nz(lastVolumeClimaxGeneration, -1) == nz(lockedStartBar, -1) and not na(lastVolumeClimaxBar)
     ? bar_index - lastVolumeClimaxBar : 100000
int rejectionAge =
     direction != 0 and nz(lastRejectionGeneration, -1) == nz(lockedStartBar, -1) and not na(lastRejectionBar)
     ? bar_index - lastRejectionBar : 100000
float volumeClimaxPersistence =
     volumeClimaxAge <= effectiveReversalEvidencePersistenceBars
     ? 1.0 - volumeClimaxAge / math.max(effectiveReversalEvidencePersistenceBars + 1.0, 1.0) : 0.0
int previousRejectionAge =
     direction != 0 and nz(previousRejectionGeneration, -1) == nz(lockedStartBar, -1) and not na(previousRejectionBar)
     ? bar_index - previousRejectionBar : 100000
float rejectionPersistence =
     rejectionAge <= effectiveRejectionRiskPersistenceBars
     ? 1.0 - rejectionAge / math.max(effectiveRejectionRiskPersistenceBars + 1.0, 1.0) : 0.0
bool repeatedLockedRejectionRecent =
     rejectionAge <= effectiveRejectionRiskPersistenceBars and
     previousRejectionAge <= effectiveRejectionRiskPersistenceBars
float volumeClimaxRiskComponent = volumeClimaxPersistence * 15.0

// -----------------------------------------------------------------------------
// FAILED SWEEP — persistent but setup-generation local (no ta.barssince leakage).
// -----------------------------------------------------------------------------
bool failedLockedSweepLongNow = directionLong and not na(lockedZoneTop) and not na(lockedZoneBottom) and high > lockedZoneTop + levelTolerance and close < lockedZoneBottom
bool failedLockedSweepShortNow = directionShort and not na(lockedZoneTop) and not na(lockedZoneBottom) and low < lockedZoneBottom - levelTolerance and close > lockedZoneTop
bool lifecycleFailedSweepAgainstDirection =
     directionLong ? (not na(lockedZoneId) and not na(newResistanceFailedSweepZoneId) and newResistanceFailedSweepZoneId == lockedZoneId) :
     directionShort ? (not na(lockedZoneId) and not na(newSupportFailedSweepZoneId) and newSupportFailedSweepZoneId == lockedZoneId) : false
bool failedLockedSweepNow = failedLockedSweepLongNow or failedLockedSweepShortNow or lifecycleFailedSweepAgainstDirection
var int lastFailedSweepRiskBar = na
var int lastFailedSweepRiskGeneration = na
if failedLockedSweepNow and direction != 0
    lastFailedSweepRiskBar := bar_index
    lastFailedSweepRiskGeneration := lockedStartBar
int barsSinceFailedLockedSweep =
     direction != 0 and nz(lastFailedSweepRiskGeneration, -1) == nz(lockedStartBar, -1) and not na(lastFailedSweepRiskBar)
     ? bar_index - lastFailedSweepRiskBar : 100000
bool failedLockedSweepRecent = barsSinceFailedLockedSweep <= effectiveFailedBreakRecentBars

// External divergence + target context.
float priorOiHigh = ta.highest(oiExternalSource[1], effectiveDivergenceLookback)
float priorCvdHigh = ta.highest(cvdExternalSource[1], effectiveDivergenceLookback)
float priorCvdLow = ta.lowest(cvdExternalSource[1], effectiveDivergenceLookback)
float priorPriceHighForDiv = ta.highest(high[1], effectiveDivergenceLookback)
float priorPriceLowForDiv = ta.lowest(low[1], effectiveDivergenceLookback)

bool priceNewHighForDiv = high > priorPriceHighForDiv
bool priceNewLowForDiv = low < priorPriceLowForDiv
bool oiDivergence = useOiDivergence and (directionLong ? (priceNewHighForDiv and oiExternalSource <= priorOiHigh) : directionShort ? (priceNewLowForDiv and oiExternalSource <= priorOiHigh) : false)
bool cvdDivergence = useCvdDivergence and (directionLong ? (priceNewHighForDiv and cvdExternalSource <= priorCvdHigh) : directionShort ? (priceNewLowForDiv and cvdExternalSource >= priorCvdLow) : false)
float externalDivergenceRisk = (oiDivergence ? 5.0 : 0.0) + (cvdDivergence ? 5.0 : 0.0)

// EXHAUSTION RISK 0..100 — owns only overextension/climax/divergence evidence.
// Counter pressure, pullback, rejection/failed sweep, BTC and whipsaw are intentionally excluded.
float extensionRiskFamily = math.min(
     postBreakRiskComponent + emaRiskComponent + resetRiskComponent + accelerationRiskComponent,
     45.0)
float shortRealizedMoveExhaustion =
     directionShort and not na(return24h) and return24h < 0.0
     ? f_riskScale(math.abs(return24h), maxShortDrop24 * 0.60, maxShortDrop24) * 15.0 : 0.0
float exhaustionRisk = direction != 0 ? f_clamp(
     f_clamp(extensionRiskFamily / 45.0, 0.0, 1.0) * 75.0 +
     volumeClimaxRiskComponent +
     externalDivergenceRisk +
     shortRealizedMoveExhaustion, 0.0, 100.0) : 0.0
string exhaustionRiskLevel = exhaustionRisk >= 85.0 ? "EXTREME" : exhaustionRisk >= 70.0 ? "HIGH" : exhaustionRisk >= 50.0 ? "ELEVATED" : exhaustionRisk >= 30.0 ? "NORMAL" : "LOW"

// Legacy Reversal Risk remains an exact compatibility alias to Exhaustion Risk.
float reversalRisk = exhaustionRisk
bool reversalWarning = enableReversalGuard and direction != 0 and exhaustionRisk >= reversalWarningThreshold
bool gateReversal = not enableReversalGuard or exhaustionRisk < maxReversalRiskForPineReady

// -----------------------------------------------------------------------------
// PULLBACK / MAE RISK 0..100 — PATH-AWARE, ORTHOGONAL v1.10
// Only adverse-flow evidence belongs here: Counter / Pullback-Retest / Deceleration /
// local Failure-Rejection. Execution, Context and Exhaustion are separate dimensions.
// -----------------------------------------------------------------------------

// RETEST uses penetration/reclaim quality instead of raw distance from breakout extreme.
float retestPenetrationAtrRisk =
     directionLong and not na(lockedZoneTop) ? math.max(lockedZoneTop - low, 0.0) / riskAtr :
     directionShort and not na(lockedZoneBottom) ? math.max(high - lockedZoneBottom, 0.0) / riskAtr : 0.0
float retestZoneThicknessAtr = not na(lockedZoneTop) and not na(lockedZoneBottom) ? math.max(lockedZoneTop - lockedZoneBottom, 0.0) / riskAtr : 0.0
float retestAllowedDepthAtr = math.max(retestZoneThicknessAtr + maxRetestPenetrationAtr, 0.05)
float retestPenetrationScore = f_clamp(retestPenetrationAtrRisk / retestAllowedDepthAtr * 100.0, 0.0, 100.0)

float maeFailureScore = 0.0
if direction != 0
    maeFailureScore := math.max(maeFailureScore, failedLockedSweepRecent ? 100.0 : 0.0)
    maeFailureScore := math.max(maeFailureScore, repeatedLockedRejectionRecent ? 90.0 : reversalRejectionNow ? 80.0 : rejectionPersistence > 0.0 ? 60.0 * rejectionPersistence : 0.0)
    maeFailureScore := math.max(maeFailureScore, activeCurrentWickRisk ? 55.0 : 0.0)

[maeCounterScore, maePullbackScore, maeDecelerationScore, maeFailureAdjustedScore] =
     f_pathMaeAdjusted(riskPathCode, counterPressureScore, pullbackDepthScore, decelerationScore, maeFailureScore, retestPenetrationScore)
[maeWeightCounter, maeWeightPullback, maeWeightDeceleration, maeWeightFailure] =
     f_pathMaeWeights(riskPathCode)

float maeRisk = direction != 0 ? f_clamp(
     maeCounterScore * maeWeightCounter +
     maePullbackScore * maeWeightPullback +
     maeDecelerationScore * maeWeightDeceleration +
     maeFailureAdjustedScore * maeWeightFailure,
     0.0, 100.0) : 0.0
string maeRiskLevel = maeRisk >= 85.0 ? "EXTREME" : maeRisk >= 70.0 ? "HIGH" : maeRisk >= 50.0 ? "ELEVATED" : maeRisk >= 30.0 ? "NORMAL" : "LOW"

// Legacy Pullback/MAE variables remain exact aliases.
float pullbackMaeRisk = maeRisk
bool gateMaeRisk = direction == 0 or maeRisk < maxMaeRiskForPineReady

bool gateExpectedMove = expectedMoveOk
bool gateGeometry = targetAhead and slDirectionalOk and rrOk and stopAtrOk and geometryQuality >= minTradeQuality
bool gateRisk = gateGeometry and gateContext and gateLiquidity and gateBtcShock and gateShortExhaustion and gateReversal and gateMaeRisk

// Once liquidity is consumed, the old target cannot produce an arbitrary delayed entry.
// Valid exceptions are the actual break bar OR an accepted retest/hold of the same frozen level.
bool gateConsumedExecution = not lockedLiquidityConsumed or breakoutLong or breakdownShort or postBreakRetestAccepted or postBreakHoldLong
bool targetConsumedUnresolved = lockedLiquidityConsumed and nz(lockedBreakGeneration, -1) != nz(lockedStartBar, -1)

// v1.15.1 FRESH TRIGGER GATE.
// A slow gate (especially Fixed-time In-Play / Context) is not allowed to unlock READY
// one bar later while the same pre-break trigger and fast metrics are deteriorating.
bool sameSetupGenerationPrev =
     direction != 0 and direction[1] == direction and
     nz(lockedStartBar[1], -1) == nz(lockedStartBar, -1)
bool triggerNewThisBar = gateTrigger and (not sameSetupGenerationPrev or not gateTrigger[1])
bool currentPreBreakPath = directionLong and (entryPath == "PRE-BREAK" or entryPath == "COMPRESSION")
bool currentSoftTriggerPath = directionLong and (entryPath == "PRE-BREAK" or entryPath == "COMPRESSION" or entryPath == "DIRECT MOMENTUM")
bool fastMetricsDeteriorating =
     sameSetupGenerationPrev and
     formationQuality < formationQuality[1] and executionQuality < executionQuality[1] and
     activeApproachScore < activeApproachScore[1] and
     (na(activeDistanceAtr[1]) or na(activeDistanceAtr) or activeDistanceAtr >= activeDistanceAtr[1])
bool fastTriggerReconfirmed =
     gateTrigger and sameSetupGenerationPrev and not fastMetricsDeteriorating and
     (executionQuality >= executionQuality[1] or formationQuality >= formationQuality[1] or activeApproachScore > activeApproachScore[1]) and
     (not directionLong or na(activeDistanceAtr[1]) or na(activeDistanceAtr) or activeDistanceAtr <= activeDistanceAtr[1])
bool structuralFreshTrigger = breakoutLong or breakdownShort or breakdownRetestShort or postBreakRetestAccepted or openSkyContinuationTrigger
bool gateFreshReadyTrigger =
     not requireFreshTriggerForPineReady or
     structuralFreshTrigger or
     (currentSoftTriggerPath and (triggerNewThisBar or fastTriggerReconfirmed))

// PRE-BREAK / COMPRESSION has a stricter safety profile than an actual break/retest.
// This specifically blocks weak one-touch / 2-of-4 In-Play / low-RR compression READYs.
bool preBreakLevelStrengthOk = lockedTouches >= preBreakReadyMinTouches or activeLevelQuality >= preBreakReadyStrongSingleTouchLevel
bool preBreakActivityOk = activityCheckCount >= preBreakReadyMinInPlay or volumeReExpansion
bool preBreakSafetyAllowed =
     not currentPreBreakPath or (
         activeLevelQuality >= preBreakReadyMinLevelQuality and
         formationQuality >= preBreakReadyMinFormation and executionQuality >= preBreakReadyMinExecution and
         activeApproachScore >= preBreakReadyMinApproach and
         not na(rrToT1) and rrToT1 >= preBreakReadyMinRR and
         preBreakActivityOk and preBreakLevelStrengthOk and
         distanceImprovingLong and rejectionWeakeningLong and
         not repeatedLockedRejectionRecent)

bool entryReady =
     armed and gateTrigger and gateFreshReadyTrigger and preBreakSafetyAllowed and
     gateExpectedMove and gateRisk and gateConsumedExecution and
     entryReadiness >= minEntryReadiness


// MATURED / PRE-BREAK ENTRY: no gateTrigger, but it now shares the strict early-entry
// safety principles so it cannot become a looser substitute for PINE READY.
bool maturedEntryStructureLong = directionLong and not isPostBreak and (
     candidateCompressionLong or candidateProtoBreakLong or candidatePreBreakLong or
     broadConsolidationLong or (dynamicSupportLong and activeAcceptance))
bool maturedStrictActivityOk = activityCheckCount >= preBreakReadyMinInPlay or volumeReExpansion
bool maturedStrictLevelOk = lockedTouches >= preBreakReadyMinTouches or activeLevelQuality >= preBreakReadyStrongSingleTouchLevel
bool maturedEntryFiltersAllowed =
     enableMaturedEntryMode and maturedEntryStructureLong and not gateTrigger and
     validWatch and gateInPlay and gateLiquidity and gateStructure and
     activeLevelQuality >= maturedEntryMinLevelQuality and activeApproachScore >= maturedEntryMinApproachScore and
     not na(activeDistanceAtr) and activeDistanceAtr <= maturedEntryMaxDistanceAtr and
     formationQuality >= maturedEntryMinFormation and executionQuality >= maturedEntryMinExecution and
     targetAhead and slDirectionalOk and stopAtrOk and not na(rrToT1) and rrToT1 >= maturedEntryMinRR and
     geometryQuality >= maturedEntryMinGeometry and contextQuality >= maturedEntryMinContext and gateBtcShock and
     maeRisk <= maturedEntryMaxMae and exhaustionRisk <= maturedEntryMaxExhaustion and
     maturedStrictActivityOk and maturedStrictLevelOk and
     distanceImprovingLong and rejectionWeakeningLong and not repeatedLockedRejectionRecent

// ============================================================================
// PERSISTENT SETUP STATE MACHINE v1.9
// State moves only forward inside the same lockedStartBar generation. Temporary
// deterioration is exposed as DEGRADED but never rewinds WATCH/ARMED/TRIGGERED.
// This makes alerts and UI describe lifecycle rather than raw one-bar oscillations.
// ============================================================================
var int setupFsmDirection = 0
var int setupFsmGeneration = na
var int setupFsmState = FSM_NONE
var string setupFsmPath = "WAIT"
var float setupFsmPathScore = 0.0

bool setupFsmGenerationChanged =
     direction != 0 and
     (setupFsmDirection != direction or nz(setupFsmGeneration, -1) != nz(lockedStartBar, -1))

bool fsmNewWatchEvent = false
bool fsmNewArmedEvent = false
bool fsmNewReadyEvent = false

if direction == 0
    setupFsmDirection := 0
    setupFsmGeneration := na
    setupFsmState := FSM_NONE
    setupFsmPath := "WAIT"
    setupFsmPathScore := 0.0
else
    if setupFsmGenerationChanged
        setupFsmDirection := direction
        setupFsmGeneration := lockedStartBar
        setupFsmState := FSM_FORMING
        setupFsmPath := riskPath
        setupFsmPathScore := entryPathScore > 0.0 ? entryPathScore : candidateEntryPathScore > 0.0 ? candidateEntryPathScore : pathMemoryScore

    if barstate.isconfirmed
        int fsmPreviousState = setupFsmState
        int fsmDesiredState = setupFsmState

        if entryPathScore > 0.0
            setupFsmPath := entryPath
            setupFsmPathScore := entryPathScore
        else if candidateEntryPathScore > setupFsmPathScore and candidateEntryPathScore > 0.0 and setupFsmState < FSM_TRIGGERED
            setupFsmPath := candidateEntryPath
            setupFsmPathScore := candidateEntryPathScore
        else if setupFsmPath == "WAIT" and riskPath != "WAIT"
            setupFsmPath := riskPath
            setupFsmPathScore := pathMemoryScore

        if validWatch
            fsmDesiredState := math.max(fsmDesiredState, FSM_WATCH)
        if validWatch and activeApproach
            fsmDesiredState := math.max(fsmDesiredState, FSM_APPROACH)
        if armed
            fsmDesiredState := math.max(fsmDesiredState, FSM_ARMED)
        if fsmDesiredState >= FSM_ARMED and gateTrigger
            fsmDesiredState := math.max(fsmDesiredState, FSM_TRIGGERED)
        if fsmDesiredState >= FSM_WATCH and (generationPostBreakPhase or openSkyModeActive)
            fsmDesiredState := math.max(fsmDesiredState, FSM_RETEST)
        if entryReady
            fsmDesiredState := math.max(fsmDesiredState, FSM_READY)
        if fsmPreviousState == FSM_READY
            fsmDesiredState := FSM_ACTIVE

        setupFsmState := fsmDesiredState
        fsmNewReadyEvent := fsmPreviousState < FSM_READY and setupFsmState >= FSM_READY
        fsmNewArmedEvent := armed and fsmPreviousState < FSM_ARMED and setupFsmState >= FSM_ARMED and setupFsmState < FSM_READY
        fsmNewWatchEvent := validWatch and fsmPreviousState < FSM_WATCH and setupFsmState >= FSM_WATCH and setupFsmState < FSM_ARMED

bool fsmWatchDegraded = direction != 0 and setupFsmState >= FSM_WATCH and setupFsmState < FSM_ARMED and not validWatch
bool fsmArmedDegraded = direction != 0 and setupFsmState >= FSM_ARMED and setupFsmState < FSM_RETEST and not armed

// v1.15.1 — ACTIVE PLAN HEALTH is live and may deteriorate even though the lifecycle FSM
// deliberately stays ACTIVE. It never moves the frozen SL/T1; it changes management guidance.
bool activePlanNow = direction != 0 and setupFsmState == FSM_ACTIVE
bool activePlanExit = activePlanNow and (maeRisk >= activePlanExitMae or failedLockedSweepRecent)
bool activePlanReduce = activePlanNow and not activePlanExit and (
     (maeRisk >= activePlanReduceMae and not gateStructure) or
     (maeRisk >= 60.0 and not gateTrigger))
bool activePlanStructuralDegraded = activePlanNow and not gateStructure and not gateTrigger and formationQuality < minSetupQuality
bool activePlanNoAdd = activePlanNow and (
     activePlanExit or activePlanReduce or targetConsumedUnresolved or not gateBtcShock or
     activePlanStructuralDegraded or not gateStructure or not gateTrigger or
     formationQuality < addOnMinFormation or executionQuality < addOnMinExecution or
     activeApproachScore < addOnMinApproach or maeRisk > addOnMaxMae or exhaustionRisk > addOnMaxExhaustion)
bool addOnFreshConfirmation = directionLong ? (breakoutLong or (postBreakRetestAccepted and longRetestTrigger) or openSkyContinuationTrigger) : directionShort ? (breakdownShort or (postBreakRetestAccepted and shortRetestTrigger)) : false
bool addOnAllowed = activePlanNow and addOnFreshConfirmation and not activePlanNoAdd and
     gateInPlay and gateLiquidity and gateBtcShock and gateLevel and gateStructure and gateApproach and gateDistance and
     gateExpectedMove and gateGeometry and gateContext and gateReversal and
     formationQuality >= addOnMinFormation and executionQuality >= addOnMinExecution and activeApproachScore >= addOnMinApproach and
     maeRisk <= addOnMaxMae and exhaustionRisk <= addOnMaxExhaustion
bool activePlanHealthy = activePlanNow and not activePlanNoAdd


float exhaustionSafety = f_clamp(100.0 - exhaustionRisk, 0.0, 100.0)
float maeSafety = f_clamp(100.0 - maeRisk, 0.0, 100.0)

// Continuation is a downstream meta-score built ONLY from the six independent
// dimensions. No raw factor is injected a second time.
float continuationScore = direction != 0 ? f_clamp(
     formationQuality * 0.30 +
     executionQuality * 0.20 +
     geometryQuality * 0.10 +
     contextQuality * 0.20 +
     exhaustionSafety * 0.10 +
     maeSafety * 0.10, 0.0, 100.0) : 0.0


// ============================================================================
// AVG SETUP 0..100 — SIX-DIMENSION MODEL v1.10
// Formation 30% | Execution 25% | Geometry 15% | Context 10% |
// Exhaustion Safety 10% | MAE Safety 10%.
// Each raw market factor belongs to one base dimension only; AVG SETUP combines
// only dimension outputs, eliminating the former cross-score double counting.
// ============================================================================
float avgSetupInstantPct = direction != 0 ? f_clamp(
     formationQuality * 0.30 +
     executionQuality * 0.25 +
     geometryQuality * 0.15 +
     contextQuality * 0.10 +
     exhaustionSafety * 0.10 +
     maeSafety * 0.10,
     0.0, 100.0) : na

float avgSetupInstant = avgSetupInstantPct

// varip is required here: ordinary var/series state rolls back on every realtime tick.
varip float avgSetupIntrabarSum = 0.0
varip int avgSetupIntrabarSamples = 0
varip int avgSetupIntrabarDirection = 0
varip int avgSetupIntrabarStartBar = na

bool avgSetupIntrabarContextChanged =
     barstate.isnew or
     direction != avgSetupIntrabarDirection or
     nz(lockedStartBar, -1) != nz(avgSetupIntrabarStartBar, -1)

if avgSetupIntrabarContextChanged
    avgSetupIntrabarSum := 0.0
    avgSetupIntrabarSamples := 0
    avgSetupIntrabarDirection := direction
    avgSetupIntrabarStartBar := lockedStartBar

if direction != 0 and not na(avgSetupInstant)
    avgSetupIntrabarSum += avgSetupInstant
    avgSetupIntrabarSamples += 1

float avgSetupBarScore = direction != 0 and avgSetupIntrabarSamples > 0 ? avgSetupIntrabarSum / avgSetupIntrabarSamples : na

float avgSetupHistorySum = 0.0
int avgSetupHistoryCount = 0

if direction != 0 and not na(lockedStartBar)
    for i = 0 to avgSetupBarsHistory - 1
        bool avgSetupSameGeneration =
             not na(avgSetupBarScore[i]) and
             direction[i] == direction and
             nz(lockedStartBar[i], -1) == lockedStartBar
        if avgSetupSameGeneration
            avgSetupHistorySum += avgSetupBarScore[i]
            avgSetupHistoryCount += 1

float avgSetup = avgSetupHistoryCount > 0 ? f_clamp(avgSetupHistorySum / avgSetupHistoryCount, 0.0, 100.0) : na

// Live risk override: smoothing may keep AVG high after the setup has already degraded.
bool avgSetupRiskOverride = direction != 0 and (
     maeRisk >= 60.0 or
     (setupFsmState >= FSM_READY and (not gateStructure or not gateTrigger or targetConsumedUnresolved or not gateBtcShock)))

// AVG SETUP >= 70 — REALTIME INTRABAR crossing.
// varip is essential: the latch must survive Pine rollback on every realtime update.
// `avgSetup70Signal` stays true after the first crossing until the current chart bar ends,
// so TradingView Frequency=Once Per Bar fires immediately while Once Per Bar Close still
// sees the event at candle close. A drop below 70 re-arms the next upward crossing.
const float AVG_SETUP_ALERT_LEVEL = 70.0
varip bool avgSetup70WasAbove = false
varip bool avgSetup70CrossThisBar = false
varip int avgSetup70LatchDirection = 0
varip int avgSetup70LatchStartBar = na

bool avgSetup70ContextChanged =
     direction != avgSetup70LatchDirection or
     nz(lockedStartBar, -1) != nz(avgSetup70LatchStartBar, -1)

if barstate.isnew
    avgSetup70CrossThisBar := false

if avgSetup70ContextChanged
    avgSetup70WasAbove := false
    avgSetup70CrossThisBar := false
    avgSetup70LatchDirection := direction
    avgSetup70LatchStartBar := lockedStartBar

bool avgSetup70AboveNow = direction != 0 and not na(avgSetup) and avgSetup >= AVG_SETUP_ALERT_LEVEL and not avgSetupRiskOverride
bool avgSetup70CrossNow = avgSetup70AboveNow and not avgSetup70WasAbove

if avgSetup70CrossNow
    avgSetup70CrossThisBar := true

avgSetup70WasAbove := avgSetup70AboveNow
bool avgSetup70Signal = avgSetup70CrossThisBar

// EXECUTION QUALITY >= 65 — realtime intrabar crossing, independent from AVG SETUP.
const float EXECUTION_ALERT_LEVEL = 65.0
varip bool execution65WasAbove = false
varip bool execution65CrossThisBar = false
varip int execution65LatchDirection = 0
varip int execution65LatchStartBar = na
bool execution65ContextChanged = direction != execution65LatchDirection or nz(lockedStartBar, -1) != nz(execution65LatchStartBar, -1)
if barstate.isnew
    execution65CrossThisBar := false
if execution65ContextChanged
    execution65WasAbove := false
    execution65CrossThisBar := false
    execution65LatchDirection := direction
    execution65LatchStartBar := lockedStartBar
bool execution65AboveNow = direction != 0 and executionQuality >= EXECUTION_ALERT_LEVEL
bool execution65CrossNow = execution65AboveNow and not execution65WasAbove
if execution65CrossNow
    execution65CrossThisBar := true
execution65WasAbove := execution65AboveNow
bool execution65Signal = execution65CrossThisBar

// ----------------------------------------------------------------------------
// BOUNCE WATCH — отдельная семья, только наблюдение.
// ----------------------------------------------------------------------------
float candleRangeForBounce = high - low
float closeLocationBounce = candleRangeForBounce > 0.0 ? (close - low) / candleRangeForBounce : 0.5
bool bounceActivity = (not na(rvol) and rvol >= bounceMinRvol) or volumeReExpansion
bool bounceLong = enableBounceWatch and lockedDirection == 0 and not na(rawSupport1) and rawSupportQuality >= bounceMinLevelQuality and not na(rawDistanceShortAtr) and rawDistanceShortAtr >= 0.0 and rawDistanceShortAtr <= bounceMaxDistanceAtr and not na(return6h) and return6h <= -bounceMinMove6h and not na(lowerWickAtr) and lowerWickAtr >= bounceMinWickAtr and closeLocationBounce >= 0.55 and bounceActivity
bool bounceShort = enableBounceWatch and lockedDirection == 0 and not na(rawResistance1) and rawResistanceQuality >= bounceMinLevelQuality and not na(rawDistanceLongAtr) and rawDistanceLongAtr >= 0.0 and rawDistanceLongAtr <= bounceMaxDistanceAtr and not na(return6h) and return6h >= bounceMinMove6h and not na(upperWickAtr) and upperWickAtr >= bounceMinWickAtr and closeLocationBounce <= 0.45 and bounceActivity
bool bounceWatch = bounceLong or bounceShort

string setupFamily = openSkyModeActive ? "ATH / OPEN SKY" : direction != 0 ? "CONTINUATION" : bounceWatch ? "BOUNCE WATCH" : "—"

bool retainedRetestWindow = generationPostBreakPhase

string blockerText = ""
if direction == 0
    blockerText := bounceWatch ? "BOUNCE = observation only" : "No locked continuation setup"
else
    blockerText := blockerText + (not gateInPlay ? "IN-PLAY" : "")
    blockerText := blockerText + (not gateLiquidity ? " LIQUIDITY" : "")
    blockerText := blockerText + (not gateBtcShock ? " BTC_SHOCK" : "")
    blockerText := blockerText + (not gateLevel ? " LEVEL" : "")
    blockerText := blockerText + (not validWatch ? " QUALITY" : "")
    blockerText := blockerText + (not gateStructure ? " STRUCTURE" : "")
    blockerText := blockerText + (not gateApproach ? " APPROACH" : "")
    blockerText := blockerText + (not gateDistance ? " DISTANCE" : "")
    blockerText := blockerText + (lockedLiquidityConsumed and not retainedRetestWindow ? " TARGET_CONSUMED" : "")
    blockerText := blockerText + (not gateExpectedMove ? " TARGET" : "")
    blockerText := blockerText + (not rrOk ? " RR" : "")
    blockerText := blockerText + (not stopAtrOk ? " SL" : "")
    blockerText := blockerText + (not gateShortExhaustion ? " EXHAUSTION" : "")
    blockerText := blockerText + (not gateGeometry ? " GEOMETRY" : "")
    blockerText := blockerText + (not gateContext ? " CONTEXT" : "")
    blockerText := blockerText + (not gateReversal ? " EXHAUSTION" : "")
    blockerText := blockerText + (not gateMaeRisk ? " MAE" : "")
    blockerText := blockerText + (not gateTrigger ? " TRIGGER" : "")
    blockerText := blockerText + (gateTrigger and not gateFreshReadyTrigger ? " STALE_TRIGGER" : "")
    blockerText := blockerText + (currentPreBreakPath and not preBreakSafetyAllowed ? " PREBREAK_SAFETY" : "")
    blockerText := blockerText + (entryReadiness < minEntryReadiness ? " ENTRY" : "")
    blockerText := blockerText == "" ? "NONE" : blockerText

string setupState =
     direction != 0
     ? (setupFsmState == FSM_ACTIVE ? (activePlanExit ? "ACTIVE / INVALIDATED" : activePlanNoAdd ? "ACTIVE / DEGRADED" : "ACTIVE / HEALTHY") :
        setupFsmState == FSM_READY ? "PINE READY" :
        setupFsmState == FSM_RETEST ? (openSkyModeActive ? "POST-BREAK HOLD / OPEN SKY" : "POST-BREAK RETEST") :
        setupFsmState == FSM_TRIGGERED ? (fsmArmedDegraded ? "TRIGGERED / DEGRADED" : "TRIGGERED") :
        setupFsmState == FSM_ARMED ? (fsmArmedDegraded ? "ARMED / DEGRADED" : "ARMED") :
        setupFsmState == FSM_APPROACH ? (fsmWatchDegraded ? "APPROACH / DEGRADED" : "APPROACH") :
        setupFsmState == FSM_WATCH ? (fsmWatchDegraded ? "WATCH / DEGRADED" : "WATCH") :
        "FORMING")
     : bounceWatch ? "BOUNCE WATCH" : inPlay ? "IN-PLAY" : "NO SETUP"

// Persistent lifecycle no longer masks live management risk. ACTIVE health has priority.
string actionText =
     activePlanExit ? "EXIT / ABORT ACTIVE PLAN" :
     activePlanReduce ? "REDUCE / NO ADD" :
     activePlanNow and targetConsumedUnresolved ? "NO ADD / TARGET CONSUMED" :
     activePlanNow and not gateBtcShock ? "NO ADD / BTC SHOCK" :
     activePlanNow and activePlanNoAdd ? "ACTIVE DEGRADED / NO ADD" :
     addOnAllowed ? "ADD-ON CONFIRMED" :
     activePlanHealthy ? "ACTIVE HEALTHY / MANAGE PLAN" :
     setupFsmState == FSM_READY and direction != 0 ? "CHECK DOM/TAPE → ENTRY" :
     directionLong and maturedEntryFiltersAllowed ? "MATURED PRE-BREAK ENTRY" :
     direction != 0 and enableReversalGuard and exhaustionRisk >= maxReversalRiskForPineReady ? "DO NOT CHASE / WAIT RESET" :
     direction != 0 and not gateLiquidity ? "SKIP / LIQUIDITY" :
     direction != 0 and not gateBtcShock ? "WAIT / BTC SHOCK" :
     direction != 0 and not gateMaeRisk ? "WAIT / HIGH MAE RISK" :
     setupFsmState == FSM_RETEST and openSkyModeActive and postBreakHoldLong ? "OPEN SKY / HOLD CONTINUATION" :
     setupFsmState == FSM_RETEST and not postBreakRetestAccepted ? "WAIT RETEST" :
     setupFsmState == FSM_RETEST and postBreakRetestAccepted and not gateTrigger ? "WAIT RETEST TRIGGER" :
     setupFsmState == FSM_TRIGGERED and not entryReady ? "TRIGGERED / WAIT ENTRY QUALITY" :
     fsmArmedDegraded ? "ARMED / WAIT RECOVERY" :
     setupFsmState >= FSM_ARMED and not targetAhead ? "SKIP / TARGET BEHIND" :
     setupFsmState >= FSM_ARMED and not slDirectionalOk ? "SKIP / INVALID SL" :
     setupFsmState >= FSM_ARMED and not rrOk ? "SKIP / R:R" :
     setupFsmState >= FSM_ARMED and not gateGeometry ? "SKIP / GEOMETRY" :
     setupFsmState >= FSM_ARMED and not gateContext ? "WAIT / CONTEXT" :
     lockedLiquidityConsumed and not retainedRetestWindow ? "TARGET CONSUMED → NEXT ZONE" :
     setupFsmState >= FSM_ARMED and not gateTrigger ? "WAIT TRIGGER" :
     setupFsmState == FSM_APPROACH ? "WAIT TRIGGER / MATURATION" :
     fsmWatchDegraded ? "WATCH / WAIT RECOVERY" :
     direction != 0 and not gateStructure ? "SKIP / STRUCTURE" :
     direction != 0 and not gateApproach ? "WAIT APPROACH" :
     direction != 0 and not gateRisk ? "SKIP / RISK" :
     bounceWatch ? "WATCH BOUNCE ONLY" :
     direction != 0 ? "WATCH" : "WAIT SETUP"

// ============================================================================
// ALERT EVENT LOGIC + T1 TRACKER
// ============================================================================

bool alertBarOk = not alertsOnConfirmedClose or barstate.isconfirmed

// Milestone Quality Filters are the single source of truth for BRONZE/STRONG.
// Setup Quality is only the first layer. A final milestone may additionally require
// Trigger, Expected Move, Execution, Geometry, R:R, Continuation,
// MAE, Core Quality and a low enough Exhaustion Risk. All final milestone signals are confirmed-close only.
bool bronzeReversalAllowed = not enableReversalGuard or reversalRisk < maxReversalRiskBronze
bool strongReversalAllowed = not enableReversalGuard or reversalRisk < maxReversalRiskStrong

bool milestoneTriggerAllowed = not milestoneRequireTrigger or gateTrigger

bool bronzeExpectedMoveAllowed =
     not milestoneRequireExpectedMove or
     (targetAhead and not na(expectedMovePct) and expectedMovePct >= milestoneBronzeMinExpectedMovePct)
bool strongExpectedMoveAllowed =
     not milestoneRequireExpectedMove or
     (targetAhead and not na(expectedMovePct) and expectedMovePct >= milestoneStrongMinExpectedMovePct)

bool bronzeEntryReadinessAllowed =
     not milestoneRequireEntryReadiness or entryReadiness >= milestoneBronzeMinEntryReadiness
bool strongEntryReadinessAllowed =
     not milestoneRequireEntryReadiness or entryReadiness >= milestoneStrongMinEntryReadiness

bool bronzeTradeQualityAllowed =
     not milestoneRequireTradeQuality or tradeQuality >= milestoneBronzeMinTradeQuality
bool strongTradeQualityAllowed =
     not milestoneRequireTradeQuality or tradeQuality >= milestoneStrongMinTradeQuality

bool bronzeRrAllowed =
     not milestoneRequireRR or
     (targetAhead and slDirectionalOk and not na(rrToT1) and rrToT1 >= milestoneBronzeMinRR)
bool strongRrAllowed =
     not milestoneRequireRR or
     (targetAhead and slDirectionalOk and not na(rrToT1) and rrToT1 >= milestoneStrongMinRR)

bool bronzeContinuationAllowed =
     not milestoneRequireContinuation or continuationScore >= milestoneBronzeMinContinuation
bool strongContinuationAllowed =
     not milestoneRequireContinuation or continuationScore >= milestoneStrongMinContinuation

bool bronzeMaeRiskAllowed = not milestoneRequireMaeRisk or pullbackMaeRisk <= milestoneBronzeMaxMaeRisk
bool strongMaeRiskAllowed = not milestoneRequireMaeRisk or pullbackMaeRisk <= milestoneStrongMaxMaeRisk

// Core Quality Gate — EARLY MILESTONE QUALITY.
// IMPORTANT v1.13.4: Core stays early; Signal Integrity handles actionability/freshness separately.
// It evaluates structural level + adverse-flow safety at the first milestone reach.
// Activity / reset contributes only a small bonus, so a clean early BRONZE is not
// forced to wait for terminal momentum. RETEST/COMPRESSION get wider path limits.
bool milestoneCoreDirectionApplies = directionLong or (directionShort and milestoneCoreApplyToShort)
bool milestoneCoreLevelAllowed = activeLevelQuality >= milestoneCoreMinLevelQuality

float coreCounterLimit =
     riskPathCode == PATH_BREAKOUT_RETEST or riskPathCode == PATH_BREAKDOWN_RETEST ? milestoneCoreMaxCounterPressure * 5.0 :
     riskPathCode == PATH_COMPRESSION ? milestoneCoreMaxCounterPressure * 2.5 :
     riskPathCode == PATH_PROTO_BREAK ? milestoneCoreMaxCounterPressure * 2.0 :
     riskPathCode == PATH_BREAKOUT or riskPathCode == PATH_BREAKDOWN ? milestoneCoreMaxCounterPressure * 1.6 :
     milestoneCoreMaxCounterPressure
float coreDecelLimit =
     riskPathCode == PATH_BREAKOUT_RETEST or riskPathCode == PATH_BREAKDOWN_RETEST ? milestoneCoreMaxDeceleration * 4.0 :
     riskPathCode == PATH_COMPRESSION ? milestoneCoreMaxDeceleration * 3.0 :
     riskPathCode == PATH_PROTO_BREAK ? milestoneCoreMaxDeceleration * 2.0 :
     riskPathCode == PATH_BREAKOUT or riskPathCode == PATH_BREAKDOWN ? milestoneCoreMaxDeceleration * 1.5 :
     milestoneCoreMaxDeceleration
float coreCounterSafety = counterPressureScore <= coreCounterLimit ? 100.0 : f_clamp(1.0 - (counterPressureScore - coreCounterLimit) / math.max(100.0 - coreCounterLimit, 1.0), 0.0, 1.0) * 100.0
float coreDecelSafety = decelerationScore <= coreDecelLimit ? 100.0 : f_clamp(1.0 - (decelerationScore - coreDecelLimit) / math.max(100.0 - coreDecelLimit, 1.0), 0.0, 1.0) * 100.0
float coreImpulseHealth = math.max(
     f_clamp(activeActivityProxy / math.max(milestoneCoreMinActivity, 1) * 100.0, 0.0, 100.0),
     f_clamp(moveSinceResetAtr / math.max(milestoneCoreMinMoveSinceResetAtr, 0.10) * 100.0, 0.0, 100.0))
float coreQualityScore = direction != 0 ? f_clamp(
     activeLevelQuality * 0.40 +
     coreCounterSafety * 0.25 +
     coreDecelSafety * 0.25 +
     coreImpulseHealth * 0.10, 0.0, 100.0) : 0.0

float milestoneCoreMinBronzeEffective = math.min(100.0, milestoneCoreMinScoreBronze + (directionShort ? 5.0 : 0.0))
float milestoneCoreMinStrongEffective = math.min(100.0, milestoneCoreMinScoreStrong + (directionShort ? 5.0 : 0.0))
bool milestoneCoreQualityRawAllowed = milestoneCoreLevelAllowed and coreQualityScore >= milestoneCoreMinBronzeEffective
bool milestoneCoreQualityStrongRawAllowed = milestoneCoreLevelAllowed and coreQualityScore >= milestoneCoreMinStrongEffective
bool bronzeCoreQualityAllowed =
     not milestoneRequireCoreQuality or not milestoneCoreDirectionApplies or milestoneCoreQualityRawAllowed
bool strongCoreQualityAllowed =
     not milestoneRequireCoreQuality or not milestoneCoreDirectionApplies or milestoneCoreQualityStrongRawAllowed

// SIGNAL INTEGRITY v1.13.4 — makes BRONZE/STRONG actionable rather than pure Formation labels.
// SHORT milestones cannot fire while price is merely approaching support: actual short Trigger is mandatory.
float milestoneFreshResetBonus =
     riskPathCode == PATH_BREAKOUT_RETEST or riskPathCode == PATH_BREAKDOWN_RETEST ? 0.60 :
     riskPathCode == PATH_BREAKOUT or riskPathCode == PATH_BREAKDOWN ? 0.25 : 0.0
float milestoneFreshEmaBonus =
     riskPathCode == PATH_BREAKOUT_RETEST or riskPathCode == PATH_BREAKDOWN_RETEST ? 0.35 :
     riskPathCode == PATH_BREAKOUT or riskPathCode == PATH_BREAKDOWN ? 0.15 : 0.0
float milestoneBronzeMaxResetFresh = moveSinceResetWarnAtr + (moveSinceResetExtremeAtr - moveSinceResetWarnAtr) * 0.50 + milestoneFreshResetBonus
float milestoneStrongMaxResetFresh = moveSinceResetWarnAtr + (moveSinceResetExtremeAtr - moveSinceResetWarnAtr) * 0.35 + milestoneFreshResetBonus
float milestoneBronzeMaxEmaFresh = emaExtensionWarnAtr + (emaExtensionExtremeAtr - emaExtensionWarnAtr) * 0.50 + milestoneFreshEmaBonus
float milestoneStrongMaxEmaFresh = emaExtensionWarnAtr + (emaExtensionExtremeAtr - emaExtensionWarnAtr) * 0.35 + milestoneFreshEmaBonus

bool milestonePlanSane = targetAhead and slDirectionalOk and stopAtrOk and gateBtcShock
bool milestoneBronzePathReady = directionShort ? gateTrigger : (gateTrigger or candidateEntryPathScore > 0.0)
bool milestoneStrongPathReady =
     directionShort ? gateTrigger :
     (gateTrigger or (candidateEntryPathScore >= 90.0 and executionQuality >= milestoneStrongMinEntryReadiness and activeActivityProxy >= 4))
bool milestoneBronzeFresh = moveSinceResetAtr <= milestoneBronzeMaxResetFresh and emaExtensionAtr <= milestoneBronzeMaxEmaFresh
bool milestoneStrongFresh = moveSinceResetAtr <= milestoneStrongMaxResetFresh and emaExtensionAtr <= milestoneStrongMaxEmaFresh
bool bronzeSignalIntegrityAllowed = not milestoneSignalIntegrity or (milestonePlanSane and milestoneBronzePathReady and milestoneBronzeFresh)
bool strongSignalIntegrityAllowed = not milestoneSignalIntegrity or (milestonePlanSane and milestoneStrongPathReady and milestoneStrongFresh)

bool sameSetupGeneration =
     direction != 0 and direction[1] == direction and
     nz(lockedStartBar, -1) == nz(lockedStartBar[1], -1)

bool milestoneExecutionAllowed =
     direction != 0 and gateLiquidity and
     (not lockedLiquidityConsumed or breakoutLong or breakdownShort or postBreakRetestAccepted or postBreakHoldLong)

bool bronzeMilestoneFiltersAllowed =
     milestoneExecutionAllowed and milestoneTriggerAllowed and bronzeReversalAllowed and
     bronzeExpectedMoveAllowed and bronzeEntryReadinessAllowed and bronzeTradeQualityAllowed and
     bronzeRrAllowed and bronzeContinuationAllowed and bronzeMaeRiskAllowed and bronzeCoreQualityAllowed and bronzeSignalIntegrityAllowed

bool strongMilestoneFiltersAllowed =
     milestoneExecutionAllowed and milestoneTriggerAllowed and strongReversalAllowed and
     strongExpectedMoveAllowed and strongEntryReadinessAllowed and strongTradeQualityAllowed and
     strongRrAllowed and strongContinuationAllowed and strongMaeRiskAllowed and strongCoreQualityAllowed and strongSignalIntegrityAllowed

// MILESTONE TIMING v1.13.4 — BOUNDED QUALIFICATION WINDOW.
// First Formation reach starts a short pending window. Filters may mature only inside
// that window; after expiry the milestone is dropped instead of appearing terminally late.
bool milestoneCloseConfirmed = barstate.isconfirmed
var int milestoneLatchDirection = 0
var int milestoneLatchGeneration = na
var int milestoneState = 0
var int milestoneBronzeReachBar = na
var int milestoneStrongReachBar = na
var bool milestoneBronzeDone = false
var bool milestoneStrongDone = false
bool milestoneGenerationChanged =
     direction != 0 and
     (milestoneLatchDirection != direction or nz(milestoneLatchGeneration, -1) != nz(lockedStartBar, -1))

if direction == 0
    milestoneLatchDirection := 0
    milestoneLatchGeneration := na
    milestoneState := 0
    milestoneBronzeReachBar := na
    milestoneStrongReachBar := na
    milestoneBronzeDone := false
    milestoneStrongDone := false
else if milestoneGenerationChanged
    milestoneLatchDirection := direction
    milestoneLatchGeneration := lockedStartBar
    milestoneState := 0
    milestoneBronzeReachBar := na
    milestoneStrongReachBar := na
    milestoneBronzeDone := false
    milestoneStrongDone := false

if milestoneCloseConfirmed and direction != 0
    if na(milestoneBronzeReachBar) and setupQuality >= SETUP_QUALITY_BRONZE
        milestoneBronzeReachBar := bar_index
    if na(milestoneStrongReachBar) and setupQuality >= SETUP_QUALITY_STRONG
        milestoneStrongReachBar := bar_index

int bronzeQualificationAge = not na(milestoneBronzeReachBar) ? bar_index - milestoneBronzeReachBar : 100000
int strongQualificationAge = not na(milestoneStrongReachBar) ? bar_index - milestoneStrongReachBar : 100000
bool bronzeQualificationOpen = milestoneCloseConfirmed and not milestoneBronzeDone and bronzeQualificationAge >= 0 and bronzeQualificationAge <= milestoneQualificationWindowBars
bool strongQualificationOpen = milestoneCloseConfirmed and not milestoneStrongDone and strongQualificationAge >= 0 and strongQualificationAge <= milestoneQualificationWindowBars

bool setupQualityBronzeQualified = bronzeQualificationOpen and bronzeMilestoneFiltersAllowed
bool setupQualityStrongQualified = strongQualificationOpen and strongMilestoneFiltersAllowed
bool setupQualityBronzeReached = false
bool setupQualityStrongReached = false

if setupQualityStrongQualified
    setupQualityStrongReached := true
    milestoneStrongDone := true
    milestoneBronzeDone := true
    milestoneState := 2
else if setupQualityBronzeQualified
    setupQualityBronzeReached := true
    milestoneBronzeDone := true
    milestoneState := math.max(milestoneState, 1)

if milestoneCloseConfirmed
    if not milestoneBronzeDone and not na(milestoneBronzeReachBar) and bronzeQualificationAge >= milestoneQualificationWindowBars
        milestoneBronzeDone := true
    if not milestoneStrongDone and not na(milestoneStrongReachBar) and strongQualificationAge >= milestoneQualificationWindowBars
        milestoneStrongDone := true

// Single source of truth for user-facing milestone marker + alert.
bool setupQualityBronzeSignal = setupQualityBronzeReached
bool setupQualityStrongSignal = setupQualityStrongReached
bool setupQualityAnySignal = setupQualityBronzeSignal or setupQualityStrongSignal

// -----------------------------------------------------------------------------
// RESEARCH MODE — confirmed milestone outcome tracker
// Each signal starts at its confirmed Close; the signal candle itself is excluded.
// T1/SL are frozen at milestone time. Samples are bucketed by milestone + Risk Path.
// -----------------------------------------------------------------------------
if researchMode and milestoneCloseConfirmed
    if setupQualityBronzeSignal
        bool droppedBronzeResearch = f_researchAdd(researchActiveSignals, f_researchBucket(RESEARCH_BRONZE_BASE, riskPathCode), direction, close, atr, targetT1, estimatedSL, researchMaxActive)
        researchDropped += droppedBronzeResearch ? 1 : 0
    if setupQualityStrongSignal
        bool droppedStrongResearch = f_researchAdd(researchActiveSignals, f_researchBucket(RESEARCH_STRONG_BASE, riskPathCode), direction, close, atr, targetT1, estimatedSL, researchMaxActive)
        researchDropped += droppedStrongResearch ? 1 : 0
    f_researchUpdate(researchActiveSignals, researchStats, researchHorizonBars, researchGoodMfeAtr, researchMaxMaeAtr)


bool reversalWarningReached = alertBarOk and reversalWarning and (not sameSetupGeneration or not reversalWarning[1])
// A lifecycle FAILED SWEEP contributes to the active setup only when its stable
// zone ID matches the currently locked zone. Unrelated map-zone failures cannot
// print an R marker or contaminate this setup generation.
bool newLongReversalRisk = (reversalWarningReached and directionLong) or (alertBarOk and directionLong and lifecycleFailedSweepAgainstDirection)
bool newShortReversalRisk = (reversalWarningReached and directionShort) or (alertBarOk and directionShort and lifecycleFailedSweepAgainstDirection)

bool newLongWatch = alertBarOk and directionLong and fsmNewWatchEvent
bool newShortWatch = alertBarOk and directionShort and fsmNewWatchEvent

// WATCH ENTRY is deliberately first-WATCH-only: no qualification window, no later
// retry. This preserves the timing advantage observed in WATCH versus milestones.
bool watchEntryFiltersAllowed =
     enableWatchEntryMode and validWatch and gateInPlay and gateStructure and gateLiquidity and gateBtcShock and
     activeLevelQuality >= watchEntryMinLevelQuality and activeApproachScore >= watchEntryMinApproachScore and
     not na(activeDistanceAtr) and activeDistanceAtr <= watchEntryMaxDistanceAtr and
     targetAhead and slDirectionalOk and stopAtrOk and not na(rrToT1) and rrToT1 >= watchEntryMinRR and
     maeRisk <= watchEntryMaxMaeRisk and exhaustionRisk <= watchEntryMaxExhaustionRisk and
     contextQuality >= watchEntryMinContextQuality and
     (not watchEntryRequireCandidatePath or candidateEntryPathScore > 0.0)
bool watchEntryLongSignal = newLongWatch and watchEntryFiltersAllowed
bool watchEntryShortSignal = newShortWatch and watchEntryFiltersAllowed
bool watchEntryAnySignal = watchEntryLongSignal or watchEntryShortSignal


// WATCH ENTRY RESEARCH — independent family.
if researchMode and milestoneCloseConfirmed and watchEntryAnySignal
    int watchResearchDirection = watchEntryLongSignal ? 1 : -1
    bool droppedWatchResearch = f_researchAdd(researchActiveSignals, f_researchBucket(RESEARCH_WATCH_BASE, riskPathCode), watchResearchDirection, close, atr, targetT1, estimatedSL, researchMaxActive)
    researchDropped += droppedWatchResearch ? 1 : 0

// MATURED ENTRY is one-shot per setup generation and cannot duplicate the first WATCH bar.
var int maturedEntryLastGeneration = na
bool maturedEntryLongSignal = alertBarOk and directionLong and not newLongWatch and setupFsmState >= FSM_WATCH and maturedEntryFiltersAllowed and nz(maturedEntryLastGeneration, -1) != nz(lockedStartBar, -1)
if maturedEntryLongSignal
    maturedEntryLastGeneration := lockedStartBar
if direction == 0
    maturedEntryLastGeneration := na

if researchMode and milestoneCloseConfirmed and maturedEntryLongSignal
    bool droppedMaturedResearch = f_researchAdd(researchActiveSignals, f_researchBucket(RESEARCH_MATURED_BASE, riskPathCode), 1, close, atr, targetT1, estimatedSL, researchMaxActive)
    researchDropped += droppedMaturedResearch ? 1 : 0

bool newLongArmed = alertBarOk and directionLong and fsmNewArmedEvent and milestoneExecutionAllowed
bool newShortArmed = alertBarOk and directionShort and fsmNewArmedEvent and milestoneExecutionAllowed

// PINE READY is emitted from the persistent FSM transition. READY can only be
// reached once per generation, so a separate boolean latch is no longer required.
bool newLongEntry = alertBarOk and directionLong and fsmNewReadyEvent
bool newShortEntry = alertBarOk and directionShort and fsmNewReadyEvent


if researchMode and milestoneCloseConfirmed and (newLongEntry or newShortEntry)
    int pineResearchDirection = newLongEntry ? 1 : -1
    bool droppedPineResearch = f_researchAdd(researchActiveSignals, f_researchBucket(RESEARCH_PINE_BASE, riskPathCode), pineResearchDirection, close, atr, targetT1, estimatedSL, researchMaxActive)
    researchDropped += droppedPineResearch ? 1 : 0
bool newLongBreakout = alertBarOk and directionLong and breakoutLong
bool newShortBreakdown = alertBarOk and directionShort and breakdownShort
bool longArmedLost = alertBarOk and sameSetupGeneration and directionLong and fsmArmedDegraded and not fsmArmedDegraded[1] and not newLongEntry
bool shortArmedLost = alertBarOk and sameSetupGeneration and directionShort and fsmArmedDegraded and not fsmArmedDegraded[1] and not newShortEntry
bool newBounceLong = alertBarOk and bounceLong and not bounceLong[1]
bool newBounceShort = alertBarOk and bounceShort and not bounceShort[1]
bool activePlanExitSignal = barstate.isconfirmed and activePlanExit and (not sameSetupGeneration or not activePlanExit[1])
bool activePlanDegradedSignal = barstate.isconfirmed and activePlanNow and activePlanNoAdd and not activePlanExit and (not sameSetupGeneration or not activePlanNoAdd[1])
bool addOnAllowedSignal = barstate.isconfirmed and addOnAllowed and (not sameSetupGeneration or not addOnAllowed[1])

// PINE READY TRADE PLAN SNAPSHOT.
// Entry / SL / T1 / R:R / forecast are frozen at the confirmed entry event and remain
// immutable while that setup generation is active. This prevents the chart/dashboard
// from silently moving the plan after the user received an alert.
var bool tradePlanActive = false
var int tradePlanDirection = 0
var int tradePlanGeneration = na
var int tradePlanEntryBar = na
var float tradePlanEntry = na
var float tradePlanSL = na
var float tradePlanT1 = na
var float tradePlanRR = na
var float tradePlanExpectedMovePct = na
var float tradePlanStopDistanceAtr = na
var string tradePlanPath = ""
var float tradePlanPathScore = na

var float trackedLongT1 = na
var float trackedShortT1 = na
var int trackedLongEntryBar = na
var int trackedShortEntryBar = na
var bool longTargetActive = false
var bool shortTargetActive = false

bool tradePlanContextLost =
     tradePlanActive and not na(tradePlanEntryBar) and bar_index > tradePlanEntryBar and
     (lockedDirection == 0 or nz(lockedStartBar, -1) != nz(tradePlanGeneration, -1))
if tradePlanContextLost
    tradePlanActive := false
    tradePlanDirection := 0
    tradePlanGeneration := na
    tradePlanEntryBar := na
    tradePlanEntry := na
    tradePlanSL := na
    tradePlanT1 := na
    tradePlanRR := na
    tradePlanExpectedMovePct := na
    tradePlanStopDistanceAtr := na
    tradePlanPath := ""
    tradePlanPathScore := na
    trackedLongT1 := na
    trackedShortT1 := na
    trackedLongEntryBar := na
    trackedShortEntryBar := na
    longTargetActive := false
    shortTargetActive := false

if newLongEntry
    tradePlanActive := true
    tradePlanDirection := 1
    tradePlanGeneration := lockedStartBar
    tradePlanEntryBar := bar_index
    tradePlanEntry := close
    tradePlanSL := estimatedSL
    tradePlanT1 := targetT1
    tradePlanRR := rrToT1
    tradePlanExpectedMovePct := expectedMovePct
    tradePlanStopDistanceAtr := stopDistanceAtr
    tradePlanPath := entryPath
    tradePlanPathScore := entryPathScore
    trackedLongT1 := tradePlanT1
    trackedLongEntryBar := bar_index
    longTargetActive := targetAhead and not na(trackedLongT1)
    trackedShortT1 := na
    trackedShortEntryBar := na
    shortTargetActive := false

if newShortEntry
    tradePlanActive := true
    tradePlanDirection := -1
    tradePlanGeneration := lockedStartBar
    tradePlanEntryBar := bar_index
    tradePlanEntry := close
    tradePlanSL := estimatedSL
    tradePlanT1 := targetT1
    tradePlanRR := rrToT1
    tradePlanExpectedMovePct := expectedMovePct
    tradePlanStopDistanceAtr := stopDistanceAtr
    tradePlanPath := entryPath
    tradePlanPathScore := entryPathScore
    trackedShortT1 := tradePlanT1
    trackedShortEntryBar := bar_index
    shortTargetActive := targetAhead and not na(trackedShortT1)
    trackedLongT1 := na
    trackedLongEntryBar := na
    longTargetActive := false

// Confirmed-close entry cannot hit a target earlier inside the same candle.
bool longT1Hit = alertBarOk and longTargetActive and not na(trackedLongT1) and not na(trackedLongEntryBar) and bar_index > trackedLongEntryBar and high >= trackedLongT1
bool shortT1Hit = alertBarOk and shortTargetActive and not na(trackedShortT1) and not na(trackedShortEntryBar) and bar_index > trackedShortEntryBar and low <= trackedShortT1

if longT1Hit
    longTargetActive := false
    releaseSetupNextBar := true

if shortT1Hit
    shortTargetActive := false
    releaseSetupNextBar := true

// Persistent box updater: update geometry/style in-place and only allocate/delete
// when visibility changes. This avoids delete/new churn on every realtime tick.
f_syncBox(box existing, bool visible, int leftBar, float topPrice, float bottomPrice, color borderColor, int borderWidth, color bgColor, string boxText, color textColor) =>
    box result = existing
    if visible
        if na(result)
            result := box.new(
                 left = leftBar, top = topPrice, right = bar_index, bottom = bottomPrice,
                 xloc = xloc.bar_index, extend = extend.right, border_color = borderColor,
                 border_width = borderWidth, bgcolor = bgColor, text = boxText,
                 text_color = textColor, text_size = size.tiny)
        else
            box.set_left(result, leftBar)
            box.set_right(result, bar_index)
            box.set_top(result, topPrice)
            box.set_bottom(result, bottomPrice)
            box.set_border_color(result, borderColor)
            box.set_border_width(result, borderWidth)
            box.set_bgcolor(result, bgColor)
            box.set_text(result, boxText)
            box.set_text_color(result, textColor)
    else if not na(result)
        box.delete(result)
        result := na
    result

// ============================================================================
// ВИЗУАЛИЗАЦИЯ
// ============================================================================

// R/S are drawn as persistent horizontal box-zones instead of price-following plots.
// Fresh R/S targets are active boxes. Consumed liquidity is rendered separately
// according to lifecycle: SWEPT/PENDING, BROKEN/RETEST or FAILED SWEEP.
var box lifecycleZoneBox = na
var box r2ZoneBox = na
var box s2ZoneBox = na
var box r1ZoneBox = na
var box s1ZoneBox = na

if barstate.islast
    bool showLifecycleBox = showLevels and showBrokenRetestZone and effectiveBrokenZoneRetestBars > 0 and recentLifecycleZoneState > 0 and not na(recentLifecycleZoneTop) and not na(recentLifecycleZoneBottom) and not na(recentLifecycleZoneFirstBar)
    color lifecycleBg = recentLifecycleZoneState == 3 ? failedSweepZoneColor : recentLifecycleZoneState == 2 ? brokenRetestZoneColor : sweptPendingZoneColor
    color lifecycleBorder = recentLifecycleZoneState == 3 ? failedSweepBorderColor : recentLifecycleZoneState == 2 ? brokenRetestBorderColor : sweptPendingBorderColor
    string lifecycleText = recentLifecycleZoneState == 3 ? "FAILED SWEEP" : recentLifecycleZoneState == 2 ? "BROKEN / RETEST" : "SWEPT / PENDING"
    lifecycleZoneBox := f_syncBox(
         lifecycleZoneBox, showLifecycleBox,
         not na(recentLifecycleZoneFirstBar) ? math.max(recentLifecycleZoneFirstBar, bar_index - 9990) : bar_index,
         nz(recentLifecycleZoneTop, close), nz(recentLifecycleZoneBottom, close),
         lifecycleBorder, zoneBorderWidth, lifecycleBg, lifecycleText, lifecycleBorder)

    bool showR2 = showLevels and not na(resistance2) and not na(resistanceTop2) and not na(resistanceBottom2) and not na(resistanceFirstBar2)
    r2ZoneBox := f_syncBox(r2ZoneBox, showR2, not na(resistanceFirstBar2) ? math.max(resistanceFirstBar2, bar_index - 9990) : bar_index, nz(resistanceTop2, close), nz(resistanceBottom2, close), zoneBorderColorR, zoneBorderWidth, r2ZoneColor, "", zoneBorderColorR)

    bool showS2 = showLevels and not na(support2) and not na(supportTop2) and not na(supportBottom2) and not na(supportFirstBar2)
    s2ZoneBox := f_syncBox(s2ZoneBox, showS2, not na(supportFirstBar2) ? math.max(supportFirstBar2, bar_index - 9990) : bar_index, nz(supportTop2, close), nz(supportBottom2, close), zoneBorderColorS, zoneBorderWidth, s2ZoneColor, "", zoneBorderColorS)

    // On the sweep bar the frozen WATCH copy is already consumed. Do not keep
    // painting it as an active R1/S1 target; the lifecycle box above takes over.
    bool displayActiveR1 = hasResistance and not (lockedDirection == 1 and lockedLiquidityConsumed)
    bool displayActiveS1 = hasSupport and not (lockedDirection == -1 and lockedLiquidityConsumed)

    bool showR1 = showLevels and displayActiveR1 and not na(resistanceFirstBar1)
    r1ZoneBox := f_syncBox(r1ZoneBox, showR1, not na(resistanceFirstBar1) ? math.max(resistanceFirstBar1, bar_index - 9990) : bar_index, nz(resistanceTop1, close), nz(resistanceBottom1, close), zoneBorderColorR, lockedDirection == 1 ? lockedZoneBorderWidth : zoneBorderWidth, r1ZoneColor, "", zoneBorderColorR)

    bool showS1 = showLevels and displayActiveS1 and not na(supportFirstBar1)
    s1ZoneBox := f_syncBox(s1ZoneBox, showS1, not na(supportFirstBar1) ? math.max(supportFirstBar1, bar_index - 9990) : bar_index, nz(supportTop1, close), nz(supportBottom1, close), zoneBorderColorS, lockedDirection == -1 ? lockedZoneBorderWidth : zoneBorderWidth, s1ZoneColor, "", zoneBorderColorS)

float displayedTradePlanT1 = tradePlanActive ? tradePlanT1 : targetT1
float displayedTradePlanSL = tradePlanActive ? tradePlanSL : estimatedSL
float displayedTradePlanRR = tradePlanActive ? tradePlanRR : rrToT1
float displayedTradePlanExpectedMovePct = tradePlanActive ? tradePlanExpectedMovePct : expectedMovePct
// Hidden service plots for TradingView alertcondition placeholders.
float alertPlaceholderTP = directionLong and not na(trackedLongT1) ? trackedLongT1 : directionShort and not na(trackedShortT1) ? trackedShortT1 : displayedTradePlanT1
plot(displayedTradePlanSL, "ALERT_SL", display = display.none, editable = false)
plot(alertPlaceholderTP, "ALERT_TP", display = display.none, editable = false)
plot(direction, "ALERT_DIR", display = display.none, editable = false)

// Price-scale-only helpers for active structural R/S levels.
// These plots do not draw extra lines on the chart. They only expose the current
// R1/R2/S1/S2 prices on the symbol price scale and can be enabled/disabled
// independently from the indicator's Style tab.
bool scaleR1Visible = showLevels and hasResistance and not na(resistanceFirstBar1) and not (lockedDirection == 1 and lockedLiquidityConsumed)
bool scaleR2Visible = showLevels and not na(resistance2) and not na(resistanceTop2) and not na(resistanceBottom2) and not na(resistanceFirstBar2)
bool scaleS1Visible = showLevels and hasSupport and not na(supportFirstBar1) and not (lockedDirection == -1 and lockedLiquidityConsumed)
bool scaleS2Visible = showLevels and not na(support2) and not na(supportTop2) and not na(supportBottom2) and not na(supportFirstBar2)
plot(scaleR1Visible ? resistance1 : na, "R1 — цена на шкале", color = color.red, linewidth = 1, style = plot.style_linebr, display = display.price_scale, editable = true)
plot(scaleR2Visible ? resistance2 : na, "R2 — цена на шкале", color = color.red, linewidth = 1, style = plot.style_linebr, display = display.price_scale, editable = true)
plot(scaleS1Visible ? support1 : na, "S1 — цена на шкале", color = color.green, linewidth = 1, style = plot.style_linebr, display = display.price_scale, editable = true)
plot(scaleS2Visible ? support2 : na, "S2 — цена на шкале", color = color.green, linewidth = 1, style = plot.style_linebr, display = display.price_scale, editable = true)

plot((direction != 0 or tradePlanActive) ? displayedTradePlanT1 : na, "Forecast T1", color = color.blue, linewidth = 3, style = plot.style_linebr, editable = true)
plot(showRiskLevels and (direction != 0 or tradePlanActive) ? displayedTradePlanSL : na, "Estimated Structural SL", color = color.fuchsia, linewidth = 2, style = plot.style_linebr, editable = true)
plot(showEma ? emaFast : na, "EMA Fast", color = color.aqua, linewidth = 1, editable = true)
plot(showEma ? emaSlow : na, "EMA Slow", color = color.orange, linewidth = 1, editable = true)

// Один bgcolor() вместо пяти отдельных вызовов: это экономит plot-count TradingView.
color setupBgColor =
     not showBackground ? na :
     setupFsmState >= FSM_READY and directionLong ? color.new(color.lime, 82) :
     setupFsmState >= FSM_READY and directionShort ? color.new(color.red, 82) :
     setupFsmState >= FSM_ARMED and direction != 0 ? color.new(color.orange, 87) :
     setupFsmState >= FSM_WATCH and direction != 0 ? color.new(color.blue, 92) :
     bounceWatch ? color.new(color.purple, 90) :
     na
bgcolor(setupBgColor, title = "Setup state background", editable = true)

plotshape(showSignals and newLongWatch, title = "L WATCH label", style = shape.labelup, location = location.belowbar, text = "L WATCH", color = color.green, textcolor = color.white, editable = true, size = size.tiny)
plotshape(showSignals and newShortWatch, title = "S WATCH label", style = shape.labeldown, location = location.abovebar, text = "S WATCH", color = color.red, textcolor = color.white, editable = true, size = size.tiny)
// WATCH ENTRY uses label.new() rather than plotshape(): this allows a real vertical
// ATR offset and user-selectable marker style without consuming additional plot count.
f_watchEntryMarkerStyle(bool isLong) =>
    watchEntryMarkerType == "Arrow" ? (isLong ? label.style_arrowup : label.style_arrowdown) :
     watchEntryMarkerType == "Label" ? (isLong ? label.style_label_up : label.style_label_down) :
     watchEntryMarkerType == "Circle" ? label.style_circle :
     watchEntryMarkerType == "Diamond" ? label.style_diamond :
     watchEntryMarkerType == "Square" ? label.style_square :
     (isLong ? label.style_triangleup : label.style_triangledown)

f_renderWatchEntryMarkers() =>
    float markerGap = math.max(atr * watchEntryMarkerOffsetAtr, syminfo.mintick * 6.0)
    if showWatchEntryMarkers and watchEntryLongSignal
        label.new(
             x = bar_index, y = low - markerGap,
             text = "WE", xloc = xloc.bar_index, yloc = yloc.price,
             style = f_watchEntryMarkerStyle(true),
             color = watchEntryLongColor, textcolor = color.white, size = size.small,
             tooltip = "LONG WATCH ENTRY\nEarly-entry WATCH filters passed\nOffset: " + str.tostring(watchEntryMarkerOffsetAtr, "#.##") + " ATR"
        )
    if showWatchEntryMarkers and watchEntryShortSignal
        label.new(
             x = bar_index, y = high + markerGap,
             text = "WE", xloc = xloc.bar_index, yloc = yloc.price,
             style = f_watchEntryMarkerStyle(false),
             color = watchEntryShortColor, textcolor = color.white, size = size.small,
             tooltip = "SHORT WATCH ENTRY\nEarly-entry WATCH filters passed\nOffset: " + str.tostring(watchEntryMarkerOffsetAtr, "#.##") + " ATR"
        )
    0

f_renderWatchEntryMarkers()


f_renderMaturedEntryMarker() =>
    if showMaturedEntryMarkers and maturedEntryLongSignal
        float maturedGap = math.max(atr * maturedEntryMarkerOffsetAtr, syminfo.mintick * 8.0)
        label.new(x = bar_index, y = low - maturedGap, text = "M ENTRY", xloc = xloc.bar_index, yloc = yloc.price,
             style = label.style_label_up, color = maturedEntryLongColor, textcolor = color.white, size = size.small,
             tooltip = "LONG MATURED / PRE-BREAK ENTRY\nStrict pre-break safety passed before full trigger")
    0

f_renderMaturedEntryMarker()
plotshape(showSignals and newLongArmed, title = "LONG ARMED label", style = shape.labelup, location = location.belowbar, text = "ARMED", color = color.orange, textcolor = color.white, editable = true, size = size.tiny)
plotshape(showSignals and newShortArmed, title = "SHORT ARMED label", style = shape.labeldown, location = location.abovebar, text = "ARMED", color = color.orange, textcolor = color.white, editable = true, size = size.tiny)
plotshape(showSignals and newLongEntry, title = "LONG PINE READY label", style = shape.labelup, location = location.belowbar, text = "PINE\nREADY", color = color.lime, textcolor = color.white, editable = true, size = size.small)
plotshape(showSignals and newShortEntry, title = "SHORT PINE READY label", style = shape.labeldown, location = location.abovebar, text = "PINE\nREADY", color = color.red, textcolor = color.white, editable = true, size = size.small)
plotshape(showSignals and newBounceLong, title = "LONG BOUNCE WATCH label", style = shape.circle, location = location.belowbar, text = "B", color = color.purple, textcolor = color.white, editable = true, size = size.tiny)
plotshape(showSignals and newBounceShort, title = "SHORT BOUNCE WATCH label", style = shape.circle, location = location.abovebar, text = "B", color = color.purple, textcolor = color.white, editable = true, size = size.tiny)

// Высокий риск разворота / кульминации. Для LONG warning ставится над свечой,
// для SHORT — под свечой: это предупреждение против текущего continuation-direction.
plotshape(showReversalWarnings and newLongReversalRisk, title = "LONG REVERSAL RISK warning", style = shape.diamond, location = location.abovebar, text = "R", color = reversalWarningColor, textcolor = color.white, editable = true, size = size.tiny)
plotshape(showReversalWarnings and newShortReversalRisk, title = "SHORT REVERSAL RISK warning", style = shape.diamond, location = location.belowbar, text = "R", color = reversalWarningColor, textcolor = color.white, editable = true, size = size.tiny)

// AVG SETUP number on every active setup candle. label.new() is used because
// plotshape()/plotchar() cannot display a dynamic series string. On the realtime bar
// Pine rollback keeps only the newest label instance, so the displayed number updates
// as intrabar samples accumulate. TradingView's global label limit still applies.
string avgSetupBand =
     na(avgSetup) ? "n/a" :
     avgSetup >= 75.0 ? "EXCELLENT" :
     avgSetup >= 68.0 ? "STRONG" :
     avgSetup >= 62.0 ? "GOOD" :
     avgSetup >= 55.0 ? "BELOW AVG" :
     "WEAK"

color avgSetupChartColor =
     avgSetupRiskOverride ? color.red :
     na(avgSetup) ? color.silver :
     avgSetup >= 75.0 ? color.lime :
     avgSetup >= 68.0 ? color.green :
     avgSetup >= 62.0 ? color.yellow :
     avgSetup >= 55.0 ? color.orange :
     color.red

f_renderAvgSetupLabels() =>
    string avgSetupTooltip =
         "AVG SETUP: " + (na(avgSetup) ? "n/a" : str.tostring(avgSetup, "#.1") + " / 100") +
         "\nState: " + (avgSetupRiskOverride ? "DEGRADED / RISK OVERRIDE" : avgSetupBand) +
         "\nColors: <55 RED | 55..61 ORANGE | 62..67 YELLOW | 68..74 GREEN | >=75 LIME" +
         "\nHistory: " + str.tostring(avgSetupHistoryCount) + "/" + str.tostring(avgSetupBarsHistory) + " bars (same locked setup)" +
         "\nIntrabar samples, current bar: " + str.tostring(avgSetupIntrabarSamples) +
         "\nCurrent instant: " + (na(avgSetupInstant) ? "n/a" : str.tostring(avgSetupInstant, "#.1") + " / 100") +
         (showExecutionQualityOnChart ? "\nChart rows: AVG SETUP (top) / EXECUTION QUALITY " + str.tostring(executionQuality, "#") + "% (bottom)" : "") +
         "\n\nSIX DIMENSIONS / CURRENT" +
         "\nFormation 30%: " + str.tostring(formationQuality, "#") + "%" +
         " | Execution 25%: " + str.tostring(executionQuality, "#") + "%" +
         "\nGeometry 15%: " + str.tostring(geometryQuality, "#") + "%" +
         " | Context 10%: " + str.tostring(contextQuality, "#") + "%" +
         "\nExhaustion safety 10%: " + str.tostring(exhaustionSafety, "#") + "%" +
         " | MAE safety 10%: " + str.tostring(maeSafety, "#") + "%" +
         "\n\nRealtime current candle = intrabar mean. After script reload historical candles use final-bar state."

    if showAvgSetupOnChart and directionLong and not na(avgSetup)
        label.new(
             x = bar_index,
             y = low - math.max(atr * 0.42, syminfo.mintick * 7.0),
             text = str.tostring(avgSetup, "#") + (avgSetupRiskOverride ? "!" : "") + (showExecutionQualityOnChart ? "\n" + str.tostring(executionQuality, "#") : ""),
             xloc = xloc.bar_index,
             yloc = yloc.price,
             style = label.style_none,
             textcolor = avgSetupChartColor,
             size = size.tiny,
             tooltip = avgSetupTooltip
        )

    if showAvgSetupOnChart and directionShort and not na(avgSetup)
        label.new(
             x = bar_index,
             y = high + math.max(atr * 0.42, syminfo.mintick * 7.0),
             text = str.tostring(avgSetup, "#") + (avgSetupRiskOverride ? "!" : "") + (showExecutionQualityOnChart ? "\n" + str.tostring(executionQuality, "#") : ""),
             xloc = xloc.bar_index,
             yloc = yloc.price,
             style = label.style_none,
             textcolor = avgSetupChartColor,
             size = size.tiny,
             tooltip = avgSetupTooltip
        )

    0

f_renderAvgSetupLabels()

// Event-only management labels use label.new() to avoid consuming extra plot budget.
f_renderActiveHealthMarkers() =>
    if showSignals and activePlanExitSignal
        label.new(bar_index, directionLong ? high + math.max(atr * 0.25, syminfo.mintick * 5.0) : low - math.max(atr * 0.25, syminfo.mintick * 5.0), "EXIT", xloc = xloc.bar_index, yloc = yloc.price, style = directionLong ? label.style_label_down : label.style_label_up, color = color.red, textcolor = color.white, size = size.small, tooltip = "ACTIVE PLAN invalidated: MAE/failed-sweep risk crossed abort threshold")
    else if showSignals and activePlanDegradedSignal
        label.new(bar_index, directionLong ? high + math.max(atr * 0.20, syminfo.mintick * 4.0) : low - math.max(atr * 0.20, syminfo.mintick * 4.0), "NO ADD", xloc = xloc.bar_index, yloc = yloc.price, style = directionLong ? label.style_label_down : label.style_label_up, color = color.orange, textcolor = color.white, size = size.tiny, tooltip = "ACTIVE PLAN degraded: do not add until a fresh breakout/accepted retest confirmation")
    0

f_renderActiveHealthMarkers()

// SETUP QUALITY milestone tooltips.
// plotshape() не поддерживает hover-tooltip, поэтому BRONZE / STRONG визуализация
// выполнена через label.new(). Labels не расходуют TradingView plot-count budget.
// Подробности доступны при наведении как на dot, так и на directional arrow.
f_milestoneTooltip(bool isStrong) =>
    string side = directionLong ? "LONG" : directionShort ? "SHORT" : "—"
    string rrText = na(rrToT1) ? "n/a" : str.tostring(rrToT1, "#.##")
    (isStrong ? "STRONG " : "BRONZE ") + side +
     "\nF/E/G/C " + str.tostring(formationQuality, "#") + "/" + str.tostring(executionQuality, "#") + "/" + str.tostring(geometryQuality, "#") + "/" + str.tostring(contextQuality, "#") +
     "\nEx/MAE/Core " + str.tostring(exhaustionRisk, "#") + "/" + str.tostring(maeRisk, "#") + "/" + str.tostring(coreQualityScore, "#") +
     "\nPath " + riskPath + " | RR " + rrText + " | SL " + (na(estimatedSL) ? "n/a" : str.tostring(estimatedSL, format.mintick)) + " | T1 " + (na(targetT1) ? "n/a" : str.tostring(targetT1, format.mintick))

f_renderMilestonePair(color dotColor, color arrowColor, float offsetAtr, float offsetTicks, string tooltipText) =>
    label.new(bar_index, close, "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_circle,
         color = dotColor, textcolor = dotColor, size = size.tiny, tooltip = tooltipText)
    label.new(bar_index,
         directionLong ? low - math.max(atr * offsetAtr, syminfo.mintick * offsetTicks) : high + math.max(atr * offsetAtr, syminfo.mintick * offsetTicks),
         "", xloc = xloc.bar_index, yloc = yloc.price,
         style = directionLong ? label.style_triangleup : label.style_triangledown,
         color = arrowColor, textcolor = arrowColor, size = size.tiny, tooltip = tooltipText)
    0

f_renderQualityMilestones() =>
    bool renderBronze = showQualityBronzeMarker and setupQualityBronzeSignal
    bool renderStrong = showQualityStrongMarker and setupQualityStrongSignal
    if renderBronze
        f_renderMilestonePair(setupQualityBronzeDotColor, setupQualityBronzeArrowColor, 0.18, 4.0, f_milestoneTooltip(false))
    if renderStrong
        f_renderMilestonePair(setupQualityStrongDotColor, setupQualityStrongArrowColor, 0.30, 6.0, f_milestoneTooltip(true))
    0

f_renderQualityMilestones()

// -----------------------------------------------------------------------------
// Trigger diagnostics labels removed in compile-lean build; alerts and trigger logic are unchanged.
plotshape(showTargetLabel and directionLong and not na(displayedTradePlanT1) ? displayedTradePlanT1 : na, title = "LONG T1 label", style = shape.triangledown, location = location.absolute, text = "T1", color = color.blue, textcolor = color.white, editable = true, size = size.tiny)
plotshape(showTargetLabel and directionShort and not na(displayedTradePlanT1) ? displayedTradePlanT1 : na, title = "SHORT T1 label", style = shape.triangleup, location = location.absolute, text = "T1", color = color.blue, textcolor = color.white, editable = true, size = size.tiny)

// ============================================================================
// DECISION PANEL / DASHBOARD
// Зелёный = обязательное выполнено; красный = blocker; оранжевый = optional/neutral.
// ============================================================================

var table dash = table.new(position.top_right, 4, 43, border_width = 1, frame_width = 1)

// Adaptive dashboard renderer.
// FULL keeps the original 4-column layout.
// COMPACT pairs two source rows into Metric/Value | Metric/Value.
// MINIMAL keeps 20 decision-critical metrics in 10 rows.
// Trading logic is untouched; only table coordinates/presentation change.
// FULL order: decision → quality/risk → entry → structure → context/plan → management → research.
f_dashboardTextSize(bool forceTiny) =>
    forceTiny ? size.tiny :
     dashboardTextSizeInput == "Tiny" ? size.tiny :
     dashboardTextSizeInput == "Small" ? size.small :
     size.normal

f_minimalSlot(int row) =>
    // 20 decision-critical metrics in the same semantic order as FULL.
    row == 1  ? 0  :  // ACTION
     row == 2  ? 1  :  // BLOCKERS
     row == 4  ? 2  :  // Direction / Path
     row == 5  ? 3  :  // AVG SETUP
     row == 6  ? 4  :  // CONTINUATION
     row == 7  ? 5  :  // Formation
     row == 8  ? 6  :  // Execution
     row == 9  ? 7  :  // Geometry
     row == 10 ? 8  :  // Exhaustion
     row == 11 ? 9  :  // MAE
     row == 12 ? 10 :  // Hard Gates
     row == 13 ? 11 :  // Fresh Trigger
     row == 14 ? 12 :  // Candidate Path
     row == 15 ? 13 :  // Trigger Path
     row == 22 ? 14 :  // Approach
     row == 30 ? 15 :  // Context
     row == 31 ? 16 :  // SL
     row == 32 ? 17 :  // T1
     row == 33 ? 18 :  // R:R
     row == 35 ? 19 :  // ACTIVE Plan Health
     -1

// FULL rows are now contiguous and already arranged semantically.
// COMPACT simply packs the same order two Metric/Value pairs per line.
f_compactSlot(int row) =>
    row >= 1 and row <= 42 ? row - 1 : -1

f_dashRow(int row, string labelText, string valueText, string noteText, int state, color valueBgOverride, bool valueTiny) =>
    color neutralBg = color.new(dashboardBackgroundColor, dashboardBackgroundTransparency)
    color noteColor = color.new(dashboardFontColor, 30)
    color valueBg = na(valueBgOverride) ? neutralBg : valueBgOverride

    if dashboardModeInput == "FULL"
        table.cell(dash, 0, row, labelText, bgcolor = neutralBg, text_color = dashboardFontColor, text_size = f_dashboardTextSize(false), tooltip = noteText)
        table.cell(dash, 1, row, valueText, bgcolor = valueBg, text_color = dashboardFontColor, text_size = f_dashboardTextSize(valueTiny), tooltip = noteText)
        table.cell(dash, 2, row, noteText, bgcolor = neutralBg, text_color = noteColor, text_size = size.tiny, tooltip = noteText)
        table.cell(dash, 3, row, f_gateMark(state), bgcolor = f_gateColor(state), text_color = dashboardFontColor, text_size = f_dashboardTextSize(false), tooltip = noteText)
    else if dashboardModeInput == "COMPACT"
        int compactSlot = f_compactSlot(row)
        if compactSlot >= 0
            int compactRow = int(math.floor(compactSlot / 2.0)) + 1
            int compactCol = compactSlot % 2 == 0 ? 0 : 2
            string compactValue = f_gateMark(state) + " " + valueText
            table.cell(dash, compactCol, compactRow, labelText, bgcolor = neutralBg, text_color = dashboardFontColor, text_size = f_dashboardTextSize(false), tooltip = noteText)
            table.cell(dash, compactCol + 1, compactRow, compactValue, bgcolor = valueBg, text_color = dashboardFontColor, text_size = f_dashboardTextSize(valueTiny), tooltip = noteText)
    else
        int minimalSlot = f_minimalSlot(row)
        if minimalSlot >= 0
            int minimalRow = int(math.floor(minimalSlot / 2.0)) + 1
            int minimalCol = minimalSlot % 2 == 0 ? 0 : 2
            string minimalValue = f_gateMark(state) + " " + valueText
            table.cell(dash, minimalCol, minimalRow, labelText, bgcolor = neutralBg, text_color = dashboardFontColor, text_size = f_dashboardTextSize(false), tooltip = noteText)
            table.cell(dash, minimalCol + 1, minimalRow, minimalValue, bgcolor = valueBg, text_color = dashboardFontColor, text_size = f_dashboardTextSize(valueTiny), tooltip = noteText)
    0

f_renderDecisionPanelA() =>

    if barstate.islast
        if dashboardPositionInput == "Нижний правый"
            table.set_position(dash, position.bottom_right)
        else if dashboardPositionInput == "Нижний левый"
            table.set_position(dash, position.bottom_left)
        else
            table.set_position(dash, position.top_right)
        // Clear the full table before each last-bar redraw.
        // Prevents stale FULL cells when switching to COMPACT/MINIMAL.
        table.clear(dash, 0, 0, 3, 42)

    if barstate.islast and showDashboard
        int dashboardHeaderTransparency = math.max(dashboardBackgroundTransparency - 30, 0)
        color headerBg = color.new(dashboardBackgroundColor, dashboardHeaderTransparency)
        color neutralBg = color.new(dashboardBackgroundColor, dashboardBackgroundTransparency)
        string dirText = directionLong ? "LONG" : directionShort ? "SHORT" : bounceLong ? "LONG bounce" : bounceShort ? "SHORT bounce" : "—"

        if dashboardModeInput == "FULL"
            table.cell(dash, 0, 0, "DECISION", bgcolor = headerBg, text_color = dashboardFontColor, text_size = f_dashboardTextSize(false))
            table.cell(dash, 1, 0, "VALUE", bgcolor = headerBg, text_color = dashboardFontColor, text_size = f_dashboardTextSize(false))
            table.cell(dash, 2, 0, "GATE / NOTE", bgcolor = headerBg, text_color = dashboardFontColor, text_size = size.tiny)
            table.cell(dash, 3, 0, "OK", bgcolor = headerBg, text_color = dashboardFontColor, text_size = f_dashboardTextSize(false))
        else
            table.cell(dash, 0, 0, "DECISION", bgcolor = headerBg, text_color = dashboardFontColor, text_size = f_dashboardTextSize(false))
            table.cell(dash, 1, 0, "VALUE", bgcolor = headerBg, text_color = dashboardFontColor, text_size = f_dashboardTextSize(false))
            table.cell(dash, 2, 0, "DECISION", bgcolor = headerBg, text_color = dashboardFontColor, text_size = f_dashboardTextSize(false))
            table.cell(dash, 3, 0, "VALUE", bgcolor = headerBg, text_color = dashboardFontColor, text_size = f_dashboardTextSize(false))

        f_dashRow(1, "ACTION", actionText, "DOM/Tape remains external; ACTIVE health has priority", activePlanExit or activePlanReduce or activePlanNoAdd ? -1 : setupFsmState >= FSM_READY ? 1 : reversalWarning ? -1 : 0, activePlanExit ? color.new(color.red, 52) : activePlanNoAdd ? color.new(color.orange, 62) : setupFsmState >= FSM_READY ? color.new(color.green, 60) : reversalWarning ? color.new(color.red, 70) : setupFsmState >= FSM_ARMED ? color.new(color.orange, 65) : neutralBg, false)

        f_dashRow(3, "Family / State", setupFamily + " / " + setupState, "FORM→WATCH→APPROACH→ARMED→TRIGGER→RETEST→READY→ACTIVE", direction != 0 or bounceWatch ? 1 : 0, color(na), false)

        f_dashRow(4, "Direction / Path", dirText + " / " + riskPath, (generationPostBreakPhase ? "POST-BREAK" : "PRE-BREAK") + " | FSM path=" + setupFsmPath, direction != 0 ? 1 : 0, color(na), false)

        f_dashRow(7, "Formation Quality", str.tostring(formationQuality, "#") + "%", "WATCH / ARMED / milestone quality", direction == 0 ? 0 : validWatch ? 1 : -1, direction == 0 ? color(na) : f_valueTrafficColor(formationQuality, 65.0, 75.0, false), false)

        f_dashRow(8, "Execution Quality", str.tostring(executionQuality, "#") + "%", "READY ≥ " + str.tostring(minEntryReadiness, "#") + "%", direction == 0 ? 0 : entryReadiness >= minEntryReadiness ? 1 : -1, direction == 0 ? color(na) : f_valueTrafficColor(executionQuality, 60.0, 70.0, false), false)

        f_dashRow(9, "Geometry Quality", str.tostring(geometryQuality, "#") + "%", "R:R quality / SL / target ≥ " + str.tostring(minTradeQuality, "#") + "%", direction == 0 ? 0 : tradeQuality >= minTradeQuality ? 1 : -1, direction == 0 ? color(na) : f_valueTrafficColor(geometryQuality, 50.0, 60.0, false), false)

        color avgSetupBg =
             avgSetupRiskOverride ? color.new(color.red, 62) :
             na(avgSetup) ? neutralBg :
             avgSetup >= 75.0 ? color.new(color.lime, 66) :
             avgSetup >= 68.0 ? color.new(color.green, 70) :
             avgSetup >= 62.0 ? color.new(color.yellow, 70) :
             avgSetup >= 55.0 ? color.new(color.orange, 72) :
             color.new(color.red, 76)
        f_dashRow(5, "AVG SETUP", na(avgSetup) ? "n/a" : str.tostring(avgSetup, "#.1") + (avgSetupRiskOverride ? " / DEGRADED" : " / 100"), (avgSetupRiskOverride ? "RISK OVERRIDE | " : "") + avgSetupBand + " | " + str.tostring(avgSetupHistoryCount) + "/" + str.tostring(avgSetupBarsHistory) + " bars + intrabar", avgSetupRiskOverride ? -1 : 0, avgSetupBg, false)
        f_dashRow(6, "CONTINUATION", str.tostring(continuationScore, "#") + "%", "meta-score: F30 / E20 / G10 / C20 / ExSafe10 / MAESafe10; informational, not a hard gate", direction == 0 ? 0 : continuationScore >= 62.0 ? 1 : continuationScore < 55.0 ? -1 : 0, direction == 0 ? color(na) : f_valueTrafficColor(continuationScore, 55.0, 62.0, false), false)


        f_dashRow(10, "Exhaustion Risk", str.tostring(exhaustionRisk, "#") + "% / " + exhaustionRiskLevel, "PINE max " + str.tostring(maxReversalRiskForPineReady, "#") + "%", direction == 0 ? 0 : gateReversal ? 1 : -1, direction == 0 ? color(na) : f_valueTrafficColor(exhaustionRisk, 40.0, 65.0, true), false)

        f_dashRow(11, "MAE Risk", str.tostring(maeRisk, "#") + "% / " + maeRiskLevel, "path-aware adverse excursion risk", direction == 0 ? 0 : gateMaeRisk ? 1 : -1, direction == 0 ? color(na) : f_valueTrafficColor(maeRisk, 40.0, 60.0, true), false)

        f_dashRow(13, "Fresh Trigger", gateTrigger ? (gateFreshReadyTrigger ? "FRESH / RECONFIRMED" : "STALE") : "WAIT", "PINE READY requires current trigger freshness", direction == 0 ? 0 : gateTrigger and gateFreshReadyTrigger ? 1 : gateTrigger ? -1 : 0, gateTrigger and not gateFreshReadyTrigger ? color.new(color.red, 68) : color(na), false)
        f_dashRow(17, "Pre-break Safety", currentPreBreakPath ? (preBreakSafetyAllowed ? "PASS" : "BLOCK") : "n/a", "L65 F75 E75 A7 RR1.5 InPlay3/4 or vol; distance/rejection; touches", currentPreBreakPath ? (preBreakSafetyAllowed ? 1 : -1) : 0, currentPreBreakPath and not preBreakSafetyAllowed ? color.new(color.red, 68) : color(na), true)
        f_dashRow(35, "ACTIVE Plan Health", not activePlanNow ? "n/a" : activePlanExit ? "EXIT" : activePlanReduce ? "REDUCE" : activePlanNoAdd ? "DEGRADED" : "HEALTHY", "live health overrides persistent ACTIVE lifecycle", not activePlanNow ? 0 : activePlanExit or activePlanReduce ? -1 : activePlanNoAdd ? -1 : 1, activePlanExit ? color.new(color.red, 55) : activePlanNoAdd ? color.new(color.orange, 65) : activePlanHealthy ? color.new(color.green, 68) : color(na), false)
        f_dashRow(36, "ADD-ON Gate", not activePlanNow ? "n/a" : addOnAllowed ? "ADD CONFIRMED" : "NO ADD", "fresh breakout/accepted retest + current quality/risk gates", not activePlanNow ? 0 : addOnAllowed ? 1 : -1, addOnAllowed ? color.new(color.green, 62) : activePlanNow ? color.new(color.red, 74) : color(na), false)
        f_dashRow(34, "Target Freshness", direction == 0 ? "n/a" : targetConsumedUnresolved ? "CONSUMED / UNRESOLVED" : lockedLiquidityConsumed ? "BROKEN/RETEST" : "FRESH", "unresolved sweep blocks add-on and degrades ACTIVE", direction == 0 ? 0 : targetConsumedUnresolved ? -1 : 1, targetConsumedUnresolved ? color.new(color.red, 70) : color(na), false)

    0

f_renderDecisionPanelB() =>

    if barstate.islast and showDashboard
        color neutralBg = color.new(dashboardBackgroundColor, dashboardBackgroundTransparency)
        string activeZoneText = directionLong and not na(resistanceBottom1) and not na(resistanceTop1) ? str.tostring(resistanceBottom1, format.mintick) + "–" + str.tostring(resistanceTop1, format.mintick) : directionShort and not na(supportBottom1) and not na(supportTop1) ? str.tostring(supportBottom1, format.mintick) + "–" + str.tostring(supportTop1, format.mintick) : "n/a"
        int gatesPassed = (gateInPlay ? 1 : 0) + (gateLevel ? 1 : 0) + (gateStructure ? 1 : 0) + (gateApproach ? 1 : 0) + (gateDistance ? 1 : 0)





        f_dashRow(12, "Hard Gates", str.tostring(gatesPassed) + "/5", "InPlay Level Structure Approach Distance", direction == 0 ? 0 : gatesPassed == 5 ? 1 : -1, color(na), false)

        f_dashRow(19, "Level Quality", str.tostring(activeLevelQuality, "#") + "%", "level + early core quality", direction == 0 ? 0 : gateLevel ? 1 : -1, direction == 0 ? color(na) : f_valueTrafficColor(activeLevelQuality, 55.0, 70.0, false), false)

        f_dashRow(20, "Trigger Zone", activeZoneText + " / " + str.tostring(lockedTouches) + "t", lockedLiquidityConsumed ? "consumed/retest" : "fresh trigger zone", direction == 0 ? 0 : retainedRetestWindow ? 0 : lockedLiquidityConsumed ? -1 : 1, lockedLiquidityConsumed ? color.new(color.orange, 78) : neutralBg, false)

        f_dashRow(21, "Distance → level", na(activeDistanceAtr) ? "n/a" : str.tostring(activeDistanceAtr, "#.##") + " ATR", isPostBreak ? "post-break guarded" : "to nearest box edge", direction == 0 ? 0 : gateDistance ? 1 : -1, color(na), false)

        f_dashRow(22, "Approach Quality", str.tostring(activeApproachScore) + "/9 / " + str.tostring(activeApproachQuality, "#") + "%", "hard gate ≥ " + str.tostring(minApproachScore), direction == 0 ? 0 : gateApproach ? 1 : -1, direction == 0 ? color(na) : f_valueTrafficColor(float(activeApproachScore), 5.0, 6.0, false), false)

        string maturedPanelText = not enableMaturedEntryMode ? "OFF" : maturedEntryLongSignal ? "FIRED" : maturedEntryFiltersAllowed ? "PRE-BREAK READY" : "WAIT"
        f_dashRow(16, "MATURED Entry", maturedPanelText, "LONG pre-break entry; independent of OHLCV trigger", not enableMaturedEntryMode ? 0 : maturedEntryLongSignal or maturedEntryFiltersAllowed ? 1 : 0, maturedEntryLongSignal or maturedEntryFiltersAllowed ? color.new(color.green, 70) : neutralBg, false)

    0

f_renderDecisionPanelC() =>

    if barstate.islast and showDashboard
        color neutralBg = color.new(dashboardBackgroundColor, dashboardBackgroundTransparency)
        string trendText = bullTrend ? "Bull" : bearTrend ? "Bear" : "Neutral"

        f_dashRow(23, "Structure", openSkyModeActive ? "ATH / Open Sky" : broadConsolidationLong ? "Broad Consolidation" : activeCompression ? "Compression" : activeProto ? "Protorgovka" : directionLong and correctionResetLong ? "Reset/Recovery" : directionShort and correctionResetShort ? "Reset/Recovery" : trendText, "hard structural gate", direction == 0 ? 0 : gateStructure ? 1 : -1, color(na), false)


        f_dashRow(14, "Candidate Path", candidateEntryPath + " / " + str.tostring(candidateEntryPathScore, "#") + "%", "forming route; ×0.75 until trigger", direction == 0 ? 0 : candidateEntryPathScore > 0.0 ? 1 : 0, color(na), false)

        f_dashRow(15, "Trigger Path", entryPath + " / " + str.tostring(entryPathScore, "#") + "%", "actual route NOW; freshness=" + (gateFreshReadyTrigger ? "OK" : "STALE"), direction == 0 ? 0 : gateTrigger and gateFreshReadyTrigger ? 1 : gateTrigger ? -1 : 0, gateTrigger and not gateFreshReadyTrigger ? color.new(color.red, 70) : gateTrigger ? color.new(color.green, 72) : neutralBg, false)


        f_dashRow(29, "Fixed-time In-Play", str.tostring(activityCheckCount) + "/4", "1h/6h/24h + 1h NATR", inPlay ? 1 : -1, color(na), false)



        f_dashRow(30, "Context Quality", str.tostring(contextQuality, "#") + "% / BTC " + (not useBtcContext ? "off" : btcBull ? "Bull" : btcBear ? "Bear" : "Neutral") + " / Shock " + str.tostring(btcShockScore, "#"), "activity / liquidity / BTC / whipsaw", direction == 0 ? 0 : gateContext ? 1 : -1, direction == 0 ? color(na) : f_valueTrafficColor(contextQuality, 45.0, 60.0, false), false)

    0

f_renderDecisionPanelD() =>

    if barstate.islast and showDashboard
        color neutralBg = color.new(dashboardBackgroundColor, dashboardBackgroundTransparency)

        float displayedStopDistanceAtr = tradePlanActive ? tradePlanStopDistanceAtr : stopDistanceAtr
        int displayedSlState = tradePlanActive ? (not na(displayedTradePlanSL) ? 1 : -1) : direction == 0 ? 0 : (slDirectionalOk and stopAtrOk) ? 1 : -1
        f_dashRow(31, "Estimated SL", not na(displayedTradePlanSL) ? str.tostring(displayedTradePlanSL, format.mintick) + " / " + str.tostring(displayedStopDistanceAtr, "#.##") + " ATR" : "n/a", tradePlanActive ? "FROZEN @ PINE READY" : "≤ " + str.tostring(maxStopAtr, "#.##") + " ATR", displayedSlState, color(na), false)

        int displayedTargetState = tradePlanActive ? (not na(displayedTradePlanT1) ? 1 : -1) : direction == 0 ? 0 : expectedMoveOk ? 1 : -1
        f_dashRow(32, "Forecast T1", not na(displayedTradePlanT1) ? str.tostring(displayedTradePlanT1, format.mintick) + " / " + f_fmtPct(displayedTradePlanExpectedMovePct) : "n/a", tradePlanActive ? "FROZEN @ PINE READY" : targetMode, displayedTargetState, color(na), false)

        int displayedRrState = tradePlanActive ? (not na(displayedTradePlanRR) and displayedTradePlanRR >= minRRSafetyFloor ? 1 : -1) : direction == 0 ? 0 : rrOk ? 1 : -1
        f_dashRow(33, "R:R → T1", na(displayedTradePlanRR) ? "n/a" : str.tostring(displayedTradePlanRR, "#.##"), tradePlanActive ? "frozen @ PINE READY" : "safety floor + geometry quality", displayedRrState, color(na), false)



        f_dashRow(2, "BLOCKERS", blockerText, "REVERSAL = no chase", blockerText == "NONE" ? 1 : direction == 0 ? 0 : -1, blockerText == "NONE" ? color.new(color.green, 65) : neutralBg, true)

        f_dashRow(18, "DOM / Tape Gate", entryReady ? "CHECK NOW" : "WAIT", "Pine ≠ order book/tape | Fresh trigger + path safety required", entryReady ? 1 : 0, color(na), false)

        f_dashRow(24, "MTF Trend Quality", str.tostring(directionLong ? mtfTrendQualityLong : directionShort ? mtfTrendQualityShort : mtfTrendQualityLong, "#") + "%", "MTF alignment; Formation bonus", direction == 0 ? 0 : ((directionLong ? mtfTrendQualityLong : mtfTrendQualityShort) >= 60.0 ? 1 : 0), color(na), false)
        f_dashRow(25, "Dynamic Support", directionLong ? str.tostring(dynamicSupportQualityLong, "#") + "%" : "—", "swing-low trendline proxy | MATURED helper", directionLong ? (dynamicSupportLong ? 1 : 0) : 0, color(na), false)
        f_dashRow(26, "HTF Base", str.tostring(htfBaseQualityLong, "#") + "% / age~" + str.tostring(htfBaseAgeProxy, "#"), "long-duration HTF base context", directionLong ? (htfBaseQualityLong >= 60.0 ? 1 : 0) : 0, color(na), false)
        f_dashRow(27, "Broad Consolidation", broadConsolidationLong ? str.tostring(broadConsolidationQualityLong, "#") + "%" : "—", "separate from narrow proto", broadConsolidationLong ? 1 : 0, color(na), false)
        f_dashRow(28, "ATH / Open Sky", openSkyModeActive ? "ACTIVE / A" + str.tostring(athAcceptanceQuality, "#") + "%" : "—", "accepted ATH breakout continuation", openSkyModeActive ? (postBreakHoldLong ? 1 : 0) : 0, color(na), false)

        [researchWatchText, researchWatchNote] = f_researchSummary(RESEARCH_WATCH_BASE, riskPathCode)
        [researchMaturedText, researchMaturedNote] = f_researchSummary(RESEARCH_MATURED_BASE, riskPathCode)
        [researchPineText, researchPineNote] = f_researchSummary(RESEARCH_PINE_BASE, riskPathCode)
        [researchBronzeText, researchBronzeNote] = f_researchSummary(RESEARCH_BRONZE_BASE, riskPathCode)
        [researchStrongText, researchStrongNote] = f_researchSummary(RESEARCH_STRONG_BASE, riskPathCode)
        f_dashRow(37, "Research Mode", researchMode ? "ON / H" + str.tostring(researchHorizonBars) + " / active " + str.tostring(array.size(researchActiveSignals)) : "OFF", "MFE/MAE + T1/SL first-hit tracker", researchMode ? 1 : 0, color(na), true)
        f_dashRow(38, "Research WATCH ENTRY", researchMode ? researchWatchText : "—", researchMode ? riskPath + " | " + researchWatchNote : "Enable Research Mode", 0, color(na), true)
        f_dashRow(39, "Research MATURED", researchMode ? researchMaturedText : "—", researchMode ? riskPath + " | " + researchMaturedNote : "Enable Research Mode", 0, color(na), true)
        f_dashRow(40, "Research PINE READY", researchMode ? researchPineText : "—", researchMode ? riskPath + " | " + researchPineNote : "Enable Research Mode", 0, color(na), true)
        f_dashRow(41, "Research BRONZE", researchMode ? researchBronzeText : "—", researchMode ? riskPath + " | " + researchBronzeNote : "Enable Research Mode", 0, color(na), true)
        f_dashRow(42, "Research STRONG", researchMode ? researchStrongText : "—", researchMode ? riskPath + " | " + researchStrongNote : "Enable Research Mode", 0, color(na), true)

    if barstate.islast and not showDashboard
        table.clear(dash, 0, 0, 3, 42)

    0

f_renderDecisionPanelA()
f_renderDecisionPanelB()
f_renderDecisionPanelC()
f_renderDecisionPanelD()

