float pullbackRiskStartAtr = input.float(0.25, "MAE: pullback risk starts, ATR", minval = 0.0, maxval = 3.0, step = 0.05, group = G_REVERSAL)
float pullbackRiskExtremeAtr = input.float(1.20, "MAE: pullback extreme, ATR", minval = 0.1, maxval = 6.0, step = 0.05, group = G_REVERSAL)
float counterPressureExtremeAtr = input.float(0.80, "MAE: counter body extreme, ATR", minval = 0.1, maxval = 4.0, step = 0.05, group = G_REVERSAL)
int decelerationFastBars = input.int(2, "MAE: recent velocity bars", minval = 1, maxval = 10, group = G_REVERSAL)
int decelerationSlowBars = input.int(5, "MAE: prior velocity endpoint", minval = 2, maxval = 20, tooltip = "Should normally be greater than recent velocity bars. The code safely handles equal/reversed values.", group = G_REVERSAL)
float maxMaeRiskForPineReady = input.float(
     60.0, "PINE READY: max Pullback / MAE Risk, %", minval = 0, maxval = 100, step = 1,
     tooltip = "Separate from Reversal Risk. Blocks entries that are not necessarily exhausted but currently have high probability of an adverse pullback / MAE.",
     group = G_REVERSAL
)
int accelerationLookback = input.int(5, "Acceleration lookback, баров", minval = 2, maxval = 20, group = G_REVERSAL)
int accelerationStrongBars = input.int(3, "Мин. сильных свечей в acceleration", minval = 1, maxval = 10, group = G_REVERSAL)
float accelerationMinMoveAtr = input.float(2.0, "Acceleration: мин. движение, ATR", minval = 0.2, maxval = 10.0, step = 0.1, group = G_REVERSAL)
int minNoPullbackBars = input.int(4, "Acceleration: минимум баров без reset", minval = 1, maxval = 30, group = G_REVERSAL)

float volumeClimaxRvol = input.float(2.0, "Volume climax: RVOL >=", minval = 0.5, maxval = 20.0, step = 0.1, group = G_REVERSAL)
float volumeClimaxRangeAtr = input.float(1.10, "Volume climax: range >= ATR", minval = 0.2, maxval = 8.0, step = 0.1, group = G_REVERSAL)
float reversalWickAtr = input.float(0.70, "Reversal rejection wick, ATR", minval = 0.1, maxval = 5.0, step = 0.05, group = G_REVERSAL)
float reversalCloseLocation = input.float(0.45, "Reversal: close-location threshold", minval = 0.10, maxval = 0.49, step = 0.01, tooltip = "LONG risk: close <= threshold; SHORT risk: close >= 1-threshold.", group = G_REVERSAL)
int failedBreakRecentBars = input.int(8, "Failed sweep сохранять N баров", minval = 0, maxval = 24, tooltip = "v1.15.1: longer same-generation memory so a failed attack cannot disappear after only a few candles.", group = G_REVERSAL)
float minRemainingTargetAtr = input.float(0.50, "Мин. оставшееся пространство до T1, ATR", minval = 0.0, maxval = 5.0, step = 0.1, group = G_REVERSAL)

float reversalWarningThreshold = input.float(65.0, "Exhaustion Risk: предупреждение от, %", minval = 0, maxval = 100, step = 1, group = G_REVERSAL)
float maxReversalRiskForPineReady = input.float(75.0, "PINE READY: макс. Exhaustion Risk, %", minval = 0, maxval = 100, step = 1, group = G_REVERSAL)
bool useOiDivergence = input.bool(false, "Учитывать внешний OI plot", tooltip = "Опционально. Выберите OI plot в следующем Source. Сам по себе OI не является hard filter.", group = G_REVERSAL)
float oiExternalSource = input.source(close, "OI Source", group = G_REVERSAL)
bool useCvdDivergence = input.bool(false, "Учитывать внешний CVD plot", tooltip = "Опционально. Выберите CVD plot в следующем Source.", group = G_REVERSAL)
float cvdExternalSource = input.source(close, "CVD Source", group = G_REVERSAL)
int divergenceLookback = input.int(12, "OI/CVD divergence lookback", minval = 3, maxval = 100, group = G_REVERSAL)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS — MILESTONE QUALITY FILTERS
// Финальные BRONZE/STRONG marker + alert используют эти фильтры как единый source of truth.
// PROFILE DEFAULT: legacy v1.6.1 inputs remain restored. Pullback/MAE + Core Quality Gate are ON by default; other optional milestone filters stay OFF.
// ─────────────────────────────────────────────────────────────────────────────
float SETUP_QUALITY_BRONZE = input.float(58.0, "SETUP_QUALITY_BRONZE, %",
     minval = 0.0, maxval = 100.0, step = 1.0, inline = "ms_quality",
     tooltip = "Базовый Quality threshold для BRONZE. Финальный marker/alert дополнительно требует все включённые Milestone Quality Filters.",
     group = G_MILESTONE
)

float SETUP_QUALITY_STRONG = input.float(
     70.0, "SETUP_QUALITY_STRONG, %",
     minval = 0.0, maxval = 100.0, step = 1.0, inline = "ms_quality",
     tooltip = "Базовый Quality threshold для STRONG. Финальный marker/alert дополнительно требует все включённые Milestone Quality Filters.",
     group = G_MILESTONE
)

// CORE QUALITY — Stage 3. Level remains a structural hard floor. Core Score itself
// is now built only from independent Execution (65%) + Context (35%) dimensions.
// Old Counter/Decel/Activity/Reset anchors remain visible as legacy path diagnostics.
bool milestoneRequireCoreQuality = input.bool(
     true, "Core Quality Gate",
     tooltip = "Default ON. Milestone Core is an EARLY-quality veto, not a hidden Execution/Trigger gate: Level Quality stays a hard floor; Counter Pressure and Deceleration use path-aware limits; Activity/Reset only improve Core Score and do not delay a milestone by themselves.",
     group = G_MILESTONE
)
bool milestoneCoreApplyToShort = input.bool(
     true, "Core Gate: применять к SHORT",
     tooltip = "Default ON с v1.13.4. SHORT остаётся строже LONG: к базовому Core Score автоматически добавляется +5 п.п. к минимальному порогу. Это исправляет ситуацию, когда SHORT milestone проходил почти без quality-veto.",
     group = G_MILESTONE
)
float milestoneCoreMinLevelQuality = input.float(70.0, "Core: Level Quality >=", minval = 0.0, maxval = 100.0, step = 1.0, inline = "ms_core1", group = G_MILESTONE)
float milestoneCoreMaxCounterPressure = input.float(5.0, "Diag Counter <=", minval = 0.0, maxval = 100.0, step = 1.0, inline = "ms_core1", group = G_MILESTONE)
float milestoneCoreMaxDeceleration = input.float(10.0, "Diag Decel <=", minval = 0.0, maxval = 100.0, step = 1.0, inline = "ms_core2", group = G_MILESTONE)
int milestoneCoreMinActivity = input.int(5, "Diag Activity >=", minval = 1, maxval = 5, inline = "ms_core2", group = G_MILESTONE)
float milestoneCoreMinMoveSinceResetAtr = input.float(1.50, "Diag Reset >= ATR", minval = 0.0, maxval = 20.0, step = 0.10, inline = "ms_core2", group = G_MILESTONE)
float milestoneCoreMinScoreBronze = input.float(65.0, "Core Score B >=", minval = 0.0, maxval = 100.0, step = 1.0, inline = "ms_core3", tooltip = "Early Core Quality Score. Level is a hard floor; Counter/Decel are path-aware safety factors; Activity/Reset is a small bonus rather than a hard wait condition.", group = G_MILESTONE)
float milestoneCoreMinScoreStrong = input.float(72.0, "STR >=", minval = 0.0, maxval = 100.0, step = 1.0, inline = "ms_core3", group = G_MILESTONE)

bool milestoneSignalIntegrity = input.bool(
     true, "Signal Integrity Gate",
     tooltip = "Default ON. Не даёт BRONZE/STRONG противоречить Decision Panel: нужен реальный Candidate/Trigger path, валидный trade plan, отсутствие adverse BTC Shock и не слишком поздняя EMA/reset extension. Для SHORT BRONZE/STRONG дополнительно требуется фактический Trigger; STRONG LONG до Trigger допускается только для очень сильного Candidate path.",
     group = G_MILESTONE
)
int milestoneQualificationWindowBars = input.int(
     3, "Milestone qualification window, баров", minval = 0, maxval = 10,
     tooltip = "После первого достижения Formation threshold milestone может ждать включённые фильтры только это число закрытых баров. 0 = только бар первого достижения. Ограниченное окно допускает формирование path/trigger без старого эффекта запоздалого сигнала через много свечей.",
     group = G_MILESTONE
)

// Все фильтры ниже применяются к marker и alert одинаково.
// Milestone получает короткое qualification-window, но никогда не ждёт бесконечно.

bool milestoneRequireTrigger = input.bool(
     true, "Require Trigger = YES",
     tooltip = "Default ON. BRONZE/STRONG отображаются только на закрытом баре с активным OHLCV Trigger. Milestone может ждать Trigger только внутри ограниченного qualification window, поэтому поздний сигнал через много свечей не возникает.",
     group = G_MILESTONE
)

bool milestoneRequireExpectedMove = input.bool(false, "Expected Move", inline = "ms_move", group = G_MILESTONE)
float milestoneBronzeMinExpectedMovePct = input.float(1.0, "B ≥ %", minval = 0.0, maxval = 30.0, step = 0.1, inline = "ms_move", group = G_MILESTONE)
float milestoneStrongMinExpectedMovePct = input.float(1.5, "STR ≥ %", minval = 0.0, maxval = 30.0, step = 0.1, inline = "ms_move", group = G_MILESTONE)

bool milestoneRequireEntryReadiness = input.bool(false, "Execution Quality", inline = "ms_entry", group = G_MILESTONE)
float milestoneBronzeMinEntryReadiness = input.float(55.0, "B ≥", minval = 0.0, maxval = 100.0, step = 1.0, inline = "ms_entry", group = G_MILESTONE)
float milestoneStrongMinEntryReadiness = input.float(62.0, "STR ≥", minval = 0.0, maxval = 100.0, step = 1.0, inline = "ms_entry", group = G_MILESTONE)

bool milestoneRequireTradeQuality = input.bool(false, "Geometry Quality", inline = "ms_trade", group = G_MILESTONE)
float milestoneBronzeMinTradeQuality = input.float(55.0, "B ≥", minval = 0.0, maxval = 100.0, step = 1.0, inline = "ms_trade", group = G_MILESTONE)
float milestoneStrongMinTradeQuality = input.float(60.0, "STR ≥", minval = 0.0, maxval = 100.0, step = 1.0, inline = "ms_trade", group = G_MILESTONE)

bool milestoneRequireRR = input.bool(false, "R:R → T1", inline = "ms_rr", tooltip = "Default OFF in v1.15: T1 is often first liquidity and may have R:R below 1.5. Enable only if you want milestone-specific R:R filtering.", group = G_MILESTONE)
float milestoneBronzeMinRR = input.float(1.20, "B ≥", minval = 0.1, maxval = 20.0, step = 0.1, inline = "ms_rr", group = G_MILESTONE)
float milestoneStrongMinRR = input.float(1.40, "STR ≥", minval = 0.1, maxval = 20.0, step = 0.1, inline = "ms_rr", group = G_MILESTONE)

bool milestoneRequireContinuation = input.bool(false, "Continuation", inline = "ms_cont", group = G_MILESTONE)
float milestoneBronzeMinContinuation = input.float(55.0, "B ≥", minval = 0.0, maxval = 100.0, step = 1.0, inline = "ms_cont", group = G_MILESTONE)
float milestoneStrongMinContinuation = input.float(62.0, "STR ≥", minval = 0.0, maxval = 100.0, step = 1.0, inline = "ms_cont", group = G_MILESTONE)

bool milestoneRequireMaeRisk = input.bool(
     true, "Pullback / MAE Risk", inline = "ms_mae",
     tooltip = "Default ON: filters milestones that look structurally good but have elevated near-term adverse excursion risk. This is deliberately separate from Reversal/Exhaustion Risk.",
     group = G_MILESTONE
)
float milestoneBronzeMaxMaeRisk = input.float(65.0, "B ≤", minval = 0.0, maxval = 100.0, step = 1.0, inline = "ms_mae", group = G_MILESTONE)
float milestoneStrongMaxMaeRisk = input.float(55.0, "STR ≤", minval = 0.0, maxval = 100.0, step = 1.0, inline = "ms_mae", group = G_MILESTONE)

float maxReversalRiskBronze = input.float(70.0, "Max Exhaustion Risk — BRONZE, %",
     minval = 0.0, maxval = 100.0, step = 1.0,
     tooltip = "Используется при включённом Reversal / Exhaustion Guard. Более низкое значение сильнее отсеивает late-entry / overextension.",
     inline = "ms_rev", group = G_MILESTONE
)
float maxReversalRiskStrong = input.float(65.0, "STRONG Exhaustion, %",
     minval = 0.0, maxval = 100.0, step = 1.0,
     inline = "ms_rev", group = G_MILESTONE
)

// ─────────────────────────────────────────────────────────────────────────────
// WATCH ENTRY — early first-entry layer. Evaluated ONLY on the first confirmed
// WATCH event of a setup generation; it never waits for later maturation.
// ─────────────────────────────────────────────────────────────────────────────
bool enableWatchEntryMode = input.bool(true, "Включить WATCH Entry Mode", tooltip = "Ранний вход только на свече первого LONG/SHORT WATCH. Не ждёт последующие бары: если фильтры не прошли на первом WATCH, WATCH ENTRY для этой generation не появляется. BRONZE/STRONG остаются confirmation/add-on.", group = G_WATCH_ENTRY)
float watchEntryMinLevelQuality = input.float(60.0, "Level Quality >=", minval = 0, maxval = 100, step = 1, inline = "we1", group = G_WATCH_ENTRY)
int watchEntryMinApproachScore = input.int(5, "Approach >=", minval = 1, maxval = 9, inline = "we1", group = G_WATCH_ENTRY)
float watchEntryMaxDistanceAtr = input.float(2.5, "Distance <= ATR", minval = 0.1, maxval = 10, step = 0.1, inline = "we2", group = G_WATCH_ENTRY)
float watchEntryMinRR = input.float(0.60, "R:R >=", minval = 0.1, maxval = 20, step = 0.1, inline = "we2", group = G_WATCH_ENTRY)
float watchEntryMaxMaeRisk = input.float(45.0, "MAE <= %", minval = 0, maxval = 100, step = 1, inline = "we3", group = G_WATCH_ENTRY)
float watchEntryMaxExhaustionRisk = input.float(45.0, "Exhaust <= %", minval = 0, maxval = 100, step = 1, inline = "we3", group = G_WATCH_ENTRY)
float watchEntryMinContextQuality = input.float(45.0, "Context >= %", minval = 0, maxval = 100, step = 1, inline = "we4", group = G_WATCH_ENTRY)
bool watchEntryRequireCandidatePath = input.bool(false, "Требовать Candidate Path != WAIT", tooltip = "Default OFF, чтобы не превращать WATCH ENTRY в поздний mature-сигнал. Включайте только если хотите более редкий ранний вход с уже сформированным execution path.", inline = "we4", group = G_WATCH_ENTRY)


// MATURED / PRE-BREAK ENTRY — a second early-entry layer that can fire after the first WATCH,
// when compression/acceptance has matured but BEFORE a full breakout trigger.
bool enableMaturedEntryMode = input.bool(true, "Включить MATURED / PRE-BREAK ENTRY", tooltip = "One-shot LONG signal per setup generation. It never replaces PINE READY and does not require gateTrigger.", group = G_MATURED)
float maturedEntryMinFormation = input.float(75.0, "Formation >=", minval = 0, maxval = 100, step = 1, inline = "me1", group = G_MATURED)
float maturedEntryMinExecution = input.float(75.0, "Execution >=", minval = 0, maxval = 100, step = 1, inline = "me1", group = G_MATURED)
float maturedEntryMinLevelQuality = input.float(65.0, "Level >=", minval = 0, maxval = 100, step = 1, inline = "me2", group = G_MATURED)
int maturedEntryMinApproachScore = input.int(7, "Approach >=", minval = 1, maxval = 9, inline = "me2", group = G_MATURED)
float maturedEntryMaxDistanceAtr = input.float(1.50, "Distance <= ATR", minval = 0.1, maxval = 10.0, step = 0.1, inline = "me3", group = G_MATURED)
float maturedEntryMinRR = input.float(1.50, "R:R >=", minval = 0.1, maxval = 10.0, step = 0.05, inline = "me3", group = G_MATURED)
float maturedEntryMinGeometry = input.float(60.0, "Geometry >=", minval = 0, maxval = 100, step = 1, inline = "me4", group = G_MATURED)
float maturedEntryMinContext = input.float(45.0, "Context >=", minval = 0, maxval = 100, step = 1, inline = "me4", group = G_MATURED)
float maturedEntryMaxMae = input.float(45.0, "MAE <=", minval = 0, maxval = 100, step = 1, inline = "me5", group = G_MATURED)
float maturedEntryMaxExhaustion = input.float(45.0, "Exhaust <=", minval = 0, maxval = 100, step = 1, inline = "me5", group = G_MATURED)

